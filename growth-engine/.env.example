# Copy to .env and fill in. See docs/SETUP.md for how to get each value.

# --- Claude (drafting engine) ---
ANTHROPIC_API_KEY=sk-ant-...
# Pre-approval draft check: an LLM judge (claude-haiku-4-5) grades every draft
# against a checklist before it reaches Telegram, auto-revising once on failure.
# ON by default — set to 0 to disable without a deploy.
GROWTH_ENGINE_VERIFY=1

# --- Telegram (approval bot) ---
# Create a bot with @BotFather, then message your bot once and get your chat id.
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=123456789

# --- X / Twitter (auto-posting) ---
# From developer.x.com — a project with OAuth 1.0a user context (read + write).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Google Search Console (read-only search performance, docs/SETUP.md §4b) ---
# Optional. Path to a service-account key file, and the verified property URL.
# The service account also needs Full access on the property in Search Console.
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=https://klantkraan.nl/

# --- Meta: Instagram + Facebook Page auto-posting (docs/AUTOPUBLISH.md) ---
# Long-lived Page access token (no expiry) for the Page linked to the IG account.
META_ACCESS_TOKEN=
# Numeric id of the Facebook Page posts go to.
META_FB_PAGE_ID=
# Numeric id of the IG professional account (from page?fields=instagram_business_account).
META_IG_USER_ID=
# Public HTTPS base URL serving data/<vertical>/media/ — IG *image* posts need it
# (Meta downloads the file); reels upload locally and don't. e.g. https://media.klantkraan.nl/fitness
# META_MEDIA_BASE_URL=
# Graph API version override (default v25.0).
# META_GRAPH_VERSION=v25.0

# --- TikTok: draft-to-inbox upload (docs/AUTOPUBLISH.md) ---
# From the app on developers.tiktok.com (Content Posting API product, video.upload scope).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the TikTok app (one-time OAuth).
TIKTOK_REDIRECT_URI=

# --- Buffer (LinkedIn / Instagram / X delivery) ---
# GraphQL API at https://api.buffer.com, bearer auth. Available on every Buffer plan.
# Buffer's per-channel queue owns the posting SCHEDULE — the engine only pushes drafts
# into the queue (mode: addToQueue), so cadence is tuned in Buffer, not in this repo.
BUFFER_API_KEY=
# Both optional. Channels are found by matching Buffer's `service` to the platform name,
# so neither is needed for one org with one channel per service. Pin the org only if the
# account has several; pin a channel when one service has two (personal profile + company
# page) and the engine cannot know which you meant. Check with:
#   python -m src.publish_buffer
# BUFFER_ORGANIZATION_ID=
# BUFFER_CHANNEL_LINKEDIN=

# --- Stock photos (optional) ---
# Free key from https://www.pexels.com/api/ — enables photo cards (media.stock in config).
# Without it, all cards render flat-branded (still fine). Shared across verticals.
# PEXELS_API_KEY=

# --- Optional overrides ---
# GROWTH_ENGINE_DRY_RUN=1   # generate + notify but never actually post to X

# --- Multi-vertical ---
# One engine process per vertical. GROWTH_CONFIG selects the strategy YAML (default:
# config/content_strategy.yaml = trades). Per-vertical secrets go in .env.<vertical>
# (e.g. .env.fitness), which overrides this file — at minimum its OWN
# TELEGRAM_BOT_TOKEN (two pollers on one token conflict).
# GROWTH_CONFIG=config/fitness.yaml
