[Unit]
Description=Regenerate the Klantkraan status page every 15 minutes

[Timer]
# The page header promises a fresh page every 15 min (generate.py REGEN_MINUTES);
# keep the two in sync. Persistent=true regenerates immediately after a reboot.
OnCalendar=*:0/15
Persistent=true
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
