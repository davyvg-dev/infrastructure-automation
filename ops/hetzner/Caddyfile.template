# deploy.sh substitutes __DEMO_HOST__ (demo-<ip-dashes>.sslip.io until real DNS exists).
# demo.klantkraan.nl is served here too; add its A record (DNS-only / grey cloud in
# Cloudflare, so Caddy can provision its own Let's Encrypt cert) then run deploy.sh.
# The sslip host stays as a fallback that always works without DNS.
demo.klantkraan.nl, __DEMO_HOST__ {
	reverse_proxy 127.0.0.1:8000
}

# Fitness-vertical demo — same process; the server routes by the first Host label
# ("fitness" -> config/clients/fitness.yaml). Linked from klantkraan.nl/sportscholen.
fitness.__DEMO_HOST__ {
	reverse_proxy 127.0.0.1:8000
}

# Founder-only status page: static HTML regenerated by klantkraan-status.timer.
# deploy.sh substitutes __STATUS_HASH__ (bcrypt from `caddy hash-password`, generated
# once on the box and kept in /etc/caddy/status_hash; the plaintext is printed exactly
# once, on the deploy that generates it).
status.__DEMO_HOST__ {
	basic_auth {
		founder __STATUS_HASH__
	}
	root * /var/www/status
	file_server
}
