---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import PreviewBanner from '../components/PreviewBanner.astro'
import StickyCallBar from '../components/StickyCallBar.astro'
import { loadClient } from '../lib/client'
import { openingHoursSpecification } from '../lib/format'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const { config, siteUrl, logoUrl, isPreview } = loadClient()
const { bedrijf } = config

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString()
// A proposal says so in the tab title too: screenshots and shared links travel
// further than the page itself.
const paginaTitel = isPreview ? `${title} | voorbeeld van Klantkraan` : title

// LocalBusiness JSON-LD: name, address, area, phone, hours, url. Deliberately
// NO review/aggregateRating markup: self-serving review schema is a Google
// manual-action risk, reviews stay plain text on the page.
// Never emitted on a proposal: structured data about a business we do not
// represent, on a URL they do not own, is exactly the entity confusion that
// noindex alone would not prevent.
const schema = isPreview
  ? null
  : {
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      '@id': `${siteUrl}/#bedrijf`,
      name: bedrijf.naam,
      url: `${siteUrl}/`,
      telephone: bedrijf.telefoon.replace(/ /g, ''),
      email: bedrijf.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: bedrijf.adres.straat,
        postalCode: bedrijf.adres.postcode,
        addressLocality: bedrijf.adres.plaats,
        addressCountry: 'NL',
      },
      areaServed: bedrijf.werkgebied.map((plaats) => ({ '@type': 'City', name: plaats })),
      openingHoursSpecification: openingHoursSpecification(config.openingstijden),
      ...(logoUrl ? { image: `${siteUrl}${logoUrl}` } : {}),
    }
---

<!doctype html>
<html
  lang="nl"
  style={`--brand-primary: ${config.branding.kleur_primair}; --brand-accent: ${config.branding.kleur_accent}`}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <title>{paginaTitel}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content={bedrijf.naam} />
    <meta property="og:title" content={paginaTitel} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta name="theme-color" content={config.branding.kleur_primair} />
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class="pb-[calc(4.75rem+env(safe-area-inset-bottom))] md:pb-0">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-(--radius-button) focus:bg-(--brand-primary) focus:px-4 focus:py-2 focus:text-white focus:no-underline"
    >
      Ga naar hoofdinhoud
    </a>
    {isPreview && <PreviewBanner />}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyCallBar />
  </body>
</html>
