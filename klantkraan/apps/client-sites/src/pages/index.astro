---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import Intro from '../components/Intro.astro'
import Diensten from '../components/Diensten.astro'
import Werk from '../components/Werk.astro'
import Werkgebied from '../components/Werkgebied.astro'
import Usps from '../components/Usps.astro'
import Reviews from '../components/Reviews.astro'
import SpoedPanel from '../components/SpoedPanel.astro'
import FinalCta from '../components/FinalCta.astro'
import { loadClient } from '../lib/client'
import { toon } from '../lib/toon'

const { config } = loadClient()
const t = toon(config)
---

<Base title={t.titel} description={t.omschrijving}>
  <Hero />
  <Intro />
  <Diensten />
  <Werk />
  <Werkgebied />
  <Usps />
  <Reviews />
  <SpoedPanel />
  <FinalCta />
</Base>
