---
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import Diensten from '../../components/Diensten.astro'
import FinalCta from '../../components/FinalCta.astro'
import { loadClient } from '../../lib/client'
import { capitalize, plaatsSlug, somOp, telHref } from '../../lib/format'

// One city-page template, rendered ONLY for the configured werkgebied plaatsen.
// The schema caps werkgebied at 5, which keeps this under Google's
// doorway-page radar: few pages, each tied to a real service area.
export function getStaticPaths() {
  const { config } = loadClient()
  return config.bedrijf.werkgebied.map((plaats) => ({
    params: { plaats: plaatsSlug(plaats) },
    props: { plaats },
  }))
}

interface Props {
  plaats: string
}
const { plaats } = Astro.props
const { config } = loadClient()
const { bedrijf } = config
const vak = capitalize(bedrijf.vak)
const andere = bedrijf.werkgebied.filter((p) => p !== plaats)
const title = `${vak} in ${plaats} | ${bedrijf.naam}`
const description = `${bedrijf.naam} is uw ${bedrijf.vak} in ${plaats}. Bel ${bedrijf.telefoon} voor een afspraak of een vrijblijvende offerte.`
---

<Base title={title} description={description}>
  <section class="border-b border-(--color-line) bg-(--color-card)">
    <div class="mx-auto max-w-5xl px-6 py-14 md:py-20">
      <h1 class="text-h1">{vak} in {plaats}</h1>
      <p class="mt-5 max-w-2xl text-(--color-mist)">
        Zoekt u een {bedrijf.vak} in {plaats}? {bedrijf.naam} komt bij u langs, bekijkt de
        situatie en doet u een heldere offerte voordat het werk begint.
        {
          bedrijf.adres.plaats === plaats
            ? ` Ons bedrijf zit in ${plaats}, dus wij zijn snel bij u.`
            : ` Vanuit ${bedrijf.adres.plaats} zijn wij snel in ${plaats}.`
        }
      </p>
      <a href={telHref(bedrijf.telefoon)} class="btn btn-call mt-8">
        <Icon name="phone" class="h-5 w-5" />
        <span>Bel {bedrijf.telefoon}</span>
      </a>
    </div>
  </section>

  <Diensten />

  {
    andere.length > 0 && (
      <section class="mx-auto max-w-5xl px-6 pb-4">
        <p class="text-small text-(--color-mist)">
          Naast {plaats} werken wij ook in {somOp(andere)}.
        </p>
      </section>
    )
  }

  <FinalCta />
</Base>
