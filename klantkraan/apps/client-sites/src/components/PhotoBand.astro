---
import { loadClient } from '../lib/client'

// Photo band, in order of preference:
//   1. the client's own work photos (clients/<slug>/fotos/) -- always best, and what
//      the intake checklist asks for;
//   2. the stock set for their vak (stock/<vak>/, fetched by scripts/stock-photos.py)
//      when they supplied none, which is always the case on a voorstel because we do
//      not take a prospect's own images;
//   3. a decorative colour-block band, when no stock set exists for the vak yet.
// Still never AI images. Stock is a backdrop while we wait for real photos, never a
// claim that this is the client's work: only the client's own photos get the "Werk van
// <naam>" alt text, stock is described by trade instead.
const { config, fotos, stock } = loadClient()
const own = fotos.length > 0
const shown = (own ? fotos : stock).slice(0, 6)
// "Werk van een loodgieter", not "Werk van <naam>": true of a stock photo, and it
// composes for any vak without guessing Dutch compound-noun linking letters.
const alt = own ? `Werk van ${config.bedrijf.naam}` : `Werk van een ${config.bedrijf.vak}`
const label = own ? "Foto's van ons werk" : 'Sfeerbeeld'
// The band renders ~170px squares, so the -sm variant covers almost every viewport.
// Client photos have no -sm and no known dimensions (no image pipeline: intake asks for
// web-ready files), so srcset and width/height apply to the stock set only.
const srcset = (src: string) => `${src.replace(/\.jpg$/, '-sm.jpg')} 400w, ${src} 800w`
// Matches SIZE in scripts/stock-photos.py; square, so the ratio agrees with aspect-square
// and the browser reserves the right box before the image loads (no layout shift).
const STOCK_PX = 800
---

{
  shown.length > 0 ? (
    <section aria-label={label} class="border-y border-(--color-line) bg-(--color-card)">
      <ul
        role="list"
        class="mx-auto grid max-w-5xl grid-cols-2 gap-2 px-6 py-8 sm:grid-cols-3 md:grid-cols-6"
      >
        {shown.map((src) => (
          <li>
            <img
              src={src}
              srcset={own ? undefined : srcset(src)}
              sizes={own ? undefined : '(min-width: 768px) 170px, (min-width: 640px) 30vw, 45vw'}
              width={own ? undefined : STOCK_PX}
              height={own ? undefined : STOCK_PX}
              alt={alt}
              loading="lazy"
              decoding="async"
              class="aspect-square w-full rounded-(--radius-card) object-cover"
            />
          </li>
        ))}
      </ul>
    </section>
  ) : (
    <div aria-hidden="true" class="grid h-16 grid-cols-6 md:h-20">
      <div style="background-color: var(--brand-primary)" />
      <div style="background-color: color-mix(in oklab, var(--brand-primary) 70%, white)" />
      <div style="background-color: color-mix(in oklab, var(--brand-primary) 40%, white)" />
      <div style="background-color: color-mix(in oklab, var(--brand-accent) 45%, white)" />
      <div style="background-color: color-mix(in oklab, var(--brand-accent) 75%, white)" />
      <div style="background-color: var(--brand-accent)" />
    </div>
  )
}
