---
import Icon from './Icon.astro'
import { loadClient, toont } from '../lib/client'
import { telHref } from '../lib/format'
import { toon } from '../lib/toon'

// Header: bedrijfsnaam (or logo), compact nav, phone prominent on desktop.
// Mobile relies on the sticky call bar (StickyCallBar.astro) for the CTA.
const { config, logoUrl } = loadClient()
const { bedrijf } = config
const tel = telHref(bedrijf.telefoon)
const t = toon(config)
---

<header class="border-b border-(--color-line) bg-(--color-card)">
  <div
    class="mx-auto flex max-w-(--maat-kolom) flex-wrap items-center justify-between gap-x-6 gap-y-3 px-(--maat-gutter) py-4"
  >
    <a href="/" class="flex items-center gap-3 no-underline">
      {logoUrl && <img src={logoUrl} alt="" class="h-9 w-auto" />}
      <span class="text-h3 font-extrabold text-(--brand-primary)">{bedrijf.naam}</span>
    </a>
    <nav aria-label="Hoofdmenu" class="flex items-center gap-5 text-small font-medium">
      <a href="/diensten/" class="text-(--color-ink) no-underline hover:underline">Diensten</a>
      {
        /* Only when the homepage actually has that section: a nav item pointing at an
         * anchor the page does not contain builds, passes every gate, and is found by
         * clicking it. The werkgebied still has its own pages and its footer column. */
        toont(config, 'werkgebied') && (
          <a href="/#werkgebied" class="text-(--color-ink) no-underline hover:underline">
            {t.gebiedNav}
          </a>
        )
      }
      <a href="/contact/" class="text-(--color-ink) no-underline hover:underline">Contact</a>
      <a href={tel} class="btn btn-call hidden md:inline-flex">
        <Icon name="phone" class="h-4 w-4" />
        <span>{bedrijf.telefoon}</span>
      </a>
    </nav>
  </div>
</header>
