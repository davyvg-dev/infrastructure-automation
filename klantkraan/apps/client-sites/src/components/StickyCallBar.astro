---
import Icon from './Icon.astro'
import { loadClient } from '../lib/client'
import { telHref, waHref } from '../lib/format'

// Sticky bottom call bar, mobile only (< md). Click-to-call is the primary
// conversion path on every page; WhatsApp rides along when the client has it.
// Pure CSS, no JS. Base.astro reserves body bottom-padding for it.
const { config } = loadClient()
const { bedrijf } = config
---

<aside
  aria-label="Snel contact"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-(--color-line) bg-(--color-card) px-4 py-3 md:hidden"
  style="padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 0.75rem)"
>
  <div class="mx-auto flex max-w-(--maat-kolom) items-center gap-3">
    <a href={telHref(bedrijf.telefoon)} class="btn btn-call h-11 flex-1">
      <Icon name="phone" class="h-5 w-5" />
      <span>Bel nu</span>
    </a>
    {
      bedrijf.whatsapp && (
        <a
          href={waHref(bedrijf.whatsapp)}
          target="_blank"
          rel="noopener"
          class="btn btn-outline h-11 w-11 shrink-0 px-0"
          aria-label={`WhatsApp ${bedrijf.naam}`}
        >
          <Icon name="whatsapp" class="h-5 w-5" />
        </a>
      )
    }
  </div>
</aside>
