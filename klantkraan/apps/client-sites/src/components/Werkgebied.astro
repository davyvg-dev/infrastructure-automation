---
import Icon from './Icon.astro'
import { loadClient } from '../lib/client'
import { plaatsSlug, somOp } from '../lib/format'

// Werkgebied: chips linking to the city pages (max 5, capped by the schema).
const { config } = loadClient()
const { bedrijf } = config
---

<section id="werkgebied" class="mx-auto max-w-5xl px-6 py-9 md:py-12">
  <h2 class="text-h2">Werkgebied</h2>
  <p class="mt-3 max-w-2xl text-(--color-mist)">
    {config.bedrijf.naam} werkt in {somOp(bedrijf.werkgebied)}. Woont u net daarbuiten? Bel
    gerust, vaak kunnen wij toch iets voor u betekenen.
  </p>
  <ul role="list" class="mt-6 flex flex-wrap gap-3">
    {
      bedrijf.werkgebied.map((plaats) => (
        <li>
          <a
            href={`/werkgebied/${plaatsSlug(plaats)}/`}
            class="card inline-flex items-center gap-2 px-4 py-2 text-small font-medium no-underline hover:border-(--brand-primary)"
          >
            <Icon name="map-pin" class="h-4 w-4 text-(--brand-primary)" />
            <span class="text-(--color-ink)">{plaats}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
