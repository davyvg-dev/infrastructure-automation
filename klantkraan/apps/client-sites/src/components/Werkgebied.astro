---
import Icon from './Icon.astro'
import { loadClient } from '../lib/client'
import { plaatsSlug } from '../lib/format'
import { toon } from '../lib/toon'

// Werkgebied: chips linking to the city pages (max 5, capped by the schema). For a
// locatie bedrijf the same chips mean the opposite direction -- the neighbourhoods
// customers come FROM -- so the heading and the line above them change with the register.
const { config } = loadClient()
const { bedrijf } = config
const t = toon(config)
---

<section id="werkgebied" class="mx-auto max-w-5xl px-6 py-(--ritme-y) md:py-(--ritme-y-md)">
  <h2 class="text-h2">{t.gebiedKop}</h2>
  <p class="mt-3 max-w-2xl text-(--color-mist)">{t.gebiedTekst}</p>
  <ul role="list" class="mt-6 flex flex-wrap gap-3">
    {
      bedrijf.werkgebied.map((plaats) => (
        <li>
          <a
            href={`/werkgebied/${plaatsSlug(plaats)}/`}
            class="card inline-flex items-center gap-2 px-4 py-2 text-small font-medium no-underline hover:border-(--brand-primary)"
          >
            <Icon name="map-pin" class="h-4 w-4 text-(--brand-primary)" />
            <span class="text-(--color-ink)">{plaats}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
