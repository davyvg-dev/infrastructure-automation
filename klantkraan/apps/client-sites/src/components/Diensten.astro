---
import { loadClient } from '../lib/client'

// Diensten grid: name + short description per service, from client.yaml.
// No prices anywhere (pilot rule: prices are never published).
interface Props {
  /** Heading level for the section title: homepage uses h2, /diensten/ uses none. */
  compact?: boolean
}
const { compact = false } = Astro.props
const { config } = loadClient()
---

<section class="mx-auto max-w-5xl px-6 py-9 md:py-12" id="diensten">
  {
    !compact && (
      <>
        <h2 class="text-h2">Onze diensten</h2>
        <p class="mt-3 max-w-2xl text-(--color-mist)">
          Dit is waar u ons voor belt. Staat uw klus er niet bij? Vraag het gerust, wij denken
          met u mee.
        </p>
      </>
    )
  }
  <ul role="list" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      config.diensten.map((dienst) => (
        <li class="card p-6">
          <h3 class="text-h3">{dienst.naam}</h3>
          <p class="mt-2 text-small text-(--color-mist)">{dienst.omschrijving}</p>
        </li>
      ))
    }
  </ul>
</section>
