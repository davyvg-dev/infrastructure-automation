---
import Base from '../layouts/Base.astro'
import VerderLezen from '../components/VerderLezen.astro'
import Hero from '../components/dakdekkers/Hero.astro'
import PainStats from '../components/dakdekkers/PainStats.astro'
import Features from '../components/dakdekkers/Features.astro'
import StormScenario from '../components/dakdekkers/StormScenario.astro'
import RoiSnippet from '../components/dakdekkers/RoiSnippet.astro'
import Faq from '../components/dakdekkers/Faq.astro'
import CityLinks from '../components/dakdekkers/CityLinks.astro'
import FinalCta from '../components/dakdekkers/FinalCta.astro'
import RiskReversal from '../components/RiskReversal.astro'
---

<Base
  title="Dakdekker klanten werven: AI-receptionist met storm-protocol"
  description="AI-receptionist voor dakdekkers, per maand opzegbaar. Storm-protocol escaleert spoed-lekkages direct, plant inspecties in uw agenda en vangt leads, 24/7."
  centered={false}
>
  <Hero />

  <section aria-hidden="false" class="pb-10 md:pb-16">
    <div class="mx-auto max-w-5xl px-6">
      <img
        src="/photos/dakdekkers.jpg"
        srcset="/photos/dakdekkers-sm.jpg 700w, /photos/dakdekkers.jpg 1400w"
        sizes="(min-width: 1024px) 960px, calc(100vw - 3rem)"
        width="1400"
        height="900"
        loading="lazy"
        decoding="async"
        alt="Dakdekker aan het werk op een hellend dak"
        class="h-56 w-full rounded-(--radius-card) border border-(--color-line) object-cover md:h-72"
      />
    </div>
  </section>

  <RiskReversal />
  <PainStats />
  <Features />
  <StormScenario />
  <RoiSnippet />
  <Faq />
  <CityLinks />
  <!-- Verder lezen: gids + blog voor deze branche -->
  <VerderLezen vertical="dakdekker" />

  <FinalCta />
</Base>
