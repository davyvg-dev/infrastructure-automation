---
import Base from '../layouts/Base.astro'
import Hero from '../components/dakdekkers/Hero.astro'
import PainStats from '../components/dakdekkers/PainStats.astro'
import Features from '../components/dakdekkers/Features.astro'
import StormScenario from '../components/dakdekkers/StormScenario.astro'
import RoiSnippet from '../components/dakdekkers/RoiSnippet.astro'
import Faq from '../components/dakdekkers/Faq.astro'
import CityLinks from '../components/dakdekkers/CityLinks.astro'
import FinalCta from '../components/dakdekkers/FinalCta.astro'
import RiskReversal from '../components/RiskReversal.astro'
---

<Base
  title="Dakdekker klanten werven — Klantkraan storm-protocol en 24/7 noodreparaties"
  description="Nederlandstalige AI-receptionist voor dakdekkers. Storm-protocol herkent spoed-lekkages en escaleert direct. Inspectie-afspraken in uw agenda, automatische reviews. Per maand opzegbaar."
  centered={false}
>
  <Hero />
  <RiskReversal />
  <PainStats />
  <Features />
  <StormScenario />
  <RoiSnippet />
  <Faq />
  <CityLinks />
  <FinalCta />
</Base>
