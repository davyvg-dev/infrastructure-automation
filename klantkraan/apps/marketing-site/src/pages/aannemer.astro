---
import Base from '../layouts/Base.astro'
import FlowDiagram from '../components/diagrams/FlowDiagram.astro'
import VerderLezen from '../components/VerderLezen.astro'
import Icon from '../components/Icon.astro'
import Stat from '../components/Stat.astro'
import HardHat from '../components/illustrations/HardHat.astro'
import RiskReversal from '../components/RiskReversal.astro'
import PhotoBand from '../components/PhotoBand.astro'

// Aannemer landing page. Follows the /loodgieters template structure.
// Trade-specific copy: offerteaanvragen, meerwerk, onderaannemers, projectplanning.

interface PainStat {
  value: string
  caption: string
}

const painStats: PainStat[] = [
  { value: '41%', caption: 'van uw offerteaanvragen komt buiten kantoortijd binnen.' },
  { value: '€\u00a012.000', caption: 'gemiddelde waarde van een gemiste verbouwingsaanvraag.' },
  { value: '5×', caption: 'meer aanvragen na een renovatieproject in de buurt.' },
]

interface Feature {
  icon: 'phone' | 'message-square' | 'calendar-check'
  title: string
  body: string
}

const features: Feature[] = [
  {
    icon: 'message-square',
    title: 'Houdt offerteaanvragen en meerwerk apart',
    body: "Beantwoordt klantvragen op uw website en in WhatsApp, in vlot Nederlands, ook 's avonds en in het weekend. Ook leveranciers en spoed houdt hij apart. 's Ochtends staat er een kort lijstje in uw WhatsApp, voordat u de bus instapt.",
  },
  {
    icon: 'calendar-check',
    title: 'Afspraken direct in uw agenda',
    body: 'De receptionist plant advies- en inmeetafspraken rechtstreeks in uw agenda, alleen op momenten die u zelf heeft vrijgegeven. U belt en mailt niet meer heen en weer tussen twee renovaties door.',
  },
  {
    icon: 'phone',
    title: 'Aanvragen en terugbelverzoeken op uw telefoon',
    body: 'Meldt een opdrachtgever zich tijdens een werkbezoek, dan staat de aanvraag direct als bericht op uw telefoon, met naam, nummer en soort project. Geen opdrachtgever blijft hangen in uw voicemail.',
  },
]

interface Faq {
  q: string
  a: string
  href?: string
  linkLabel?: string
}

const faqs: Faq[] = [
  {
    q: 'Hoe komt de receptionist op mijn website?',
    a: 'Wij plaatsen één klein script op uw website en koppelen uw WhatsApp. U hoeft zelf niets te doen. U houdt uw eigen site, nummer en huisstijl.',
  },
  {
    q: 'Wat als ik op de bouwplaats sta?',
    a: 'Dan beantwoordt de receptionist de vraag (offerteaanvraag, meerwerk, leverancier, klacht), beoordeelt nieuwe aanvragen op postcode en soort project en plant een afspraak in uw agenda. U krijgt een samenvatting per WhatsApp of e-mail en belt terug in de pauze.',
  },
  {
    q: 'Wat als drie klanten tegelijk een offerteaanvraag doen?',
    a: 'De receptionist voert gesprekken tegelijk, zonder wachtrij. Chatten of appen tien klanten tegelijk, dan krijgen ze alle tien direct antwoord. Spoed (lekkage, schade, verzekeringsclaim) herkent hij en houdt hij apart van vragen over de planning.',
  },
  {
    q: 'Weet de klant dat het AI is?',
    a: 'Ja. Elk gesprek begint met de melding dat de klant met een digitale assistent van uw bedrijf chat. Dat is wettelijk verplicht (artikel 50 van de Europese AI-verordening), dus die melding staat altijd aan.',
    href: '/legal/ai-disclosure/',
    linkLabel: 'Lees de volledige AI-disclosure',
  },
  {
    q: 'Wat als de AI iets verkeerd zegt over mijn tarieven of beschikbaarheid?',
    a: 'Dat kan niet gebeuren. De assistent noemt alleen wat u zelf heeft ingesteld: voorrijkosten, uurtarief voor inspectie, doorlooptijd op uw planning, vakantieperioden. Weet hij het antwoord niet, dan verzint hij niets en krijgt de klant een terugbelverzoek. Wij testen elke instelling voordat u live gaat.',
  },
  {
    q: 'Wat gebeurt er met de klantgegevens?',
    a: 'Wij hosten in de EU: Hetzner Frankfurt, Neon EU en Cloudflare EU. Wij tekenen een verwerkersovereenkomst met u en bewaren chatgesprekken 30 dagen, of korter als u dat wilt. Al onze subverwerkers staan in een openbare lijst.',
    href: '/legal/dpa/',
    linkLabel: 'Lees de verwerkersovereenkomst',
  },
  {
    q: 'Is het echt per maand opzegbaar?',
    a: 'Ja. U zegt op met één mail, wanneer u wilt. Er is geen jaarcontract en geen verborgen verlenging. De receptionist werkt tot het einde van de betaalde maand; daarna incasseren wij niets meer. Betaalt u liever 6 of 12 maanden vooruit, dan krijgt u 15% of 20% korting.',
    href: '/legal/voorwaarden/',
    linkLabel: 'Lees de algemene voorwaarden',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]+>/g, ''),
    },
  })),
}
---

<Base
  title="Klanten werven als aannemer: AI-receptionist voor offertes"
  description="AI-receptionist voor aannemers, per maand opzegbaar. Houdt offerteaanvragen en meerwerk apart en plant afspraken terwijl u op de bouwplaats staat."
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div
      class="mx-auto grid max-w-page gap-10 px-gutter md:grid-cols-[1fr_auto] md:items-center md:gap-16"
    >
      <div>
        <h1 class="font-display text-hero text-chalk">
          De <span class="text-(--color-sodium)">Klantenmotor</span> voor aannemers.
        </h1>
        <p class="mt-6 max-w-2xl text-[1.125rem] text-dim leading-relaxed">
          Stelt iemand om 19:30 een vraag over een verbouwing terwijl u nog op de bouwplaats staat, dan
          beantwoordt de digitale receptionist die op uw website of in WhatsApp. Offerteaanvragen,
          meerwerk en leveranciers houdt hij apart.
        </p>
        <div class="mt-10 btn-row">
          <a href="/demo/" class="btn btn-primary btn-lg"> Probeer de demo </a>
          <a href="/rekentool/" class="btn btn-ghost btn-lg"> Open de rekentool </a>
        </div>
      </div>
      <div class="hidden text-(--color-dim) md:block">
        <HardHat class="h-64 w-64 lg:h-72 lg:w-72" />
      </div>
    </div>
    <div class="mx-auto max-w-page px-gutter">
      <ul role="list" class="fact-row mt-10">
        <li><span class="text-(--color-chalk)">AVG + AI Act art. 50</span> <span>AI-melding altijd aan</span></li>
        <li><span class="text-(--color-chalk)">Gehost in de EU</span> <span>Cloudflare · Neon · Hetzner</span></li>
        <li><span class="text-(--color-chalk)">Vlot Nederlands</span> <span>Houdt offerteaanvragen apart</span></li>
      </ul>
      <p class="mt-8 text-small text-dim">
        Per maand opzegbaar · Wij richten alles in · 50% korting eerste maand
      </p>
    </div>
  </section>

  <section class="pb-10 md:pb-16">
    <PhotoBand
      slug="aannemers"
      alt="Aannemer op de bouwplaats, helm onder de arm"
      caption="Midden op de bouwplaats. Uw receptionist antwoordt wél."
    />
  </section>

  <!-- 1b. Risk-reversal -->
  <RiskReversal />

  <!-- 2. Pijn-stats trio (stone-100) -->
  <section
    class="border-y border-(--color-line) py-8 md:py-10"
    aria-label="Wat een gemiste oproep een aannemer kost"
  >
    <div class="mx-auto max-w-page px-gutter">
      <div class="stat-row">
      {painStats.map((stat) => <Stat value={stat.value} label={stat.caption} />)}
      </div>
    </div>
  </section>

  <!-- 3. Wat Klantkraan doet, als schema: de drie modules zijn de drie uitgangen -->
  <FlowDiagram
    id="modules"
    nodeSub='voor aannemers'
    t={{
      label: 'Modules',
      heading: 'Wat Klantkraan doet voor aannemers',
      sub: 'Drie modules voor één maandprijs, voor de aannemer die op de bouwplaats staat als zijn beste opdrachtgever zich meldt.',
      steps: features.map((f) => ({ title: f.title, text: f.body })),
    }}
  />

  <!-- 4. ROI snippet (stone-100) -->
  <section class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      
      <h2 class="font-display text-h1 text-chalk">Reken het even na</h2>
      <div
        class="mt-8 frame bg-(--color-panel) p-6 md:p-10"
      >
        <p class="text-h3 text-chalk">
          Mist u 2 offerteaanvragen per maand à € 12.000? Dat is <strong
            class="text-(--color-sodium)">circa € 95.000 verloren omzet per jaar</strong
          >.
        </p>
        <p class="mt-4 text-body text-dim">
          Klantkraan Chat kost € 299 per maand. Eén extra renovatie per jaar dekt ruim drie jaar
          abonnement. Elke aanvraag die u daarna terugwint, is extra omzet.
        </p>
        <div class="mt-6 btn-row">
          <a href="/rekentool/" class="btn btn-primary btn-lg"> Open de rekentool </a>
          <a href="/prijzen/" class="btn btn-ghost btn-lg"> Bekijk prijzen </a>
        </div>
        <p class="mt-6 text-micro text-dim">
          Bedragen excl. 21% btw. Rekenvoorbeeld met een branchegemiddelde van € 12.000 per
          offerte voor verbouwing of renovatie (bron: BNA / Aedes 2024 benchmarks) en de aanname dat
          ongeveer 1 op 3 gemiste aanvragen een betaalde klus had opgeleverd.
        </p>
      </div>
    </div>
  </section>

  <!-- 5. FAQ (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      
      <h2 class="font-display text-h1 text-chalk">Veelgestelde vragen</h2>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          faqs.map((faq) => (
            <details class="group py-4">
              <summary class="block min-h-[2.75rem] cursor-pointer list-none py-1 font-display text-h3 text-chalk marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{faq.q}</span>
                  <Icon
                    name="chevron-down"
                    class="mt-1 h-5 w-5 shrink-0 text-(--color-dim) transition-transform group-open:rotate-180"
                  />
                </span>
              </summary>
              <p class="mt-3 text-body text-dim">{faq.a}</p>
              {faq.href && faq.linkLabel && (
                <p class="mt-3 text-small">
                  <a href={faq.href} class="underline">
                    {faq.linkLabel}
                  </a>
                </p>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Verder lezen: gids + blog voor deze branche -->
  <VerderLezen vertical="aannemer" />

  <!-- 6. Final CTA (blue) -->
  <section class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      <h2 class="font-display text-h1 text-chalk break-words hyphens-auto">
        Zie hoe hij aanvragen uit elkaar houdt
      </h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        In de live demo ziet u hoe hij offerteaanvragen, vragen over meerwerk en leveranciers
        scheidt, en hoe dat in uw WhatsApp binnenkomt.
      </p>
      <div class="mt-8 btn-row">
        <a href="/demo/" class="btn btn-primary btn-lg"> Probeer de demo </a>
        <a href="/prijzen/" class="btn btn-ghost btn-lg"> Bekijk prijzen </a>
      </div>
    </div>
  </section>


  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Base>
