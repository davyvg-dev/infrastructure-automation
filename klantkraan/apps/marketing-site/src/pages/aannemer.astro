---
import Base from '../layouts/Base.astro'
import VerderLezen from '../components/VerderLezen.astro'
import Icon from '../components/Icon.astro'
import Stat from '../components/Stat.astro'
import HardHat from '../components/illustrations/HardHat.astro'
import RiskReversal from '../components/RiskReversal.astro'

// Aannemer landing page. Follows the /loodgieters template structure.
// Trade-specific copy: offerteaanvragen, meerwerk, onderaannemers, projectplanning.

interface PainStat {
  value: string
  caption: string
}

const painStats: PainStat[] = [
  { value: '41%', caption: 'van uw offerteaanvragen komt buiten kantoortijd binnen.' },
  { value: '€12k', caption: 'gemiddelde omvang van een gemiste verbouwingsaanvraag.' },
  { value: '5×', caption: 'meer aanvragen na een buurt-renovatieproject in de regio.' },
]

interface Feature {
  icon: 'phone' | 'message-square' | 'calendar-check'
  title: string
  body: string
}

const features: Feature[] = [
  {
    icon: 'message-square',
    title: 'Splitst offerteaanvragen en meerwerk apart',
    body: 'Beantwoordt klantvragen op uw website en via WhatsApp, in vlot Nederlands, ook \'s avonds en in het weekend. Splitst offerteaanvragen, meerwerk, leveranciers en spoed apart. \'s Ochtends staat een kort lijstje in uw WhatsApp, voor u de bus instapt.',
  },
  {
    icon: 'calendar-check',
    title: 'Afspraken direct in uw agenda',
    body: 'Advies- en inmeet-afspraken worden rechtstreeks in uw agenda gepland, alleen op momenten die u zelf heeft vrijgegeven. Geen telefoontag, geen heen-en-weer-gemail tussen twee renovaties door.',
  },
  {
    icon: 'phone',
    title: 'Leads en terugbelverzoeken op uw telefoon',
    body: 'Meldt een opdrachtgever zich tijdens een werkbezoek? De receptionist vangt de aanvraag op en zet haar direct als bericht op uw telefoon, met naam, nummer en projecttype. Geen prospect raakt verloren in een voicemail.',
  },
]

interface Faq {
  q: string
  a: string
  href?: string
  linkLabel?: string
}

const faqs: Faq[] = [
  {
    q: 'Hoe komt de receptionist op mijn website?',
    a: 'Met één klein scriptje dat wij voor u installeren. U hoeft niets te doen. Het WhatsApp-kanaal koppelen wij in dezelfde done-for-you setup. U houdt uw eigen site, uw eigen nummer en uw eigen huisstijl.',
  },
  {
    q: 'En als ik op de bouwplaats sta?',
    a: 'Daar is dit voor gemaakt. De receptionist beantwoordt de vraag (offerteaanvraag, meerwerk-vraag, leverancier, klacht), kwalificeert nieuwe aanvragen op postcode en projecttype, en plant een afspraak in uw agenda. U krijgt een samenvatting per WhatsApp of e-mail. Terugbellen kan in de pauze.',
  },
  {
    q: 'Wat als drie klanten tegelijk een offerteaanvraag doen?',
    a: 'De receptionist handelt gesprekken parallel af. Geen wachtrij. Tien klanten kunnen tegelijk chatten of appen, alle tien krijgen direct antwoord. Spoed (lekkage, schade, verzekeringsclaim) wordt herkend en gescheiden van planning-aanvragen.',
  },
  {
    q: 'Hoort de klant dat het AI is?',
    a: 'Ja. Elk gesprek opent met de melding dat uw klant met een digitale assistent chat, namens uw bedrijf. Dat is geen marketingkeuze maar een wettelijke verplichting onder artikel 50 van de Europese AI-wet. De disclosure blijft altijd aan staan.',
    href: '/legal/ai-disclosure/',
    linkLabel: 'Lees de volledige AI-disclosure',
  },
  {
    q: 'Wat als de AI iets verkeerd zegt over mijn tarieven of beschikbaarheid?',
    a: 'Dat kan niet gebeuren. De assistent noemt alleen wat u zelf in uw systeem heeft gezet: voorrijkosten, uurtarief inspectie, doorlooptijd op uw planning, vakantieperioden. Onbekende vragen worden nooit verzonnen; de klant krijgt dan een terugbelverzoek. Wij testen elke configuratie voor u live gaat.',
  },
  {
    q: 'Wat gebeurt er met de klantgegevens?',
    a: 'Wij hosten in de EU: Hetzner Frankfurt, Neon EU, Cloudflare EU. Wij tekenen een verwerkersovereenkomst (DPA) met u en bewaren chatgesprekken 30 dagen, tenzij u korter wenst. De volledige leverancierslijst staat openbaar in ons sub-processorregister.',
    href: '/legal/dpa/',
    linkLabel: 'Bekijk DPA en privacyverklaring',
  },
  {
    q: 'Per maand opzegbaar, echt waar?',
    a: 'Ja. Geen jaarcontract, geen verborgen verlenging. U zegt op via een mail; opzegtermijn is één maand. Voor wie liever 6 of 12 maanden vooruit betaalt is er korting (15% respectievelijk 20%).',
    href: '/legal/voorwaarden/',
    linkLabel: 'Lees de algemene voorwaarden',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]+>/g, ''),
    },
  })),
}
---

<Base
  title="Aannemer klanten werven: AI-receptionist voor offertes"
  description="AI-receptionist voor aannemers, per maand opzegbaar. Filtert offerteaanvragen en meerwerk, plant afspraken en vangt leads terwijl u op de bouwplaats staat."
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div
      class="mx-auto grid max-w-5xl gap-10 px-6 md:grid-cols-[1fr_auto] md:items-center md:gap-16"
    >
      <div>
        <h1 class="font-display text-hero text-chalk">
          De <span class="text-(--color-sodium)">Klantenmotor</span> voor aannemers.
        </h1>
        <p class="mt-6 max-w-2xl text-h3 text-dim">
          Houdt offerteaanvragen, meerwerk en leveranciers apart. Stelt iemand om 19:30 een vraag
          over een verbouwing terwijl u nog op de bouwplaats staat? De digitale receptionist
          beantwoordt hem op uw website en via WhatsApp. Geen gemiste aanvraag meer.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/demo/"
            class="btn btn-primary btn-lg"
          >
            Probeer de demo
          </a>
          <a
            href="/rekentool/"
            class="btn btn-ghost btn-lg"
          >
            Bereken uw ROI
          </a>
        </div>
      </div>
      <div class="hidden text-(--color-sodium) md:block">
        <HardHat class="h-64 w-64 lg:h-72 lg:w-72" />
      </div>
    </div>
    <div class="mx-auto max-w-5xl px-6">
      <ul role="list" class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-6">
        <li class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
          <div>
            <p class="text-small font-medium text-chalk">AVG + AI Act art. 50</p>
            <p class="text-small text-dim">Disclosure standaard aan</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
          <div>
            <p class="text-small font-medium text-chalk">Gehost in de EU</p>
            <p class="text-small text-dim">Cloudflare · Neon · Hetzner</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="phone-call" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
          <div>
            <p class="text-small font-medium text-chalk">Vlot Nederlands</p>
            <p class="text-small text-dim">Filtert offerteaanvragen</p>
          </div>
        </li>
      </ul>
      <p class="mt-8 text-small text-dim">
        Per maand opzegbaar · Done-for-you setup · 50% korting eerste maand
      </p>
    </div>
  </section>

  <!-- 1b. Risk-reversal -->
  <RiskReversal />

  <!-- 2. Pijn-stats trio (stone-100) -->
  <section
    class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16"
    aria-label="Wat een gemiste oproep een aannemer kost"
  >
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 sm:grid-cols-3">
      {painStats.map((stat) => <Stat value={stat.value} label={stat.caption} />)}
    </div>
  </section>

  <!-- 3. Modules (cream, hairline rows) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">Modules</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">
        Wat Klantkraan doet voor aannemers.
      </h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        Drie modules. Eén maandprijs. Voor de aannemer die op de bouwplaats staat als zijn beste prospect belt.
      </p>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          features.map((feature) => (
            <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
              <Icon name={feature.icon} class="mt-1 h-7 w-7 text-(--color-sodium)" />
              <div>
                <h3 class="font-display text-h3 text-chalk">{feature.title}</h3>
                <p class="mt-2 text-body text-dim">{feature.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. ROI snippet (stone-100) -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">Rekensom</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">
        Reken het even na.
      </h2>
      <div class="mt-8 rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-6 md:p-10">
        <p class="text-h3 text-chalk">
          Mist u 2 offerteaanvragen per maand à €12.000? Dat is <strong class="text-(--color-sodium)">circa €95.000 verloren omzet per jaar</strong>.
        </p>
        <p class="mt-4 text-body text-dim">
          Klantkraan Chat is €299 per maand. Eén extra renovatie per jaar dekt ruim drie jaar abonnement. Daarna telt
          elke gemiste prospect die u terugwint puur door.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/rekentool/"
            class="btn btn-primary btn-lg"
          >
            Open de rekentool
          </a>
          <a
            href="/prijzen/"
            class="btn btn-ghost btn-lg"
          >
            Bekijk de tarieven
          </a>
        </div>
        <p class="mt-6 text-micro text-dim">
          Bedragen excl. 21% BTW. Voorbeeld op basis van branche-gemiddelde €12k per
          verbouwings-/renovatie-offerte (bron: BNA / Aedes 2024 benchmarks) en de aanname dat
          ongeveer 1 op 3 gemiste aanvragen een betalende klus had opgeleverd (33% conversiekans).
        </p>
      </div>
    </div>
  </section>

  <!-- 5. FAQ (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">Vragen</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">
        Veelgestelde vragen.
      </h2>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          faqs.map((faq) => (
            <details class="group py-4">
              <summary class="block min-h-[2.75rem] cursor-pointer list-none py-1 font-display text-h3 text-chalk marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{faq.q}</span>
                  <Icon
                    name="chevron-down"
                    class="mt-1 h-5 w-5 shrink-0 text-(--color-sodium) transition-transform group-open:rotate-180"
                  />
                </span>
              </summary>
              <p class="mt-3 text-body text-dim">{faq.a}</p>
              {faq.href && faq.linkLabel && (
                <p class="mt-3 text-small">
                  <a href={faq.href} class="underline">
                    {faq.linkLabel}
                  </a>
                </p>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Verder lezen: gids + blog voor deze branche -->
  <VerderLezen vertical="aannemer" />

  <!-- 6. Final CTA (blue) -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="font-display text-h1 text-chalk break-words hyphens-auto">
        Klaar om geen verbouwingsaanvraag meer te missen?
      </h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        Probeer de live demo. Daarna weet u hoe hij offerteaanvragen, meerwerk-vragen en
        leveranciers uit elkaar houdt. En hoe dat in uw WhatsApp landt.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/demo/"
          class="btn btn-primary btn-lg"
        >
          Probeer de demo
        </a>
        <a
          href="/prijzen/"
          class="btn btn-ghost btn-lg"
        >
          Bekijk prijzen
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Base>
