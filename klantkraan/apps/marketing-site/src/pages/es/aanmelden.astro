---
import Base from '../../layouts/Base.astro'

const trades = [
  { value: 'loodgieter', label: 'Fontanero' },
  { value: 'dakdekker', label: 'Tejador' },
  { value: 'installateur', label: 'Instalador (climatización)' },
  { value: 'elektricien', label: 'Electricista' },
  { value: 'aannemer', label: 'Contratista' },
  { value: 'schilder', label: 'Pintor' },
  { value: 'sportschool', label: 'Gimnasio' },
  { value: 'anders', label: 'Otro' },
]

const inputClass =
  'mt-2 w-full rounded-(--radius-button) border border-(--color-line) bg-[rgba(0,0,0,0.25)] px-3 py-3 text-body text-(--color-chalk)'
---

<Base
  lang="es"
  title="Alta: empiece con su recepcionista con IA | Klantkraan"
  description="Dé de alta su negocio en Klantkraan Chat (299 € al mes). Le contactamos en un día laborable y nos encargamos de toda la instalación."
  centered={false}
>
  <!-- 1. Hero -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="font-display text-hero text-(--color-chalk)">Manos a la obra</h1>
      <p class="mt-6 max-w-2xl text-h3 text-(--color-dim)">
        Deje sus datos abajo. Le llamamos en un día laborable para repasar sus servicios, tarifas
        y calendario. Nosotros montamos todo; usted no tiene que construir nada.
      </p>
    </div>
  </section>

  <!-- 2. Form + next steps -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto grid max-w-5xl gap-6 md:gap-8 px-6 md:grid-cols-[1.15fr_.85fr] md:items-start">
      <form
        id="lead-form"
        class="rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5 md:p-6"
        novalidate
      >
        <div class="space-y-6">
          <div>
            <label for="naam" class="block text-body font-medium text-(--color-chalk)">Nombre</label>
            <input id="naam" name="naam" type="text" required autocomplete="name" class={inputClass} />
          </div>
          <div>
            <label for="bedrijf" class="block text-body font-medium text-(--color-chalk)">
              Nombre de la empresa
            </label>
            <input id="bedrijf" name="bedrijf" type="text" autocomplete="organization" class={inputClass} />
          </div>
          <div class="grid gap-6 sm:grid-cols-2 sm:gap-4">
            <div>
              <label for="telefoon" class="block text-body font-medium text-(--color-chalk)">
                Teléfono
              </label>
              <input id="telefoon" name="telefoon" type="tel" autocomplete="tel" class={inputClass} />
            </div>
            <div>
              <label for="email" class="block text-body font-medium text-(--color-chalk)">
                Correo electrónico
              </label>
              <input id="email" name="email" type="email" autocomplete="email" class={inputClass} />
            </div>
          </div>
          <p class="-mt-3 text-small text-(--color-dim)">
            Con teléfono o correo basta; ambos también vale.
          </p>
          <div>
            <label for="vak" class="block text-body font-medium text-(--color-chalk)">
              Oficio o sector
            </label>
            <select id="vak" name="vak" class={inputClass}>
              {trades.map((t) => <option value={t.value}>{t.label}</option>)}
            </select>
          </div>
          <fieldset>
            <legend class="block text-body font-medium text-(--color-chalk)">Plan</legend>
            <div class="mt-2 space-y-2">
              <label class="flex items-start gap-3 rounded-(--radius-button) border border-(--color-line) bg-[rgba(0,0,0,0.25)] px-3 py-3">
                <input type="radio" name="plan" value="chat" checked class="mt-1 accent-(--color-sodium)" />
                <span class="text-body text-(--color-chalk)">
                  Chat
                  <span class="block text-small text-(--color-dim)">
                    299 € al mes &middot; chat web + WhatsApp &middot; cancelación mensual
                  </span>
                </span>
              </label>
              <label class="flex items-start gap-3 rounded-(--radius-button) border border-(--color-line) bg-[rgba(0,0,0,0.25)] px-3 py-3">
                <input type="radio" name="plan" value="compleet-interesse" class="mt-1 accent-(--color-sodium)" />
                <span class="text-body text-(--color-chalk)">
                  Interés en Compleet
                  <span class="block text-small text-(--color-dim)">
                    con agente telefónico de IA, próximamente &middot; le mantenemos informado
                  </span>
                </span>
              </label>
            </div>
          </fieldset>
          <div>
            <label for="bericht" class="block text-body font-medium text-(--color-chalk)">
              Mensaje <span class="font-normal text-(--color-dim)">(opcional)</span>
            </label>
            <textarea id="bericht" name="bericht" rows="3" class={inputClass}></textarea>
          </div>
          <div class="hp" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <p id="lead-error" class="hidden text-small text-(--color-sodium)" role="alert"></p>
          <button type="submit" id="lead-submit" class="btn btn-primary btn-lg w-full justify-center">
            Enviar solicitud
          </button>
          <p class="text-small text-(--color-dim)">
            Solo usamos sus datos para ponernos en contacto con usted. Consulte nuestra
            <a href="/legal/privacy/" class="underline">política de privacidad</a> (en neerlandés).
          </p>
        </div>
      </form>

      <div>
        <aside
          id="lead-success"
          class="hidden rounded-(--radius-card) border border-(--color-sodium) bg-(--color-panel) p-5 md:p-6"
        >
          <h2 class="font-display text-h2 text-(--color-chalk)">Solicitud recibida</h2>
          <p class="mt-3 text-body text-(--color-dim)">
            Gracias. Nos pondremos en contacto con usted en un día laborable para planificar el
            siguiente paso.
          </p>
        </aside>
        <aside
          id="lead-steps"
          class="rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5 md:p-6"
        >
          <h2 class="font-display text-h2 text-(--color-chalk)">Qué pasa después</h2>
          <ol class="mt-4 space-y-3 text-body text-(--color-dim)">
            <li>
              <span class="font-mono text-small text-(--color-sodium)">1.</span>
              Le llamamos en un día laborable y repasamos sus servicios, tarifas y calendario.
            </li>
            <li>
              <span class="font-mono text-small text-(--color-sodium)">2.</span>
              Montamos y conectamos su recepcionista. Llave en mano; usted solo aporta el
              conocimiento.
            </li>
            <li>
              <span class="font-mono text-small text-(--color-sodium)">3.</span>
              Usted la prueba, da el visto bueno y la recepcionista entra en marcha en su web y
              WhatsApp.
            </li>
          </ol>
          <p class="mt-5 border-t border-(--color-line) pt-4 text-small text-(--color-dim)">
            Darse de alta no le compromete a nada. Primero hablamos con usted y lo repasamos todo.
            Cancelación mensual, primer mes al 50%.
          </p>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Honeypot: parked off-screen so humans never see it; bots that fill it are dropped. */
  .hp {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  const ENDPOINT = 'https://demo.klantkraan.nl/api/lead'

  function initLeadForm() {
    const form = document.getElementById('lead-form') as HTMLFormElement | null
    if (!form || form.dataset.bound) return
    form.dataset.bound = '1'

    // ?plan=chat | ?plan=compleet-interesse (or plain "compleet") preselects the radio.
    const wanted = new URLSearchParams(window.location.search).get('plan')
    const plan = wanted === 'compleet' ? 'compleet-interesse' : wanted
    if (plan) {
      const radio = form.querySelector<HTMLInputElement>(`input[name="plan"][value="${plan}"]`)
      if (radio) radio.checked = true
    }

    const errorEl = document.getElementById('lead-error') as HTMLElement
    const submitBtn = document.getElementById('lead-submit') as HTMLButtonElement

    const fail = (html: string) => {
      errorEl.innerHTML = html
      errorEl.classList.remove('hidden')
      submitBtn.disabled = false
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      errorEl.classList.add('hidden')
      const data = new FormData(form)
      const value = (name: string) => String(data.get(name) ?? '').trim()

      if (!value('naam')) return fail('Escriba su nombre.')
      if (!value('telefoon') && !value('email'))
        return fail('Escriba un número de teléfono o una dirección de correo.')

      submitBtn.disabled = true
      try {
        const resp = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            naam: value('naam'),
            bedrijf: value('bedrijf'),
            telefoon: value('telefoon'),
            email: value('email'),
            vak: value('vak'),
            plan: value('plan'),
            bericht: value('bericht'),
            website: value('website'),
          }),
        })
        if (!resp.ok) throw new Error(String(resp.status))
        form.classList.add('hidden')
        document.getElementById('lead-steps')?.classList.add('hidden')
        document.getElementById('lead-success')?.classList.remove('hidden')
      } catch {
        fail(
          'No se ha podido enviar. Escríbanos a <a href="mailto:hallo@klantkraan.nl" class="underline">hallo@klantkraan.nl</a> y lo gestionamos desde ahí.'
        )
      }
    })
  }

  document.addEventListener('astro:page-load', initLeadForm)
</script>
