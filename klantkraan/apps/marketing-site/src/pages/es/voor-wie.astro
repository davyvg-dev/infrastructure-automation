---
import Base from '../../layouts/Base.astro'
import { branches } from '../../data/branches'
import TapValve from '../../components/illustrations/TapValve.astro'
import StormCloud from '../../components/illustrations/StormCloud.astro'
import PaintRoller from '../../components/illustrations/PaintRoller.astro'
import HardHat from '../../components/illustrations/HardHat.astro'
import Dumbbell from '../../components/illustrations/Dumbbell.astro'
import Icon from '../../components/Icon.astro'

// Map illustration name to component for branches that have one.
const illustrations = {
  TapValve,
  StormCloud,
  PaintRoller,
  HardHat,
  Dumbbell,
  RingingPhone: null, // Reserved for the homepage; not used on cards.
}
---

<Base
  lang="es"
  title="Para quién es | Klantkraan para cada oficio"
  description="Klantkraan funciona para fontaneros, techadores, pintores, electricistas, contratistas y gimnasios. Elija su oficio y tendrá una recepcionista a su medida."
  centered={false}
>
  <!-- Hero -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="font-display text-hero text-(--color-kraan-ink)">
        ¿Qué tipo de negocio tiene?
      </h1>
      <p class="mt-6 max-w-2xl text-h3 text-(--color-kraan-stone-700)">
        Klantkraan habla el idioma de su oficio. Clases de prueba y cuotas para el gimnasio. Gastos de
        desplazamiento y tarifas de urgencia para el fontanero. Precios por metro cuadrado y muestras
        de color para el pintor.
      </p>
    </div>
  </section>

  <!-- Branches grid -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16" aria-label="Sectores">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid gap-5 md:gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          branches.map((b) => {
            const Illustration = b.illustration ? illustrations[b.illustration] : null
            return (
              <a
                href={`/en/${b.slug}/`}
                class="group flex flex-col rounded-(--radius-card) border border-(--color-kraan-stone-300) bg-white p-5 md:p-6 no-underline transition-colors hover:border-(--color-kraan-blue)"
              >
                <div class="flex items-start justify-between gap-3">
                  <h2 class="font-display text-h2 text-(--color-kraan-ink)">{b.labelPluralEs}</h2>
                  {Illustration && (
                    <div
                      class="hidden text-(--color-kraan-blue) sm:block"
                      aria-hidden="true"
                    >
                      <Illustration class="h-20 w-20" />
                    </div>
                  )}
                </div>
                <p class="mt-3 text-body text-(--color-kraan-stone-700)">{b.hubLineEs}</p>
                <p
                  class="mt-5 inline-flex items-center gap-1 text-small font-medium text-(--color-kraan-blue) group-hover:underline"
                >
                  <span>Ver la solución para {b.labelPluralEs.toLowerCase()}</span>
                  <span aria-hidden="true">→</span>
                </p>
              </a>
            )
          })
        }
      </div>
    </div>
  </section>

  <!-- "My trade isn't listed" -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p
        class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)"
      >
        ¿Otro oficio?
      </p>
      <h2 class="mt-3 font-display text-h2 text-(--color-kraan-ink)">
        ¿No ve su oficio?
      </h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-kraan-stone-700)">
        Klantkraan funciona para cualquier negocio que reciba preguntas y citas de clientes, desde
        carpinteros, jardineros y cristaleros hasta peluquerías, fisioterapeutas y autoescuelas. En una
        breve toma de datos recogemos sus servicios, tarifas y normas internas. A partir de ahí la
        recepcionista responde como lo haría usted mismo.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/es/demo/"
          class="inline-block rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
        >
          Pruebe la demo
        </a>
        <a
          href="/es/rekentool/"
          class="inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
        >
          Calcule su retorno
        </a>
      </div>
    </div>
  </section>

  <!-- Trust micro-line -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <ul role="list" class="grid grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-6">
        <li class="flex items-start gap-3">
          <Icon
            name="shield-check"
            class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)"
          />
          <div>
            <p class="text-small font-medium text-(--color-kraan-ink)">RGPD + Reglamento de IA art. 50</p>
            <p class="text-small text-(--color-kraan-stone-500)">Declaración activada por defecto</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <Icon
            name="shield-check"
            class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)"
          />
          <div>
            <p class="text-small font-medium text-(--color-kraan-ink)">Alojado en la UE</p>
            <p class="text-small text-(--color-kraan-stone-500)">Cloudflare · Neon · Hetzner</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="clock" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
          <div>
            <p class="text-small font-medium text-(--color-kraan-ink)">Cancele cada mes</p>
            <p class="text-small text-(--color-kraan-stone-500)">Sin permanencia ni costes ocultos</p>
          </div>
        </li>
      </ul>
    </div>
  </section>
</Base>
