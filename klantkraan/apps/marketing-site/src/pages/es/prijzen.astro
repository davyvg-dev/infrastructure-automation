---
import Base from '../../layouts/Base.astro'
import { company } from '../../data/company'

interface Tier {
  id: 'chat' | 'compleet'
  name: string
  price: number
  /** Day-price equivalent, Spanish decimal-comma format (price / 30, rounded to cents). */
  dayPrice: string
  /** Optional usage note under the price (e.g. included call minutes + overage rate). */
  priceNote?: string
  blurb: string
  highlight: boolean
  cta: string
  ctaHref: string
}

const tiers: Tier[] = [
  {
    id: 'chat',
    name: 'Chat',
    price: 299,
    dayPrice: '9,97',
    blurb:
      'Agenda citas directamente en su calendario y capta cada cliente, por chat web y WhatsApp, 24/7. Se lo dejamos montado entero. Nuestra recomendación.',
    highlight: true,
    cta: 'Empezar con Chat',
    ctaHref: '/es/aanmelden/?plan=chat',
  },
  {
    id: 'compleet',
    name: 'Compleet',
    price: 499,
    dayPrice: '16,63',
    priceNote: 'incl. 750 minutos de llamada/mes, luego 0,40 €/min',
    blurb:
      'Todo lo de Chat, más un agente telefónico con IA que atiende su teléfono 24/7 en su propio número. Las llamadas perdidas dejan de existir.',
    highlight: false,
    cta: 'Empezar con Compleet',
    ctaHref: '/es/aanmelden/?plan=compleet',
  },
]

interface FeatureRow {
  feature: string
  chat: string
  compleet: string
}

const features: FeatureRow[] = [
  { feature: 'Agenda citas directamente en su calendario', chat: 'sí', compleet: 'sí' },
  { feature: 'Chat en su propia web (24/7)', chat: 'sí', compleet: 'sí' },
  { feature: 'Canal de WhatsApp', chat: 'sí', compleet: 'sí' },
  {
    feature: 'Responde preguntas sobre servicios, tarifas y zona de cobertura',
    chat: 'sí',
    compleet: 'sí',
  },
  { feature: 'Capta clientes y solicitudes de llamada', chat: 'sí', compleet: 'sí' },
  { feature: 'Lo montamos nosotros y lo mantenemos al día', chat: 'sí', compleet: 'sí' },
  { feature: 'Estadísticas mensuales por correo', chat: 'sí', compleet: 'sí' },
  {
    feature: 'Agente telefónico con IA en su propio número',
    chat: '–',
    compleet: 'sí',
  },
  {
    feature: 'Minutos de llamada incluidos al mes',
    chat: '–',
    compleet: '750, luego 0,40 €/min',
  },
  {
    feature: 'Llamadas simultáneas',
    chat: '–',
    compleet: 'hasta 5 a la vez',
  },
]

// Service schema with both subscription tiers, derived from the tiers array
// above so the JSON-LD can never drift from the visible pricing cards.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Recepcionista con IA de ${company.tradeName}`,
  serviceType: 'Recepcionista con IA para negocios locales',
  url: new URL('/es/prijzen/', Astro.site).toString(),
  provider: {
    '@type': 'Organization',
    name: company.tradeName,
    url: new URL('/es/', Astro.site).toString(),
  },
  areaServed: { '@type': 'Country', name: 'España' },
  offers: tiers.map((tier) => ({
    '@type': 'Offer',
    name: `${company.tradeName} ${tier.name}`,
    description: tier.blurb,
    price: String(tier.price),
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: String(tier.price),
      priceCurrency: 'EUR',
      unitText: 'al mes',
    },
  })),
}
---

<Base
  lang="es"
  title="Precios de la recepcionista con IA: Chat 299 € o Compleet 499 € | Klantkraan"
  description="Chat 299 € y Compleet 499 € al mes. Agenda citas directamente en su calendario. Se lo dejamos montado entero, usted no monta nada. Cancelación mensual."
  centered={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="font-display text-hero text-(--color-chalk)">Precios</h1>
      <p class="mt-6 max-w-2xl text-h3 text-(--color-dim)">
        Cancelación mensual, primer mes al 50%. Instalación única desde 249 € (gratis para clientes
        piloto). Los importes no incluyen el 21% de IVA.
      </p>
    </div>
  </section>

  <!-- 2. Tier cards (stone-100) -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 md:grid-cols-2">
      {
        tiers.map((tier) => (
          <article
            class={`rounded-(--radius-card) border p-5 md:p-6 ${tier.highlight ? 'border-(--color-sodium) bg-(--color-panel)' : 'border-(--color-line) bg-(--color-panel)'}`}
          >
            <header class="flex items-baseline justify-between">
              <h2 class="font-display text-h2 text-(--color-chalk)">{tier.name}</h2>
              {tier.highlight && (
                <span class="rounded-(--radius-button) bg-(--color-sodium) px-2 py-1 text-micro text-(--color-night)">
                  recomendado
                </span>
              )}
            </header>
            <p
              class={`mt-4 font-display text-h1 ${tier.highlight ? 'text-(--color-sodium)' : 'text-(--color-dim)'}`}
            >
              {tier.price} €<span class="text-body text-(--color-dim)">/mes</span>
            </p>
            <p class="mt-1 font-mono text-small text-(--color-dim)">≈ {tier.dayPrice} € al día</p>
            {tier.priceNote && <p class="mt-2 text-small text-(--color-dim)">{tier.priceNote}</p>}
            <p class="mt-3 text-body text-(--color-dim)">{tier.blurb}</p>
            <a
              href={tier.ctaHref}
              class={`mt-6 btn btn-lg ${tier.highlight ? 'btn-primary' : 'btn-ghost'}`}
            >
              {tier.cta}
            </a>
            {tier.highlight && (
              <p class="mt-3 text-small">
                <a href="/es/demo/" class="text-(--color-dim) underline">
                  ¿Prefiere probarlo primero? Vea la demo
                </a>
              </p>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <!-- 3. Done-for-you (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">Qué hace usted</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-chalk)">Nada. Lo montamos nosotros.</h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-dim)">
        Comprar un chatbot es una cosa. Convertirlo en un recepcionista que conoce sus tarifas y le
        llena la agenda es trabajo. Ese trabajo es nuestro.
      </p>
      <ul class="mt-6 grid gap-4 md:gap-6 text-body text-(--color-dim) sm:grid-cols-2">
        <li class="rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5">
          <p class="font-display text-h3 text-(--color-chalk)">Sus servicios y tarifas cargados</p>
          <p class="mt-2">
            Nos los envía o los sacamos de su web. Usted revisa, nosotros tecleamos.
          </p>
        </li>
        <li class="rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5">
          <p class="font-display text-h3 text-(--color-chalk)">Su calendario conectado</p>
          <p class="mt-2">
            Para que la cita entre directamente, y no como una nota en un buzón de correo.
          </p>
        </li>
        <li class="rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5">
          <p class="font-display text-h3 text-(--color-chalk)">WhatsApp solicitado</p>
          <p class="mt-2">La solicitud ante Meta la gestionamos nosotros. Usted no la ve.</p>
        </li>
        <li class="rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5">
          <p class="font-display text-h3 text-(--color-chalk)">Actualizado cuando algo cambia</p>
          <p class="mt-2">
            ¿Tarifas nuevas o un servicio nuevo? Un correo y lo ajustamos. Siempre.
          </p>
        </li>
      </ul>
      <p class="mt-6 max-w-2xl text-body text-(--color-dim)">
        Hay chatbots más baratos. En esos el que monta es usted, y la mayoría no agenda ninguna
        cita. Esa diferencia es lo que paga aquí.
      </p>
    </div>
  </section>

  <!-- 4. Feature comparison (stone-100) -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">Qué incluye</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-chalk)">Qué incluye cada plan</h2>

      <div class="mt-6 hidden md:block">
        <table class="w-full border-collapse text-body">
          <thead>
            <tr class="border-b border-(--color-line) text-left">
              <th class="py-3 pr-4 font-display text-h3 text-(--color-chalk)">Característica</th>
              <th class="py-3 pr-4 font-display text-h3 text-(--color-chalk)">Chat</th>
              <th class="py-3 pr-4 font-display text-h3 text-(--color-chalk)">Compleet</th>
            </tr>
          </thead>
          <tbody>
            {
              features.map((row) => (
                <tr class="border-b border-(--color-line)">
                  <td class="py-3 pr-4 text-(--color-dim)">{row.feature}</td>
                  <td class="py-3 pr-4">{row.chat}</td>
                  <td class="py-3 pr-4">{row.compleet}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <ul class="mt-6 space-y-4 md:hidden">
        {
          features.map((row) => (
            <li class="rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5">
              <p class="font-display text-h3 text-(--color-chalk)">{row.feature}</p>
              <div class="mt-3 grid grid-cols-2 gap-2 text-small">
                <div>
                  <p class="text-(--color-dim)">Chat</p>
                  <p class="mt-1 text-(--color-chalk)">{row.chat}</p>
                </div>
                <div>
                  <p class="text-(--color-dim)">Compleet</p>
                  <p class="mt-1 text-(--color-chalk)">{row.compleet}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. Every plan + discount (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 sm:grid-cols-2">
      <div>
        <h2 class="font-display text-h2 text-(--color-chalk)">Todos los planes incluyen</h2>
        <ul class="mt-4 space-y-2 text-body text-(--color-dim)">
          <li>Montaje completo y mantenimiento. Usted no monta nada.</li>
          <li>Cancelación mensual; se cancela por correo, sin preaviso.</li>
          <li>Primer mes al 50%.</li>
          <li>Garantía de satisfacción de 30 días. ¿No le convence? Le devolvemos el dinero.</li>
        </ul>
      </div>
      <div>
        <h2 class="font-display text-h2 text-(--color-chalk)">Descuento por pago por adelantado</h2>
        <ul class="mt-4 space-y-2 text-body text-(--color-dim)">
          <li>6 meses por adelantado: 15% de descuento.</li>
          <li>12 meses por adelantado: 20% de descuento y precio fijo todo el año.</li>
          <li>
            IVA del 21% (inversión del sujeto pasivo para clientes fuera de los Países Bajos).
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 6. Final CTA (stone-100) -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">¿Listo?</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-chalk)">¿Listo para empezar?</h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-dim)">
        Dese de alta y le llamamos en un día laborable para planificar la instalación. ¿Prefiere ver
        antes cómo funciona? Pruebe la demo, directamente en su navegador.
      </p>
      <div class="mt-6 btn-row">
        <a href="/es/aanmelden/?plan=chat" class="btn btn-primary btn-lg">Empezar con Chat</a>
        <a href="/es/aanmelden/?plan=compleet" class="btn btn-ghost btn-lg">Empezar con Compleet</a>
        <a href="/es/demo/" class="btn btn-ghost btn-lg">Pruebe la demo</a>
      </div>
    </div>
  </section>
</Base>
