---
import Base from '../../layouts/Base.astro'
import { company } from '../../data/company'

interface Tier {
  id: 'chat' | 'compleet'
  name: string
  price: number
  /** Day-price equivalent, Spanish decimal-comma format (price / 30, rounded to cents). */
  dayPrice: string
  /** Optional usage note under the price (e.g. included call minutes + overage rate). */
  priceNote?: string
  blurb: string
  highlight: boolean
}

const tiers: Tier[] = [
  {
    id: 'chat',
    name: 'Chat',
    price: 299,
    dayPrice: '9,97',
    blurb:
      'Recepcionista con IA por chat web + WhatsApp: responde preguntas, agenda citas y anota solicitudes de llamada, 24/7. Nuestra recomendación.',
    highlight: true,
  },
  {
    id: 'compleet',
    name: 'Compleet',
    price: 499,
    dayPrice: '16,63',
    priceNote: 'incl. 750 minutos de llamada/mes, luego 0,40 €/min',
    blurb:
      'Todo lo de Chat, más un agente telefónico con IA en su propio número (próximamente).',
    highlight: false,
  },
]

interface FeatureRow {
  feature: string
  chat: string
  compleet: string
}

const features: FeatureRow[] = [
  { feature: 'Chat en su propia web (24/7)', chat: 'sí', compleet: 'sí' },
  { feature: 'Canal de WhatsApp', chat: 'sí', compleet: 'sí' },
  { feature: 'Responde preguntas sobre servicios, tarifas y zona de cobertura', chat: 'sí', compleet: 'sí' },
  { feature: 'Agenda citas directamente en su calendario', chat: 'sí', compleet: 'sí' },
  { feature: 'Capta clientes y solicitudes de llamada', chat: 'sí', compleet: 'sí' },
  { feature: 'Instalación y ajuste llave en mano', chat: 'sí', compleet: 'sí' },
  { feature: 'Estadísticas mensuales por correo', chat: 'sí', compleet: 'sí' },
  {
    feature: 'Agente telefónico con IA en su propio número',
    chat: '–',
    compleet: 'próximamente',
  },
  {
    feature: 'Minutos de llamada incluidos al mes',
    chat: '–',
    compleet: '750, luego 0,40 €/min',
  },
]

// Service schema with both subscription tiers, derived from the tiers array
// above so the JSON-LD can never drift from the visible pricing cards.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${company.tradeName} AI receptionist`,
  serviceType: 'AI receptionist for local businesses',
  url: new URL('/es/prijzen/', Astro.site).toString(),
  provider: {
    '@type': 'Organization',
    name: company.tradeName,
    url: new URL('/es/', Astro.site).toString(),
  },
  areaServed: { '@type': 'Country', name: 'Netherlands' },
  offers: tiers.map((tier) => ({
    '@type': 'Offer',
    name: `${company.tradeName} ${tier.name}`,
    description: tier.blurb,
    price: String(tier.price),
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: String(tier.price),
      priceCurrency: 'EUR',
      unitText: 'per month',
    },
  })),
}
---

<Base
  lang="es"
  title="Precios de la recepcionista con IA: Chat 299 € o Compleet 499 € | Klantkraan"
  description="Dos planes: Chat 299 € y Compleet 499 € al mes. Instalación 249 € (gratis para clientes piloto), cancele cada mes, primer mes al 50%."
  centered={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="font-display text-hero text-(--color-kraan-ink)">Precios</h1>
      <p class="mt-6 max-w-2xl text-h3 text-(--color-kraan-stone-700)">
        Cancele cada mes, primer mes al 50%. Instalación única de 249 € (gratis para clientes
        piloto). Todos los importes no incluyen el 21% de IVA.
      </p>
    </div>
  </section>

  <!-- 2. Tier cards (stone-100) -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16">
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 md:grid-cols-2">
      {
        tiers.map((tier) => (
          <article
            class={`rounded-(--radius-card) border p-5 md:p-6 ${tier.highlight ? 'border-(--color-kraan-blue) bg-white' : 'border-(--color-kraan-stone-300) bg-white'}`}
          >
            <header class="flex items-baseline justify-between">
              <h2 class="font-display text-h2 text-(--color-kraan-ink)">{tier.name}</h2>
              {tier.highlight && (
                <span class="rounded-(--radius-button) bg-(--color-kraan-rust) px-2 py-1 text-micro text-white">
                  recomendado
                </span>
              )}
            </header>
            <p class="mt-4 font-display text-h1 text-(--color-kraan-blue)">
              {tier.price} €
              <span class="text-body text-(--color-kraan-stone-500)"> / mes</span>
            </p>
            <p class="mt-1 font-mono text-small text-(--color-kraan-stone-500)">
              ≈ {tier.dayPrice} € al día
            </p>
            {tier.priceNote && (
              <p class="mt-2 text-small text-(--color-kraan-stone-500)">{tier.priceNote}</p>
            )}
            <p class="mt-3 text-body text-(--color-kraan-stone-700)">{tier.blurb}</p>
            <a
              href="/es/demo/"
              class={`mt-6 inline-block rounded-(--radius-button) px-5 py-3 text-body font-medium no-underline ${tier.highlight ? 'bg-(--color-kraan-blue) text-white hover:bg-(--color-kraan-blue-700)' : 'border border-(--color-kraan-blue) text-(--color-kraan-blue) hover:bg-(--color-kraan-stone-100)'}`}
            >
              Pruebe la demo
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 3. Feature comparison (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">Qué incluye</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">Qué incluye cada plan</h2>

      <div class="mt-6 hidden md:block">
        <table class="w-full border-collapse text-body">
          <thead>
            <tr class="border-b border-(--color-kraan-stone-300) text-left">
              <th class="py-3 pr-4 font-display text-h3 text-(--color-kraan-ink)">Característica</th>
              <th class="py-3 pr-4 font-display text-h3 text-(--color-kraan-ink)">Chat</th>
              <th class="py-3 pr-4 font-display text-h3 text-(--color-kraan-ink)">Compleet</th>
            </tr>
          </thead>
          <tbody>
            {
              features.map((row) => (
                <tr class="border-b border-(--color-kraan-stone-300)">
                  <td class="py-3 pr-4 text-(--color-kraan-stone-700)">{row.feature}</td>
                  <td class="py-3 pr-4">{row.chat}</td>
                  <td class="py-3 pr-4">{row.compleet}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <ul class="mt-6 space-y-4 md:hidden">
        {
          features.map((row) => (
            <li class="rounded-(--radius-card) border border-(--color-kraan-stone-300) bg-white p-5">
              <p class="font-display text-h3 text-(--color-kraan-ink)">{row.feature}</p>
              <dl class="mt-3 grid grid-cols-2 gap-2 text-small">
                <div>
                  <dt class="text-(--color-kraan-stone-500)">Chat</dt>
                  <dd class="mt-1 text-(--color-kraan-ink)">{row.chat}</dd>
                </div>
                <div>
                  <dt class="text-(--color-kraan-stone-500)">Compleet</dt>
                  <dd class="mt-1 text-(--color-kraan-ink)">{row.compleet}</dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. Every plan + discount (stone-100) -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16">
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 sm:grid-cols-2">
      <div>
        <h2 class="font-display text-h2 text-(--color-kraan-ink)">Todos los planes incluyen</h2>
        <ul class="mt-4 space-y-2 text-body text-(--color-kraan-stone-700)">
          <li>Instalación y ajuste llave en mano. Lo montamos y lo conectamos todo por usted.</li>
          <li>Cancele cada mes (30 días de preaviso).</li>
          <li>Primer mes al 50%.</li>
          <li>Garantía de satisfacción de 30 días. ¿No le convence? Le devolvemos el dinero.</li>
        </ul>
      </div>
      <div>
        <h2 class="font-display text-h2 text-(--color-kraan-ink)">Descuento por pago por adelantado</h2>
        <ul class="mt-4 space-y-2 text-body text-(--color-kraan-stone-700)">
          <li>6 meses por adelantado: 15% de descuento.</li>
          <li>12 meses por adelantado: 20% de descuento y precio fijo todo el año.</li>
          <li>IVA del 21% (inversión del sujeto pasivo para clientes fuera de los Países Bajos).</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. Final CTA (blue) -->
  <section class="bg-(--color-kraan-blue) py-10 md:py-16 text-white">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-white/70">¿Listo?</p>
      <h2 class="mt-3 font-display text-h1 text-white">¿Listo para empezar?</h2>
      <p class="mt-4 max-w-2xl text-body text-white/90">
        En una demo de 20 minutos le mostramos exactamente cómo funciona Klantkraan en su caso. Sin
        discursos de venta, solo los números sobre sus propias cifras.
      </p>
      <a
        href="/es/demo/"
        class="mt-6 inline-block rounded-(--radius-button) bg-white px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
      >
        Pruebe la demo
      </a>
    </div>
  </section>
</Base>
