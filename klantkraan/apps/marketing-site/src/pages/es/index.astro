---
import Base from '../../layouts/Base.astro'
import { waLink } from '../../data/contact'
---

<Base
  lang="es"
  title="Recepcionista con IA para su negocio: chat web y WhatsApp | Klantkraan"
  description="Una recepcionista con IA en su web y WhatsApp: responde preguntas, agenda citas y capta clientes, día y noche. Instalación llave en mano. Cancelación mensual."
  centered={false}
>
  <!-- HERO — copy left, live dispatch panel right -->
  <section class="pt-11 pb-0 md:pt-[4.5rem]">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid gap-10 md:grid-cols-[1.05fr_.95fr] md:items-center md:gap-14">
        <!-- copy -->
        <div>
          <span class="kk-status">
            <span class="kk-dot" aria-hidden="true"></span>
            <span>ACTIVO &middot; responde ahora</span>
            <span class="sep" aria-hidden="true">&middot;</span>
            <span>WEB + WHATSAPP</span>
          </span>

          <h1 class="kk-h1">La luz sigue <span class="on">encendida.</span></h1>

          <p class="kk-sub">
            Está en lo alto de una escalera, en un tejado, o durmiendo. Su mejor cliente tiene una
            pregunta ahora mismo. La recepcionista digital de Klantkraan la responde en su web y por
            WhatsApp, agenda la cita y anota cada solicitud de llamada. De día y de noche.
          </p>

          <div class="mt-8 flex flex-wrap gap-3.5">
            <a href="/es/demo/" class="btn btn-primary btn-lg">Pruebe la demo</a>
            <a href="#nachtdienst" class="btn btn-ghost btn-lg">Cómo funciona</a>
          </div>
          <p class="kk-trust">
            Instalación llave en mano &middot; cancelación mensual &middot;
            <span class="g">conforme al RGPD, alojado en la UE</span>
          </p>
        </div>

        <!-- live dispatch panel (decorative: role=img + summary label) -->
        <div class="kk-shell">
          <div
            id="kk-dispatch"
            class="kk-panel"
            role="img"
            aria-label="Registro de turno: a las 23:47 un cliente con una fuga hace una pregunta, la recepcionista digital agenda una cita para el martes a las 09:00 y deja preparada una solicitud de llamada para el propietario."
          >
            <div class="kk-panel-top">
              <span>REGISTRO &middot; ESTA NOCHE</span>
              <span class="on"><span class="kk-dot" aria-hidden="true"></span>ACTIVO</span>
            </div>
            <div class="kk-log" aria-hidden="true">
              <div class="kk-row dim">
                <span class="kk-ts">06:14</span>
                <span class="kk-what">solicitud de presupuesto</span>
                <span class="kk-st">✓ respondida</span>
              </div>
              <div class="kk-row dim">
                <span class="kk-ts">12:40</span>
                <span class="kk-what">cita &middot; inspección de tejado</span>
                <span class="kk-st">✓ agendada</span>
              </div>

              <div class="kk-live">
                <div class="kk-lts kk-reveal" style="animation-delay:.2s">
                  23:47 &middot; conversación entrante
                </div>
                <div class="kk-disclosure kk-reveal" style="animation-delay:.5s">
                  Está hablando con un asistente digital.
                </div>

                <div class="kk-msg kk-klant kk-reveal" style="animation-delay:.9s">
                  <span class="who">Cliente</span>
                  <span>Tengo una fuga bajo el fregadero, ¿puede venir alguien mañana?</span>
                </div>

                <div id="kk-typing" class="kk-msg kk-recep kk-reveal" style="animation-delay:1.5s;padding:0">
                  <span class="kk-typing" aria-hidden="true"><i></i><i></i><i></i></span>
                </div>

                <div id="kk-reply" class="kk-msg kk-recep" hidden>
                  <span class="who">Klantkraan</span>
                  <span>Lamento oírlo, nos encargamos. Mañana a las 09:00 está libre. ¿Se lo reservo?</span>
                </div>

                <div id="kk-stamp" class="kk-stamp" hidden>
                  <span class="tick" aria-hidden="true">✓</span>
                  <span>
                    <strong>AGENDADA</strong>
                    <span class="detail"> mar 09:00 &middot; llamada preparada para el propietario</span>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ledger strip: real times prove misses cluster at inconvenient hours -->
    <div class="kk-ledger mt-[2.125rem]">
      <div class="mx-auto max-w-5xl px-6">
        <div class="kk-ledger-grid">
          <div class="cell">
            <div class="kk-cell-ts">06:14</div>
            <div class="kk-cell-ev">Presupuesto respondido</div>
            <div class="kk-cell-aside">antes de despertarse</div>
          </div>
          <div class="cell">
            <div class="kk-cell-ts">12:40</div>
            <div class="kk-cell-ev">Cita agendada</div>
            <div class="kk-cell-aside">estaba en el tejado</div>
          </div>
          <div class="cell">
            <div class="kk-cell-ts">23:47</div>
            <div class="kk-cell-ev">Fuga urgente → cita</div>
            <div class="kk-cell-aside">estaba durmiendo</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DUTIES — the night shift -->
  <section id="nachtdienst" class="scroll-mt-24 py-[3.25rem] md:py-[4.875rem]">
    <div class="mx-auto max-w-5xl px-6">
      <span class="eyebrow">El turno de noche</span>
      <h2 class="mt-3.5 max-w-[16em] font-display text-h2 text-balance">
        Lo que la recepcionista asume mientras usted trabaja.
      </h2>
      <div class="mt-10 grid gap-[18px] md:grid-cols-3">
        <div class="kk-duty">
          <span class="tag">respuesta</span>
          <h3>Responde cada pregunta</h3>
          <p>
            Conoce sus tarifas, servicios y zona de trabajo. Sin precios inventados, solo lo que
            usted ha configurado.
          </p>
        </div>
        <div class="kk-duty">
          <span class="tag">agenda</span>
          <h3>Agenda la cita</h3>
          <p>
            Directo en su calendario, solo en horas que están realmente libres. El cliente elige un
            hueco y usted lo ve al instante.
          </p>
        </div>
        <div class="kk-duty">
          <span class="tag">llamada</span>
          <h3>Anota la solicitud de llamada</h3>
          <p>
            ¿No puede atender ahora? La recepcionista anota el nombre, el número y el trabajo. Usted
            devuelve la llamada a quien de verdad importa.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- COST — a receipt, not a big-number-gradient -->
  <section id="kosten" class="scroll-mt-24 border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-[3.25rem] md:py-[4.875rem]">
    <div class="mx-auto grid max-w-5xl gap-8 px-6 md:grid-cols-[1.1fr_.9fr] md:items-center md:gap-11">
      <div>
        <span class="eyebrow">La factura de una noche a oscuras</span>
        <h2 class="mt-3.5 max-w-[16em] font-display text-h2 text-balance">
          Cada pregunta sin responder es un trabajo que se va a la competencia.
        </h2>
        <p class="mt-4 max-w-[38em] text-[1.05rem] text-[#cdd8d5]">
          Esto es un ejemplo. Hágalo con sus propios números y verá exactamente lo que le cuesta un
          mes de consultas perdidas.
        </p>
      </div>
      <div class="kk-receipt" aria-label="Cálculo de ejemplo de ingresos perdidos">
        <p class="kk-receipt-cap">Ejemplo · un mes normal</p>
        <div class="line">
          <span class="k">Consultas al mes</span>
          <span class="v">20</span>
        </div>
        <div class="line">
          <span class="k">Perdidas (1 de cada 4)</span>
          <span class="v">5</span>
        </div>
        <div class="line">
          <span class="k">× valor por trabajo</span>
          <span class="v">450 €</span>
        </div>
        <div class="line result">
          <span class="k">Ingresos perdidos</span>
          <span class="v bad">2.250 €/mes</span>
        </div>
        <a class="kk-receipt-cta" href="/es/rekentool/">
          Hágalo con sus propios números
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- TRANSPARENCY / art. 50 -->
  <section id="eerlijk" class="scroll-mt-24 py-[3.25rem] md:py-[4.875rem]">
    <div class="mx-auto max-w-5xl px-6">
      <span class="eyebrow">Honestos con la IA</span>
      <h2 class="mt-3.5 max-w-[16em] font-display text-h2 text-balance">
        La luz está encendida. No hay nada que ocultar.
      </h2>
      <div class="kk-trans mt-6">
        <span class="quote">&ldquo;Está hablando con un asistente digital.&rdquo;</span>
        <p>
          Así empieza cada conversación, antes de cualquier otra cosa. Lo exige el artículo&nbsp;50 del
          Reglamento de IA de la UE, y encaja con un negocio transparente. Su cliente sabe con quién
          habla, usted no se arriesga a una multa y la conversación sigue siendo honesta, de día y
          de noche.
        </p>
        <p class="mt-4 text-small">
          <a href="/legal/ai-disclosure/">Lea la declaración completa</a>
        </p>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="py-[5.625rem] text-center">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="kk-final-h2">Encienda la <span class="on">luz.</span></h2>
      <p class="mx-auto mt-[18px] max-w-[34em] text-(--color-dim)">
        Pruebe la demo y hágale una pregunta a la recepcionista como si fuera un cliente. ¿Le
        convence? De la instalación nos encargamos nosotros, usted no construye nada.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3.5">
        <a href="/es/demo/" class="btn btn-primary btn-lg">Pruebe la demo</a>
        <a href={waLink} target="_blank" rel="noopener" class="btn btn-ghost btn-lg">
          Agende una charla inicial
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- hero copy ---- */
  .kk-status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--color-sodium-soft);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 6px 13px 6px 12px;
    background: var(--color-panel);
  }
  .kk-status .sep {
    color: var(--color-line);
  }
  .kk-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-sodium);
    flex: none;
    animation: kk-pulse 2.6s ease-out infinite;
  }
  .kk-h1 {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.025em;
    font-size: clamp(2.5rem, 6.4vw, 4.7rem);
    line-height: 0.98;
    margin: 22px 0 0;
    text-wrap: balance;
  }
  .kk-h1 .on {
    color: var(--color-sodium);
  }
  .kk-sub {
    margin-top: 24px;
    max-width: 33em;
    font-size: clamp(1.02rem, 1.4vw, 1.18rem);
    color: #cdd8d5;
    line-height: 1.6;
  }
  .kk-trust {
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.02em;
    color: var(--color-dim);
  }
  .kk-trust .g {
    color: var(--color-confirm);
  }

  /* ---- dispatch panel (the signature) ---- */
  .kk-shell {
    position: relative;
  }
  .kk-shell::before {
    content: '';
    position: absolute;
    inset: -14% -8% -18% -8%;
    z-index: 0;
    background: radial-gradient(closest-side, rgba(255, 184, 77, 0.22), transparent 72%);
    filter: blur(6px);
  }
  .kk-panel {
    position: relative;
    z-index: 1;
    background: linear-gradient(180deg, var(--color-panel-2), var(--color-panel));
    border: 1px solid var(--color-line);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.7);
  }
  .kk-panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 16px;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    color: var(--color-dim);
    background: rgba(0, 0, 0, 0.14);
  }
  .kk-panel-top .on {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--color-sodium);
  }
  .kk-log {
    padding: 8px 16px 18px;
  }
  .kk-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 12px;
    align-items: baseline;
    padding: 11px 0;
    border-bottom: 1px dashed var(--color-line);
    font-size: 14.5px;
  }
  .kk-row:last-child {
    border-bottom: 0;
  }
  .kk-row.dim {
    opacity: 0.5;
  }
  .kk-ts {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-sodium-soft);
  }
  .kk-what {
    color: #cdd8d5;
  }
  .kk-st {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.03em;
    color: var(--color-confirm);
    white-space: nowrap;
  }
  .kk-live {
    margin-top: 4px;
    padding-top: 12px;
  }
  .kk-lts {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-sodium-soft);
    letter-spacing: 0.04em;
  }
  .kk-disclosure {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-dim);
    border: 1px dashed var(--color-line);
    border-radius: 7px;
    padding: 6px 9px;
    margin: 10px 0 12px;
  }
  .kk-msg {
    margin: 9px 0;
    max-width: 82%;
    padding: 9px 13px;
    border-radius: 12px;
    font-size: 14.5px;
    line-height: 1.45;
  }
  .kk-msg .who {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-dim);
    margin-bottom: 3px;
  }
  .kk-klant {
    background: var(--color-panel-2);
    border: 1px solid var(--color-line);
    border-bottom-left-radius: 4px;
  }
  .kk-recep {
    background: rgba(255, 184, 77, 0.12);
    border: 1px solid rgba(255, 184, 77, 0.32);
    color: #ffe9c7;
    margin-left: auto;
    border-bottom-right-radius: 4px;
  }
  .kk-recep .who {
    color: var(--color-sodium);
  }
  .kk-typing {
    display: inline-flex;
    gap: 4px;
    padding: 12px 14px;
  }
  .kk-typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-dim);
    animation: kk-blink 1.1s infinite;
  }
  .kk-typing i:nth-child(2) {
    animation-delay: 0.18s;
  }
  .kk-typing i:nth-child(3) {
    animation-delay: 0.36s;
  }
  @keyframes kk-blink {
    0%,
    60%,
    100% {
      opacity: 0.25;
    }
    30% {
      opacity: 1;
    }
  }
  .kk-stamp {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    padding: 11px 13px;
    background: rgba(99, 211, 171, 0.1);
    border: 1px solid rgba(99, 211, 171, 0.34);
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-confirm);
  }
  .kk-stamp .tick {
    width: 19px;
    height: 19px;
    flex: none;
    border-radius: 50%;
    background: var(--color-confirm);
    color: var(--color-night);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 12px;
  }
  .kk-stamp .detail {
    color: #bfe7d7;
  }

  /* entrance for live rows (JS re-triggers .kk-rise on reveal) */
  .kk-reveal,
  .kk-rise {
    opacity: 0;
    transform: translateY(6px);
    animation: kk-rise 0.5s ease forwards;
  }
  @keyframes kk-rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  /* Hidden states must beat the base display of .kk-msg/.kk-stamp (higher specificity). */
  .kk-msg[hidden],
  .kk-stamp[hidden] {
    display: none;
  }

  /* ---- ledger strip ---- */
  .kk-ledger {
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    background: rgba(0, 0, 0, 0.12);
  }
  .kk-ledger-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .kk-ledger-grid .cell {
    padding: 26px 24px;
    border-right: 1px solid var(--color-line);
  }
  .kk-ledger-grid .cell:last-child {
    border-right: 0;
  }
  @media (max-width: 760px) {
    .kk-ledger-grid {
      grid-template-columns: 1fr;
    }
    .kk-ledger-grid .cell {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .kk-ledger-grid .cell:last-child {
      border-bottom: 0;
    }
  }
  .kk-cell-ts {
    font-family: var(--font-mono);
    font-size: 22px;
    color: var(--color-sodium);
    letter-spacing: -0.01em;
  }
  .kk-cell-ev {
    margin-top: 6px;
    font-weight: 600;
    font-size: 15.5px;
  }
  .kk-cell-aside {
    margin-top: 3px;
    font-size: 14px;
    color: var(--color-dim);
  }

  /* ---- duty cards ---- */
  .kk-duty {
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 24px;
  }
  .kk-duty .tag {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-sodium-soft);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .kk-duty h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.22rem;
    margin: 14px 0 8px;
    letter-spacing: -0.01em;
  }
  .kk-duty p {
    margin: 0;
    color: var(--color-dim);
    font-size: 15px;
    line-height: 1.55;
  }

  /* ---- cost receipt ---- */
  .kk-receipt {
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 8px 22px;
    font-family: var(--font-mono);
  }
  .kk-receipt .line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px dashed var(--color-line);
  }
  .kk-receipt .line:last-child {
    border-bottom: 0;
  }
  .kk-receipt .k {
    color: var(--color-dim);
    font-size: 13.5px;
    letter-spacing: 0.02em;
  }
  .kk-receipt .v {
    font-size: 19px;
    color: var(--color-chalk);
  }
  .kk-receipt .v.bad {
    color: var(--color-sodium);
  }
  .kk-receipt-cap {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-dim);
    padding-top: 14px;
    margin: 0;
  }
  .kk-receipt .line.result {
    border-bottom: 0;
    padding-top: 18px;
  }
  .kk-receipt .line.result .k {
    color: var(--color-chalk);
    font-size: 14px;
  }
  .kk-receipt .line.result .v {
    font-size: 23px;
    font-weight: 700;
  }
  .kk-receipt-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px dashed var(--color-line);
    padding: 16px 0 8px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-sodium);
    text-decoration: none;
  }
  .kk-receipt-cta span {
    transition: transform 0.15s ease;
  }
  .kk-receipt-cta:hover {
    color: var(--color-sodium-soft);
  }
  .kk-receipt-cta:hover span {
    transform: translateX(3px);
  }

  /* ---- transparency panel ---- */
  .kk-trans {
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-sodium);
    border-radius: var(--radius-card);
    padding: 30px 32px;
    max-width: 760px;
  }
  .kk-trans .quote {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-sodium-soft);
    border: 1px dashed var(--color-line);
    border-radius: 8px;
    padding: 10px 13px;
    display: inline-block;
    margin-bottom: 18px;
  }
  .kk-trans p {
    color: #cdd8d5;
  }

  /* ---- final cta ---- */
  .kk-final-h2 {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.025em;
    font-size: clamp(2.2rem, 5.6vw, 4rem);
    line-height: 1;
    margin: 0;
    text-wrap: balance;
  }
  .kk-final-h2 .on {
    color: var(--color-sodium);
  }
</style>

<script>
  // Live dispatch panel: klant → typing → reply → INGEPLAND stamp.
  // Bound to astro:page-load so it survives client-side (ClientRouter) nav and
  // re-runs when the visitor returns to the home page. Reduced-motion jumps
  // straight to the resting state. The panel is decorative (role=img with a
  // summary label), so the no-JS state (typing shown, reply/stamp hidden)
  // matches the approved concept.
  function initDispatch() {
    const panel = document.getElementById('kk-dispatch')
    if (!panel) return
    const typing = document.getElementById('kk-typing')
    const reply = document.getElementById('kk-reply')
    const stamp = document.getElementById('kk-stamp')
    if (!typing || !reply || !stamp) return

    const reduce =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const reveal = (el: HTMLElement) => {
      el.hidden = false
      el.classList.remove('kk-rise')
      void el.offsetWidth // force reflow so the entrance animation restarts
      el.classList.add('kk-rise')
    }

    if (reduce) {
      typing.hidden = true
      reply.hidden = false
      stamp.hidden = false
      return
    }

    // rewind to the start of the shift, then play it out
    typing.hidden = false
    reply.hidden = true
    stamp.hidden = true
    window.setTimeout(() => {
      typing.hidden = true
      reveal(reply)
    }, 2400)
    window.setTimeout(() => reveal(stamp), 3100)
  }

  document.addEventListener('astro:page-load', initDispatch)
</script>
