---
import Base from '../../layouts/Base.astro'
import FlowDiagram from '../../components/diagrams/FlowDiagram.astro'
import CostReceipt from '../../components/home/CostReceipt.astro'
import FinalCta from '../../components/home/FinalCta.astro'
import Hero from '../../components/home/Hero.astro'
import Honest from '../../components/home/Honest.astro'
import HowItWorks from '../../components/home/HowItWorks.astro'
import { waLink } from '../../data/contact'

const hero = {
  status: 'Responde ahora en su web y WhatsApp',
  h1a: 'La luz sigue',
  h1on: 'encendida.',
  sub:
    'Está en lo alto de una escalera, en un tejado o durmiendo, y un cliente tiene una pregunta ' +
    'ahora mismo. La recepcionista digital de Klantkraan la responde en su web y por WhatsApp, ' +
    'de día y de noche. Agenda la cita y anota cada solicitud de llamada.',
  ctaPrimary: 'Empiece hoy',
  ctaPrimaryHref: '/es/aanmelden/',
  ctaGhost: 'Pruebe la demo',
  ctaGhostHref: '/es/demo/',
  proof: [
    { label: 'Instalación llave en mano' },
    { label: 'Cancelación mensual' },
    { label: 'Conforme al RGPD, alojado en la UE' },
  ],
  panelAria:
    'Conversación a las 23:47: un cliente con una fuga hace una pregunta, la recepcionista digital agenda una cita para el martes a las 09:00 y deja preparada una solicitud de llamada para el propietario.',
  threadName: 'Klantkraan',
  threadSub: 'Responde al instante',
  liveTs: 'Esta noche 23:47',
  disclosure: 'Está hablando con un asistente digital.',
  customerMsg: 'Tengo una fuga bajo el fregadero, ¿puede venir alguien mañana?',
  recepMsg: 'Lamento oírlo, nos encargamos. Mañana a las 09:00 está libre. ¿Se lo reservo?',
  stampStrong: 'AGENDADA',
  stampDetail: 'mar 09:00 · llamada preparada para el propietario',
  window: {
    title: 'klantkraan',
    meta: 'Ejemplo',
    listLabel: 'Conversaciones',
    rows: [
      { channel: 'WhatsApp', time: '23:47', text: 'Fuga bajo el fregadero', status: 'Agendada', active: true },
      { channel: 'Chat web', time: '22:14', text: 'La caldera no funciona', status: 'Llamar' },
      { channel: 'WhatsApp', time: '20:31', text: '¿Trabajan también en Haarlem?', status: 'Respondida' },
      { channel: 'Chat web', time: '18:05', text: '¿Cuánto cuesta cambiar un grifo?', status: 'Respondida' },
    ],
    resultLabel: 'Cita',
    fields: [
      { k: 'Trabajo', v: 'Fuga bajo el fregadero' },
      { k: 'Cuándo', v: 'mar 09:00' },
      { k: 'Vía', v: 'WhatsApp, 23:47' },
      { k: 'Después', v: 'Llamada preparada para el propietario' },
    ],
  },
}

const flow = {
  label: 'El turno de noche',
  heading: 'Lo que la recepcionista asume mientras usted trabaja.',
  steps: [
    { title: 'Responde cada pregunta', text: 'Conoce sus tarifas, servicios y zona de trabajo, y solo da los precios que usted ha fijado.' },
    { title: 'Agenda la cita', text: 'Directo en su calendario, solo en huecos libres. El cliente elige uno y usted lo ve al instante.' },
    { title: 'Anota la solicitud de llamada', text: 'Cuando usted no puede atender, la recepcionista anota el nombre, el número y el trabajo. Usted devuelve la llamada a quien de verdad importa.' },
  ],
}
const flowLabels = {
  inSite: 'Chat web',
  inWa: 'WhatsApp',
  node: 'Klantkraan',
  nodeSub: 'recepcionista digital',
  outAnswer: 'Respuesta',
  outBooking: 'Cita en agenda',
  outCallback: 'Devolver llamada',
  aria:
    'Esquema: las preguntas por chat web y WhatsApp llegan a Klantkraan, que las responde, agenda una cita en su calendario o le deja preparada una solicitud de llamada.',
}

const kosten = {
  eyebrow: 'La factura de una noche a oscuras',
  heading: 'Cada pregunta sin responder es un trabajo que se va a la competencia.',
  sub:
    'Esto es un ejemplo. Calcúlelo con sus propias cifras y verá lo que le cuesta un mes de ' +
    'llamadas perdidas.',
  ariaLabel: 'Cálculo de ejemplo de ingresos perdidos',
  cap: 'Ejemplo · 40 llamadas por semana',
  lines: [
    { k: 'Llamadas al mes', v: '173' },
    { k: 'Perdidas (estimación del sector: 28%)', v: '48' },
    { k: 'Habrían sido trabajos (1 de cada 3)', v: '16' },
    { k: '× valor por trabajo', v: '450 €' },
  ],
  resultK: 'Ingresos perdidos',
  resultV: '± 7.200 €/mes',
  ctaLabel: 'Calcúlelo con sus propias cifras',
  ctaHref: '/es/rekentool/',
}

const eerlijk = {
  eyebrow: 'Honestos sobre la IA',
  heading: 'La luz está encendida. No hay nada que ocultar.',
  quote: 'Está hablando con un asistente digital.',
  bullets: [
    'Cada conversación empieza con esa frase.',
    'El artículo 50 del Reglamento de IA de la UE exige ese aviso desde el 2 de agosto de 2026.',
    'Hay robots de voz que se venden con un "nadie nota la diferencia". Nuestra recepcionista dice lo que es. Su cliente sabe con quién habla y usted no se arriesga a una multa.',
  ],
  linkLabel: 'Lea la declaración completa',
  linkHref: '/legal/ai-disclosure/',
}

const starten = {
  eyebrow: 'Así se empieza',
  heading: 'Alta hoy, en marcha esta misma semana.',
  steps: [
    {
      title: 'Dese de alta',
      text: 'Cinco minutos. Paga directamente a través de Mollie: primer mes 149,50 €, después 299 € al mes, IVA no incluido.',
    },
    {
      title: 'Montamos su recepcionista',
      text: 'En un día laborable le llamamos para repasar sus servicios, tarifas y calendario. Usted no tiene que montar nada.',
    },
    {
      title: 'En marcha en su web y WhatsApp',
      text: 'Usted la prueba y da el visto bueno. Desde ese momento atiende todas las consultas, día y noche.',
    },
  ],
  note: 'Puede cancelar cada mes con un correo, sin preaviso. Sin contrato anual ni renovación oculta.',
}

const roadmap = {
  eyebrow: 'Hacia dónde va',
  heading: 'Hoy la puerta. Mañana la oficina.',
  sub:
    'La recepcionista se ocupa de la puerta: todo lo que entra mientras usted trabaja. Detrás ' +
    'está el papeleo que ahora hace de noche en la mesa de la cocina. Hacia ahí vamos, junto ' +
    'con nuestros primeros clientes.',
  nowLabel: 'Lo que hace ahora',
  now: [
    'Responde preguntas en su web y en WhatsApp, de día y de noche',
    'Agenda citas directamente en su propio calendario',
    'Anota solicitudes de llamada con nombre, número y trabajo',
    'Dice que es un asistente digital, en cada conversación',
  ],
  laterLabel: 'Lo que estamos construyendo',
  laterNote: 'Todavía no está disponible. No forma parte de su suscripción y no lo está pagando.',
  later: [
    'Presupuestos que hacen su propio seguimiento cuando el cliente no responde',
    'Recordatorios de cita, para que nadie se desplace en balde',
    'Peticiones de reseña en cuanto termina el trabajo',
    'Recordatorios de facturas pendientes',
  ],
  footnote:
    'Qué llega primero lo deciden los clientes que tengamos entonces, no nosotros. Si pide algo ' +
    'que no está en la lista, se lo decimos, y también cuándo estará.',
}

const finalCta = {
  h2a: 'Encienda la',
  h2on: 'luz.',
  sub:
    'Pruebe la demo y hágale una pregunta a la recepcionista como si fuera un cliente. Si le ' +
    'convence, dese de alta y nosotros nos encargamos del resto.',
  primary: { label: 'Empiece hoy', href: '/es/aanmelden/' },
  ghosts: [
    { label: 'Pruebe la demo', href: '/es/demo/' },
    { label: 'Agende una charla inicial', href: waLink, external: true },
  ],
}
---

<Base
  lang="es"
  title="Recepcionista con IA para su negocio: chat web y WhatsApp | Klantkraan"
  description="Una recepcionista con IA en su web y WhatsApp: responde preguntas, agenda citas y capta clientes, día y noche. Instalación llave en mano. Cancelación mensual."
  centered={false}
>
  <Hero t={hero} />
  <FlowDiagram t={flow} labels={flowLabels} />
  <CostReceipt t={kosten} />
  <Honest eerlijk={eerlijk} roadmap={roadmap} />
  <HowItWorks t={starten} />
  <FinalCta t={finalCta} />
</Base>
