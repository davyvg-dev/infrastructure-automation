---
// context7: Astro Content Collections dynamic routes — getStaticPaths + render()
// (/llmstxt/astro_build_llms-full_txt, 2026-05-20)
import { getCollection, render, type CollectionEntry } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { niches, type NicheSlug } from '../../data/niches'
import { company } from '../../data/company'

type BlogPost = CollectionEntry<'blog'>

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') as string },
    props: { post },
  }))
}

interface Props {
  post: BlogPost
}

const { post } = Astro.props as Props
const { Content } = await render(post)

const postSlug = (p: BlogPost): string => p.id.replace(/\.md$/, '')

// Same label pattern as gidsen/[slug].astro: niches.ts where available,
// regular Dutch plural as fallback so no vertical ever renders undefined.
const verticalLabel = (v: string): string =>
  v === 'algemeen' ? 'Algemeen' : v in niches ? niches[v as NicheSlug].labelPlural : `${v}s`

// Cornerstone page per vertical (same map as gidsen/[slug].astro).
const cornerstone: Record<string, string> = {
  loodgieter: '/loodgieters/',
  dakdekker: '/dakdekkers/',
  schilder: '/schilder/',
  installateur: '/installateur/',
  elektricien: '/elektricien/',
  aannemer: '/aannemer/',
}
const cornerstonePath = cornerstone[post.data.vertical] ?? '/voor-wie/'
const cornerstoneLabel =
  post.data.vertical === 'algemeen' ? 'vakmensen' : verticalLabel(post.data.vertical).toLowerCase()

// Related posts: same vertical first; otherwise the two most recent others.
const otherPosts = (await getCollection('blog')).filter((p) => p.id !== post.id)
const sameVertical = otherPosts.filter((p) => p.data.vertical === post.data.vertical)
const related = (
  sameVertical.length > 0
    ? sameVertical
    : otherPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
).slice(0, 2)

const canonical = new URL(`/blog/${postSlug(post)}/`, Astro.site).toString()
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString().slice(0, 10),
  author: { '@type': 'Organization', name: company.tradeName },
  publisher: { '@type': 'Organization', name: company.tradeName },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical,
}

const dateFmt = new Intl.DateTimeFormat('nl-NL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})

// Only append the brand suffix when the title stays within ~65 chars.
const pageTitle =
  post.data.title.length <= 52 ? `${post.data.title} — Klantkraan` : post.data.title
---

<Base title={pageTitle} description={post.data.description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
  <article class="py-8">
    <p class="text-micro uppercase tracking-wide text-(--color-kraan-stone-500)">
      <a href="/blog/" class="no-underline hover:underline">Blog</a> · {
        verticalLabel(post.data.vertical)
      } · {dateFmt.format(post.data.pubDate)}
    </p>
    <h1 class="mt-4 font-display text-hero text-(--color-kraan-ink)">{post.data.title}</h1>
    <p class="mt-6 max-w-2xl text-h3 text-(--color-kraan-stone-700)">{post.data.description}</p>

    <div class="prose-blog mt-10 max-w-2xl text-body text-(--color-kraan-ink)">
      <Content />
    </div>

    <aside class="mt-10 max-w-2xl text-body text-(--color-kraan-stone-700)">
      <p>
        Meer voor {cornerstoneLabel}:
        <a href={cornerstonePath} class="text-(--color-kraan-blue) underline">
          zo werkt de Klantkraan AI-receptionist voor {cornerstoneLabel}
        </a>.
      </p>
    </aside>

    {
      related.length > 0 && (
        <section class="mt-10 max-w-2xl">
          <h2 class="font-display text-h3 text-(--color-kraan-ink)">Gerelateerde artikelen</h2>
          <ul class="mt-3 space-y-2 text-body">
            {related.map((p) => (
              <li>
                <a
                  href={`/blog/${postSlug(p)}/`}
                  class="text-(--color-kraan-blue) underline hover:text-(--color-kraan-rust)"
                >
                  {p.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <footer
      class="mt-12 border-t border-(--color-kraan-stone-300) pt-8 text-small text-(--color-kraan-stone-500)"
    >
      Geschreven door {post.data.author}. Vragen of feedback?
      <a href="/demo/" class="no-underline hover:underline">Probeer de demo</a> of bekijk de
      <a href="/prijzen/" class="no-underline hover:underline">prijzen</a>.
    </footer>
  </article>
</Base>

<style is:global>
  .prose-blog h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    font-weight: var(--text-h2--font-weight);
    color: var(--color-kraan-ink);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .prose-blog h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    font-weight: var(--text-h3--font-weight);
    color: var(--color-kraan-ink);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-blog p {
    margin-top: 0;
    margin-bottom: 1.25rem;
    color: var(--color-kraan-stone-700);
  }
  .prose-blog ul,
  .prose-blog ol {
    margin: 1rem 0 1.5rem 1.25rem;
    padding: 0;
    color: var(--color-kraan-stone-700);
  }
  .prose-blog li {
    margin-bottom: 0.5rem;
  }
  .prose-blog strong {
    color: var(--color-kraan-ink);
    font-weight: 600;
  }
  .prose-blog blockquote {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--color-kraan-blue);
    background: var(--color-kraan-stone-100);
    color: var(--color-kraan-stone-700);
    font-style: italic;
  }
  .prose-blog a {
    color: var(--color-kraan-blue);
    text-underline-offset: 0.2em;
    /* Long inline URLs must be able to break so they never widen the page. */
    overflow-wrap: break-word;
  }
  .prose-blog a:hover {
    color: var(--color-kraan-rust);
  }
  /* Markdown tables become their own horizontal scroll container so a wide
   * table (e.g. the 4-column one in cv-storing-januari-installateur.md) scrolls
   * inside its box on a phone instead of pushing the whole page sideways. */
  .prose-blog table {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: var(--text-small);
    -webkit-overflow-scrolling: touch;
  }
  .prose-blog th,
  .prose-blog td {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-kraan-stone-300);
    text-align: left;
    vertical-align: top;
  }
  .prose-blog th {
    font-weight: 600;
    color: var(--color-kraan-ink);
    background: var(--color-kraan-stone-100);
  }
  .prose-blog pre {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .prose-blog code {
    overflow-wrap: break-word;
  }
</style>
