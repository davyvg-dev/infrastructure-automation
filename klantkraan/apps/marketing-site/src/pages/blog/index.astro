---
// context7: Astro Content Collections — getCollection (/llmstxt/astro_build_llms-full_txt, 2026-05-20)
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)

// Covers every vertical the blog collection allows (src/content/config.ts).
const verticalLabel: Record<(typeof posts)[number]['data']['vertical'], string> = {
  loodgieter: 'Loodgieters',
  dakdekker: 'Dakdekkers',
  schilder: 'Schilders',
  installateur: 'Installateurs',
  elektricien: 'Elektriciens',
  aannemer: 'Aannemers',
  algemeen: 'Algemeen',
}

const dateFmt = new Intl.DateTimeFormat('nl-NL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
---

<Base
  title="Blog over klantcontact voor vakmensen | Klantkraan"
  description="Praktische artikelen voor Nederlandse ondernemers over AI-receptionist, gemiste oproepen, no-shows en klantenmotor-automatisering."
>
  <section class="py-8">
    <h1 class="font-display text-hero text-(--color-chalk)">Blog</h1>
    <p class="mt-6 max-w-2xl text-h3 text-(--color-dim)">
      Eerlijke artikelen over gemiste oproepen, AI-telefoniste en automatisering voor Nederlandse
      ondernemers. Geen marketing-praatjes, wel cijfers.
    </p>
  </section>

  <section class="grid gap-4 md:gap-6 py-8 md:grid-cols-2">
    {
      posts.map((post) => (
        <article class="flex flex-col rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5 md:p-6">
          <header>
            <p class="text-micro uppercase tracking-wide text-(--color-dim)">
              {verticalLabel[post.data.vertical]} · {dateFmt.format(post.data.pubDate)}
            </p>
            <h2 class="mt-3 font-display text-h2 text-(--color-chalk)">
              <a
                href={`/blog/${post.id.replace(/\.md$/, '')}/`}
                class="text-(--color-chalk) no-underline hover:text-(--color-sodium)"
              >
                {post.data.title}
              </a>
            </h2>
          </header>
          <p class="mt-4 flex-1 text-body text-(--color-dim)">{post.data.description}</p>
          <a
            href={`/blog/${post.id.replace(/\.md$/, '')}/`}
            aria-label={`Lees het artikel → ${post.data.title}`}
            class="mt-6 inline-flex min-h-[2.75rem] items-center text-body font-medium text-(--color-sodium) no-underline hover:underline"
          >
            Lees het artikel →
          </a>
        </article>
      ))
    }
  </section>
</Base>
