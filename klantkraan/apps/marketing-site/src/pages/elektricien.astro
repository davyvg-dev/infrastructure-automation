---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import Stat from '../components/Stat.astro'
import Plug from '../components/illustrations/Plug.astro'
import RiskReversal from '../components/RiskReversal.astro'

// Elektricien landing page. Follows the /loodgieters template structure.
// Trade-specific copy: kortsluiting, groepenkast, EV-laadpunt, stroomstoring.

interface PainStat {
  value: string
  caption: string
}

const painStats: PainStat[] = [
  { value: '34%', caption: 'van uw oproepen na 17:00 wordt niet opgenomen.' },
  { value: '€375', caption: 'gemiddelde waarde per stroomstoring-melding.' },
  { value: '0', caption: 'reviews per klus die u nu niet vraagt.' },
]

interface Feature {
  icon: 'phone-call' | 'message-square' | 'star'
  title: string
  body: string
}

const features: Feature[] = [
  {
    icon: 'phone-call',
    title: 'Praat over kortsluiting in vakjargon',
    body: 'Neemt op in vlot Nederlands, ook na 17:00 en in het weekend. Noemt alleen uw eigen kortsluitings-spoedtarief, uurtarief en weekendtoeslag. Geen prijs die u niet vooraf heeft ingesteld.',
  },
  {
    icon: 'message-square',
    title: 'Missed-call SMS binnen 60 seconden',
    body: 'Stroomstoring na sluitingstijd? De beller krijgt direct een Nederlandstalig bericht met een terugbel-link via Cal.com. Geen klant gaat naar de concurrent terwijl u op een andere klus zit.',
  },
  {
    icon: 'star',
    title: 'Google-reviews na elke klus',
    body: 'De volgende ochtend om 10:00 stuurt het systeem een korte review-uitnodiging aan uw klant. Soft follow-up per e-mail op dag 7. Geen handmatig werk.',
  },
]

interface Faq {
  q: string
  a: string
  href?: string
  linkLabel?: string
}

const faqs: Faq[] = [
  {
    q: 'Werkt het ook met mijn huidige telefoonnummer?',
    a: 'Ja. Wij koppelen Klantkraan aan uw bestaande nummer via een doorschakeling. U houdt hetzelfde nummer op uw bus, facturen en Google-vermelding. Doorschakelen kan altijd, alleen \'s avonds, of alleen bij geen gehoor. U bepaalt.',
  },
  {
    q: 'En als ik op een installatie zit en niet kan opnemen?',
    a: 'Daar is dit voor gemaakt. De AI-receptionist neemt op, classificeert de oproep (kortsluitings-spoed, nieuwe klus, bestaande klant, leverancier), boekt indien gewenst een terugbel-afspraak in Cal.com en stuurt u een samenvatting per WhatsApp of e-mail. U belt terug wanneer de groepenkast weer dicht zit.',
  },
  {
    q: 'Hoort de klant dat het AI is?',
    a: 'Ja. Direct na de begroeting meldt de assistent dat het gesprek door een AI gevoerd wordt, namens uw bedrijf. Geen marketingkeuze maar een wettelijke verplichting onder de Europese AI-wet (artikel 50). De disclosure blijft altijd aan staan.',
    href: '/legal/ai-disclosure',
    linkLabel: 'Lees de volledige AI-disclosure',
  },
  {
    q: 'Wat als de AI iets verkeerd zegt over mijn tarieven?',
    a: 'Dat kan niet gebeuren. De assistent noemt alleen tarieven die u zelf in uw systeem heeft gezet: voorrijkosten, uurtarief, spoedtoeslag, EV-laadpaal-meerprijs. Onbekende prijzen worden niet verzonnen; de klant krijgt dan een terugbel-afspraak. Wij testen elke configuratie voor u live gaat.',
  },
  {
    q: 'Wat gebeurt er met de klantgegevens?',
    a: 'Alles draait in de EU: Hetzner Frankfurt, Neon EU, Cloudflare EU. Wij tekenen een verwerkersovereenkomst (DPA) met u en bewaren gespreksopnamen 30 dagen, tenzij u korter wenst. Geen data naar VS-leveranciers.',
    href: '/legal/dpa',
    linkLabel: 'Bekijk DPA en privacyverklaring',
  },
  {
    q: 'Per maand opzegbaar, echt waar?',
    a: 'Ja. Geen jaarcontract, geen verborgen verlenging. U zegt op via een mail; opzegtermijn is één maand. Voor wie liever 6 of 12 maanden vooruit betaalt is er korting (15% respectievelijk 20%).',
    href: '/legal/voorwaarden',
    linkLabel: 'Lees de algemene voorwaarden',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]+>/g, ''),
    },
  })),
}
---

<Base
  title="Elektricien klanten werven: Klantkraan AI-receptionist voor stroomstoringen en EV-laadpunten"
  description="Nederlandstalige AI-receptionist die uw kortsluitings-spoedtarief, EV-laadpaal-meerprijs en voorrijkosten kent. Automatische missed-call SMS en Google-review automation. Per maand opzegbaar, done-for-you setup, EU-gehost."
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div
      class="mx-auto grid max-w-5xl gap-10 px-6 md:grid-cols-[1fr_auto] md:items-center md:gap-16"
    >
      <div>
        <h1 class="font-display text-hero text-(--color-kraan-ink)">
          De <span class="text-(--color-kraan-rust)">Klantenmotor</span> voor elektriciens.
        </h1>
        <p class="mt-6 max-w-2xl text-h3 text-(--color-kraan-stone-700)">
          Een stem die uw klant uitlegt wat een kortsluitings-spoedtarief is. Of een
          EV-laadpaal-meerprijs. Neemt op tot 22:00, zeven dagen per week. Reviews en
          terugbelafspraken zitten in hetzelfde abonnement.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/demo"
            class="inline-block rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
          >
            Probeer de demo
          </a>
          <a
            href="/rekentool"
            class="inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
          >
            Bereken uw ROI
          </a>
        </div>
      </div>
      <div class="hidden text-(--color-kraan-blue) md:block">
        <Plug class="h-64 w-64 lg:h-72 lg:w-72" />
      </div>
    </div>
    <div class="mx-auto max-w-5xl px-6">
      <dl class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-6">
        <div class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
          <div>
            <dt class="text-small font-medium text-(--color-kraan-ink)">AVG + AI Act art. 50</dt>
            <dd class="text-small text-(--color-kraan-stone-500)">Disclosure standaard aan</dd>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
          <div>
            <dt class="text-small font-medium text-(--color-kraan-ink)">Gehost in de EU</dt>
            <dd class="text-small text-(--color-kraan-stone-500)">Cloudflare · Neon · Hetzner</dd>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Icon name="phone-call" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
          <div>
            <dt class="text-small font-medium text-(--color-kraan-ink)">Vlot Nederlands</dt>
            <dd class="text-small text-(--color-kraan-stone-500)">Kent uurtarief + spoedtoeslag</dd>
          </div>
        </div>
      </dl>
      <p class="mt-8 text-small text-(--color-kraan-stone-500)">
        Per maand opzegbaar · Done-for-you setup · 50% korting eerste maand
      </p>
    </div>
  </section>

  <!-- 1b. Risk-reversal -->
  <RiskReversal />

  <!-- 2. Pijn-stats trio (stone-100) -->
  <section
    class="bg-(--color-kraan-stone-100) py-10 md:py-16"
    aria-label="Wat een gemiste oproep een elektricien kost"
  >
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 sm:grid-cols-3">
      {painStats.map((stat) => <Stat value={stat.value} label={stat.caption} />)}
    </div>
  </section>

  <!-- 3. Modules (cream, hairline rows) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">Modules</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">
        Wat Klantkraan doet voor elektriciens.
      </h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-kraan-stone-700)">
        Drie modules. Eén maandprijs. Niet voor de grote installatiebureaus. Voor de elektricien met twee tot acht monteurs.
      </p>
      <div class="mt-10 divide-y divide-(--color-kraan-stone-300) border-y border-(--color-kraan-stone-300)">
        {
          features.map((feature) => (
            <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
              <Icon name={feature.icon} class="mt-1 h-7 w-7 text-(--color-kraan-blue)" />
              <div>
                <h3 class="font-display text-h3 text-(--color-kraan-ink)">{feature.title}</h3>
                <p class="mt-2 text-body text-(--color-kraan-stone-700)">{feature.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. ROI snippet (stone-100) -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">Rekensom</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">
        Reken het even na.
      </h2>
      <div class="mt-8 rounded-(--radius-card) border border-(--color-kraan-stone-300) bg-white p-6 md:p-10">
        <p class="text-h3 text-(--color-kraan-ink)">
          Mist u 8 oproepen per week à €375? Dat is <strong class="text-(--color-kraan-rust)">€156.000 verloren omzet per jaar</strong>.
        </p>
        <p class="mt-4 text-body text-(--color-kraan-stone-700)">
          Klantkraan Chat is €299 per maand. Eén kortsluitings-spoed per maand betaalt het
          abonnement. Wat daarna binnenkomt gaat niet meer naar de concurrent verderop.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/rekentool"
            class="inline-block rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
          >
            Open de rekentool
          </a>
          <a
            href="/prijzen"
            class="inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
          >
            Bekijk de tarieven
          </a>
        </div>
        <p class="mt-6 text-micro text-(--color-kraan-stone-500)">
          Bedragen excl. 21% BTW. Voorbeeld op basis van branche-gemiddelde €375 per oproep voor
          installatie- en elektrotechnisch werk (bron: Aira / Invoca missed-call benchmarks).
        </p>
      </div>
    </div>
  </section>

  <!-- 5. FAQ (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">Vragen</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">
        Veelgestelde vragen.
      </h2>
      <div class="mt-10 divide-y divide-(--color-kraan-stone-300) border-y border-(--color-kraan-stone-300)">
        {
          faqs.map((faq) => (
            <details class="group py-4">
              <summary class="block min-h-[2.75rem] cursor-pointer list-none py-1 font-display text-h3 text-(--color-kraan-ink) marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{faq.q}</span>
                  <Icon
                    name="chevron-down"
                    class="mt-1 h-5 w-5 shrink-0 text-(--color-kraan-blue) transition-transform group-open:rotate-180"
                  />
                </span>
              </summary>
              <p class="mt-3 text-body text-(--color-kraan-stone-700)">{faq.a}</p>
              {faq.href && faq.linkLabel && (
                <p class="mt-3 text-small">
                  <a href={faq.href} class="underline">
                    {faq.linkLabel}
                  </a>
                </p>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. Final CTA (blue) -->
  <section class="bg-(--color-kraan-blue) py-10 md:py-16 text-white">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="font-display text-h1 text-white">
        Klaar om geen kortsluitings-spoed meer te missen?
      </h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-kraan-stone-100)">
        Acht minuten demo op een testnummer. U hoort hoe hij uw kortsluitings-spoedtarief noemt
        en wat hij doet als iemand belt over een EV-laadpaal.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/demo"
          class="inline-block rounded-(--radius-button) bg-white px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
        >
          Probeer de demo
        </a>
        <a
          href="/prijzen"
          class="inline-block rounded-(--radius-button) border border-white px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
        >
          Bekijk prijzen
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Base>
