---
import Base from '../layouts/Base.astro'
import FlowDiagram from '../components/diagrams/FlowDiagram.astro'
import VerderLezen from '../components/VerderLezen.astro'
import Icon from '../components/Icon.astro'
import Stat from '../components/Stat.astro'
import Plug from '../components/illustrations/Plug.astro'
import RiskReversal from '../components/RiskReversal.astro'
import PhotoBand from '../components/PhotoBand.astro'

// Elektricien landing page. Follows the /loodgieters template structure.
// Trade-specific copy: kortsluiting, groepenkast, EV-laadpunt, stroomstoring.

interface PainStat {
  value: string
  caption: string
}

const painStats: PainStat[] = [
  { value: '34%', caption: 'van uw oproepen na 17:00 wordt niet opgenomen.' },
  { value: '€\u00a0375', caption: 'gemiddelde waarde van een melding van een stroomstoring.' },
  { value: '0', caption: 'reviews van een klus waar u niet om een review vraagt.' },
]

interface Feature {
  icon: 'phone' | 'message-square' | 'calendar-check'
  title: string
  body: string
}

const features: Feature[] = [
  {
    icon: 'message-square',
    title: 'Praat over kortsluiting in vakjargon',
    body: 'Beantwoordt klantvragen op uw website en in WhatsApp, in vlot Nederlands, ook na 17:00 en in het weekend. Noemt alleen uw eigen spoedtarief bij kortsluiting, uurtarief en weekendtoeslag.',
  },
  {
    icon: 'calendar-check',
    title: 'Afspraken direct in uw agenda',
    body: 'De receptionist plant storings- en installatieafspraken rechtstreeks in uw agenda, alleen op momenten die u zelf heeft vrijgegeven. U belt en mailt niet meer heen en weer.',
  },
  {
    icon: 'phone',
    title: 'Aanvragen en terugbelverzoeken op uw telefoon',
    body: 'Meldt iemand na sluitingstijd een stroomstoring, dan staat de melding direct als bericht op uw telefoon, met naam, nummer en de vraag. Zo gaat geen klant naar de concurrent terwijl u op een andere klus bent.',
  },
]

interface Faq {
  q: string
  a: string
  href?: string
  linkLabel?: string
}

const faqs: Faq[] = [
  {
    q: 'Hoe komt de receptionist op mijn website?',
    a: 'Wij plaatsen één klein script op uw website en koppelen uw WhatsApp. U hoeft zelf niets te doen. U houdt uw eigen site, nummer en huisstijl.',
  },
  {
    q: 'Wat als ik aan een installatie werk en niet kan reageren?',
    a: 'Dan beantwoordt de receptionist de vraag (spoed bij kortsluiting, nieuwe klus, bestaande klant, leverancier), plant zo nodig een afspraak in uw agenda en stuurt u een samenvatting per WhatsApp of e-mail. U belt terug als de groepenkast weer dicht is.',
  },
  {
    q: 'Weet de klant dat het AI is?',
    a: 'Ja. Elk gesprek begint met de melding dat de klant met een digitale assistent van uw bedrijf chat. Dat is wettelijk verplicht (artikel 50 van de Europese AI-verordening), dus die melding staat altijd aan.',
    href: '/legal/ai-disclosure/',
    linkLabel: 'Lees de volledige AI-disclosure',
  },
  {
    q: 'Wat als de AI iets verkeerd zegt over mijn tarieven?',
    a: 'Dat kan niet gebeuren. De assistent noemt alleen tarieven die u zelf heeft ingesteld: voorrijkosten, uurtarief, spoedtoeslag, meerprijs voor een laadpaal. Kent hij een prijs niet, dan verzint hij niets en krijgt de klant een terugbelverzoek. Wij testen elke instelling voordat u live gaat.',
  },
  {
    q: 'Wat gebeurt er met de klantgegevens?',
    a: 'Gesprekken en afspraken staan op onze server in Duitsland (Hetzner, Neurenberg). Voor de antwoorden gaan chatberichten naar Anthropic in de VS, onder de EU-standaardcontractbepalingen. Wij tekenen een verwerkersovereenkomst met u en bewaren chatgesprekken 30 dagen, of korter als u dat wilt. Al onze subverwerkers staan in een openbare lijst.',
    href: '/legal/dpa/',
    linkLabel: 'Lees de verwerkersovereenkomst',
  },
  {
    q: 'Is het echt per maand opzegbaar?',
    a: 'Ja. U zegt op met één mail, wanneer u wilt. Er is geen jaarcontract en geen verborgen verlenging. De receptionist werkt tot het einde van de betaalde maand; daarna incasseren wij niets meer. Betaalt u liever 6 of 12 maanden vooruit, dan krijgt u 15% of 20% korting.',
    href: '/legal/voorwaarden/',
    linkLabel: 'Lees de algemene voorwaarden',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]+>/g, ''),
    },
  })),
}
---

<Base
  title="Klanten werven als elektricien: AI-receptionist voor spoed en laadpalen"
  description="AI-receptionist voor elektriciens, per maand opzegbaar. Kent uw spoedtarief en uw meerprijs voor een laadpaal, plant afspraken en beantwoordt klantvragen, dag en nacht."
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div
      class="mx-auto grid max-w-page gap-10 px-gutter md:grid-cols-[1fr_auto] md:items-center md:gap-16"
    >
      <div>
        <h1 class="font-display text-hero text-chalk">
          De <span class="text-(--color-sodium)">Klantenmotor</span> voor elektriciens.
        </h1>
        <p class="mt-6 max-w-2xl text-[1.125rem] text-dim leading-relaxed">
          Een digitale receptionist op uw website en in WhatsApp die uw klant uitlegt wat uw spoedtarief
          bij kortsluiting is, of wat een laadpaal extra kost. Hij beantwoordt vragen dag en nacht, ook in
          het weekend. Afspraken en terugbelverzoeken zitten in hetzelfde abonnement.
        </p>
        <div class="mt-10 btn-row">
          <a href="/demo/" class="btn btn-primary btn-lg"> Probeer de demo </a>
          <a href="/rekentool/" class="btn btn-ghost btn-lg"> Open de rekentool </a>
        </div>
      </div>
      <div class="hidden text-(--color-dim) md:block">
        <Plug class="h-64 w-64 lg:h-72 lg:w-72" />
      </div>
    </div>
    <div class="mx-auto max-w-page px-gutter">
      <ul role="list" class="fact-row mt-10">
        <li><span class="text-(--color-chalk)">AVG + AI Act art. 50</span> <span>AI-melding altijd aan</span></li>
        <li><span class="text-(--color-chalk)">Gehost in de EU</span> <span>Cloudflare · Neon · Hetzner</span></li>
        <li><span class="text-(--color-chalk)">Vlot Nederlands</span> <span>Kent uurtarief en spoedtoeslag</span></li>
      </ul>
      <p class="mt-8 text-small text-dim">
        Per maand opzegbaar · Wij richten alles in · 50% korting eerste maand
      </p>
    </div>
  </section>

  <section class="pb-10 md:pb-16">
    <PhotoBand
      slug="elektriciens"
      alt="Elektricien aan het werk in een schakelkast"
      caption="In de meterkast. Uw receptionist antwoordt wél."
    />
  </section>

  <!-- 1b. Risk-reversal -->
  <RiskReversal />

  <!-- 2. Pijn-stats trio (stone-100) -->
  <section
    class="border-y border-(--color-line) py-8 md:py-10"
    aria-label="Wat een gemiste oproep een elektricien kost"
  >
    <div class="mx-auto max-w-page px-gutter">
      <div class="stat-row">
      {painStats.map((stat) => <Stat value={stat.value} label={stat.caption} />)}
      </div>
    </div>
  </section>

  <!-- 3. Wat Klantkraan doet, als schema: de drie modules zijn de drie uitgangen -->
  <FlowDiagram
    id="modules"
    nodeSub='voor elektriciens'
    t={{
      label: 'Modules',
      heading: 'Wat Klantkraan doet voor elektriciens',
      sub: 'Drie modules voor één maandprijs, gebouwd voor de elektricien met twee tot acht monteurs.',
      steps: features.map((f) => ({ title: f.title, text: f.body })),
    }}
  />

  <!-- 4. ROI snippet (stone-100) -->
  <section class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      
      <h2 class="font-display text-h1 text-chalk">Reken het even na</h2>
      <div
        class="mt-8 frame bg-(--color-panel) p-6 md:p-10"
      >
        <p class="text-h3 text-chalk">
          Mist u 8 oproepen per week à € 375? Dat is <strong class="text-(--color-sodium)"
            >ruim € 51.000 verloren omzet per jaar</strong
          >.
        </p>
        <p class="mt-4 text-body text-dim">
          Klantkraan Chat kost € 299 per maand. Eén spoedklus bij kortsluiting per maand betaalt het
          abonnement. Wat daarna binnenkomt, gaat niet meer naar de concurrent verderop.
        </p>
        <div class="mt-6 btn-row">
          <a href="/rekentool/" class="btn btn-primary btn-lg"> Open de rekentool </a>
          <a href="/prijzen/" class="btn btn-ghost btn-lg"> Bekijk prijzen </a>
        </div>
        <p class="mt-6 text-micro text-dim">
          Bedragen excl. 21% btw. Rekenvoorbeeld met een branchegemiddelde van € 375 per oproep voor
          installatie- en elektrotechnisch werk (bron: Aira / Invoca missed-call benchmarks) en de
          aanname dat ongeveer 1 op 3 gemiste oproepen een betaalde klus had opgeleverd.
        </p>
      </div>
    </div>
  </section>

  <!-- 5. FAQ (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      
      <h2 class="font-display text-h1 text-chalk">Veelgestelde vragen</h2>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          faqs.map((faq) => (
            <details class="group py-4">
              <summary class="block min-h-[2.75rem] cursor-pointer list-none py-1 font-display text-h3 text-chalk marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{faq.q}</span>
                  <Icon
                    name="chevron-down"
                    class="mt-1 h-5 w-5 shrink-0 text-(--color-dim) transition-transform group-open:rotate-180"
                  />
                </span>
              </summary>
              <p class="mt-3 text-body text-dim">{faq.a}</p>
              {faq.href && faq.linkLabel && (
                <p class="mt-3 text-small">
                  <a href={faq.href} class="underline">
                    {faq.linkLabel}
                  </a>
                </p>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Verder lezen: gids + blog voor deze branche -->
  <VerderLezen vertical="elektricien" />

  <!-- 6. Final CTA (blue) -->
  <section class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      <h2 class="font-display text-h1 text-chalk">
        Test hem met een spoedvraag
      </h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        In de live demo ziet u hoe hij een spoedtarief noemt en wat hij doet met een vraag over een
        laadpaal.
      </p>
      <div class="mt-8 btn-row">
        <a href="/demo/" class="btn btn-primary btn-lg"> Probeer de demo </a>
        <a href="/prijzen/" class="btn btn-ghost btn-lg"> Bekijk prijzen </a>
      </div>
    </div>
  </section>


  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Base>
