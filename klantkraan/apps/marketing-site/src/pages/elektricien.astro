---
import Base from '../layouts/Base.astro'
import VerderLezen from '../components/VerderLezen.astro'
import Icon from '../components/Icon.astro'
import Stat from '../components/Stat.astro'
import Plug from '../components/illustrations/Plug.astro'
import RiskReversal from '../components/RiskReversal.astro'
import PhotoBand from '../components/PhotoBand.astro'

// Elektricien landing page. Follows the /loodgieters template structure.
// Trade-specific copy: kortsluiting, groepenkast, EV-laadpunt, stroomstoring.

interface PainStat {
  value: string
  caption: string
}

const painStats: PainStat[] = [
  { value: '34%', caption: 'van uw oproepen na 17:00 wordt niet opgenomen.' },
  { value: '€375', caption: 'gemiddelde waarde per stroomstoring-melding.' },
  { value: '0', caption: 'reviews per klus die u nu niet vraagt.' },
]

interface Feature {
  icon: 'phone' | 'message-square' | 'calendar-check'
  title: string
  body: string
}

const features: Feature[] = [
  {
    icon: 'message-square',
    title: 'Praat over kortsluiting in vakjargon',
    body: 'Beantwoordt klantvragen op uw website en via WhatsApp, in vlot Nederlands, ook na 17:00 en in het weekend. Noemt alleen uw eigen kortsluitings-spoedtarief, uurtarief en weekendtoeslag. Geen prijs die u niet vooraf heeft ingesteld.',
  },
  {
    icon: 'calendar-check',
    title: 'Afspraken direct in uw agenda',
    body: 'Storings- en installatie-afspraken worden rechtstreeks in uw agenda gepland, alleen op momenten die u zelf heeft vrijgegeven. Geen telefoontag, geen heen-en-weer-gemail.',
  },
  {
    icon: 'phone',
    title: 'Leads en terugbelverzoeken op uw telefoon',
    body: 'Stroomstoring na sluitingstijd? De receptionist vangt de melding op en zet haar direct als bericht op uw telefoon, met naam, nummer en de vraag. Geen klant gaat naar de concurrent terwijl u op een andere klus zit.',
  },
]

interface Faq {
  q: string
  a: string
  href?: string
  linkLabel?: string
}

const faqs: Faq[] = [
  {
    q: 'Hoe komt de receptionist op mijn website?',
    a: 'Met één klein scriptje dat wij voor u installeren. U hoeft niets te doen. Het WhatsApp-kanaal koppelen wij in dezelfde done-for-you setup. U houdt uw eigen site, uw eigen nummer en uw eigen huisstijl.',
  },
  {
    q: 'En als ik op een installatie zit en niet kan reageren?',
    a: 'Daar is dit voor gemaakt. De receptionist beantwoordt de vraag (kortsluitings-spoed, nieuwe klus, bestaande klant, leverancier), plant indien gewenst een afspraak in uw agenda en stuurt u een samenvatting per WhatsApp of e-mail. U belt terug wanneer de groepenkast weer dicht zit.',
  },
  {
    q: 'Hoort de klant dat het AI is?',
    a: 'Ja. Elk gesprek opent met de melding dat uw klant met een digitale assistent chat, namens uw bedrijf. Dat is geen marketingkeuze maar een wettelijke verplichting onder artikel 50 van de Europese AI-wet. De disclosure blijft altijd aan staan.',
    href: '/legal/ai-disclosure/',
    linkLabel: 'Lees de volledige AI-disclosure',
  },
  {
    q: 'Wat als de AI iets verkeerd zegt over mijn tarieven?',
    a: 'Dat kan niet gebeuren. De assistent noemt alleen tarieven die u zelf in uw systeem heeft gezet: voorrijkosten, uurtarief, spoedtoeslag, EV-laadpaal-meerprijs. Onbekende prijzen worden niet verzonnen; de klant krijgt dan een terugbelverzoek. Wij testen elke configuratie voor u live gaat.',
  },
  {
    q: 'Wat gebeurt er met de klantgegevens?',
    a: 'Wij hosten in de EU: Hetzner Frankfurt, Neon EU, Cloudflare EU. Wij tekenen een verwerkersovereenkomst (DPA) met u en bewaren chatgesprekken 30 dagen, tenzij u korter wenst. De volledige leverancierslijst staat openbaar in ons sub-processorregister.',
    href: '/legal/dpa/',
    linkLabel: 'Bekijk DPA en privacyverklaring',
  },
  {
    q: 'Per maand opzegbaar, echt waar?',
    a: 'Ja. Geen jaarcontract, geen verborgen verlenging. U zegt op via een mail; opzegtermijn is één maand. Voor wie liever 6 of 12 maanden vooruit betaalt is er korting (15% respectievelijk 20%).',
    href: '/legal/voorwaarden/',
    linkLabel: 'Lees de algemene voorwaarden',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]+>/g, ''),
    },
  })),
}
---

<Base
  title="Elektricien klanten werven: AI-receptionist voor spoed en EV"
  description="AI-receptionist voor elektriciens, per maand opzegbaar. Kent uw spoedtarief en EV-laadpaal-meerprijs, plant afspraken en vangt leads, 24/7."
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div
      class="mx-auto grid max-w-5xl gap-10 px-6 md:grid-cols-[1fr_auto] md:items-center md:gap-16"
    >
      <div>
        <h1 class="font-display text-hero text-chalk">
          De <span class="text-(--color-sodium)">Klantenmotor</span> voor elektriciens.
        </h1>
        <p class="mt-6 max-w-2xl text-h3 text-dim">
          Een digitale receptionist op uw website en WhatsApp die uw klant uitlegt wat een
          kortsluitings-spoedtarief is. Of een EV-laadpaal-meerprijs. Beantwoordt vragen 24/7,
          zeven dagen per week. Afspraken en terugbelverzoeken zitten in hetzelfde abonnement.
        </p>
        <div class="mt-10 btn-row">
          <a
            href="/demo/"
            class="btn btn-primary btn-lg"
          >
            Probeer de demo
          </a>
          <a
            href="/rekentool/"
            class="btn btn-ghost btn-lg"
          >
            Bereken uw ROI
          </a>
        </div>
      </div>
      <div class="hidden text-(--color-sodium) md:block">
        <Plug class="h-64 w-64 lg:h-72 lg:w-72" />
      </div>
    </div>
    <div class="mx-auto max-w-5xl px-6">
      <ul role="list" class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-6">
        <li class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
          <div>
            <p class="text-small font-medium text-chalk">AVG + AI Act art. 50</p>
            <p class="text-small text-dim">Disclosure standaard aan</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
          <div>
            <p class="text-small font-medium text-chalk">Gehost in de EU</p>
            <p class="text-small text-dim">Cloudflare · Neon · Hetzner</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="phone-call" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
          <div>
            <p class="text-small font-medium text-chalk">Vlot Nederlands</p>
            <p class="text-small text-dim">Kent uurtarief + spoedtoeslag</p>
          </div>
        </li>
      </ul>
      <p class="mt-8 text-small text-dim">
        Per maand opzegbaar · Done-for-you setup · 50% korting eerste maand
      </p>
    </div>
  </section>

  <section class="pb-10 md:pb-16">
    <PhotoBand
      slug="elektriciens"
      alt="Elektricien aan het werk in een schakelkast"
      caption="In de meterkast. Uw receptionist antwoordt wél."
    />
  </section>

  <!-- 1b. Risk-reversal -->
  <RiskReversal />

  <!-- 2. Pijn-stats trio (stone-100) -->
  <section
    class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16"
    aria-label="Wat een gemiste oproep een elektricien kost"
  >
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 sm:grid-cols-3">
      {painStats.map((stat) => <Stat value={stat.value} label={stat.caption} />)}
    </div>
  </section>

  <!-- 3. Modules (cream, hairline rows) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">Modules</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">
        Wat Klantkraan doet voor elektriciens.
      </h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        Drie modules. Eén maandprijs. Niet voor de grote installatiebureaus. Voor de elektricien met twee tot acht monteurs.
      </p>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          features.map((feature) => (
            <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
              <Icon name={feature.icon} class="mt-1 h-7 w-7 text-(--color-sodium)" />
              <div>
                <h3 class="font-display text-h3 text-chalk">{feature.title}</h3>
                <p class="mt-2 text-body text-dim">{feature.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. ROI snippet (stone-100) -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">Rekensom</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">
        Reken het even na.
      </h2>
      <div class="mt-8 rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-6 md:p-10">
        <p class="text-h3 text-chalk">
          Mist u 8 oproepen per week à €375? Dat is <strong class="text-(--color-sodium)">ruim €51.000 verloren omzet per jaar</strong>.
        </p>
        <p class="mt-4 text-body text-dim">
          Klantkraan Chat is €299 per maand. Eén kortsluitings-spoed per maand betaalt het
          abonnement. Wat daarna binnenkomt gaat niet meer naar de concurrent verderop.
        </p>
        <div class="mt-6 btn-row">
          <a
            href="/rekentool/"
            class="btn btn-primary btn-lg"
          >
            Open de rekentool
          </a>
          <a
            href="/prijzen/"
            class="btn btn-ghost btn-lg"
          >
            Bekijk de tarieven
          </a>
        </div>
        <p class="mt-6 text-micro text-dim">
          Bedragen excl. 21% BTW. Voorbeeld op basis van branche-gemiddelde €375 per oproep voor
          installatie- en elektrotechnisch werk (bron: Aira / Invoca missed-call benchmarks) en de
          aanname dat ongeveer 1 op 3 gemiste oproepen een betalende klus had opgeleverd (33%
          conversiekans).
        </p>
      </div>
    </div>
  </section>

  <!-- 5. FAQ (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">Vragen</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">
        Veelgestelde vragen.
      </h2>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          faqs.map((faq) => (
            <details class="group py-4">
              <summary class="block min-h-[2.75rem] cursor-pointer list-none py-1 font-display text-h3 text-chalk marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{faq.q}</span>
                  <Icon
                    name="chevron-down"
                    class="mt-1 h-5 w-5 shrink-0 text-(--color-sodium) transition-transform group-open:rotate-180"
                  />
                </span>
              </summary>
              <p class="mt-3 text-body text-dim">{faq.a}</p>
              {faq.href && faq.linkLabel && (
                <p class="mt-3 text-small">
                  <a href={faq.href} class="underline">
                    {faq.linkLabel}
                  </a>
                </p>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Verder lezen: gids + blog voor deze branche -->
  <VerderLezen vertical="elektricien" />

  <!-- 6. Final CTA (blue) -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="font-display text-h1 text-chalk">
        Klaar om geen kortsluitings-spoed meer te missen?
      </h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        Probeer de live demo. U ziet hoe hij uw kortsluitings-spoedtarief noemt en wat hij doet als
        iemand een vraag stelt over een EV-laadpaal.
      </p>
      <div class="mt-8 btn-row">
        <a
          href="/demo/"
          class="btn btn-primary btn-lg"
        >
          Probeer de demo
        </a>
        <a
          href="/prijzen/"
          class="btn btn-ghost btn-lg"
        >
          Bekijk prijzen
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Base>
