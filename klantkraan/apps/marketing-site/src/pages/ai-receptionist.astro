    'noteert wie teruggebeld wil worden. Ook om elf uur \'s avonds.',
  ctaPrimary: 'Start vandaag',
  ctaPrimaryHref: '/aanmelden/',
  ctaGhost: 'Probeer de demo',
  ctaGhostHref: '#demo',
  proof: [
    { label: 'Direct te proberen, geen account' },
    { label: 'Per maand opzegbaar' },
    { label: 'AVG-proof, EU-gehost' },
  ],
  panelAria:
    'Gesprek om 23:47: een klant met een lekkage stelt een vraag, de AI-receptionist plant een afspraak op dinsdag 09:00 en zet een terugbelverzoek klaar voor de eigenaar.',
  threadName: 'Klantkraan',
  threadSub: 'Reageert direct',
  liveTs: 'Vannacht 23:47',
  disclosure: 'U chat met een digitale assistent.',
  customerMsg: 'Ik heb een lekkage onder de gootsteen, kan er morgen iemand komen?',
  recepMsg: 'Vervelend, dat pakken we op. Morgen 09:00 is vrij. Zal ik dat voor u vastzetten?',
  stampStrong: 'INGEPLAND',
  stampDetail: 'di 09:00 · terugbelverzoek klaar voor de eigenaar',
  // The product window around the thread: the owner's view of the same evening.
  // Rows reuse conversations and questions from this page (gesprek, demo.asks).
  window: {
    title: 'klantkraan',
    meta: 'Voorbeeld',
    listLabel: 'Gesprekken',
    rows: [
      { channel: 'WhatsApp', time: '23:47', text: 'Lekkage onder de gootsteen', status: 'Ingepland', active: true },
      { channel: 'Websitechat', time: '22:14', text: 'Cv-ketel doet het niet meer', status: 'Terugbellen' },
      { channel: 'WhatsApp', time: '20:31', text: 'Werken jullie ook in Haarlem?', status: 'Beantwoord' },
      { channel: 'Websitechat', time: '18:05', text: 'Wat kost het vervangen van een kraan?', status: 'Beantwoord' },
    ],
    resultLabel: 'Afspraak',
    fields: [
      { k: 'Klus', v: 'Lekkage onder de gootsteen' },
      { k: 'Wanneer', v: 'di 09:00' },
      { k: 'Via', v: 'WhatsApp, 23:47' },
      { k: 'Daarna', v: 'Terugbelverzoek klaar voor de eigenaar' },
    ],
  },
}

const gesprek = {
  heading: 'Wat de receptionist doet terwijl u aan het werk bent',
  steps: [
    {
      title: 'Beantwoordt de vraag',
      text: 'Met uw diensten, tarieven en werkgebied. Hij noemt alleen prijzen die u heeft ingesteld.',
    },
    {
      title: 'Plant de afspraak',
      text: 'Alleen op tijden die vrij zijn in uw agenda. U ziet de afspraak meteen staan.',
    },
    {
      title: 'Noteert wat niet meteen kan',
      text: 'Naam, nummer en klus. U kiest zelf wie u terugbelt.',
    },
  ],
}

const demo = {
  eyebrow: 'Probeer het zelf',
  heading: 'Stel hem een vraag zoals uw klant dat zou doen',
  sub:
    'Dit is een voorbeeldbedrijf, een installateur. U kunt ook een afspraak plannen. Een ' +
    'account is niet nodig.',
  asksLabel: 'Vraag bijvoorbeeld:',
  asks: [
    'Wat kost het vervangen van een kraan?',
    'Kan er morgenochtend iemand langskomen?',
    'Werken jullie ook in Haarlem?',
  ],
  iframeTitle: 'Live chat met de AI-receptionist van Klantkraan',
  mobileName: 'Van Dijk Installatietechniek',
  mobileTag: 'Digitale assistent · reageert direct',
  mobileHint: 'Chat zoals een klant dat doet. De demo opent op volledig scherm.',
  mobileCta: 'Start de demo',
  trust: 'Voorbeeldbedrijf · uw eigen receptionist kent uw diensten en tarieven',
}

const kosten = {
  heading: 'Wat gemiste oproepen u per maand kosten',
  sub: 'Wie geen antwoord krijgt, belt de volgende in de lijst.',
  ariaLabel: 'Voorbeeldberekening van misgelopen omzet',
  cap: 'Voorbeeld · 40 oproepen per week',
  lines: [
    { k: 'Oproepen per maand', v: '173' },
    { k: 'Gemist (brancheschatting 28%)', v: '48' },
    { k: 'Was een klus geworden (1 op 3)', v: '16' },
    { k: '× waarde per klus', v: '€\u00a0450' },
  ],
  resultK: 'Misgelopen omzet',
  resultV: '± €\u00a07.200/mnd',
  ctaLabel: 'Reken met uw eigen cijfers',
  ctaHref: '/rekentool/',
}

const eerlijk = {
  heading: 'Uw klant weet altijd dat hij met een assistent praat',
  quote: 'U chat met een digitale assistent.',
  bullets: [
    'Met deze zin begint elk gesprek. U kunt hem niet uitzetten.',
    'Sinds 2 augustus 2026 is die melding verplicht onder artikel 50 van de EU AI Act.',
    'Sommige belrobots worden verkocht met de belofte dat niemand het verschil hoort. Daarmee riskeert u een boete.',
  ],
  linkLabel: 'Lees de AI-disclosure',
  linkHref: '/legal/ai-disclosure/',
}

const starten = {
  heading: 'Binnen een week staat hij live',
  steps: [
    {
      title: 'Meld u aan',
      text: 'Dat kost vijf minuten. U betaalt direct via Mollie: de eerste maand €\u00a0149,50, daarna €\u00a0299 per maand, excl. btw.',
    },
    {
      title: 'Wij bouwen uw receptionist',
      text: 'Binnen één werkdag bellen we om uw diensten, tarieven en agenda door te nemen.',
    },
    {
      title: 'Live op uw site en WhatsApp',
      text: 'U test hem zelf en geeft akkoord. Daarna neemt hij elke vraag aan, dag en nacht.',
    },
  ],
  note: 'Per maand opzegbaar, zonder jaarcontract of verborgen verlenging. Opzeggen gaat per mail, zonder opzegtermijn.',
}

const roadmap = {
  heading: 'Wat hij nu doet en wat er nog komt',
  sub:
    'Als volgende stap willen we het papierwerk aanpakken dat u nu \'s avonds aan de keukentafel doet. ' +
    'Dat bouwen we samen met de eerste klanten.',
  nowLabel: 'Nu in het abonnement',
  now: [
    'Beantwoordt vragen op uw site en WhatsApp, dag en nacht',
    'Plant afspraken in uw eigen agenda',
    'Noteert terugbelverzoeken met naam, nummer en klus',
    'Meldt zich in elk gesprek als digitale assistent',
  ],
  laterLabel: 'Nog niet in het abonnement',
  // Plan 2026-11-16: these are sold today as separate automations (/automatiseringen/),
  // so the list no longer says they are unavailable. Honest renders strings only,
  // so the pointer sits in the footnote without a link (see the plan's Deviations).
  laterNote: 'U betaalt er nu niet voor.',
  later: [
    'Offertes die zichzelf opvolgen als de klant niet reageert',
    'Afspraakherinneringen, zodat er niemand voor niets uitrijdt',
    'Reviewverzoeken zodra de klus klaar is',
    'Factuurherinneringen voor wat blijft openstaan',
  ],
  footnote:
    'Wilt u er nu al een? Dan bouwen we die als losse automatisering, voor een vaste prijs ' +
    'vooraf. Wat als eerste in het abonnement komt, hangt af van waar klanten om vragen.',
}

const finalCta = {
  h2a: 'Probeer het eerst',
  h2on: 'zelf.',
  sub:
    'Stel in de demo een vraag zoals een klant dat doet. Bevalt het, meld u dan aan. Binnen één ' +
    'werkdag bellen we om hem voor uw bedrijf in te richten.',
  primary: { label: 'Start vandaag', href: '/aanmelden/' },
  ghosts: [
    { label: 'Probeer de demo', href: '/demo/' },
    { label: 'Plan een kennismaking', href: waLink, external: true },
  ],
  photo: {
    src: '/photos/home-van.jpg',
    srcSm: '/photos/home-van-sm.jpg',
    alt: 'Werkbonnen, een rolmaat en werkhandschoenen op de stoel van een werkbus, in een Nederlandse straat.',
    width: 928,
    height: 1152,
  },
}
---

<Base
  title="AI-receptionist voor uw bedrijf: websitechat & WhatsApp | Klantkraan"
  description="AI-receptionist op uw website en WhatsApp: beantwoordt vragen, plant afspraken en noteert terugbelverzoeken, dag en nacht. Wij richten hem in. Per maand opzegbaar."
  centered={false}
>
  <Hero t={hero} />
  <DemoSection t={demo} />
  <FlowDiagram t={gesprek} />
  <CostReceipt t={kosten} />
  <Honest eerlijk={eerlijk} roadmap={roadmap} />
  <HowItWorks t={starten} />
  <FinalCta t={finalCta} />
</Base>
