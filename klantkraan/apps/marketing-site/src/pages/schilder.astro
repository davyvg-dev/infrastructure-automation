---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import Stat from '../components/Stat.astro'
import PaintRoller from '../components/illustrations/PaintRoller.astro'
import RiskReversal from '../components/RiskReversal.astro'

// Schilder landing page. Follows the /loodgieters template structure.
// Trade-specific copy: offerteaanvragen, lente-piek, m²-tarief, kleurproef.

interface PainStat {
  value: string
  caption: string
}

const painStats: PainStat[] = [
  { value: '37%', caption: 'van uw offerteaanvragen komt binnen na 17:00 uur.' },
  { value: '€2.500', caption: 'gemiddelde waarde per binnen-schilderklus huis.' },
  { value: '3×', caption: 'meer aanvragen in maart–mei (lente-piek).' },
]

interface Feature {
  icon: 'phone' | 'message-square' | 'calendar-check'
  title: string
  body: string
}

const features: Feature[] = [
  {
    icon: 'message-square',
    title: 'Kent uw m²-tarief van buiten',
    body: 'Beantwoordt klantvragen op uw website en via WhatsApp, in vlot Nederlands, ook na 17:00. Noemt alleen uw eigen m²-tarief, kleurproef-meerprijs en spuitwerk-toeslag. Niets verzonnen, niets benaderend.',
  },
  {
    icon: 'calendar-check',
    title: 'Afspraken direct in uw agenda',
    body: 'Opname- en offerte-afspraken worden rechtstreeks in uw agenda gepland — alleen op momenten die u zelf heeft vrijgegeven. Geen telefoontag, geen heen-en-weer-gemail.',
  },
  {
    icon: 'phone',
    title: 'Leads en terugbelverzoeken op uw telefoon',
    body: 'Vraagt een particulier na werktijd een offerte aan? De receptionist vangt de aanvraag op en zet haar direct als bericht op uw telefoon, met naam, nummer en de vraag. Geen prospect raakt verloren terwijl u op de stelling staat.',
  },
]

interface Faq {
  q: string
  a: string
  href?: string
  linkLabel?: string
}

const faqs: Faq[] = [
  {
    q: 'Hoe komt de receptionist op mijn website?',
    a: 'Met één klein scriptje dat wij voor u installeren — u hoeft niets te doen. Het WhatsApp-kanaal koppelen wij in dezelfde done-for-you setup. U houdt uw eigen site, uw eigen nummer en uw eigen huisstijl.',
  },
  {
    q: 'En als ik op een stelling sta en niet kan reageren?',
    a: 'Daar is dit voor gemaakt. De receptionist beantwoordt de vraag (nieuwe offerteaanvraag, planning-vraag, leverancier, klacht), kwalificeert de aanvraag op postcode en project-omvang, en plant een afspraak in uw agenda. U krijgt een samenvatting per WhatsApp of e-mail. Terugbellen kan in de pauze of na werktijd.',
  },
  {
    q: 'Wat als vijf klanten tegelijk een aanvraag doen in het lente-seizoen?',
    a: 'De receptionist handelt gesprekken parallel af. Geen wachtrij. Tien klanten kunnen tegelijk chatten of appen over een buiten-schilderklus, alle tien krijgen direct antwoord. Spoed (water- of schimmelschade) wordt herkend en gescheiden van planning-aanvragen.',
  },
  {
    q: 'Hoort de klant dat het AI is?',
    a: 'Ja. Elk gesprek opent met de melding dat uw klant met een digitale assistent chat, namens uw bedrijf. Geen marketingkeuze maar een wettelijke verplichting onder de Europese AI-wet (artikel 50). De disclosure blijft altijd aan staan.',
    href: '/legal/ai-disclosure',
    linkLabel: 'Lees de volledige AI-disclosure',
  },
  {
    q: 'Wat als de AI iets verkeerd zegt over mijn tarieven?',
    a: 'Dat kan niet gebeuren. De assistent noemt alleen tarieven die u zelf in uw systeem heeft gezet: voorrijkosten, m²-tarief binnen en buiten, spuitwerk-toeslag, kleurproef. Onbekende prijzen worden niet verzonnen; de klant krijgt dan een terugbelverzoek. Wij testen elke configuratie voor u live gaat.',
  },
  {
    q: 'Wat gebeurt er met de klantgegevens?',
    a: 'Wij hosten in de EU: Hetzner Frankfurt, Neon EU, Cloudflare EU. Wij tekenen een verwerkersovereenkomst (DPA) met u en bewaren chatgesprekken 30 dagen, tenzij u korter wenst. De volledige leverancierslijst staat openbaar in ons sub-processorregister.',
    href: '/legal/dpa',
    linkLabel: 'Bekijk DPA en privacyverklaring',
  },
  {
    q: 'Per maand opzegbaar, echt waar?',
    a: 'Ja. Geen jaarcontract, geen verborgen verlenging. U zegt op via een mail; opzegtermijn is één maand. Voor wie liever 6 of 12 maanden vooruit betaalt is er korting (15% respectievelijk 20%).',
    href: '/legal/voorwaarden',
    linkLabel: 'Lees de algemene voorwaarden',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
}
---

<Base
  title="Schilder klanten werven: Klantkraan AI-receptionist voor offertes en seizoenswerk"
  description="Nederlandstalige digitale receptionist via websitechat en WhatsApp die uw m²-tarief, kleurproef-meerprijs en voorrijkosten kent. Vangt lente-piek aanvragen en avond-vragen terwijl u doorwerkt. Per maand opzegbaar, EU-gehost."
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div
      class="mx-auto grid max-w-5xl gap-10 px-6 md:grid-cols-[1fr_auto] md:items-center md:gap-16"
    >
      <div>
        <h1 class="font-display text-hero text-(--color-kraan-ink)">
          De <span class="text-(--color-kraan-rust)">Klantenmotor</span> voor schilders.
        </h1>
        <p class="mt-6 max-w-2xl text-h3 text-(--color-kraan-stone-700)">
          Een digitale receptionist op uw website en WhatsApp die offerteaanvragen,
          planning-vragen en leveranciers uit elkaar houdt. Vangt de avond-aanvragen die u nu mist
          als u op de stelling staat. En de lente-piek zonder dat u extra mensen aanneemt.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/demo"
            class="inline-block rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
          >
            Plan een demo
          </a>
          <a
            href="/rekentool"
            class="inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
          >
            Bereken uw ROI
          </a>
        </div>
      </div>
      <div class="hidden text-(--color-kraan-blue) md:block">
        <PaintRoller class="h-64 w-64 lg:h-72 lg:w-72" />
      </div>
    </div>
    <div class="mx-auto max-w-5xl px-6">
      <dl class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-6">
        <div class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
          <div>
            <dt class="text-small font-medium text-(--color-kraan-ink)">AVG + AI Act art. 50</dt>
            <dd class="text-small text-(--color-kraan-stone-500)">Disclosure standaard aan</dd>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
          <div>
            <dt class="text-small font-medium text-(--color-kraan-ink)">Gehost in de EU</dt>
            <dd class="text-small text-(--color-kraan-stone-500)">Cloudflare · Neon · Hetzner</dd>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Icon name="phone-call" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
          <div>
            <dt class="text-small font-medium text-(--color-kraan-ink)">Vlot Nederlands</dt>
            <dd class="text-small text-(--color-kraan-stone-500)">Kent m²-tarief + kleurproef</dd>
          </div>
        </div>
      </dl>
      <p class="mt-8 text-small text-(--color-kraan-stone-500)">
        Per maand opzegbaar · Done-for-you setup · 50% korting eerste maand
      </p>
    </div>
  </section>

  <!-- 1b. Risk-reversal -->
  <RiskReversal />

  <!-- 2. Pijn-stats trio (stone-100) -->
  <section
    class="bg-(--color-kraan-stone-100) py-10 md:py-16"
    aria-label="Wat een gemiste offerteaanvraag een schilder kost"
  >
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 sm:grid-cols-3">
      {painStats.map((stat) => <Stat value={stat.value} label={stat.caption} />)}
    </div>
  </section>

  <!-- 3. Modules (cream, hairline rows) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">Modules</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">
        Wat Klantkraan doet voor schilders.
      </h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-kraan-stone-700)">
        Drie modules. Eén maandprijs. Gemaakt voor de schilder die in de lente-piek geen avondtelefoontjes meer wil missen.
      </p>
      <div class="mt-10 divide-y divide-(--color-kraan-stone-300) border-y border-(--color-kraan-stone-300)">
        {
          features.map((feature) => (
            <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
              <Icon name={feature.icon} class="mt-1 h-7 w-7 text-(--color-kraan-blue)" />
              <div>
                <h3 class="font-display text-h3 text-(--color-kraan-ink)">{feature.title}</h3>
                <p class="mt-2 text-body text-(--color-kraan-stone-700)">{feature.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. ROI snippet (stone-100) -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">Rekensom</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">
        Reken het even na.
      </h2>
      <div class="mt-8 rounded-(--radius-card) border border-(--color-kraan-stone-300) bg-white p-6 md:p-10">
        <p class="text-h3 text-(--color-kraan-ink)">
          Mist u 5 offerteaanvragen per maand à €2.500? Dat is <strong class="text-(--color-kraan-rust)">circa €50.000 verloren omzet per jaar</strong>.
        </p>
        <p class="mt-4 text-body text-(--color-kraan-stone-700)">
          Klantkraan Chat is €299 per maand. Eén lente-klus die u nu mist tijdens de avond-bellers betaalt het hele
          abonnement. De rest gaat in uw zak in plaats van die van de concurrent.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/rekentool"
            class="inline-block rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
          >
            Open de rekentool
          </a>
          <a
            href="/prijzen"
            class="inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
          >
            Bekijk de tarieven
          </a>
        </div>
        <p class="mt-6 text-micro text-(--color-kraan-stone-500)">
          Bedragen excl. 21% BTW. Voorbeeld op basis van branche-gemiddelde €2.500 per
          binnen-schilderklus huis (bron: branchecijfers OnderhoudNL) en de aanname dat ongeveer
          1 op 3 gemiste aanvragen een betalende klus had opgeleverd (33% conversiekans).
        </p>
      </div>
    </div>
  </section>

  <!-- 5. FAQ (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">Vragen</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">
        Veelgestelde vragen.
      </h2>
      <div class="mt-10 divide-y divide-(--color-kraan-stone-300) border-y border-(--color-kraan-stone-300)">
        {
          faqs.map((faq) => (
            <details class="group py-4">
              <summary class="block min-h-[2.75rem] cursor-pointer list-none py-1 font-display text-h3 text-(--color-kraan-ink) marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{faq.q}</span>
                  <Icon
                    name="chevron-down"
                    class="mt-1 h-5 w-5 shrink-0 text-(--color-kraan-blue) transition-transform group-open:rotate-180"
                  />
                </span>
              </summary>
              <p class="mt-3 text-body text-(--color-kraan-stone-700)">{faq.a}</p>
              {faq.href && faq.linkLabel && (
                <p class="mt-3 text-small">
                  <a href={faq.href} class="underline">
                    {faq.linkLabel}
                  </a>
                </p>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 5b. Wij werken ook in: programmatic city link block -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16" aria-label="Schilders per stad">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">
        Per stad
      </p>
      <h2 class="mt-3 font-display text-h2 text-(--color-kraan-ink)">
        Wij ondersteunen schilders in:
      </h2>
      <ul class="mt-6 grid max-w-3xl grid-cols-2 gap-2 text-body sm:grid-cols-3 md:grid-cols-4">
        <li>
          <a href="/amsterdam/schilder" class="text-(--color-kraan-blue) underline">Amsterdam</a>
        </li>
        <li>
          <a href="/rotterdam/schilder" class="text-(--color-kraan-blue) underline">Rotterdam</a>
        </li>
        <li>
          <a href="/den-haag/schilder" class="text-(--color-kraan-blue) underline">Den Haag</a>
        </li>
        <li>
          <a href="/utrecht/schilder" class="text-(--color-kraan-blue) underline">Utrecht</a>
        </li>
      </ul>
    </div>
  </section>

  <!-- 6. Final CTA (blue) -->
  <section class="bg-(--color-kraan-blue) py-10 md:py-16 text-white">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="font-display text-h1 text-white">
        Klaar voor het lente-seizoen?
      </h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-kraan-stone-100)">
        Plan een live demo. U ziet hoe hij een m²-vraag en een kleurproef-vraag uit elkaar houdt
        en wat hij doet als iemand een vraag stelt over spuitwerk.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/demo"
          class="inline-block rounded-(--radius-button) bg-white px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
        >
          Plan een demo
        </a>
        <a
          href="/prijzen"
          class="inline-block rounded-(--radius-button) border border-white px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
        >
          Bekijk prijzen
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Base>
