---
import Base from '../layouts/Base.astro'
import FlowDiagram from '../components/diagrams/FlowDiagram.astro'
import VerderLezen from '../components/VerderLezen.astro'
import Icon from '../components/Icon.astro'
import Stat from '../components/Stat.astro'
import PaintRoller from '../components/illustrations/PaintRoller.astro'
import RiskReversal from '../components/RiskReversal.astro'
import PhotoBand from '../components/PhotoBand.astro'

// Schilder landing page. Follows the /loodgieters template structure.
// Trade-specific copy: offerteaanvragen, lente-piek, m²-tarief, kleurproef.

interface PainStat {
  value: string
  caption: string
}

const painStats: PainStat[] = [
  { value: '37%', caption: 'van uw offerteaanvragen komt binnen na 17:00.' },
  { value: '€\u00a02.500', caption: 'gemiddelde waarde van een binnenschilderklus in een woning.' },
  { value: '3×', caption: 'meer aanvragen van maart tot en met mei.' },
]

interface Feature {
  icon: 'phone' | 'message-square' | 'calendar-check'
  title: string
  body: string
}

const features: Feature[] = [
  {
    icon: 'message-square',
    title: 'Kent uw m²-tarief van buiten',
    body: 'Beantwoordt klantvragen op uw website en in WhatsApp, in vlot Nederlands, ook na 17:00. Noemt alleen uw eigen m²-tarief, meerprijs voor een kleurproef en toeslag voor spuitwerk.',
  },
  {
    icon: 'calendar-check',
    title: 'Afspraken direct in uw agenda',
    body: 'De receptionist plant opname- en offerteafspraken rechtstreeks in uw agenda, alleen op momenten die u zelf heeft vrijgegeven. U belt en mailt niet meer heen en weer.',
  },
  {
    icon: 'phone',
    title: 'Aanvragen en terugbelverzoeken op uw telefoon',
    body: 'Vraagt een particulier na werktijd een offerte aan, dan staat de aanvraag direct als bericht op uw telefoon, met naam, nummer en de vraag. Geen aanvraag raakt zoek terwijl u op de stelling staat.',
  },
]

interface Faq {
  q: string
  a: string
  href?: string
  linkLabel?: string
}

const faqs: Faq[] = [
  {
    q: 'Hoe komt de receptionist op mijn website?',
    a: 'Wij plaatsen één klein script op uw website en koppelen uw WhatsApp. U hoeft zelf niets te doen. U houdt uw eigen site, nummer en huisstijl.',
  },
  {
    q: 'Wat als ik op de stelling sta en niet kan reageren?',
    a: 'Dan beantwoordt de receptionist de vraag (nieuwe offerteaanvraag, planning, leverancier, klacht), beoordeelt de aanvraag op postcode en omvang en plant een afspraak in uw agenda. U krijgt een samenvatting per WhatsApp of e-mail en belt terug in de pauze of na werktijd.',
  },
  {
    q: 'Wat als in de lente vijf klanten tegelijk een aanvraag doen?',
    a: 'De receptionist voert gesprekken tegelijk, zonder wachtrij. Chatten of appen tien klanten tegelijk over een buitenschilderklus, dan krijgen ze alle tien direct antwoord. Spoed (water- of schimmelschade) herkent hij en houdt hij apart van vragen over de planning.',
  },
  {
    q: 'Weet de klant dat het AI is?',
    a: 'Ja. Elk gesprek begint met de melding dat de klant met een digitale assistent van uw bedrijf chat. Dat is wettelijk verplicht (artikel 50 van de Europese AI-verordening), dus die melding staat altijd aan.',
    href: '/legal/ai-disclosure/',
    linkLabel: 'Lees de volledige AI-disclosure',
  },
  {
    q: 'Wat als de AI iets verkeerd zegt over mijn tarieven?',
    a: 'Dat kan niet gebeuren. De assistent noemt alleen tarieven die u zelf heeft ingesteld: voorrijkosten, m²-tarief binnen en buiten, toeslag voor spuitwerk, kleurproef. Kent hij een prijs niet, dan verzint hij niets en krijgt de klant een terugbelverzoek. Wij testen elke instelling voordat u live gaat.',
  },
  {
    q: 'Wat gebeurt er met de klantgegevens?',
    a: 'Wij hosten in de EU: Hetzner Frankfurt, Neon EU en Cloudflare EU. Wij tekenen een verwerkersovereenkomst met u en bewaren chatgesprekken 30 dagen, of korter als u dat wilt. Al onze subverwerkers staan in een openbare lijst.',
    href: '/legal/dpa/',
    linkLabel: 'Lees de verwerkersovereenkomst',
  },
  {
    q: 'Is het echt per maand opzegbaar?',
    a: 'Ja. U zegt op met één mail, wanneer u wilt. Er is geen jaarcontract en geen verborgen verlenging. De receptionist werkt tot het einde van de betaalde maand; daarna incasseren wij niets meer. Betaalt u liever 6 of 12 maanden vooruit, dan krijgt u 15% of 20% korting.',
    href: '/legal/voorwaarden/',
    linkLabel: 'Lees de algemene voorwaarden',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
}
---

<Base
  title="Klanten werven als schilder: AI-receptionist voor offertes"
  description="AI-receptionist voor schilders, per maand opzegbaar. Kent uw m²-tarief en meerprijs voor een kleurproef, vangt de aanvragen in de lentepiek op en plant afspraken, dag en nacht."
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div
      class="mx-auto grid max-w-page gap-10 px-gutter md:grid-cols-[1fr_auto] md:items-center md:gap-16"
    >
      <div>
        <h1 class="font-display text-hero text-chalk">
          De <span class="text-(--color-sodium)">Klantenmotor</span> voor schilders.
        </h1>
        <p class="mt-6 max-w-2xl text-[1.125rem] text-dim leading-relaxed">
          Een digitale receptionist op uw website en in WhatsApp die offerteaanvragen, vragen over de
          planning en leveranciers uit elkaar houdt. Hij vangt de avondaanvragen op die u nu mist als u
          op de stelling staat, en de lentepiek zonder dat u extra mensen aanneemt.
        </p>
        <div class="mt-10 btn-row">
          <a href="/demo/" class="btn btn-primary btn-lg"> Probeer de demo </a>
          <a href="/rekentool/" class="btn btn-ghost btn-lg"> Open de rekentool </a>
        </div>
      </div>
      <div class="hidden text-(--color-dim) md:block">
        <PaintRoller class="h-64 w-64 lg:h-72 lg:w-72" />
      </div>
    </div>
    <div class="mx-auto max-w-page px-gutter">
      <ul role="list" class="fact-row mt-10">
        <li><span class="text-(--color-chalk)">AVG + AI Act art. 50</span> <span>AI-melding altijd aan</span></li>
        <li><span class="text-(--color-chalk)">Gehost in de EU</span> <span>Cloudflare · Neon · Hetzner</span></li>
        <li><span class="text-(--color-chalk)">Vlot Nederlands</span> <span>Kent m²-tarief en kleurproef</span></li>
      </ul>
      <p class="mt-8 text-small text-dim">
        Per maand opzegbaar · Wij richten alles in · 50% korting eerste maand
      </p>
    </div>
  </section>

  <section class="pb-10 md:pb-16">
    <PhotoBand
      slug="schilders"
      alt="Schilder op een trap rolt een muur"
      caption="Boven op de ladder. Uw receptionist antwoordt wél."
    />
  </section>

  <!-- 1b. Risk-reversal -->
  <RiskReversal />

  <!-- 2. Pijn-stats trio (stone-100) -->
  <section
    class="border-y border-(--color-line) py-8 md:py-10"
    aria-label="Wat een gemiste offerteaanvraag een schilder kost"
  >
    <div class="mx-auto max-w-page px-gutter">
      <div class="stat-row">
      {painStats.map((stat) => <Stat value={stat.value} label={stat.caption} />)}
      </div>
    </div>
  </section>

  <!-- 3. Wat Klantkraan doet, als schema: de drie modules zijn de drie uitgangen -->
  <FlowDiagram
    id="modules"
    nodeSub='voor schilders'
    t={{
      label: 'Modules',
      heading: 'Wat Klantkraan doet voor schilders',
      sub: 'Drie modules voor één maandprijs, gemaakt voor de schilder die in de lentepiek geen avondaanvraag meer wil missen.',
      steps: features.map((f) => ({ title: f.title, text: f.body })),
    }}
  />

  <!-- 4. ROI snippet (stone-100) -->
  <section class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      
      <h2 class="font-display text-h1 text-chalk">Reken het even na</h2>
      <div
        class="mt-8 frame bg-(--color-panel) p-6 md:p-10"
      >
        <p class="text-h3 text-chalk">
          Mist u 5 offerteaanvragen per maand à € 2.500? Dat is <strong class="text-(--color-sodium)"
            >circa € 50.000 verloren omzet per jaar</strong
          >.
        </p>
        <p class="mt-4 text-body text-dim">
          Klantkraan Chat kost € 299 per maand. Eén lenteklus die u nu 's avonds misloopt, betaalt
          het hele abonnement. De rest gaat in uw zak in plaats van in die van de concurrent.
        </p>
        <div class="mt-6 btn-row">
          <a href="/rekentool/" class="btn btn-primary btn-lg"> Open de rekentool </a>
          <a href="/prijzen/" class="btn btn-ghost btn-lg"> Bekijk prijzen </a>
        </div>
        <p class="mt-6 text-micro text-dim">
          Bedragen excl. 21% btw. Rekenvoorbeeld met een branchegemiddelde van € 2.500 per
          binnenschilderklus in een woning (bron: branchecijfers OnderhoudNL) en de aanname dat ongeveer 1
          op 3 gemiste aanvragen een betaalde klus had opgeleverd.
        </p>
      </div>
    </div>
  </section>

  <!-- 5. FAQ (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      
      <h2 class="font-display text-h1 text-chalk">Veelgestelde vragen</h2>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          faqs.map((faq) => (
            <details class="group py-4">
              <summary class="block min-h-[2.75rem] cursor-pointer list-none py-1 font-display text-h3 text-chalk marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{faq.q}</span>
                  <Icon
                    name="chevron-down"
                    class="mt-1 h-5 w-5 shrink-0 text-(--color-dim) transition-transform group-open:rotate-180"
                  />
                </span>
              </summary>
              <p class="mt-3 text-body text-dim">{faq.a}</p>
              {faq.href && faq.linkLabel && (
                <p class="mt-3 text-small">
                  <a href={faq.href} class="underline">
                    {faq.linkLabel}
                  </a>
                </p>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 5b. Wij werken ook in: programmatic city link block -->
  <section
    class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16"
    aria-label="Schilders per stad"
  >
    <div class="mx-auto max-w-page px-gutter">
      <p class="eyebrow">Per stad</p>
      <h2 class="mt-3 font-display text-h2 text-chalk">Lees verder voor uw stad:</h2>
      <ul class="mt-6 grid max-w-3xl grid-cols-2 gap-2 text-body sm:grid-cols-3 md:grid-cols-4">
        <li>
          <a href="/amsterdam/schilder/" class="block py-2 text-(--color-sodium) underline"
            >Amsterdam</a
          >
        </li>
        <li>
          <a href="/rotterdam/schilder/" class="block py-2 text-(--color-sodium) underline"
            >Rotterdam</a
          >
        </li>
        <li>
          <a href="/den-haag/schilder/" class="block py-2 text-(--color-sodium) underline"
            >Den Haag</a
          >
        </li>
        <li>
          <a href="/utrecht/schilder/" class="block py-2 text-(--color-sodium) underline">Utrecht</a
          >
        </li>
      </ul>
    </div>
  </section>

  <!-- Verder lezen: gids + blog voor deze branche -->
  <VerderLezen vertical="schilder" />

  <!-- 6. Final CTA (blue) -->
  <section class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      <h2 class="font-display text-h1 text-chalk">Test hem vóór de lentepiek</h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        In de live demo ziet u hoe hij een vraag over de m²-prijs en een over een kleurproef uit
        elkaar houdt, en wat hij doet met een vraag over spuitwerk.
      </p>
      <div class="mt-8 btn-row">
        <a href="/demo/" class="btn btn-primary btn-lg"> Probeer de demo </a>
        <a href="/prijzen/" class="btn btn-ghost btn-lg"> Bekijk prijzen </a>
      </div>
    </div>
  </section>


  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Base>
