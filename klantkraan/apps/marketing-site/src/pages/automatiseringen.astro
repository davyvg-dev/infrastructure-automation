---
/**
 * /automatiseringen/: the work after the job, built to order (plan
 * 2026-11-16-homepage-four-services). Dark site, "u" voice.
 * Price path: free scan, then a fixed price up front (from € 1.250 one-time),
 * then management (from € 350 a month). The Offerte-opvolger is the small start.
 * The follow-up drawing shows only what magnets.ts says: reminders on day 3 and
 * day 7 that stop when the client answers.
 */
import Base from '../layouts/Base.astro'
import FollowUpDiagram from '../components/diagrams/FollowUpDiagram.astro'
import MiniOfferCard from '../components/MiniOfferCard.astro'
import { waLink } from '../data/contact'
import { AUTOMATION_BEHEER_FROM, AUTOMATION_BUILD_FROM, eur, serviceByArea } from '../data/services'

const s = serviceByArea.automations
const opvolger = s.small

const examples = [
  {
    title: 'Offertes opvolgen',
    text: 'Na een paar dagen een nette herinnering, die stopt zodra de klant antwoordt.',
  },
  {
    title: 'Afspraakherinneringen',
    text: 'De klant krijgt vooraf een herinnering, zodat er niemand voor niets uitrijdt.',
  },
  {
    title: 'Reviewverzoeken',
    text: 'Een verzoek om een review op het moment dat de klus net klaar is.',
  },
  {
    title: 'Factuurherinneringen',
    text: 'Een herinnering voor wat blijft openstaan, zodat u niet zelf hoeft na te bellen.',
  },
  {
    title: 'Koppelingen tussen uw systemen',
    text: 'Wat u nu overtypt van het ene programma naar het andere, gaat vanzelf.',
  },
]

const steps = [
  {
    label: 'Stap 1',
    title: 'Gratis scan',
    text: s.free.next,
    price: 'Gratis',
    note: '',
  },
  {
    label: 'Stap 2',
    title: 'Vaste prijs vooraf',
    text: 'U weet wat het kost voordat we beginnen. Daarna bouwen we het op maat.',
    price: `vanaf ${eur(AUTOMATION_BUILD_FROM)} eenmalig`,
    note: 'excl. btw',
  },
  {
    label: 'Stap 3',
    title: 'Beheer',
    text: 'Wij houden het draaiend.',
    price: `vanaf ${eur(AUTOMATION_BEHEER_FROM)} per maand`,
    note: 'excl. btw',
  },
]
---

<Base
  title="Automatiseringen: het werk na de klus loopt vanzelf | Klantkraan"
  description="Offertes die zichzelf opvolgen, afspraak- en factuurherinneringen, reviewverzoeken en koppelingen tussen uw systemen. Eerst een gratis scan, daarna een vaste prijs vooraf."
  centered={false}
  offerArea="automations"
>
  <section class="pt-16 pb-12 md:pt-24 md:pb-16" aria-labelledby="au-h">
    <div class="mx-auto max-w-page px-gutter">
      <p class="eyebrow">{s.label}</p>
      <h1 id="au-h" class="mt-3 max-w-[18em] font-display text-hero text-balance text-(--color-chalk)">
        Het werk na de klus, dat loopt vanzelf
      </h1>
      <p class="mt-6 max-w-2xl text-body text-(--color-chalk-2) md:text-[1.125rem]">
        Een offerte die niemand opvolgt, een herinnering die niemand stuurt, een factuur die blijft
        openstaan. Dat werk kan zichzelf doen. Wij bouwen het op maat, voor een vaste prijs vooraf.
      </p>
      <div class="mt-8 btn-row">
        <a href={s.free.href} class="btn btn-primary btn-lg">{s.free.button}</a>
        <a href={waLink} class="btn btn-ghost btn-lg" target="_blank" rel="noopener">Plan een kennismaking</a>
      </div>
    </div>
  </section>

  <section class="border-y border-(--color-line) bg-(--color-panel) py-12 md:py-20" aria-labelledby="au-schema-h">
    <div class="svc-schema mx-auto max-w-page px-gutter">
      <div>
        <p class="eyebrow">Zo werkt de {opvolger.name}</p>
        <h2 id="au-schema-h" class="mt-3 text-h2 text-balance text-(--color-chalk)">
          Zo volgt een offerte zichzelf op.
        </h2>
        <p class="mt-4 text-body text-(--color-chalk-2)">{opvolger.delivers}</p>
      </div>
      <div class="svc-schema-drawing">
        <FollowUpDiagram />
      </div>
    </div>
  </section>

  <section class="py-12 md:py-20" aria-labelledby="au-bv-h">
    <div class="mx-auto max-w-page px-gutter">
      <p class="eyebrow">Bijvoorbeeld</p>
      <h2 id="au-bv-h" class="mt-3 text-h2 text-balance text-(--color-chalk)">Wat we voor u kunnen bouwen</h2>
      <ul role="list" class="grid-rule mt-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          examples.map((e) => (
            <li class="p-6 md:p-8">
              <h3 class="text-h3 text-(--color-chalk)">{e.title}</h3>
              <p class="mt-2 text-body text-(--color-dim)">{e.text}</p>
            </li>
          ))
        }
        <li class="au-other flex flex-col p-6 md:p-8">
          <h3 class="text-h3 text-(--color-chalk)">Iets anders?</h3>
          <p class="mt-2 text-body text-(--color-dim)">De gratis scan laat zien wat bij u loont.</p>
          <a href={s.free.href} class="au-other-link">{s.free.button}{'\u00a0'}<span aria-hidden="true">→</span></a>
        </li>
      </ul>
      <p class="mt-6 text-small text-(--color-dim)">Elk van deze bouwen we op maat, voor uw bedrijf.</p>
    </div>
  </section>

  <section class="border-y border-(--color-line) bg-(--color-panel) py-12 md:py-20" aria-labelledby="au-prijs-h">
    <div class="mx-auto max-w-page px-gutter">
      <p class="eyebrow">Zo werkt de prijs</p>
      <h2 id="au-prijs-h" class="mt-3 text-h2 text-balance text-(--color-chalk)">
        Eerst gratis kijken, dan een vaste prijs.
      </h2>
      <ol role="list" class="grid-rule mt-8 md:grid-cols-3">
        {
          steps.map((st) => (
            <li class="au-step" data-price>
              <p class="font-mono text-micro text-(--color-dim)">{st.label}</p>
              <h3 class="mt-3 text-h3 text-(--color-chalk)">{st.title}</h3>
              <p class="mt-2 text-body text-(--color-dim)">{st.text}</p>
              <p class="au-price">
                <span class="au-amount">{st.price}</span>
                {st.note && <span class="au-note">{st.note}</span>}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="py-12 md:py-20" aria-labelledby="au-klein-h">
    <div class="mx-auto grid max-w-page gap-8 px-gutter md:grid-cols-2 md:items-start md:gap-14">
      <div>
        <p class="eyebrow">Klein beginnen</p>
        <h2 id="au-klein-h" class="mt-3 text-h2 text-balance text-(--color-chalk)">
          Eerst één ding laten lopen?
        </h2>
        <p class="mt-4 text-body text-(--color-chalk-2)">
          Begin met de offertes. Bevalt het, dan bouwen we daarna verder.
        </p>
      </div>
      <MiniOfferCard area="automations" level="h2" />
    </div>
  </section>
</Base>

<style>
  .au-step {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: var(--color-panel);
  }
  @media (min-width: 768px) {
    .au-step {
      padding: 2rem;
    }
  }
  .au-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
    margin: auto 0 0;
    padding-top: 1.25rem;
  }
  .au-amount {
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--color-chalk);
  }
  .au-note {
    font-size: var(--text-small);
    color: var(--color-dim);
  }
  .au-other {
    background: var(--color-panel);
  }
  /* 44px tap target; the negative margin keeps the text where the spacing puts it. */
  .au-other-link {
    align-self: flex-start;
    margin: 0.25rem 0 -0.75rem;
    padding: 0.75rem 0;
    font-size: var(--text-small);
    font-weight: 550;
    color: var(--color-sodium);
    text-decoration: none;
  }
  .au-other-link:hover {
    text-decoration: underline;
  }
  /* Copy beside the drawing from 1024; the frame stays close to the drawing's size. */
  .svc-schema {
    display: grid;
    gap: 2.5rem;
  }
  .svc-schema-drawing {
    width: 100%;
    max-width: 32rem;
  }
  @media (min-width: 1024px) {
    .svc-schema {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 3.5rem;
    }
    .svc-schema-drawing {
      justify-self: end;
    }
  }
</style>
