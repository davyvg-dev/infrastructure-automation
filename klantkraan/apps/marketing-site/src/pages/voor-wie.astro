---
import Base from '../layouts/Base.astro'
import { branches } from '../data/branches'
import TapValve from '../components/illustrations/TapValve.astro'
import StormCloud from '../components/illustrations/StormCloud.astro'
import PaintRoller from '../components/illustrations/PaintRoller.astro'
import HardHat from '../components/illustrations/HardHat.astro'
import Dumbbell from '../components/illustrations/Dumbbell.astro'
import Plug from '../components/illustrations/Plug.astro'
import Radiator from '../components/illustrations/Radiator.astro'

// Map illustration name to component for branches that have one.
const illustrations = {
  TapValve,
  StormCloud,
  PaintRoller,
  HardHat,
  Dumbbell,
  Plug,
  Radiator,
  RingingPhone: null, // Reserved for the homepage; not used on cards.
}
---

<Base
  title="Voor wie? | Klantkraan voor elke branche"
  description="Klantkraan ondersteunt loodgieters, dakdekkers, schilders, installateurs, elektriciens en aannemers. Kies uw branche voor een AI-receptionist op maat."
  centered={false}
>
  <!-- Hero -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      <h1 class="font-display text-hero text-(--color-chalk)">Wat voor bedrijf runt u?</h1>
      <p class="mt-6 max-w-2xl text-[1.125rem] text-(--color-dim) leading-relaxed">
        Klantkraan kent de termen van uw branche. Proefles en abonnement voor de sportschool.
        Voorrijkosten en spoedtoeslag voor de loodgieter. M²-tarief en kleurproef voor de schilder.
      </p>
    </div>
  </section>

  <!-- Branches grid -->
  <section
    class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16"
    aria-label="Branches"
  >
    <div class="mx-auto max-w-page px-gutter">
      <div class="grid-rule sm:grid-cols-2 lg:grid-cols-3">
        {
          branches.map((b) => {
            const Illustration = b.illustration ? illustrations[b.illustration] : null
            return (
              <a
                href={b.href}
                class="group flex flex-col p-6 md:p-7 no-underline transition-colors hover:bg-(--color-panel-2)"
              >
                <div class="flex items-start justify-between gap-3">
                  <h2 class="font-display text-h2 text-(--color-chalk)">{b.labelPlural}</h2>
                  {Illustration && (
                    <div class="hidden text-(--color-dim) sm:block" aria-hidden="true">
                      <Illustration class="h-20 w-20" />
                    </div>
                  )}
                </div>
                <p class="mt-3 text-body text-(--color-dim)">{b.hubLine}</p>
                <p class="mt-5 inline-flex items-center gap-1 text-small font-medium text-(--color-sodium) group-hover:underline">
                  <span>Bekijk de oplossing voor {b.labelPlural.toLowerCase()}</span>
                  <span aria-hidden="true">→</span>
                </p>
              </a>
            )
          })
        }
      </div>
    </div>
  </section>

  <!-- "Mijn vak staat er niet bij" -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      
      <h2 class="font-display text-h2 text-(--color-chalk)">Staat uw branche er niet bij?</h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-dim)">
        Klantkraan werkt voor elk Nederlands bedrijf waar klantvragen en afspraken binnenkomen, van
        timmermannen, hoveniers en glaszetters tot kappers, fysiopraktijken en rijscholen. In een
        korte intake leggen we uw diensten, tarieven en huisregels vast. Daarna spreekt de
        AI-receptionist die uit zoals u dat zelf doet.
      </p>
      <div class="mt-8 btn-row">
        <a href="/demo/" class="btn btn-primary btn-lg"> Probeer de demo </a>
        <a href="/rekentool/" class="btn btn-ghost btn-lg"> Bereken uw ROI </a>
      </div>
    </div>
  </section>

  <!-- Trust micro-line -->

</Base>
