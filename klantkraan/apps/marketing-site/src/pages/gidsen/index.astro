---
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { niches, type NicheSlug } from '../../data/niches'

const gidsen = await getCollection('gidsen')
// Sort by niche order in niches.ts (which matches branches.ts priority).
const nicheOrder: NicheSlug[] = ['loodgieter', 'dakdekker', 'schilder', 'aannemer']
// Plus installateur and elektricien which aren't in niches.ts yet — render at end.
const fullOrder = [...nicheOrder, 'installateur', 'elektricien']

const sorted = gidsen.sort(
  (a, b) =>
    fullOrder.indexOf(a.data.vertical) - fullOrder.indexOf(b.data.vertical),
)

const nicheLabelPlural = (v: string): string =>
  v in niches ? niches[v as NicheSlug].labelPlural : `${v}s`
---

<Base
  title="Gidsen: praktische tips per vakgebied | Klantkraan"
  description="Korte, concrete gidsen over klanten werven, storm-protocol, m²-tarief, ISDE-subsidie en meer. Per vakgebied geschreven voor Nederlandse vakmensen."
  centered={false}
>
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="font-display text-hero text-(--color-kraan-ink)">Gidsen voor vakmensen</h1>
      <p class="mt-6 max-w-2xl text-h3 text-(--color-kraan-stone-700)">
        Concrete Nederlandse praktijkadviezen per vakgebied: uurtarieven, seizoenspieken,
        juridische verplichtingen. Geen sales-praatje, alleen werk dat u direct kunt toepassen.
      </p>
    </div>
  </section>

  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid gap-5 md:gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          sorted.map((g) => (
            <a
              href={`/gidsen/${g.id.replace(/\.md$/, '')}/`}
              class="group flex flex-col rounded-(--radius-card) border border-(--color-kraan-stone-300) bg-white p-5 md:p-6 no-underline transition-colors hover:border-(--color-kraan-blue)"
            >
              <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">
                {nicheLabelPlural(g.data.vertical)}
              </p>
              <h2 class="mt-3 font-display text-h3 text-(--color-kraan-ink)">{g.data.title}</h2>
              <p class="mt-3 text-body text-(--color-kraan-stone-700)">{g.data.description}</p>
              <p class="mt-5 inline-flex items-center gap-1 text-small font-medium text-(--color-kraan-blue) group-hover:underline">
                <span>{g.data.readingTime} min lezen</span>
                <span aria-hidden="true">→</span>
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
