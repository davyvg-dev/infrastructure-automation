---
import Base from '../layouts/Base.astro'
import { company } from '../data/company'

interface Tier {
  id: 'chat' | 'compleet'
  name: string
  price: number
  /** Day-price equivalent in Dutch decimal-comma format (price / 30, rounded to cents). */
  dayPrice: string
  /** Optional usage note under the price (e.g. included call minutes + overage rate). */
  priceNote?: string
  blurb: string
  highlight: boolean
}

const tiers: Tier[] = [
  {
    id: 'chat',
    name: 'Chat',
    price: 299,
    dayPrice: '9,97',
    blurb:
      'AI-receptionist via websitechat + WhatsApp: beantwoordt vragen, plant afspraken en vangt terugbelverzoeken, 24/7. Onze aanrader.',
    highlight: true,
  },
  {
    id: 'compleet',
    name: 'Compleet',
    price: 499,
    dayPrice: '16,63',
    priceNote: 'incl. 750 belminuten/mnd, daarna €0,40/min',
    blurb:
      'Alles van Chat, plus een AI-telefonist op een eigen Nederlands nummer (binnenkort beschikbaar).',
    highlight: false,
  },
]

interface FeatureRow {
  feature: string
  chat: string
  compleet: string
}

const features: FeatureRow[] = [
  { feature: 'Websitechat op uw eigen site (Nederlands, 24/7)', chat: 'ja', compleet: 'ja' },
  { feature: 'WhatsApp-kanaal', chat: 'ja', compleet: 'ja' },
  { feature: 'Beantwoordt vragen over diensten, tarieven en werkgebied', chat: 'ja', compleet: 'ja' },
  { feature: 'Plant afspraken direct in uw agenda', chat: 'ja', compleet: 'ja' },
  { feature: 'Vangt leads en terugbelverzoeken op', chat: 'ja', compleet: 'ja' },
  { feature: 'Done-for-you setup en tuning', chat: 'ja', compleet: 'ja' },
  { feature: 'Maandelijkse statistieken per e-mail', chat: 'ja', compleet: 'ja' },
  {
    feature: 'AI-telefonist op een eigen Nederlands nummer',
    chat: '–',
    compleet: 'binnenkort beschikbaar',
  },
  {
    feature: 'Inbegrepen belminuten per maand',
    chat: '–',
    compleet: '750, daarna €0,40/min',
  },
]

// Service schema with both subscription tiers, derived from the tiers array
// above so the JSON-LD can never drift from the visible pricing cards.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${company.tradeName} AI-receptionist`,
  serviceType: 'AI-receptionist voor lokale bedrijven',
  url: new URL('/prijzen/', Astro.site).toString(),
  provider: {
    '@type': 'Organization',
    name: company.tradeName,
    url: new URL('/', Astro.site).toString(),
  },
  areaServed: { '@type': 'Country', name: 'Nederland' },
  offers: tiers.map((tier) => ({
    '@type': 'Offer',
    name: `${company.tradeName} ${tier.name}`,
    description: tier.blurb,
    price: String(tier.price),
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: String(tier.price),
      priceCurrency: 'EUR',
      unitText: 'per maand',
    },
  })),
}
---

<Base
  title="Prijzen AI-receptionist: Chat €299 of Compleet €499 | Klantkraan"
  description="Twee abonnementen: Chat €299 en Compleet €499 per maand. Setup €249 (kwijtgescholden voor pilotklanten), maandelijks opzegbaar, eerste maand 50% korting."
  centered={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="font-display text-hero text-(--color-chalk)">Prijzen</h1>
      <p class="mt-6 max-w-2xl text-h3 text-(--color-dim)">
        Maandelijks opzegbaar, eerste maand 50% korting. Eenmalige setup €249 (kwijtgescholden
        voor pilotklanten). Alle bedragen excl. 21% BTW.
      </p>
    </div>
  </section>

  <!-- 2. Tier cards (stone-100) -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 md:grid-cols-2">
      {
        tiers.map((tier) => (
          <article
            class={`rounded-(--radius-card) border p-5 md:p-6 ${tier.highlight ? 'border-(--color-sodium) bg-(--color-panel)' : 'border-(--color-line) bg-(--color-panel)'}`}
          >
            <header class="flex items-baseline justify-between">
              <h2 class="font-display text-h2 text-(--color-chalk)">{tier.name}</h2>
              {tier.highlight && (
                <span class="rounded-(--radius-button) bg-(--color-sodium) px-2 py-1 text-micro text-(--color-night)">
                  aanrader
                </span>
              )}
            </header>
            <p class="mt-4 font-display text-h1 text-(--color-sodium)">
              €{tier.price}
              <span class="text-body text-(--color-dim)"> / mnd</span>
            </p>
            <p class="mt-1 font-mono text-small text-(--color-dim)">
              ≈ €{tier.dayPrice} per dag
            </p>
            {tier.priceNote && (
              <p class="mt-2 text-small text-(--color-dim)">{tier.priceNote}</p>
            )}
            <p class="mt-3 text-body text-(--color-dim)">{tier.blurb}</p>
            <a
              href="/demo/"
              class={`mt-6 btn btn-lg ${tier.highlight ? 'btn-primary' : 'btn-ghost'}`}
            >
              Probeer de demo
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 3. Feature comparison (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">Wat zit erin</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-chalk)">Wat zit erin per abonnement</h2>

      <div class="mt-6 hidden md:block">
        <table class="w-full border-collapse text-body">
          <thead>
            <tr class="border-b border-(--color-line) text-left">
              <th class="py-3 pr-4 font-display text-h3 text-(--color-chalk)">Onderdeel</th>
              <th class="py-3 pr-4 font-display text-h3 text-(--color-chalk)">Chat</th>
              <th class="py-3 pr-4 font-display text-h3 text-(--color-chalk)">Compleet</th>
            </tr>
          </thead>
          <tbody>
            {
              features.map((row) => (
                <tr class="border-b border-(--color-line)">
                  <td class="py-3 pr-4 text-(--color-dim)">{row.feature}</td>
                  <td class="py-3 pr-4">{row.chat}</td>
                  <td class="py-3 pr-4">{row.compleet}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <ul class="mt-6 space-y-4 md:hidden">
        {
          features.map((row) => (
            <li class="rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5">
              <p class="font-display text-h3 text-(--color-chalk)">{row.feature}</p>
              <div class="mt-3 grid grid-cols-2 gap-2 text-small">
                <div>
                  <p class="text-(--color-dim)">Chat</p>
                  <p class="mt-1 text-(--color-chalk)">{row.chat}</p>
                </div>
                <div>
                  <p class="text-(--color-dim)">Compleet</p>
                  <p class="mt-1 text-(--color-chalk)">{row.compleet}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. Alle abonnementen + korting (stone-100) -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 sm:grid-cols-2">
      <div>
        <h2 class="font-display text-h2 text-(--color-chalk)">Alle abonnementen bevatten</h2>
        <ul class="mt-4 space-y-2 text-body text-(--color-dim)">
          <li>Done-for-you setup en tuning. Wij bouwen en koppelen alles voor u.</li>
          <li>Maandelijks opzegbaar (30 dagen opzegtermijn).</li>
          <li>Eerste maand 50% korting.</li>
          <li>30 dagen tevredenheidsgarantie. Niet tevreden? Geld terug.</li>
        </ul>
      </div>
      <div>
        <h2 class="font-display text-h2 text-(--color-chalk)">Korting bij vooruitbetaling</h2>
        <ul class="mt-4 space-y-2 text-body text-(--color-dim)">
          <li>6 maanden vooruit: 15% korting.</li>
          <li>12 maanden vooruit: 20% korting, prijs voor het hele jaar vastgezet.</li>
          <li>BTW-tarief 21% (verlegd voor klanten buiten Nederland).</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. Final CTA (blue) -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">Klaar?</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-chalk)">Klaar om te starten?</h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-dim)">
        In een demo van 20 minuten laten wij precies zien hoe Klantkraan in uw situatie werkt. Geen
        verkooppraatje, wel een rekensom op uw cijfers.
      </p>
      <a
        href="/demo/"
        class="mt-6 btn btn-primary btn-lg"
      >
        Probeer de demo
      </a>
    </div>
  </section>
</Base>
