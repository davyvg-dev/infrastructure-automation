---
import Base from '../layouts/Base.astro'
import MiniOfferLine from '../components/MiniOfferLine.astro'
import MiniOfferCard from '../components/MiniOfferCard.astro'
import { BREVO_ACTION } from '../data/brevo'
---

<Base
  title="ROI-rekentool: bereken uw gemiste omzet | Klantkraan"
  description="Bereken in 10 seconden hoeveel omzet u misloopt door gemiste oproepen en hoe snel een AI-receptionist van Klantkraan zichzelf terugverdient."
  centered={false}
  offerArea="automations"
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      <h1 class="font-display text-hero text-(--color-chalk)">
        Wat kost u een <span class="text-(--color-sodium)">gemiste oproep</span>?
      </h1>
      <p class="mt-6 max-w-2xl text-[1.125rem] text-(--color-dim) leading-relaxed">
        Vul uw cijfers in en zie direct wat gemiste oproepen u per jaar kosten en hoe snel elk
        abonnement zichzelf terugverdient.
      </p>
      <MiniOfferLine area="receptionist" where="before" class="mt-4 max-w-2xl" />
    </div>
  </section>

  <!-- 2. Form + results (stone-100) -->
  <section class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16">
    <div class="mx-auto grid max-w-page gap-6 md:gap-8 px-gutter md:grid-cols-2">
      <form
        id="roi-form"
        class="rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5 md:p-6"
        onsubmit="return false"
      >
        <div class="space-y-6">
          <div>
            <label for="calls" class="block text-body font-medium text-(--color-chalk)">
              Hoeveel oproepen krijgt u per week?
            </label>
            <input
              id="calls"
              name="calls"
              type="number"
              inputmode="numeric"
              autocomplete="off"
              min="0"
              step="1"
              value="40"
              class="mt-2 w-full rounded-(--radius-button) border border-(--color-line) bg-[rgba(0,0,0,0.25)] px-3 py-3 text-body text-(--color-chalk)"
            />
          </div>
          <div>
            <label for="missed" class="block text-body font-medium text-(--color-chalk)">
              Welk percentage daarvan mist u nu?
            </label>
            <input
              id="missed"
              name="missed"
              type="number"
              inputmode="numeric"
              autocomplete="off"
              min="0"
              max="100"
              step="1"
              value="28"
              class="mt-2 w-full rounded-(--radius-button) border border-(--color-line) bg-[rgba(0,0,0,0.25)] px-3 py-3 text-body text-(--color-chalk)"
            />
            <p class="mt-1 text-small text-(--color-dim)">
              Brancheschatting: 28% voor installateurs en dakdekkers.
            </p>
          </div>
          <div>
            <label for="value" class="block text-body font-medium text-(--color-chalk)">
              Gemiddelde waarde per klus (€)
            </label>
            <input
              id="value"
              name="value"
              type="number"
              inputmode="numeric"
              autocomplete="off"
              min="0"
              step="10"
              value="450"
              class="mt-2 w-full rounded-(--radius-button) border border-(--color-line) bg-[rgba(0,0,0,0.25)] px-3 py-3 text-body text-(--color-chalk)"
            />
            <p class="mt-1 text-small text-(--color-dim)">
              Standaard € 450: de gemiddelde loodgietersklus in Nederland.
            </p>
          </div>
        </div>
      </form>

      <aside
        class="rounded-(--radius-card) border border-(--color-sodium) bg-(--color-panel) p-5 md:p-6"
      >
        <h2 class="font-display text-h2 text-(--color-chalk)">Uw verlies in cijfers</h2>
        <div class="mt-4 space-y-4">
          <div>
            <p class="text-small text-(--color-dim)">Gemiste oproepen per jaar</p>
            <p
              id="out-missed-year"
              class="font-display text-h1 tabular-nums [overflow-wrap:anywhere] text-(--color-sodium)"
            >
              0
            </p>
          </div>
          <div>
            <p class="text-small text-(--color-dim)">Verloren omzet per jaar</p>
            <p
              id="out-lost-revenue"
              class="font-display text-h1 tabular-nums [overflow-wrap:anywhere] text-(--color-sodium)"
            >
              € 0
            </p>
            <p class="mt-1 text-small text-(--color-dim)">
              Aanname: ongeveer 1 op 3 gemiste oproepen had een betalende klus opgeleverd.
            </p>
          </div>
          <div>
            <p class="text-small text-(--color-dim)">Verloren omzet per maand</p>
            <p
              id="out-lost-month"
              class="font-display text-h2 tabular-nums [overflow-wrap:anywhere] text-(--color-sodium)"
            >
              € 0
            </p>
          </div>
        </div>
        <MiniOfferLine
          area="receptionist"
          where="within"
          hook="Op vakantie loopt dit bedrag door."
          class="mt-4"
        />

        <hr class="my-6 border-(--color-line)" />

        <h3 class="font-display text-h3 text-(--color-chalk)">Terugverdientijd</h3>
        <ul class="mt-3 space-y-2 text-body text-(--color-dim)">
          <li>
            Chat (€ 299 per maand): <span id="out-payback-chat" class="font-mono">…</span>
          </li>
          <li>
            Compleet (€ 499 per maand): <span id="out-payback-compleet" class="font-mono">…</span>
          </li>
        </ul>
        <p class="mt-4 text-small text-(--color-dim)">
          Terugverdientijd: het aantal maanden tot teruggewonnen omzet het abonnement heeft betaald.
        </p>
      </aside>
    </div>
  </section>

  <!-- 3. Hoe wij rekenen (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      
      <h2 class="font-display text-h2 text-(--color-chalk)">Hoe wij rekenen</h2>
      <ul class="mt-4 space-y-2 text-body text-(--color-dim)">
        <li>Gemiste oproepen per jaar = oproepen per week × 52 × (% gemist / 100).</li>
        <li>
          Verloren omzet per jaar = gemiste oproepen × waarde per klus × 33%. We tellen dus maar 1 op
          de 3 gemiste oproepen als verloren klus; zonder automatisch terugbellen haakt het gros af.
        </li>
        <li>
          Terugverdientijd = abonnementsprijs ÷ (verloren omzet per jaar ÷ 12).
        </li>
      </ul>
      <a href="/demo/" class="mt-8 btn btn-primary btn-lg">
        Laat ons uw cijfers live nakijken
      </a>
    </div>
  </section>

  <!-- 4. Werkspot math (stone-100) -->
  <section class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      <p class="eyebrow">Leadplatforms</p>
      <h2 class="mt-3 font-display text-h2 text-(--color-chalk)">
        Wat kost een klus via Werkspot?
      </h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-dim)">
        Op leadplatforms betaalt u per lead, en dezelfde lead gaat ook naar uw concurrenten. Wie het
        eerst reageert, wint de klus; de rest heeft ook betaald. Zet daar een vaste prijs voor uw
        eigen kanaal tegenover, waar elke beller wordt aangenomen.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5">
          <p class="font-display text-h1 tabular-nums text-(--color-sodium)">€&nbsp;3 tot €&nbsp;75</p>
          <p class="mt-2 text-small text-(--color-dim)">
            kost één lead op Werkspot, ook als de klus naar een ander gaat.
          </p>
        </div>
        <div class="rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5">
          <p class="font-display text-h1 tabular-nums text-(--color-sodium)">&plusmn;&nbsp;€&nbsp;208</p>
          <p class="mt-2 text-small text-(--color-dim)">
            aan leadkosten per gewonnen klus, becijferd door
            <a href="https://adaptoo.nl/blog/werkspot-kosten" class="underline">Adaptoo</a>.
          </p>
        </div>
        <div class="rounded-(--radius-card) border border-(--color-sodium) bg-(--color-panel) p-5">
          <p class="font-display text-h1 tabular-nums text-(--color-chalk)">€&nbsp;0 per lead</p>
          <p class="mt-2 text-small text-(--color-dim)">
            via uw eigen nummer en website. Klantkraan kost een vast bedrag per maand, hoeveel
            klussen u ook aanneemt.
          </p>
        </div>
      </div>
      <p class="mt-6 max-w-2xl text-body text-(--color-dim)">
        Elke review, elke terugkerende klant en elke doorverwijzing via uw eigen kanaal is van u,
        niet van het platform.
      </p>
    </div>
  </section>

  <!-- 5. After the magnet: the calculation by mail (Brevo, source "rekentool"), then the
       matching mini offer. The calculator above stays e-mail-free. -->
  <section class="py-10 md:py-16" aria-label="Uw berekening per mail">
    <div class="mx-auto grid max-w-page gap-6 px-gutter md:grid-cols-2 md:gap-8">
      <form
        id="rekentool-mail"
        data-magnet-form="rekentool"
        method="POST"
        action={BREVO_ACTION}
        data-astro-reload
        class="rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5 md:p-6"
      >
        <h2 class="font-display text-h2 text-(--color-chalk)">Deze berekening per mail</h2>
        <p class="mt-3 text-body text-(--color-dim)">
          U krijgt een mail om uw adres te bevestigen. Binnen 1 werkdag sturen we uw berekening, met
          per maand de omzet die nu blijft liggen.
        </p>
        <label for="rm-email" class="mt-5 block text-body font-medium text-(--color-chalk)">
          Uw e-mailadres
        </label>
        <input
          id="rm-email"
          name="EMAIL"
          type="email"
          required
          autocomplete="email"
          inputmode="email"
          placeholder="naam@uwbedrijf.nl"
          class="mt-2 w-full rounded-(--radius-button) border border-(--color-line) bg-[rgba(0,0,0,0.25)] px-3 py-3 text-body text-(--color-chalk)"
        />
        <p class="mt-2 text-small text-(--color-dim)">
          Daarna sturen we u af en toe een tip of aanbod. Afmelden kan in elke mail.
        </p>
        <input type="hidden" id="rm-klus" name="SCAN_KLUS" value="" />
        <input type="hidden" name="SCAN_PROGRAMMAS" value="rekentool" />
        <input type="hidden" name="SCAN_BEDRIJF" value="rekentool" />
        {/* Brevo's own two hidden inputs: its bot trap (must stay empty) and the form locale. */}
        <input
          type="text"
          name="email_address_check"
          value=""
          class="sr-only"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <input type="hidden" name="locale" value="en" />
        <p data-form-error class="mt-3 text-small text-(--color-chalk)" role="alert" hidden>
          Dat ging niet goed. Probeer het nog een keer.
        </p>
        <button type="submit" class="mt-5 btn btn-primary btn-lg w-full">Stuur mij de berekening</button>
      </form>
      <div
        id="rekentool-mail-done"
        tabindex="-1"
        hidden
        class="rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5 md:p-6"
      >
        <h2 class="font-display text-h2 text-(--color-chalk)">Bijna klaar</h2>
        <p class="mt-3 text-body text-(--color-dim)">
          Kijk in uw mail en klik op de knop om uw adres te bevestigen. Binnen 1 werkdag heeft u uw
          berekening. Geen mail gezien? Kijk bij ongewenste mail en zoek op Klantkraan.
        </p>
      </div>
      <MiniOfferCard area="receptionist" kicker="Liever meteen geregeld?" />
    </div>
  </section>

  <!-- Externalised JS (loaded as same-origin to pass strict CSP script-src 'self'). -->
  <script src="/js/rekentool.js" type="module" is:inline></script>
  <script src="/js/magnet-form.js" type="module" is:inline></script>
</Base>
