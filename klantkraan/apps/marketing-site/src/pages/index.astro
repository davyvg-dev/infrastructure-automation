---
import Base from '../layouts/Base.astro'
---

<Base
  title="Klantkraan — De Klantenmotor voor Nederlandse vakmensen"
  description="Elke gemiste oproep teruggebeld binnen 60 seconden. AI-receptionist die uw vak spreekt, automatische Google-reviews, geen setup, per maand opzegbaar."
>
  <section class="py-16">
    <h1 class="font-display text-hero text-(--color-kraan-ink)">
      De Klantenmotor voor Nederlandse vakmensen.
    </h1>
    <p class="mt-6 max-w-2xl text-h3 text-(--color-kraan-stone-700)">
      Elke gemiste oproep teruggebeld binnen 60 seconden. AI-receptionist die uw vak spreekt,
      automatische reviews, geen setup, per maand opzegbaar.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="/demo"
        class="inline-block rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
      >
        Probeer de AI-receptionist
      </a>
      <a
        href="/rekentool"
        class="inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
      >
        Bereken uw ROI
      </a>
    </div>
  </section>

  <section class="grid gap-6 border-t border-(--color-kraan-stone-300) py-12 sm:grid-cols-3">
    <div>
      <p class="font-display text-h2 text-(--color-kraan-blue)">28%</p>
      <p class="mt-2 text-body">van uw oproepen wordt gemist.</p>
    </div>
    <div>
      <p class="font-display text-h2 text-(--color-kraan-blue)">&lt; 60 sec</p>
      <p class="mt-2 text-body">terugbel-SMS na elke gemiste oproep.</p>
    </div>
    <div>
      <p class="font-display text-h2 text-(--color-kraan-blue)">€450</p>
      <p class="mt-2 text-body">gemiddelde waarde per gemiste klus.</p>
    </div>
  </section>
</Base>
