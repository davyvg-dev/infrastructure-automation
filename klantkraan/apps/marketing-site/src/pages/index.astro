---
import Base from '../layouts/Base.astro'
import { waLink } from '../data/contact'
---

<Base
  title="AI-receptionist voor uw bedrijf: websitechat & WhatsApp | Klantkraan"
  description="AI-receptionist op uw website en WhatsApp: beantwoordt vragen, plant afspraken en vangt leads, dag en nacht. Done-for-you setup. Per maand opzegbaar."
  centered={false}
>
  <!-- HERO — copy left, live dispatch panel right -->
  <section class="pt-11 pb-0 md:pt-[4.5rem]">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid gap-10 md:grid-cols-[1.05fr_.95fr] md:items-center md:gap-14">
        <!-- copy -->
        <div>
          <span class="kk-status">
            <span class="kk-dot" aria-hidden="true"></span>
            <span>AAN &middot; antwoordt nu</span>
            <span class="sep" aria-hidden="true">&middot;</span>
            <span>SITE + WHATSAPP</span>
          </span>

          <h1 class="kk-h1">Het licht blijft <span class="on">aan.</span></h1>

          <p class="kk-sub">
            U staat op de ladder, op het dak, of u slaapt. Uw beste klant heeft nú een vraag. De
            digitale receptionist van Klantkraan beantwoordt hem op uw site en WhatsApp, plant de
            afspraak en vangt elk terugbelverzoek. Dag en nacht.
          </p>

          <div class="mt-8 flex flex-wrap gap-3.5">
            <a href="/demo/" class="btn btn-primary btn-lg">Probeer de demo</a>
            <a href="#nachtdienst" class="btn btn-ghost btn-lg">Zo werkt het</a>
          </div>
          <p class="kk-trust">
            Done-for-you setup &middot; per maand opzegbaar &middot;
            <span class="g">AVG-proof, EU-gehost</span>
          </p>
        </div>

        <!-- live dispatch panel (decorative: role=img + summary label) -->
        <div class="kk-shell">
          <div
            id="kk-dispatch"
            class="kk-panel"
            role="img"
            aria-label="Dienstlog: om 23:47 stelt een klant met een lekkage een vraag, de digitale receptionist plant een afspraak op dinsdag 09:00 en zet een terugbelverzoek klaar voor de eigenaar."
          >
            <div class="kk-panel-top">
              <span>DIENSTLOG &middot; VANNACHT</span>
              <span class="on"><span class="kk-dot" aria-hidden="true"></span>AAN</span>
            </div>
            <div class="kk-log" aria-hidden="true">
              <div class="kk-row dim">
                <span class="kk-ts">06:14</span>
                <span class="kk-what">offerteaanvraag</span>
                <span class="kk-st">✓ beantwoord</span>
              </div>
              <div class="kk-row dim">
                <span class="kk-ts">12:40</span>
                <span class="kk-what">afspraak &middot; dakinspectie</span>
                <span class="kk-st">✓ ingepland</span>
              </div>

              <div class="kk-live">
                <div class="kk-lts kk-reveal" style="animation-delay:.2s">
                  23:47 &middot; binnenkomend gesprek
                </div>
                <div class="kk-disclosure kk-reveal" style="animation-delay:.5s">
                  U chat met een digitale assistent.
                </div>

                <div class="kk-msg kk-klant kk-reveal" style="animation-delay:.9s">
                  <span class="who">Klant</span>
                  <span>Ik heb een lekkage onder de gootsteen, kan er morgen iemand komen?</span>
                </div>

                <div id="kk-typing" class="kk-msg kk-recep kk-reveal" style="animation-delay:1.5s;padding:0">
                  <span class="kk-typing" aria-hidden="true"><i></i><i></i><i></i></span>
                </div>

                <div id="kk-reply" class="kk-msg kk-recep" hidden>
                  <span class="who">Klantkraan</span>
                  <span>Vervelend, dat pakken we op. Morgen 09:00 is vrij. Zal ik dat voor u vastzetten?</span>
                </div>

                <div id="kk-stamp" class="kk-stamp" hidden>
                  <span class="tick" aria-hidden="true">✓</span>
                  <span>
                    <strong>INGEPLAND</strong>
                    <span class="detail"> di 09:00 &middot; terugbel klaar voor de eigenaar</span>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ledger strip: real times prove misses cluster at inconvenient hours -->
    <div class="kk-ledger mt-[2.125rem]">
      <div class="mx-auto max-w-5xl px-6">
        <div class="kk-ledger-grid">
          <div class="cell">
            <div class="kk-cell-ts">06:14</div>
            <div class="kk-cell-ev">Offerte beantwoord</div>
            <div class="kk-cell-aside">voordat u wakker was</div>
          </div>
          <div class="cell">
            <div class="kk-cell-ts">12:40</div>
            <div class="kk-cell-ev">Afspraak ingepland</div>
            <div class="kk-cell-aside">u stond op het dak</div>
          </div>
          <div class="cell">
            <div class="kk-cell-ts">23:47</div>
            <div class="kk-cell-ev">Spoedlek → afspraak</div>
            <div class="kk-cell-aside">u sliep</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DUTIES — the night shift -->
  <section id="nachtdienst" class="scroll-mt-24 py-[3.25rem] md:py-[4.875rem]">
    <div class="mx-auto max-w-5xl px-6">
      <span class="eyebrow">De nachtdienst</span>
      <h2 class="mt-3.5 max-w-[16em] font-display text-h2 text-balance">
        Wat de receptionist overneemt terwijl u werkt.
      </h2>
      <div class="mt-10 grid gap-[18px] md:grid-cols-3">
        <div class="kk-duty">
          <span class="tag">antwoord</span>
          <h3>Beantwoordt elke vraag</h3>
          <p>
            Kent uw tarieven, diensten en werkgebied. Geen verzonnen prijzen, alleen wat u heeft
            ingesteld.
          </p>
        </div>
        <div class="kk-duty">
          <span class="tag">agenda</span>
          <h3>Plant de afspraak</h3>
          <p>
            Direct in uw agenda, alleen op momenten die écht vrij zijn. De klant kiest een slot, u
            ziet het meteen.
          </p>
        </div>
        <div class="kk-duty">
          <span class="tag">terugbel</span>
          <h3>Vangt het terugbelverzoek</h3>
          <p>
            Kan het niet meteen? De receptionist noteert naam, nummer en klus. U belt terug wie er
            écht toe doet.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- COST — a receipt, not a big-number-gradient -->
  <section id="kosten" class="scroll-mt-24 border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-[3.25rem] md:py-[4.875rem]">
    <div class="mx-auto grid max-w-5xl gap-8 px-6 md:grid-cols-[1.1fr_.9fr] md:items-center md:gap-11">
      <div>
        <span class="eyebrow">De rekening van een donkere avond</span>
        <h2 class="mt-3.5 max-w-[16em] font-display text-h2 text-balance">
          Elke onbeantwoorde vraag is een opdracht die naar de concurrent loopt.
        </h2>
        <p class="mt-4 max-w-[38em] text-[1.05rem] text-[#cdd8d5]">
          De cijfers zijn niet dramatisch bedoeld. Ze zijn gewoon de optelsom van een telefoon die
          overgaat terwijl uw handen vol zitten.
        </p>
      </div>
      <div class="kk-receipt" aria-label="Kostenoverzicht">
        <div class="line">
          <span class="k">Gemiste oproepen</span>
          <span class="v bad">28%</span>
        </div>
        <div class="line">
          <span class="k">Waarde per gemiste aanvraag</span>
          <span class="v bad">€450</span>
        </div>
        <div class="line">
          <span class="k">Uren dat u onbereikbaar bent</span>
          <span class="v">het grootste deel</span>
        </div>
        <div class="line total">
          <span class="k">Met het licht aan</span>
          <span class="v">elke vraag beantwoord, 24/7</span>
        </div>
      </div>
    </div>
  </section>

  <!-- TRANSPARENCY / art. 50 -->
  <section id="eerlijk" class="scroll-mt-24 py-[3.25rem] md:py-[4.875rem]">
    <div class="mx-auto max-w-5xl px-6">
      <span class="eyebrow">Eerlijk over AI</span>
      <h2 class="mt-3.5 max-w-[16em] font-display text-h2 text-balance">
        Het licht staat aan. Er valt niets te verbergen.
      </h2>
      <div class="kk-trans mt-6">
        <span class="quote">&ldquo;U chat met een digitale assistent.&rdquo;</span>
        <p>
          Zo begint elk gesprek, voordat er iets anders gebeurt. Wettelijk verplicht onder de EU AI
          Act artikel&nbsp;50, en het past bij open ondernemen. Geen verwarring bij de klant, geen boete
          van de toezichthouder. Gewoon een eerlijk gesprek, dag en nacht.
        </p>
        <p class="mt-4 text-small">
          <a href="/legal/ai-disclosure/">Lees de volledige disclosure</a>
        </p>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="py-[5.625rem] text-center">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="kk-final-h2">Zet het licht <span class="on">aan.</span></h2>
      <p class="mx-auto mt-[18px] max-w-[34em] text-(--color-dim)">
        Probeer de demo en stel de receptionist een vraag alsof u een klant bent. Bevalt het? De
        setup doen wij, u hoeft niets te bouwen.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3.5">
        <a href="/demo/" class="btn btn-primary btn-lg">Probeer de demo</a>
        <a href={waLink} target="_blank" rel="noopener" class="btn btn-ghost btn-lg">
          Plan een kennismaking
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- hero copy ---- */
  .kk-status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--color-sodium-soft);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 6px 13px 6px 12px;
    background: var(--color-panel);
  }
  .kk-status .sep {
    color: var(--color-line);
  }
  .kk-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-sodium);
    flex: none;
    animation: kk-pulse 2.6s ease-out infinite;
  }
  .kk-h1 {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.025em;
    font-size: clamp(2.5rem, 6.4vw, 4.7rem);
    line-height: 0.98;
    margin: 22px 0 0;
    text-wrap: balance;
  }
  .kk-h1 .on {
    color: var(--color-sodium);
  }
  .kk-sub {
    margin-top: 24px;
    max-width: 33em;
    font-size: clamp(1.02rem, 1.4vw, 1.18rem);
    color: #cdd8d5;
    line-height: 1.6;
  }
  .kk-trust {
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.02em;
    color: var(--color-dim);
  }
  .kk-trust .g {
    color: var(--color-confirm);
  }

  /* ---- dispatch panel (the signature) ---- */
  .kk-shell {
    position: relative;
  }
  .kk-shell::before {
    content: '';
    position: absolute;
    inset: -14% -8% -18% -8%;
    z-index: 0;
    background: radial-gradient(closest-side, rgba(255, 184, 77, 0.22), transparent 72%);
    filter: blur(6px);
  }
  .kk-panel {
    position: relative;
    z-index: 1;
    background: linear-gradient(180deg, var(--color-panel-2), var(--color-panel));
    border: 1px solid var(--color-line);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.7);
  }
  .kk-panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 16px;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    color: var(--color-dim);
    background: rgba(0, 0, 0, 0.14);
  }
  .kk-panel-top .on {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--color-sodium);
  }
  .kk-log {
    padding: 8px 16px 18px;
  }
  .kk-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 12px;
    align-items: baseline;
    padding: 11px 0;
    border-bottom: 1px dashed var(--color-line);
    font-size: 14.5px;
  }
  .kk-row:last-child {
    border-bottom: 0;
  }
  .kk-row.dim {
    opacity: 0.5;
  }
  .kk-ts {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-sodium-soft);
  }
  .kk-what {
    color: #cdd8d5;
  }
  .kk-st {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.03em;
    color: var(--color-confirm);
    white-space: nowrap;
  }
  .kk-live {
    margin-top: 4px;
    padding-top: 12px;
  }
  .kk-lts {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-sodium-soft);
    letter-spacing: 0.04em;
  }
  .kk-disclosure {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-dim);
    border: 1px dashed var(--color-line);
    border-radius: 7px;
    padding: 6px 9px;
    margin: 10px 0 12px;
  }
  .kk-msg {
    margin: 9px 0;
    max-width: 82%;
    padding: 9px 13px;
    border-radius: 12px;
    font-size: 14.5px;
    line-height: 1.45;
  }
  .kk-msg .who {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-dim);
    margin-bottom: 3px;
  }
  .kk-klant {
    background: var(--color-panel-2);
    border: 1px solid var(--color-line);
    border-bottom-left-radius: 4px;
  }
  .kk-recep {
    background: rgba(255, 184, 77, 0.12);
    border: 1px solid rgba(255, 184, 77, 0.32);
    color: #ffe9c7;
    margin-left: auto;
    border-bottom-right-radius: 4px;
  }
  .kk-recep .who {
    color: var(--color-sodium);
  }
  .kk-typing {
    display: inline-flex;
    gap: 4px;
    padding: 12px 14px;
  }
  .kk-typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-dim);
    animation: kk-blink 1.1s infinite;
  }
  .kk-typing i:nth-child(2) {
    animation-delay: 0.18s;
  }
  .kk-typing i:nth-child(3) {
    animation-delay: 0.36s;
  }
  @keyframes kk-blink {
    0%,
    60%,
    100% {
      opacity: 0.25;
    }
    30% {
      opacity: 1;
    }
  }
  .kk-stamp {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    padding: 11px 13px;
    background: rgba(99, 211, 171, 0.1);
    border: 1px solid rgba(99, 211, 171, 0.34);
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-confirm);
  }
  .kk-stamp .tick {
    width: 19px;
    height: 19px;
    flex: none;
    border-radius: 50%;
    background: var(--color-confirm);
    color: var(--color-night);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 12px;
  }
  .kk-stamp .detail {
    color: #bfe7d7;
  }

  /* entrance for live rows (JS re-triggers .kk-rise on reveal) */
  .kk-reveal,
  .kk-rise {
    opacity: 0;
    transform: translateY(6px);
    animation: kk-rise 0.5s ease forwards;
  }
  @keyframes kk-rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  /* Hidden states must beat the base display of .kk-msg/.kk-stamp (higher specificity). */
  .kk-msg[hidden],
  .kk-stamp[hidden] {
    display: none;
  }

  /* ---- ledger strip ---- */
  .kk-ledger {
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    background: rgba(0, 0, 0, 0.12);
  }
  .kk-ledger-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .kk-ledger-grid .cell {
    padding: 26px 24px;
    border-right: 1px solid var(--color-line);
  }
  .kk-ledger-grid .cell:last-child {
    border-right: 0;
  }
  @media (max-width: 760px) {
    .kk-ledger-grid {
      grid-template-columns: 1fr;
    }
    .kk-ledger-grid .cell {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .kk-ledger-grid .cell:last-child {
      border-bottom: 0;
    }
  }
  .kk-cell-ts {
    font-family: var(--font-mono);
    font-size: 22px;
    color: var(--color-sodium);
    letter-spacing: -0.01em;
  }
  .kk-cell-ev {
    margin-top: 6px;
    font-weight: 600;
    font-size: 15.5px;
  }
  .kk-cell-aside {
    margin-top: 3px;
    font-size: 14px;
    color: var(--color-dim);
  }

  /* ---- duty cards ---- */
  .kk-duty {
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 24px;
  }
  .kk-duty .tag {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-sodium-soft);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .kk-duty h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.22rem;
    margin: 14px 0 8px;
    letter-spacing: -0.01em;
  }
  .kk-duty p {
    margin: 0;
    color: var(--color-dim);
    font-size: 15px;
    line-height: 1.55;
  }

  /* ---- cost receipt ---- */
  .kk-receipt {
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 8px 22px;
    font-family: var(--font-mono);
  }
  .kk-receipt .line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px dashed var(--color-line);
  }
  .kk-receipt .line:last-child {
    border-bottom: 0;
  }
  .kk-receipt .k {
    color: var(--color-dim);
    font-size: 13.5px;
    letter-spacing: 0.02em;
  }
  .kk-receipt .v {
    font-size: 19px;
    color: var(--color-chalk);
  }
  .kk-receipt .v.bad {
    color: var(--color-sodium);
  }
  .kk-receipt .total {
    padding: 18px 0;
  }
  .kk-receipt .total .k {
    color: var(--color-chalk);
    font-size: 14px;
  }
  .kk-receipt .total .v {
    color: var(--color-confirm);
    font-size: 16px;
    font-family: var(--font-sans);
    font-weight: 600;
    text-align: right;
  }

  /* ---- transparency panel ---- */
  .kk-trans {
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-sodium);
    border-radius: var(--radius-card);
    padding: 30px 32px;
    max-width: 760px;
  }
  .kk-trans .quote {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-sodium-soft);
    border: 1px dashed var(--color-line);
    border-radius: 8px;
    padding: 10px 13px;
    display: inline-block;
    margin-bottom: 18px;
  }
  .kk-trans p {
    color: #cdd8d5;
  }

  /* ---- final cta ---- */
  .kk-final-h2 {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.025em;
    font-size: clamp(2.2rem, 5.6vw, 4rem);
    line-height: 1;
    margin: 0;
    text-wrap: balance;
  }
  .kk-final-h2 .on {
    color: var(--color-sodium);
  }
</style>

<script>
  // Live dispatch panel: klant → typing → reply → INGEPLAND stamp.
  // Bound to astro:page-load so it survives client-side (ClientRouter) nav and
  // re-runs when the visitor returns to the home page. Reduced-motion jumps
  // straight to the resting state. The panel is decorative (role=img with a
  // summary label), so the no-JS state (typing shown, reply/stamp hidden)
  // matches the approved concept.
  function initDispatch() {
    const panel = document.getElementById('kk-dispatch')
    if (!panel) return
    const typing = document.getElementById('kk-typing')
    const reply = document.getElementById('kk-reply')
    const stamp = document.getElementById('kk-stamp')
    if (!typing || !reply || !stamp) return

    const reduce =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const reveal = (el: HTMLElement) => {
      el.hidden = false
      el.classList.remove('kk-rise')
      void el.offsetWidth // force reflow so the entrance animation restarts
      el.classList.add('kk-rise')
    }

    if (reduce) {
      typing.hidden = true
      reply.hidden = false
      stamp.hidden = false
      return
    }

    // rewind to the start of the shift, then play it out
    typing.hidden = false
    reply.hidden = true
    stamp.hidden = true
    window.setTimeout(() => {
      typing.hidden = true
      reveal(reply)
    }, 2400)
    window.setTimeout(() => reveal(stamp), 3100)
  }

  document.addEventListener('astro:page-load', initDispatch)
</script>
