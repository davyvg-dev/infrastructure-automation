---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import LeadForm from '../components/LeadForm.astro'
import Stat from '../components/Stat.astro'
---

<Base
  title="Klantkraan — De Klantenmotor voor Nederlandse vakmensen"
  description="Elke gemiste oproep teruggebeld binnen 60 seconden. AI-receptionist die uw vak spreekt, automatische Google-reviews, geen setup, per maand opzegbaar."
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="font-display text-hero text-(--color-kraan-ink)">
        De <span class="text-(--color-kraan-rust)">Klantenmotor</span> voor Nederlandse vakmensen.
      </h1>
      <p class="mt-6 max-w-2xl text-h3 text-(--color-kraan-stone-700)">
        Elke gemiste oproep teruggebeld binnen 60 seconden. AI-receptionist die uw vak spreekt,
        automatische reviews, geen setup, per maand opzegbaar.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/demo"
          class="inline-block rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
        >
          Probeer de AI-receptionist
        </a>
        <a
          href="/rekentool"
          class="inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
        >
          Bereken uw ROI
        </a>
      </div>

      <dl class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-6">
        <div class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
          <div>
            <dt class="text-small font-medium text-(--color-kraan-ink)">AVG + AI Act art. 50</dt>
            <dd class="text-small text-(--color-kraan-stone-500)">Disclosure standaard aan</dd>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
          <div>
            <dt class="text-small font-medium text-(--color-kraan-ink)">Gehost in de EU</dt>
            <dd class="text-small text-(--color-kraan-stone-500)">Cloudflare · Neon · Hetzner</dd>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Icon name="phone-call" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
          <div>
            <dt class="text-small font-medium text-(--color-kraan-ink)">Vlot Nederlands</dt>
            <dd class="text-small text-(--color-kraan-stone-500)">Kent voorrijkosten + spoedtarief</dd>
          </div>
        </div>
      </dl>
    </div>
  </section>

  <!-- 2. Stat band (stone-100) -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16" aria-label="Klantenmotor in cijfers">
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 sm:grid-cols-3">
      <Stat value="28%" label="van uw oproepen wordt gemist." />
      <Stat value="< 60 sec" label="terugbel-SMS na elke gemiste oproep." />
      <Stat value="€450" label="gemiddelde waarde per gemiste klus." />
    </div>
  </section>

  <!-- 3. Transparantie (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">Transparantie</p>
      <div class="mt-3 rounded-(--radius-card) border-l-4 border-(--color-kraan-rust) bg-(--color-kraan-stone-100) p-6 md:p-8">
        <h2 class="font-display text-h2 text-(--color-kraan-ink)">
          Eerlijk over AI, vanaf de eerste seconde.
        </h2>
        <p class="mt-4 text-body text-(--color-kraan-stone-700)">
          Aan het begin van elk gesprek hoort uw klant: "U spreekt met een digitale assistent."
          Wettelijk verplicht onder de EU AI Act art. 50 — en op-brand voor een vakman die niet
          achter automation verstopt. Geen verwarring bij de klant, geen sancties bij de
          toezichthouder.
        </p>
        <p class="mt-4 text-small">
          <a href="/legal/ai-disclosure" class="underline">Lees de volledige disclosure</a>
        </p>
      </div>
    </div>
  </section>

  <!-- 4. Lead form (stone-100) -->
  <section id="contact" class="bg-(--color-kraan-stone-100) py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">Contact</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">Laat ons u terugbellen.</h2>
      <p class="mt-4 max-w-2xl text-h3 text-(--color-kraan-stone-700)">
        Vul het formulier in — wij nemen binnen 1 werkdag contact op om uw situatie door te nemen
        en een demo op uw eigen cijfers in te plannen.
      </p>
      <div class="mt-8 max-w-2xl">
        <LeadForm />
      </div>
    </div>
  </section>
</Base>
