---
/*
 * NL homepage: the four services (plan 2026-11-16-homepage-four-services).
 * Umbrella hero, one card per service, then the receptionist in full (live demo
 * and flow diagram), one band per other service and the close. The old
 * receptionist homepage lives on unchanged at /ai-receptionist/.
 * Prices and links come from src/data/services.ts.
 */
import Base from '../layouts/Base.astro'
import CareDiagram from '../components/diagrams/CareDiagram.astro'
import FlowDiagram from '../components/diagrams/FlowDiagram.astro'
import FollowUpDiagram from '../components/diagrams/FollowUpDiagram.astro'
import VariantsDiagram from '../components/diagrams/VariantsDiagram.astro'
import DemoSection from '../components/home/DemoSection.astro'
import FinalCta from '../components/home/FinalCta.astro'
import ServiceBand from '../components/home/ServiceBand.astro'
import ServiceCards from '../components/home/ServiceCards.astro'
import ServicesHero from '../components/home/ServicesHero.astro'
import { waLink } from '../data/contact'
import { serviceByArea } from '../data/services'

const diensten = {
  eyebrow: 'Diensten',
  heading: 'Vier diensten, één aanspreekpunt.',
  sub: 'Elke dienst heeft een vaste prijs vooraf en een gratis eerste stap. Begin met wat nu het meest knelt.',
  freeLabel: 'Gratis eerste stap',
}

const demo = {
  eyebrow: 'AI-receptionist: probeer het zelf',
  heading: 'Stel de receptionist een vraag zoals uw klant dat zou doen.',
  sub:
    'Dit is een voorbeeldbedrijf, een installateur. Typ een vraag of plan een afspraak. U ' +
    'heeft er geen account voor nodig.',
  asksLabel: 'Stel bijvoorbeeld:',
  asks: [
    'Wat kost het vervangen van een kraan?',
    'Kan er morgenochtend iemand langskomen?',
    'Werken jullie ook in Haarlem?',
  ],
  iframeTitle: 'Live chat met de digitale receptionist van Klantkraan',
  mobileName: 'Van Dijk Installatietechniek',
  mobileTag: 'Digitale assistent · reageert direct',
  mobileHint: 'Chat als een klant. Stel een vraag of plan een afspraak. Opent op volledig scherm.',
  mobileCta: 'Start de demo',
  trust: 'Voorbeeldbedrijf · bij uw eigen receptionist staan uw diensten en tarieven ingesteld',
}

const gesprek = {
  heading: 'Wat de receptionist doet terwijl u aan het werk bent.',
  steps: [
    {
      title: 'Beantwoordt de vraag',
      text: 'Met uw diensten, tarieven en werkgebied. Geen verzonnen prijzen, alleen wat u heeft ingesteld.',
    },
    {
      title: 'Plant de afspraak',
      text: 'Alleen op momenten die in uw agenda vrij zijn. U ziet het meteen.',
    },
    {
      title: 'Noteert wat niet meteen kan',
      text: 'Naam, nummer en klus. U kiest zelf wie u terugbelt.',
    },
  ],
}

// The line under the flow diagram: price, the art. 50 sentence, and the way to the
// full receptionist page and the calculator.
const rec = serviceByArea.receptionist
const receptionistLine = {
  disclosureLead: 'Elk gesprek begint met dezelfde zin:',
  disclosure: 'U chat met een digitale assistent.',
  disclosureTail: 'Die melding is verplicht onder artikel 50 van de EU AI Act, en u kunt hem niet uitzetten.',
  more: 'Alles over de receptionist',
  calc: 'Reken uit wat gemiste aanvragen kosten',
}

const bands = {
  websites: {
    heading: 'Een website die snel, veilig en bijgewerkt blijft.',
    sub:
      'Wij houden uw WordPress-site bij, zodat u er zelf niet naar hoeft te kijken. Begin met de ' +
      'gratis check: in 1 minuut ziet u wat er nu aandacht vraagt.',
    more: 'Meer over website-onderhoud',
    smallLabel: 'Eerst opruimen?',
  },
  automations: {
    heading: 'Offertes en herinneringen die vanzelf de deur uit gaan.',
    sub:
      'Een offerte die niemand opvolgt, een factuur die blijft openstaan: dat werk kan zichzelf ' +
      'doen. We beginnen met een gratis scan van waar u nu tijd verliest. Daarna krijgt u een ' +
      'vaste prijs vooraf.',
    more: 'Meer over automatiseringen',
    smallLabel: 'Klein beginnen?',
  },
  ads: {
    heading: 'Een advertentievideo die weer bekeken wordt.',
    sub:
      'Een video die goed liep, zakt weg zodra mensen de eerste seconden kennen. Van uw bestaande ' +
      'beeld maken we zestien versies, elk met een andere opening, zodat u ziet welke het beste werkt.',
    more: "Meer over advertentievideo's",
    smallLabel: '',
  },
}

const finalCta = {
  h2a: 'Begin klein, of begin',
  h2on: 'gratis.',
  sub:
    'Zie in 1 minuut wat uw website mist, laat uitzoeken waar uw bedrijf tijd verliest, reken uit ' +
    'wat gemiste aanvragen kosten of krijg 3 gratis openingen voor uw advertentievideo. Liever ' +
    'meteen iets geregeld? Begin klein, met een vaste prijs.',
  primary: { label: 'Bekijk wat gratis is', href: '/gratis/' },
  ghosts: [
    { label: 'Klein beginnen', href: '/klein-beginnen/' },
    { label: 'Plan een kennismaking', href: waLink, external: true },
  ],
  photo: {
    src: '/photos/home-van.jpg',
    srcSm: '/photos/home-van-sm.jpg',
    alt: 'Vanuit de cabine van een werkbus in een Nederlandse straat: werkbonnen, een rolmaat en werkhandschoenen op de stoel.',
    width: 928,
    height: 1152,
  },
}
---

<Base
  title="AI-receptionist, websites en automatisering | Klantkraan"
  description="AI-receptionist voor site en WhatsApp, website-onderhoud, automatiseringen en advertentievideo's. Vaste prijzen vooraf en bij elke dienst een gratis eerste stap."
  centered={false}
>
  <ServicesHero />
  <ServiceCards t={diensten} />
  <DemoSection t={demo} />
  <FlowDiagram t={gesprek}>
    <div class="kk-rec-line" data-receptionist-line>
      <p class="kk-rec-price" data-price>
        <span class="kk-rec-amount">{rec.price}</span>
        <span class="kk-rec-note">{rec.priceNote}</span>
      </p>
      <p class="kk-rec-art50">
        {receptionistLine.disclosureLead} <q>{receptionistLine.disclosure}</q>
        {receptionistLine.disclosureTail}
      </p>
      <p class="kk-rec-links">
        <a href={rec.href}>{receptionistLine.more}{'\u00a0'}<span aria-hidden="true">→</span></a>
        <a href={rec.free.href}>{receptionistLine.calc}{'\u00a0'}<span aria-hidden="true">→</span></a>
      </p>
    </div>
  </FlowDiagram>
  <ServiceBand area="websites" t={bands.websites} sunk>
    <CareDiagram />
  </ServiceBand>
  <ServiceBand area="automations" t={bands.automations}>
    <FollowUpDiagram />
  </ServiceBand>
  <ServiceBand area="ads" t={bands.ads} sunk>
    <VariantsDiagram />
  </ServiceBand>
  <FinalCta t={finalCta} />
</Base>

<style>
  .kk-rec-line {
    display: grid;
    gap: 1rem 2.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  @media (min-width: 1024px) {
    .kk-rec-line {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: baseline;
    }
  }
  .kk-rec-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
    margin: 0;
  }
  .kk-rec-amount {
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--color-chalk);
  }
  .kk-rec-note,
  .kk-rec-art50 {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-dim);
  }
  .kk-rec-art50 q {
    quotes: '“' '”';
    color: var(--color-chalk);
  }
  .kk-rec-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 0;
    font-size: var(--text-small);
    font-weight: 550;
  }
  @media (min-width: 1024px) {
    .kk-rec-links {
      flex-direction: column;
      align-items: flex-end;
    }
  }
  /* 44px tap targets: padding grows the hit area, the negative margin keeps the
   * text where it was. The 1.5rem row gap keeps two stacked targets apart. */
  .kk-rec-links a {
    padding: 0.75rem 0;
    margin: -0.75rem 0;
    color: var(--color-sodium);
    text-decoration: none;
  }
  .kk-rec-links a:hover {
    text-decoration: underline;
  }
</style>
