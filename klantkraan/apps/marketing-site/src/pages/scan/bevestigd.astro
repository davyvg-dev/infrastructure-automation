---
/**
 * /scan/bevestigd/: where the button in the confirmation mail lands, once this
 * URL is set as the redirect after confirmation in the Brevo form's settings.
 * Until then Brevo shows its own English "Thank you for subscribing" page.
 */
import ScanShell from '../../components/scan/ScanShell.astro'
import MiniOfferCard from '../../components/MiniOfferCard.astro'
import { KLEIN_BEGINNEN } from '../../data/magnets'
---

<ScanShell
  title="Uw aanvraag is bevestigd | Klantkraan"
  description="Uw aanvraag is bevestigd. Ons antwoord komt per mail."
  noindex
>
  <section class="scan-card scan-done">
    <span class="scan-tick" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
        <path
          d="M5 12.5l4.5 4.5L19 7.5"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
    <h1>Gelukt, we gaan aan de slag</h1>
    <p>
      Uw aanvraag is bevestigd. We lezen hem zelf en ons antwoord komt in deze mailbox, met
      Klantkraan als afzender.
    </p>
    <p class="scan-done-hint">
      Wilt u nog iets toevoegen? Antwoord op de mail die u net van ons kreeg.
    </p>
  </section>

  {/* After the magnet. Every Brevo form lands here (one redirect setting), so this is the
      scan's own offer; the other magnets already showed theirs in-page. */}
  <div class="scan-after">
    <MiniOfferCard area="automations" kicker="Liever meteen geregeld?" />
    <p class="scan-sign">
      Iets anders? <a href={KLEIN_BEGINNEN}>Alle vaste prijzen</a>
    </p>
  </div>
</ScanShell>

<style is:global>
  .scan-after {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 16px;
  }
  .scan-after .scan-sign a {
    color: var(--d-ink);
    font-weight: 600;
  }
</style>
