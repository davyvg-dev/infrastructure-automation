---
import Base from '../layouts/Base.astro'
import FlowDiagram from '../components/diagrams/FlowDiagram.astro'
import Icon from '../components/Icon.astro'
import Stat from '../components/Stat.astro'
import Dumbbell from '../components/illustrations/Dumbbell.astro'
import RiskReversal from '../components/RiskReversal.astro'
import PhotoBand from '../components/PhotoBand.astro'

// Sportscholen landing page — first non-trades vertical. Follows the /loodgieters
// template structure; copy per klantkraan/docs/09-brand/voice-and-tone.md (u-form,
// concrete cijfers, no emojis), with gym vocabulary (proefles, abonnement, rooster)
// instead of trade nouns. Links to the fitness demo at /demo/sportscholen/.

interface PainStat {
  value: string
  caption: string
}

const painStats: PainStat[] = [
  {
    value: "'s Avonds",
    caption: 'komen de meeste proeflesaanvragen binnen, als de balie dicht is.',
  },
  {
    value: '21×',
    caption: 'meer kans op contact als u een aanvraag binnen 5 minuten beantwoordt.',
  },
  { value: '€\u00a0480', caption: 'jaarwaarde van één gemist lid, bij € 40 per maand.' },
]

interface Feature {
  icon: 'phone' | 'message-square' | 'calendar-check'
  title: string
  body: string
}

const features: Feature[] = [
  {
    icon: 'message-square',
    title: 'Antwoord op elk bericht, ook om 22:00',
    body: 'Beantwoordt vragen over abonnementen, openingstijden en lessen, op uw website en in WhatsApp, in vlot Nederlands, ook in het weekend. Noemt alleen tarieven die u zelf heeft ingesteld.',
  },
  {
    icon: 'calendar-check',
    title: 'Proeflessen direct in de agenda',
    body: 'De receptionist plant proeflessen, rondleidingen en PT-kennismakingen rechtstreeks in uw agenda, alleen op momenten die u zelf heeft vrijgegeven. Wie om 22:00 een proefles aanvraagt, staat de volgende ochtend al ingepland.',
  },
  {
    icon: 'phone',
    title: 'Elke aanvraag op uw telefoon',
    body: 'Elke proeflesaanvraag en elk terugbelverzoek komt direct als bericht op uw telefoon binnen, met naam, nummer en de vraag. Geen aanvraag blijft hangen in een onbeantwoord privébericht.',
  },
]

interface Faq {
  q: string
  a: string
  href?: string
  linkLabel?: string
}

const faqs: Faq[] = [
  {
    q: 'Hoe komt de receptionist op mijn website?',
    a: 'Wij plaatsen één klein script op uw website en koppelen uw WhatsApp. U hoeft zelf niets te doen. U houdt uw eigen site, nummer en huisstijl.',
  },
  {
    q: 'Wij hebben al een balie. Wat voegt dit toe?',
    a: 'Tijdens de les, in het weekend en om 22:00 is de balie er niet, en juist dan zoeken mensen een sportschool. De receptionist vangt op wat buiten de baliediensten binnenkomt en plant de proefles in. Uw team blijft op de vloer.',
  },
  {
    q: 'Weet de bezoeker dat het AI is?',
    a: 'Ja. Elk gesprek begint met de melding dat de bezoeker met een digitale assistent van uw sportschool chat. Dat is wettelijk verplicht (artikel 50 van de Europese AI-verordening), dus die melding staat altijd aan.',
    href: '/legal/ai-disclosure/',
    linkLabel: 'Lees de volledige AI-disclosure',
  },
  {
    q: 'Wat als de AI iets verkeerd zegt over abonnementsprijzen?',
    a: 'Dat kan niet gebeuren. De assistent noemt alleen tarieven die u zelf heeft ingesteld: abonnementen, proefles, personal training. Kent hij een prijs niet, dan verzint hij niets en biedt hij de bezoeker een terugbelverzoek of adviesgesprek aan. Wij testen elke instelling voordat u live gaat.',
  },
  {
    q: 'Kan hij ook opzeggingen en pauzes afhandelen?',
    a: 'Hij neemt ze aan: hij noteert het verzoek, plant zo nodig een gesprek in en geeft het direct aan u door. Over abonnementen beslist uw team; de receptionist zorgt dat geen verzoek blijft liggen.',
  },
  {
    q: 'Wat gebeurt er met de gegevens van mijn leden?',
    a: 'Gesprekken en afspraken staan op onze server in Duitsland (Hetzner, Neurenberg). Voor de antwoorden gaan chatberichten naar Anthropic in de VS, onder de EU-standaardcontractbepalingen. Wij tekenen een verwerkersovereenkomst met u en bewaren chatgesprekken 30 dagen, of korter als u dat wilt. Al onze subverwerkers staan in een openbare lijst.',
    href: '/legal/dpa/',
    linkLabel: 'Lees de verwerkersovereenkomst',
  },
  {
    q: 'Is het echt per maand opzegbaar?',
    a: 'Ja. U zegt op met één mail, wanneer u wilt. Er is geen jaarcontract en geen verborgen verlenging. De receptionist werkt tot het einde van de betaalde maand; daarna incasseren wij niets meer. Betaalt u liever 6 of 12 maanden vooruit, dan krijgt u 15% of 20% korting.',
    href: '/legal/voorwaarden/',
    linkLabel: 'Lees de algemene voorwaarden',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]+>/g, ''),
    },
  })),
}
---

<Base
  title="Leden werven voor uw sportschool: receptionist voor proeflessen"
  description="Digitale receptionist voor sportscholen. Beantwoordt vragen over abonnementen en lessen en plant proeflessen in uw agenda, ook 's avonds en in het weekend."
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div
      class="mx-auto grid max-w-page gap-10 px-gutter md:grid-cols-[1fr_auto] md:items-center md:gap-16"
    >
      <div>
        <h1 class="font-display text-hero text-chalk">
          De <span class="text-(--color-sodium)">Klantenmotor</span> voor sportscholen.
        </h1>
        <p class="mt-6 max-w-2xl text-[1.125rem] text-dim leading-relaxed">
          Geeft u les, dan beantwoordt onze digitale receptionist de vraag over abonnementen of een
          proefles, op uw website en in WhatsApp, met uw rooster en tarieven erbij. Ook 's avonds, in het
          weekend en op feestdagen. De proefles staat direct in uw agenda.
        </p>
        <div class="mt-10 btn-row">
          <a href="/demo/sportscholen/" class="btn btn-primary btn-lg"> Probeer de demo </a>
          <a href="/prijzen/" class="btn btn-ghost btn-lg"> Bekijk prijzen </a>
        </div>
      </div>
      <div class="hidden text-(--color-dim) md:block">
        <Dumbbell class="h-64 w-64 lg:h-72 lg:w-72" />
      </div>
    </div>
    <div class="mx-auto max-w-page px-gutter">
      <ul role="list" class="fact-row mt-10">
        <li><span class="text-(--color-chalk)">AVG + AI Act art. 50</span> <span>AI-melding altijd aan</span></li>
        <li><span class="text-(--color-chalk)">Gehost in de EU</span> <span>Cloudflare · Neon · Hetzner</span></li>
        <li><span class="text-(--color-chalk)">Vlot Nederlands</span> <span>Kent uw rooster en abonnementen</span></li>
      </ul>
      <p class="mt-8 text-small text-dim">
        Per maand opzegbaar · Wij richten alles in · 50% korting eerste maand
      </p>
    </div>
  </section>

  <section class="pb-10 md:pb-16">
    <PhotoBand
      slug="sportscholen"
      alt="Lid meldt zich bij de balie van de sportschool"
      caption="Druk aan de balie. Uw receptionist antwoordt wél."
      focus="50% 40%"
    />
  </section>

  <!-- 1b. Risk-reversal -->
  <RiskReversal />

  <!-- 2. Pijn-stats trio (stone-100) -->
  <section
    class="border-y border-(--color-line) py-8 md:py-10"
    aria-label="Wat een gemiste aanvraag kost"
  >
    <div class="mx-auto max-w-page px-gutter">
      <div class="stat-row">
      {painStats.map((stat) => <Stat value={stat.value} label={stat.caption} />)}
      </div>
    </div>
  </section>

  <!-- 3. Wat Klantkraan doet, als schema: de drie modules zijn de drie uitgangen -->
  <FlowDiagram
    id="modules"
    nodeSub='voor sportscholen'
    t={{
      label: 'Modules',
      heading: 'Wat Klantkraan doet voor sportscholen',
      sub: 'Drie modules voor één maandprijs, gebouwd voor de eigenaar die vaker op de vloer staat dan achter de balie.',
      steps: features.map((f) => ({ title: f.title, text: f.body })),
    }}
  />

  <!-- 4. ROI snippet (cream; inner white card) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      
      <h2 class="font-display text-h1 text-chalk">Reken het even na</h2>
      <div
        class="mt-8 frame bg-(--color-panel) p-6 md:p-10"
      >
        <p class="text-h3 text-chalk">
          Blijven er 4 proeflesaanvragen per maand onbeantwoord, à € 480 jaarwaarde? Dat is
          <strong class="text-(--color-sodium)">ruim € 23.000 gemiste omzet per jaar</strong>.
        </p>
        <p class="mt-4 text-body text-dim">
          Klantkraan Chat kost € 299 per maand. Eén extra lid per maand en u staat quitte. Elk lid
          daarna is extra omzet.
        </p>
        <div class="mt-6 btn-row">
          <a href="/demo/sportscholen/" class="btn btn-primary btn-lg"> Probeer de demo </a>
          <a href="/prijzen/" class="btn btn-ghost btn-lg"> Bekijk prijzen </a>
        </div>
        <p class="mt-6 text-micro text-dim">
          Bedragen excl. 21% btw. Rekenvoorbeeld met een gemiddeld abonnement van € 40 per maand en
          een gemiddelde lidmaatschapsduur van 12 maanden. Het cijfer over reageren binnen 5 minuten
          komt uit het lead-response-onderzoek van Harvard Business Review / InsideSales.
        </p>
      </div>
    </div>
  </section>

  <!-- 5. FAQ (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      
      <h2 class="font-display text-h1 text-chalk">Veelgestelde vragen</h2>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          faqs.map((faq) => (
            <details class="group py-4">
              <summary class="block min-h-[2.75rem] cursor-pointer list-none py-1 font-display text-h3 text-chalk marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{faq.q}</span>
                  <Icon
                    name="chevron-down"
                    class="mt-1 h-5 w-5 shrink-0 text-(--color-dim) transition-transform group-open:rotate-180"
                  />
                </span>
              </summary>
              <p class="mt-3 text-body text-dim">{faq.a}</p>
              {faq.href && faq.linkLabel && (
                <p class="mt-3 text-small">
                  <a href={faq.href} class="underline">
                    {faq.linkLabel}
                  </a>
                </p>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. Eind-CTA band (blue) -->
  <section class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      <h2 class="font-display text-h1 text-chalk">Boek een proefles in de demo</h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        In één gesprek ziet u hoe een vraag over het abonnement eindigt als proefles in de agenda.
      </p>
      <div class="mt-8 btn-row">
        <a href="/demo/sportscholen/" class="btn btn-primary btn-lg"> Probeer de demo </a>
        <a href="/prijzen/" class="btn btn-ghost btn-lg"> Bekijk prijzen </a>
      </div>
    </div>
  </section>


  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Base>
