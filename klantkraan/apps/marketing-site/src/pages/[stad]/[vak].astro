---
// Programmatic SEO route /[stad]/[vak] — Wave 1 (10 pages).
// Blueprint: research/programmatic-seo-blueprint.md §5 (template) + §6
// (thin-content prevention). Each rendered page MUST contain a city-unique
// intro paragraph, a niche-in-city paragraph, ≥2 city-named FAQs, and 3-5
// internal links (cornerstone up, lateral cities, cross-niche in same stad).

import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import Stat from '../../components/Stat.astro'
import { cities, type CitySlug } from '../../data/cities'
import { niches, type NicheSlug, type Faq } from '../../data/niches'
import { wave1, nichesForCity, citiesForNiche } from '../../data/wave1'

export function getStaticPaths() {
  return wave1.map((combo) => ({
    params: { stad: combo.city, vak: combo.niche },
    props: { citySlug: combo.city, nicheSlug: combo.niche },
  }))
}

interface Props {
  citySlug: CitySlug
  nicheSlug: NicheSlug
}

const { citySlug, nicheSlug } = Astro.props
const city = cities[citySlug]
const niche = niches[nicheSlug]
const combo = wave1.find((c) => c.city === citySlug && c.niche === nicheSlug)!

const pageTitle = `${niche.label} in ${city.name}: Klantkraan AI-receptionist`
const pageDescription = `${niche.label} in ${city.name}? De AI-receptionist beantwoordt vragen via chat en WhatsApp, plant afspraken en vangt leads — 24/7. Per maand opzegbaar.`

// Merge FAQs: 2 city-named first (per blueprint thin-content rule), then 4 base.
const faqs: Faq[] = [...combo.cityFaqs, ...niche.baseFaqs]

// Lateral cities: other G4 stads with same niche (same-niche, different city).
const lateralCities = citiesForNiche(nicheSlug).filter((c) => c !== citySlug)

// Cross-niche links: other Wave-1 niches in the same city.
const sameCityCrossNiches = nichesForCity(citySlug).filter((n) => n !== nicheSlug)

// ROI snippet: rough city-tier multiplier on top of base job value.
const jobValueWithTier =
  city.priceTier === 'hoog'
    ? Math.round(niche.jobValueEur * 1.25)
    : city.priceTier === 'gemiddeld-hoog'
      ? Math.round(niche.jobValueEur * 1.12)
      : niche.jobValueEur

// ---- Structured data
const canonical = new URL(`/${citySlug}/${nicheSlug}/`, Astro.site).toString()

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]+>/g, ''),
    },
  })),
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: niche.label,
      item: new URL(niche.cornerstonePath, Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: `${niche.label} in ${city.name}`,
      item: canonical,
    },
  ],
}

// Service schema for Klantkraan describing the AI-receptionist for this trade
// in this stad. NOT a LocalBusiness wrapper around the tradesperson — that
// would be misleading. We describe the SOFTWARE service with areaServed.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Klantkraan AI-receptionist voor ${niche.labelPlural} in ${city.name}`,
  description: pageDescription,
  provider: {
    '@type': 'Organization',
    name: 'Klantkraan',
    url: new URL('/', Astro.site).toString(),
  },
  areaServed: {
    '@type': 'City',
    name: city.name,
  },
  serviceType: `AI-receptionist voor ${niche.labelPlural}`,
  url: canonical,
}
---

<Base title={pageTitle} description={pageDescription} canonical={canonical} centered={false}>
  <!-- 1. Hero -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <nav class="text-small text-(--color-kraan-stone-500)" aria-label="Kruimelpad">
        <a href="/" class="hover:underline">Home</a>
        <span aria-hidden="true"> › </span>
        <a href={niche.cornerstonePath} class="hover:underline">{niche.label}</a>
        <span aria-hidden="true"> › </span>
        <span>{city.name}</span>
      </nav>
      <h1 class="mt-4 font-display text-hero text-(--color-kraan-ink)">
        {niche.label} in <span class="text-(--color-kraan-rust)">{city.name}</span>.
      </h1>
      <p class="mt-6 max-w-2xl text-h3 text-(--color-kraan-stone-700)">
        Een Nederlandstalige digitale receptionist op uw website en WhatsApp die uw tarieven kent
        en klantvragen 24/7 beantwoordt. Ook wanneer u in {city.name} op locatie zit.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/demo/"
          class="inline-block rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
        >
          Probeer de demo
        </a>
        <a
          href="/rekentool/"
          class="inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
        >
          Bereken uw ROI
        </a>
      </div>
      <p class="mt-8 text-small text-(--color-kraan-stone-500)">
        Per maand opzegbaar · Done-for-you setup · 50% korting eerste maand
      </p>
    </div>
  </section>

  <!-- 2. Pijn-stats -->
  <section
    class="bg-(--color-kraan-stone-100) py-10 md:py-16"
    aria-label={`Wat een gemiste ${niche.label.toLowerCase()}-oproep in ${city.name} kost`}
  >
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 sm:grid-cols-3">
      {niche.painStats.map((stat) => <Stat value={stat.value} label={stat.caption} />)}
    </div>
  </section>

  <!-- 3. City intro paragraph (thin-content firewall — ≥100 city-unique words) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">
        {city.name}
      </p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">
        De markt voor {niche.labelPlural} in {city.name}.
      </h2>
      <p class="mt-6 max-w-3xl text-body text-(--color-kraan-stone-700)">{city.intro}</p>
      <p class="mt-6 max-w-3xl text-body text-(--color-kraan-stone-700)">{combo.nicheNote}</p>
    </div>
  </section>

  <!-- 4. Three modules -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">
        Modules
      </p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">
        Wat Klantkraan doet voor {niche.labelPlural} in {city.name}.
      </h2>
      <div class="mt-10 divide-y divide-(--color-kraan-stone-300) border-y border-(--color-kraan-stone-300)">
        {
          niche.features.map((feature) => (
            <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
              <Icon name={feature.icon} class="mt-1 h-7 w-7 text-(--color-kraan-blue)" />
              <div>
                <h3 class="font-display text-h3 text-(--color-kraan-ink)">{feature.title}</h3>
                <p class="mt-2 text-body text-(--color-kraan-stone-700)">{feature.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 5. Neighbourhood + price context -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">
        Werkgebied
      </p>
      <h2 class="mt-3 font-display text-h2 text-(--color-kraan-ink)">
        Wij ondersteunen {niche.labelPlural} in heel {city.name}.
      </h2>
      <p class="mt-4 max-w-3xl text-body text-(--color-kraan-stone-700)">
        Aangesloten {niche.labelPlural} werken in alle wijken van {city.name}, met name in {
          city.neighbourhoods.slice(0, -1).join(', ')
        } en {city.neighbourhoods[city.neighbourhoods.length - 1]}.
      </p>
      <ul class="mt-6 grid max-w-3xl grid-cols-2 gap-2 text-body text-(--color-kraan-stone-700) sm:grid-cols-3 md:grid-cols-4">
        {city.neighbourhoods.map((b) => <li class="font-mono text-small">· {b}</li>)}
      </ul>
      <p class="mt-8 max-w-3xl text-body text-(--color-kraan-stone-700)">{city.priceContext}</p>
    </div>
  </section>

  <!-- 6. ROI snippet -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">
        Rekensom
      </p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">Reken het even na.</h2>
      <div
        class="mt-8 rounded-(--radius-card) border border-(--color-kraan-stone-300) bg-white p-6 md:p-10"
      >
        <p class="text-h3 text-(--color-kraan-ink)">
          Mist u 10 oproepen per week à €{jobValueWithTier.toLocaleString('nl-NL')} in {city.name}? Dat is
          <strong class="text-(--color-kraan-rust)">
            €{(jobValueWithTier * 10 * 52 * 0.33).toLocaleString('nl-NL', { maximumFractionDigits: 0 })} verloren omzet per jaar
          </strong>.
        </p>
        <p class="mt-4 text-body text-(--color-kraan-stone-700)">
          Klantkraan Chat is €299 per maand. Voor {niche.labelPlural} in {city.name} verdiend zodra
          u één extra klus per maand herwint. Wat erna binnenkomt is marge.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/rekentool/"
            class="inline-block rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
          >
            Open de rekentool
          </a>
          <a
            href="/prijzen/"
            class="inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
          >
            Bekijk de tarieven
          </a>
        </div>
        <p class="mt-6 text-micro text-(--color-kraan-stone-500)">
          Bedragen excl. 21% BTW. Tarief geïndexeerd op {city.name} ({city.priceTier}) bovenop het
          landelijke gemiddelde van €{niche.jobValueEur} per gemiste klus.
        </p>
      </div>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">
        Vragen
      </p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">
        Veelgestelde vragen over {niche.labelPlural} in {city.name}.
      </h2>
      <div
        class="mt-10 divide-y divide-(--color-kraan-stone-300) border-y border-(--color-kraan-stone-300)"
      >
        {
          faqs.map((faq) => (
            <details class="group py-4">
              <summary class="block min-h-[2.75rem] cursor-pointer list-none py-1 font-display text-h3 text-(--color-kraan-ink) marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{faq.q}</span>
                  <Icon
                    name="chevron-down"
                    class="mt-1 h-5 w-5 shrink-0 text-(--color-kraan-blue) transition-transform group-open:rotate-180"
                  />
                </span>
              </summary>
              <p class="mt-3 text-body text-(--color-kraan-stone-700)">{faq.a}</p>
              {faq.href && faq.linkLabel && (
                <p class="mt-3 text-small">
                  <a href={faq.href} class="underline">
                    {faq.linkLabel}
                  </a>
                </p>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 8. Internal-linking block -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">
        Verder lezen
      </p>
      <h2 class="mt-3 font-display text-h2 text-(--color-kraan-ink)">
        Andere {niche.labelPlural}-pagina's en diensten.
      </h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        <div>
          <h3 class="font-display text-h3 text-(--color-kraan-ink)">Landelijke pagina</h3>
          <ul class="mt-3 space-y-1 text-body text-(--color-kraan-stone-700)">
            <li>
              <a href={niche.cornerstonePath} class="text-(--color-kraan-blue) underline">
                {niche.label}: landelijke pagina
              </a>
            </li>
          </ul>
        </div>
        {
          lateralCities.length > 0 && (
            <div>
              <h3 class="font-display text-h3 text-(--color-kraan-ink)">
                {niche.label} in andere steden
              </h3>
              <ul class="mt-3 space-y-1 text-body text-(--color-kraan-stone-700)">
                {lateralCities.map((c) => (
                  <li>
                    <a
                      href={`/${c}/${nicheSlug}/`}
                      class="text-(--color-kraan-blue) underline"
                    >
                      {niche.label} in {cities[c].name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          sameCityCrossNiches.length > 0 && (
            <div>
              <h3 class="font-display text-h3 text-(--color-kraan-ink)">
                Andere vakmensen in {city.name}
              </h3>
              <ul class="mt-3 space-y-1 text-body text-(--color-kraan-stone-700)">
                {sameCityCrossNiches.map((n) => (
                  <li>
                    <a
                      href={`/${citySlug}/${n}/`}
                      class="text-(--color-kraan-blue) underline"
                    >
                      {niches[n].label} in {city.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- 9. Final CTA -->
  <section class="bg-(--color-kraan-blue) py-10 md:py-16 text-white">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="font-display text-h1 text-white">
        Klaar om geen klus in {city.name} meer te missen?
      </h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-kraan-stone-100)">
        Een live demo via WhatsApp is de snelste manier om te zien wat Klantkraan voor uw bedrijf
        in {city.name} doet.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/demo/"
          class="inline-block rounded-(--radius-button) bg-white px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
        >
          Probeer de demo
        </a>
        <a
          href="/prijzen/"
          class="inline-block rounded-(--radius-button) border border-white px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
        >
          Bekijk prijzen
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
</Base>
