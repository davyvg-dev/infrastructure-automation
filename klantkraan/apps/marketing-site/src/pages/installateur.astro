---
import Base from '../layouts/Base.astro'
import FlowDiagram from '../components/diagrams/FlowDiagram.astro'
import VerderLezen from '../components/VerderLezen.astro'
import Icon from '../components/Icon.astro'
import Stat from '../components/Stat.astro'
import Radiator from '../components/illustrations/Radiator.astro'
import RiskReversal from '../components/RiskReversal.astro'
import PhotoBand from '../components/PhotoBand.astro'

// Installateur landing page. Follows the /loodgieters template structure.
// Trade-specific copy: CV-storing, onderhoud, geiser, vorstperiode-piek.

interface PainStat {
  value: string
  caption: string
}

const painStats: PainStat[] = [
  { value: '62%', caption: 'van uw cv-storingen komt binnen in januari en februari.' },
  { value: '€\u00a0340', caption: 'gemiddelde waarde van een bezoek voor een cv-storing.' },
  { value: '4×', caption: 'meer onderhoudsaanvragen in september en oktober.' },
]

interface Feature {
  icon: 'phone' | 'message-square' | 'calendar-check'
  title: string
  body: string
}

const features: Feature[] = [
  {
    icon: 'message-square',
    title: 'Herkent een cv-storing',
    body: "Beantwoordt klantvragen op uw website en in WhatsApp, in vlot Nederlands, ook 's avonds en in het weekend. Noemt uw eigen tarief voor cv-onderhoud, uw voorrijkosten en uw spoedtoeslag bij vorst.",
  },
  {
    icon: 'calendar-check',
    title: 'Afspraken direct in uw agenda',
    body: 'De receptionist plant onderhouds- en storingsafspraken rechtstreeks in uw agenda, alleen op momenten die u zelf heeft vrijgegeven. Spoed staat apart van regulier onderhoud, zodat u weet wat eerst moet.',
  },
  {
    icon: 'phone',
    title: 'Aanvragen en terugbelverzoeken op uw telefoon',
    body: 'Komt er in de vorst een cv-storing binnen, dan staat de melding direct als bericht op uw telefoon, met naam, nummer en de vraag. Zo gaat geen klant naar de concurrent terwijl u bij een andere noodreparatie bent.',
  },
]

interface Faq {
  q: string
  a: string
  href?: string
  linkLabel?: string
}

const faqs: Faq[] = [
  {
    q: 'Hoe komt de receptionist op mijn website?',
    a: 'Wij plaatsen één klein script op uw website en koppelen uw WhatsApp. U hoeft zelf niets te doen. U houdt uw eigen site, nummer en huisstijl.',
  },
  {
    q: 'Wat als ik op een klus ben en niet kan reageren?',
    a: 'Dan beantwoordt de receptionist de vraag (cv-spoed, jaarlijks onderhoud, nieuwe klus, leverancier), plant zo nodig een afspraak in uw agenda en stuurt u een samenvatting per WhatsApp of e-mail. U belt terug tussen twee klussen door.',
  },
  {
    q: 'Kan de receptionist de drukte in januari aan?',
    a: 'Ja. De receptionist voert gesprekken tegelijk, zonder wachtrij. Chatten of appen tien klanten tegelijk over een cv-storing, dan krijgen ze alle tien direct antwoord. Spoedstoringen herkent hij en houdt hij apart van regulier onderhoud, zodat u weet wie u eerst belt.',
  },
  {
    q: 'Weet de klant dat het AI is?',
    a: 'Ja. Elk gesprek begint met de melding dat de klant met een digitale assistent van uw bedrijf chat. Dat is wettelijk verplicht (artikel 50 van de Europese AI-verordening), dus die melding staat altijd aan.',
    href: '/legal/ai-disclosure/',
    linkLabel: 'Lees de volledige AI-disclosure',
  },
  {
    q: 'Wat als de AI iets verkeerd zegt over mijn tarieven?',
    a: 'Dat kan niet gebeuren. De assistent noemt alleen tarieven die u zelf heeft ingesteld: voorrijkosten, cv-onderhoud, cv-spoed en geisers. Kent hij een prijs niet, dan verzint hij niets en krijgt de klant een terugbelverzoek. Wij testen elke instelling voordat u live gaat.',
  },
  {
    q: 'Wat gebeurt er met de klantgegevens?',
    a: 'Wij hosten in de EU: Hetzner Frankfurt, Neon EU en Cloudflare EU. Wij tekenen een verwerkersovereenkomst met u en bewaren chatgesprekken 30 dagen, of korter als u dat wilt. Al onze subverwerkers staan in een openbare lijst.',
    href: '/legal/dpa/',
    linkLabel: 'Lees de verwerkersovereenkomst',
  },
  {
    q: 'Is het echt per maand opzegbaar?',
    a: 'Ja. U zegt op met één mail, wanneer u wilt. Er is geen jaarcontract en geen verborgen verlenging. De receptionist werkt tot het einde van de betaalde maand; daarna incasseren wij niets meer. Betaalt u liever 6 of 12 maanden vooruit, dan krijgt u 15% of 20% korting.',
    href: '/legal/voorwaarden/',
    linkLabel: 'Lees de algemene voorwaarden',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]+>/g, ''),
    },
  })),
}
---

<Base
  title="Klanten werven als installateur: AI-receptionist voor cv-werk"
  description="AI-receptionist voor installateurs, per maand opzegbaar. Kent uw cv-tarieven en spoedtoeslag, vangt de drukte in januari op en plant afspraken via chat en WhatsApp."
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div
      class="mx-auto grid max-w-page gap-10 px-gutter md:grid-cols-[1fr_auto] md:items-center md:gap-16"
    >
      <div>
        <h1 class="font-display text-hero text-chalk">
          De <span class="text-(--color-sodium)">Klantenmotor</span> voor installateurs.
        </h1>
        <p class="mt-6 max-w-2xl text-[1.125rem] text-dim leading-relaxed">
          Een digitale receptionist op uw website en in WhatsApp die een cv-storing herkent en niet
          verwart met een vraag over de jaarlijkse onderhoudsbeurt. Hij vangt de piek in januari en de
          onderhoudsdrukte in oktober op, ook 's avonds en in het weekend.
        </p>
        <div class="mt-10 btn-row">
          <a href="/demo/" class="btn btn-primary btn-lg"> Probeer de demo </a>
          <a href="/rekentool/" class="btn btn-ghost btn-lg"> Open de rekentool </a>
        </div>
      </div>
      <div class="hidden text-(--color-dim) md:block">
        <Radiator class="h-64 w-64 lg:h-72 lg:w-72" />
      </div>
    </div>
    <div class="mx-auto max-w-page px-gutter">
      <ul role="list" class="fact-row mt-10">
        <li><span class="text-(--color-chalk)">AVG + AI Act art. 50</span> <span>AI-melding altijd aan</span></li>
        <li><span class="text-(--color-chalk)">Gehost in de EU</span> <span>Cloudflare · Neon · Hetzner</span></li>
        <li><span class="text-(--color-chalk)">Vlot Nederlands</span> <span>Kent cv-tarief en spoedtoeslag</span></li>
      </ul>
      <p class="mt-8 text-small text-dim">
        Per maand opzegbaar · Wij richten alles in · 50% korting eerste maand
      </p>
    </div>
  </section>

  <section class="pb-10 md:pb-16">
    <PhotoBand
      slug="installateurs"
      alt="Monteur controleert de buitenunit van een warmtepomp"
      caption="Bij de buitenunit. Uw receptionist antwoordt wél."
    />
  </section>

  <!-- 1b. Risk-reversal -->
  <RiskReversal />

  <!-- 2. Pijn-stats trio (stone-100) -->
  <section
    class="border-y border-(--color-line) py-8 md:py-10"
    aria-label="Wat seizoenpieken een installateur kosten"
  >
    <div class="mx-auto max-w-page px-gutter">
      <div class="stat-row">
      {painStats.map((stat) => <Stat value={stat.value} label={stat.caption} />)}
      </div>
    </div>
  </section>

  <!-- 3. Wat Klantkraan doet, als schema: de drie modules zijn de drie uitgangen -->
  <FlowDiagram
    id="modules"
    nodeSub='voor installateurs'
    t={{
      label: 'Modules',
      heading: 'Wat Klantkraan doet voor installateurs',
      sub: 'Drie modules voor één maandprijs, gebouwd voor de installateur die de januaripiek niet meer aan zijn partner wil overlaten.',
      steps: features.map((f) => ({ title: f.title, text: f.body })),
    }}
  />

  <!-- 4. ROI snippet (stone-100) -->
  <section class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      
      <h2 class="font-display text-h1 text-chalk">Reken het even na</h2>
      <div
        class="mt-8 frame bg-(--color-panel) p-6 md:p-10"
      >
        <p class="text-h3 text-chalk">
          Mist u 7 oproepen per week à € 340? Dat is <strong class="text-(--color-sodium)"
            >circa € 41.000 verloren omzet per jaar</strong
          >.
        </p>
        <p class="mt-4 text-body text-dim">
          Klantkraan Chat kost € 299 per maand. Eén extra cv-spoedklus in januari dekt het
          abonnement. Wat daarna binnenkomt, is extra omzet, en uw klant zit niet drie uur in een koud huis.
        </p>
        <div class="mt-6 btn-row">
          <a href="/rekentool/" class="btn btn-primary btn-lg"> Open de rekentool </a>
          <a href="/prijzen/" class="btn btn-ghost btn-lg"> Bekijk prijzen </a>
        </div>
        <p class="mt-6 text-micro text-dim">
          Bedragen excl. 21% btw. Rekenvoorbeeld met een branchegemiddelde van € 340 per oproep voor
          cv- en geiserstoringen (bron: Aira / Invoca missed-call benchmarks) en de aanname dat
          ongeveer 1 op 3 gemiste oproepen een betaalde klus had opgeleverd.
        </p>
      </div>
    </div>
  </section>

  <!-- 5. FAQ (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      
      <h2 class="font-display text-h1 text-chalk">Veelgestelde vragen</h2>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          faqs.map((faq) => (
            <details class="group py-4">
              <summary class="block min-h-[2.75rem] cursor-pointer list-none py-1 font-display text-h3 text-chalk marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{faq.q}</span>
                  <Icon
                    name="chevron-down"
                    class="mt-1 h-5 w-5 shrink-0 text-(--color-dim) transition-transform group-open:rotate-180"
                  />
                </span>
              </summary>
              <p class="mt-3 text-body text-dim">{faq.a}</p>
              {faq.href && faq.linkLabel && (
                <p class="mt-3 text-small">
                  <a href={faq.href} class="underline">
                    {faq.linkLabel}
                  </a>
                </p>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Verder lezen: gids + blog voor deze branche -->
  <VerderLezen vertical="installateur" />

  <!-- 6. Final CTA (blue) -->
  <section class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      <h2 class="font-display text-h1 text-chalk">Test hem vóór het stookseizoen</h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        Meld in de live demo een cv-storing. U ziet of hij die herkent en hoe hij hem scheidt van een
        vraag over de onderhoudsbeurt.
      </p>
      <div class="mt-8 btn-row">
        <a href="/demo/" class="btn btn-primary btn-lg"> Probeer de demo </a>
        <a href="/prijzen/" class="btn btn-ghost btn-lg"> Bekijk prijzen </a>
      </div>
    </div>
  </section>


  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Base>
