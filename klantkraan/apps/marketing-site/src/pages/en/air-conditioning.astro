---
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import Stat from '../../components/Stat.astro'
import RingingPhone from '../../components/illustrations/RingingPhone.astro'
import PhotoBand from '../../components/PhotoBand.astro'

// English landing page for the air-conditioning / HVAC ICP. Follows the Dutch
// /installateur template structure; self-contained (no Dutch-copy components).

interface PainStat {
  value: string
  caption: string
}

const painStats: PainStat[] = [
  {
    value: '24/7',
    caption: 'the receptionist answers. A no-cooling question at 9pm gets a reply on the spot.',
  },
  {
    value: '28%',
    caption: "of calls to tradespeople go unanswered, usually because you're on a job.",
  },
  {
    value: '€450',
    caption: 'average value of a missed enquiry. One saved install pays for months.',
  },
]

interface Feature {
  icon: 'phone' | 'message-square' | 'calendar-check'
  title: string
  body: string
}

const features: Feature[] = [
  {
    icon: 'message-square',
    title: 'Handles the summer rush',
    body: 'Answers questions on your website and via WhatsApp, in natural English, evenings and weekends included. Quotes your own rates for a service, a recharge or a new install, and tells an urgent no-cooling call apart from a routine maintenance booking.',
  },
  {
    icon: 'calendar-check',
    title: 'Appointments straight into your calendar',
    body: "Service visits and installations are booked directly into your calendar, only in the slots you've released. Urgent breakdowns are separated from routine jobs, so you know what comes first.",
  },
  {
    icon: 'phone',
    title: 'Leads and callbacks on your phone',
    body: "When a unit goes down in a heatwave, the receptionist takes the details and sends them straight to your phone as a message, with name, number and the question. No customer walks to a competitor while you're on another job.",
  },
]

interface Faq {
  q: string
  a: string
  href?: string
  linkLabel?: string
}

const faqs: Faq[] = [
  {
    q: 'How does the receptionist get onto my website?',
    a: "With one small script that we install for you. We connect WhatsApp in the same setup. You keep your own site, number and branding.",
  },
  {
    q: "And if I'm on a job and can't reply?",
    a: "The receptionist answers the question (urgent no-cooling, a service, a recharge, a new install), books an appointment in your calendar if wanted, and sends you a summary by WhatsApp or email. You call back between jobs.",
  },
  {
    q: 'Can it handle the summer peak?',
    a: 'Yes. The receptionist handles conversations in parallel, so there is no queue. Ten customers can chat or message about a broken unit at once and all ten get an instant answer. Urgent breakdowns are recognised and separated from routine servicing, so you know who to call first.',
  },
  {
    q: "Does the customer know it's AI?",
    a: "Yes. Every conversation opens by stating that your customer is chatting with a digital assistant, on behalf of your business. Article 50 of the EU AI Act requires it, and the disclosure always stays on.",
    href: '/legal/ai-disclosure/',
    linkLabel: 'Read the full AI disclosure',
  },
  {
    q: 'What if it says something wrong about my prices?',
    a: "It can't. The assistant only quotes rates you've set yourself: call-out fee, service price, recharge, install survey. It never invents a price it doesn't have. The customer gets a callback request instead. We test every configuration before it goes live.",
  },
  {
    q: 'What happens to customer data?',
    a: 'We host in the EU: Hetzner Frankfurt, Neon EU, Cloudflare EU. We sign a data processing agreement (DPA) with you and keep chat conversations for 30 days, or shorter if you prefer. The full supplier list is public in our sub-processor register.',
    href: '/legal/dpa/',
    linkLabel: 'View the DPA and privacy statement',
  },
  {
    q: 'Cancel monthly, really?',
    a: "Yes. No annual contract, no hidden renewal. You cancel by email, whenever you like. The service runs to the end of the month you paid for, and nothing is charged after that. If you pay 6 or 12 months up front, you get 15% or 20% off.",
    href: '/legal/voorwaarden/',
    linkLabel: 'Read the terms and conditions',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]+>/g, ''),
    },
  })),
}
---

<Base
  lang="en"
  title="AI receptionist for air-conditioning companies | Klantkraan"
  description="Digital receptionist for air-conditioning and HVAC firms: answers no-cooling enquiries, quotes your rates and books jobs on your site and WhatsApp, day and night. Cancel monthly."
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div
      class="mx-auto grid max-w-page gap-10 px-gutter md:grid-cols-[1fr_auto] md:items-center md:gap-16"
    >
      <div>
        <h1 class="font-display text-hero text-chalk">
          The <span class="text-(--color-sodium)">customer engine</span> for air-conditioning companies.
        </h1>
        <p class="mt-6 max-w-2xl text-[1.125rem] text-dim leading-relaxed">
          A digital receptionist on your website and WhatsApp that tells an urgent no-cooling call
          from a routine service booking. It catches the summer rush and after-hours enquiries,
          evenings and weekends included.
        </p>
        <div class="mt-10 btn-row">
          <a href="/en/demo/" class="btn btn-primary btn-lg"> Try the demo </a>
          <a href="/en/prijzen/" class="btn btn-ghost btn-lg"> See pricing </a>
        </div>
      </div>
      <div class="hidden text-(--color-dim) md:block">
        <RingingPhone class="h-64 w-64 lg:h-72 lg:w-72" />
      </div>
    </div>
    <div class="mx-auto max-w-page px-gutter">
      <ul role="list" class="fact-row mt-10">
        <li><span class="text-(--color-chalk)">GDPR + AI Act art. 50</span> <span>Disclosure always on</span></li>
        <li><span class="text-(--color-chalk)">Hosted in the EU</span> <span>Cloudflare · Neon · Hetzner</span></li>
        <li><span class="text-(--color-chalk)">Natural English</span> <span>Knows your rates + services</span></li>
      </ul>
      <p class="mt-8 text-small text-dim">
        Cancel monthly · Done-for-you setup · 50% off the first month
      </p>
    </div>
  </section>

  <section class="pb-10 md:pb-16">
    <PhotoBand
      slug="installateurs"
      alt="Technician checking an outdoor air-conditioning unit"
      caption="Out at the unit. Your receptionist still answers."
    />
  </section>

  <!-- 2. Pain-stats trio (stone-100) -->
  <section
    class="border-y border-(--color-line) py-8 md:py-10"
    aria-label="What missed enquiries cost an air-conditioning company"
  >
    <div class="mx-auto max-w-page px-gutter">
      <div class="stat-row">
      {painStats.map((stat) => <Stat value={stat.value} label={stat.caption} />)}
      </div>
    </div>
  </section>

  <!-- 3. Modules (cream, hairline rows) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      <p class="eyebrow">Modules</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">
        What Klantkraan does for air-conditioning companies.
      </h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        Three modules for one monthly price. Built for the installer who no longer wants to leave the
        summer rush to voicemail.
      </p>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          features.map((feature) => (
            <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
              <Icon name={feature.icon} class="mt-1 h-7 w-7 text-(--color-dim)" />
              <div>
                <h3 class="font-display text-h3 text-chalk">{feature.title}</h3>
                <p class="mt-2 text-body text-dim">{feature.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. ROI snippet (stone-100) -->
  <section class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      
      <h2 class="font-display text-h1 text-chalk">Run the numbers.</h2>
      <div
        class="mt-8 frame bg-(--color-panel) p-6 md:p-10"
      >
        <p class="text-h3 text-chalk">
          Miss 5 enquiries a week at €450 each and you lose <strong class="text-(--color-sodium)"
            >around €39,000 in revenue a year</strong
          >.
        </p>
        <p class="mt-4 text-body text-dim">
          Klantkraan Chat is €299 a month. One extra install from the summer rush covers the
          subscription for months. Everything after that is revenue, and your customer isn't
          sweating through a 40°C afternoon waiting for a callback.
        </p>
        <div class="mt-6 btn-row">
          <a href="/en/demo/" class="btn btn-primary btn-lg"> Try the demo </a>
          <a href="/en/prijzen/" class="btn btn-ghost btn-lg"> See pricing </a>
        </div>
        <p class="mt-6 text-micro text-dim">
          Amounts exclude 21% VAT. Example based on a €450 average missed-enquiry value
          and the assumption that roughly 1 in 3 missed enquiries would have become a paying job
          (33% conversion).
        </p>
      </div>
    </div>
  </section>

  <!-- 5. FAQ (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      
      <h2 class="font-display text-h1 text-chalk">Frequently asked questions.</h2>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          faqs.map((faq) => (
            <details class="group py-4">
              <summary class="block min-h-[2.75rem] cursor-pointer list-none py-1 font-display text-h3 text-chalk marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{faq.q}</span>
                  <Icon
                    name="chevron-down"
                    class="mt-1 h-5 w-5 shrink-0 text-(--color-dim) transition-transform group-open:rotate-180"
                  />
                </span>
              </summary>
              <p class="mt-3 text-body text-dim">{faq.a}</p>
              {faq.href && faq.linkLabel && (
                <p class="mt-3 text-small">
                  <a href={faq.href} class="underline">
                    {faq.linkLabel}
                  </a>
                </p>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. Final CTA (blue) -->
  <section class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      <h2 class="font-display text-h1 text-chalk">Get set up before the next heatwave.</h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        In the live demo, report a unit that has stopped cooling, then ask about a routine service.
        You'll see how it tells the two apart.
      </p>
      <div class="mt-8 btn-row">
        <a href="/en/demo/" class="btn btn-primary btn-lg"> Try the demo </a>
        <a href="/en/prijzen/" class="btn btn-ghost btn-lg"> See pricing </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Base>
