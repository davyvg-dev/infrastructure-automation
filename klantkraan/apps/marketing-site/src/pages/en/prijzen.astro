---
import Base from '../../layouts/Base.astro'
import { company } from '../../data/company'

interface Tier {
  id: 'chat' | 'compleet'
  name: string
  price: number
  /** Day-price equivalent in English decimal-point format (price / 30, rounded to cents). */
  dayPrice: string
  /** Optional usage note under the price (e.g. included call minutes + overage rate). */
  priceNote?: string
  blurb: string
  highlight: boolean
  /** Mono badge in the card header (e.g. "coming soon" on Compleet). */
  badge?: string
  cta: string
  ctaHref: string
}

const tiers: Tier[] = [
  {
    id: 'chat',
    name: 'Chat',
    price: 299,
    dayPrice: '9.97',
    blurb:
      'AI receptionist via website chat + WhatsApp: answers questions, books appointments and captures callback requests, 24/7. Our pick.',
    highlight: true,
    cta: 'Start with Chat',
    ctaHref: '/en/aanmelden/?plan=chat',
  },
  {
    id: 'compleet',
    name: 'Compleet',
    price: 499,
    dayPrice: '16.63',
    priceNote: 'incl. 750 call minutes/mo, then €0.40/min',
    blurb:
      'Everything in Chat, plus an AI phone agent on your own Dutch number. Not orderable yet; leave your details and you hear it first.',
    highlight: false,
    badge: 'coming soon',
    cta: 'Keep me posted',
    ctaHref: '/en/aanmelden/?plan=compleet-interesse',
  },
]

interface FeatureRow {
  feature: string
  chat: string
  compleet: string
}

const features: FeatureRow[] = [
  { feature: 'Website chat on your own site (Dutch, 24/7)', chat: 'yes', compleet: 'yes' },
  { feature: 'WhatsApp channel', chat: 'yes', compleet: 'yes' },
  { feature: 'Answers questions about services, rates and service area', chat: 'yes', compleet: 'yes' },
  { feature: 'Books appointments straight into your calendar', chat: 'yes', compleet: 'yes' },
  { feature: 'Captures leads and callback requests', chat: 'yes', compleet: 'yes' },
  { feature: 'Done-for-you setup and tuning', chat: 'yes', compleet: 'yes' },
  { feature: 'Monthly statistics by email', chat: 'yes', compleet: 'yes' },
  {
    feature: 'AI phone agent on your own Dutch number',
    chat: '–',
    compleet: 'coming soon',
  },
  {
    feature: 'Included call minutes per month',
    chat: '–',
    compleet: '750, then €0.40/min',
  },
]

// Service schema with both subscription tiers, derived from the tiers array
// above so the JSON-LD can never drift from the visible pricing cards.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${company.tradeName} AI receptionist`,
  serviceType: 'AI receptionist for local businesses',
  url: new URL('/en/prijzen/', Astro.site).toString(),
  provider: {
    '@type': 'Organization',
    name: company.tradeName,
    url: new URL('/en/', Astro.site).toString(),
  },
  areaServed: { '@type': 'Country', name: 'Netherlands' },
  offers: tiers.map((tier) => ({
    '@type': 'Offer',
    name: `${company.tradeName} ${tier.name}`,
    description: tier.blurb,
    price: String(tier.price),
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: String(tier.price),
      priceCurrency: 'EUR',
      unitText: 'per month',
    },
  })),
}
---

<Base
  lang="en"
  title="AI receptionist pricing: Chat €299 or Compleet €499 | Klantkraan"
  description="Two plans: Chat €299 and Compleet €499 per month. Setup €249 (waived for pilot customers), cancel monthly, first month 50% off."
  centered={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="font-display text-hero text-(--color-chalk)">Pricing</h1>
      <p class="mt-6 max-w-2xl text-h3 text-(--color-dim)">
        Cancel monthly, first month 50% off. One-time setup €249 (waived for pilot customers).
        All amounts exclude 21% VAT.
      </p>
    </div>
  </section>

  <!-- 2. Tier cards (stone-100) -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 md:grid-cols-2">
      {
        tiers.map((tier) => (
          <article
            class={`rounded-(--radius-card) border p-5 md:p-6 ${tier.highlight ? 'border-(--color-sodium) bg-(--color-panel)' : 'border-(--color-line) bg-(--color-panel)'}`}
          >
            <header class="flex items-baseline justify-between">
              <h2 class="font-display text-h2 text-(--color-chalk)">{tier.name}</h2>
              {tier.highlight && (
                <span class="rounded-(--radius-button) bg-(--color-sodium) px-2 py-1 text-micro text-(--color-night)">
                  recommended
                </span>
              )}
              {tier.badge && (
                <span class="rounded-(--radius-button) border border-(--color-line) px-2 py-1 font-mono text-micro text-(--color-dim)">
                  {tier.badge}
                </span>
              )}
            </header>
            <p class={`mt-4 font-display text-h1 ${tier.highlight ? 'text-(--color-sodium)' : 'text-(--color-dim)'}`}>
              €{tier.price}
              <span class="text-body text-(--color-dim)">/mo</span>
            </p>
            <p class="mt-1 font-mono text-small text-(--color-dim)">
              ≈ €{tier.dayPrice} per day
            </p>
            {tier.priceNote && (
              <p class="mt-2 text-small text-(--color-dim)">{tier.priceNote}</p>
            )}
            <p class="mt-3 text-body text-(--color-dim)">{tier.blurb}</p>
            <a
              href={tier.ctaHref}
              class={`mt-6 btn btn-lg ${tier.highlight ? 'btn-primary' : 'btn-ghost'}`}
            >
              {tier.cta}
            </a>
            {tier.highlight && (
              <p class="mt-3 text-small">
                <a href="/en/demo/" class="text-(--color-dim) underline">
                  Rather try it first? See the demo
                </a>
              </p>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <!-- 3. Feature comparison (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">What's included</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-chalk)">What's included in each plan</h2>

      <div class="mt-6 hidden md:block">
        <table class="w-full border-collapse text-body">
          <thead>
            <tr class="border-b border-(--color-line) text-left">
              <th class="py-3 pr-4 font-display text-h3 text-(--color-chalk)">Feature</th>
              <th class="py-3 pr-4 font-display text-h3 text-(--color-chalk)">Chat</th>
              <th class="py-3 pr-4 font-display text-h3 text-(--color-chalk)">Compleet</th>
            </tr>
          </thead>
          <tbody>
            {
              features.map((row) => (
                <tr class="border-b border-(--color-line)">
                  <td class="py-3 pr-4 text-(--color-dim)">{row.feature}</td>
                  <td class="py-3 pr-4">{row.chat}</td>
                  <td class="py-3 pr-4">{row.compleet}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <ul class="mt-6 space-y-4 md:hidden">
        {
          features.map((row) => (
            <li class="rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5">
              <p class="font-display text-h3 text-(--color-chalk)">{row.feature}</p>
              <div class="mt-3 grid grid-cols-2 gap-2 text-small">
                <div>
                  <p class="text-(--color-dim)">Chat</p>
                  <p class="mt-1 text-(--color-chalk)">{row.chat}</p>
                </div>
                <div>
                  <p class="text-(--color-dim)">Compleet</p>
                  <p class="mt-1 text-(--color-chalk)">{row.compleet}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. Every plan + discount (stone-100) -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 sm:grid-cols-2">
      <div>
        <h2 class="font-display text-h2 text-(--color-chalk)">Every plan includes</h2>
        <ul class="mt-4 space-y-2 text-body text-(--color-dim)">
          <li>Done-for-you setup and tuning. We build and connect everything for you.</li>
          <li>Cancel monthly; cancel by email, no notice period.</li>
          <li>First month 50% off.</li>
          <li>30-day satisfaction guarantee. Not happy? Money back.</li>
        </ul>
      </div>
      <div>
        <h2 class="font-display text-h2 text-(--color-chalk)">Discount for paying up front</h2>
        <ul class="mt-4 space-y-2 text-body text-(--color-dim)">
          <li>6 months up front: 15% off.</li>
          <li>12 months up front: 20% off, price locked for the whole year.</li>
          <li>VAT rate 21% (reverse-charged for customers outside the Netherlands).</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. Final CTA (blue) -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">Ready?</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-chalk)">Ready to get started?</h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-dim)">
        Sign up and we call within one working day to plan the setup. Rather see how it works
        first? Try the demo, right in your browser.
      </p>
      <div class="mt-6 btn-row">
        <a href="/en/aanmelden/?plan=chat" class="btn btn-primary btn-lg">Start with Chat</a>
        <a href="/en/demo/" class="btn btn-ghost btn-lg">Try the demo</a>
      </div>
    </div>
  </section>
</Base>
