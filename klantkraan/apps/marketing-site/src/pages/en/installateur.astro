---
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import Stat from '../../components/Stat.astro'
import Radiator from '../../components/illustrations/Radiator.astro'
import RiskReversal from '../../components/RiskReversal.astro'

// Heating-engineer landing page. Follows the /loodgieters template structure.
// Trade-specific copy: boiler breakdown, servicing, water heater, cold-snap peak.

interface PainStat {
  value: string
  caption: string
}

const painStats: PainStat[] = [
  { value: '62%', caption: 'of your boiler breakdowns come in during January and February.' },
  { value: '€340', caption: 'average value of a boiler breakdown visit.' },
  { value: '4×', caption: 'more servicing requests in September and October.' },
]

interface Feature {
  icon: 'phone' | 'message-square' | 'calendar-check'
  title: string
  body: string
}

const features: Feature[] = [
  {
    icon: 'message-square',
    title: 'Spots a boiler breakdown in January',
    body: 'Answers customer questions on your website and via WhatsApp, in natural English, in the evenings and at weekends too. Quotes your own boiler servicing rate, call-out charge and cold-snap emergency surcharge. It won\'t mistake a breakdown for a scheduling question about the annual service.',
  },
  {
    icon: 'calendar-check',
    title: 'Appointments straight into your calendar',
    body: 'Servicing and breakdown appointments are booked straight into your calendar, only in the slots you\'ve opened up yourself. Emergencies are kept separate from the annual service, so you know what needs doing first.',
  },
  {
    icon: 'phone',
    title: 'Leads and callback requests on your phone',
    body: 'Boiler breakdown during a cold snap? The receptionist takes the message and sends it straight to your phone, with the name, number and the question. No customer goes to a competitor while you\'re out on another emergency repair.',
  },
]

interface Faq {
  q: string
  a: string
  href?: string
  linkLabel?: string
}

const faqs: Faq[] = [
  {
    q: 'How does the receptionist get onto my website?',
    a: 'With one small script that we install for you. You don\'t need to do a thing. We connect the WhatsApp channel in the same done-for-you setup. You keep your own site, your own number and your own branding.',
  },
  {
    q: 'And if I\'m on site and can\'t reply?',
    a: 'That\'s exactly what this is built for. The receptionist answers the question (boiler emergency, annual service, new job, supplier), books an appointment in your calendar if wanted and sends you a summary by WhatsApp or email. You call back between jobs.',
  },
  {
    q: 'How does the AI cope with the January peaks?',
    a: 'The receptionist handles conversations in parallel. No queue. Ten customers can chat or message about a boiler breakdown at the same time and all ten get an answer right away. Emergency breakdowns are recognised and kept separate from routine servicing, so you know which one to call first.',
  },
  {
    q: 'Can the customer tell it\'s AI?',
    a: 'Yes. Every conversation opens by telling your customer they\'re chatting with a digital assistant, on behalf of your business. That\'s not a marketing choice but a legal requirement under the European AI Act (article 50). The disclosure always stays on.',
    href: '/legal/ai-disclosure/',
    linkLabel: 'Read the full AI disclosure',
  },
  {
    q: 'What if the AI says something wrong about my rates?',
    a: 'That can\'t happen. The assistant only quotes rates you\'ve entered into your system yourself: call-out charge, boiler servicing rate, emergency boiler call, water-heater rate. It never invents prices it doesn\'t know; the customer gets a callback instead. We test every configuration before you go live.',
  },
  {
    q: 'What happens to the customer data?',
    a: 'We host in the EU: Hetzner Frankfurt, Neon EU, Cloudflare EU. We sign a data processing agreement (DPA) with you and keep chat conversations for 30 days, unless you\'d prefer less. The full supplier list is published openly in our sub-processor register.',
    href: '/legal/dpa/',
    linkLabel: 'View DPA and privacy statement',
  },
  {
    q: 'Cancel monthly, really?',
    a: 'Yes. No annual contract, no hidden renewal. You cancel by email; the notice period is one month. For anyone who\'d rather pay 6 or 12 months up front there\'s a discount (15% and 20% respectively).',
    href: '/legal/voorwaarden/',
    linkLabel: 'Read the terms and conditions',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]+>/g, ''),
    },
  })),
}
---

<Base
  lang="en"
  title="Win more heating jobs: AI receptionist for boiler work | Klantkraan"
  description="AI receptionist for heating engineers, cancel monthly. Knows your boiler rates and emergency surcharge, catches January peaks and books appointments via chat and WhatsApp."
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div
      class="mx-auto grid max-w-5xl gap-10 px-6 md:grid-cols-[1fr_auto] md:items-center md:gap-16"
    >
      <div>
        <h1 class="font-display text-hero text-(--color-kraan-ink)">
          The <span class="text-(--color-kraan-rust)">customer engine</span> for heating engineers.
        </h1>
        <p class="mt-6 max-w-2xl text-h3 text-(--color-kraan-stone-700)">
          A digital receptionist on your website and WhatsApp that spots a boiler breakdown and
          won't mistake it for a scheduling question about the annual service. Catches the January
          peak and the October servicing rush. Evenings and weekends included.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/en/demo/"
            class="inline-block rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
          >
            Try the demo
          </a>
          <a
            href="/en/rekentool/"
            class="inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
          >
            Work out your ROI
          </a>
        </div>
      </div>
      <div class="hidden text-(--color-kraan-blue) md:block">
        <Radiator class="h-64 w-64 lg:h-72 lg:w-72" />
      </div>
    </div>
    <div class="mx-auto max-w-5xl px-6">
      <dl class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-6">
        <div class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
          <div>
            <dt class="text-small font-medium text-(--color-kraan-ink)">GDPR + AI Act art. 50</dt>
            <dd class="text-small text-(--color-kraan-stone-500)">Disclosure on by default</dd>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
          <div>
            <dt class="text-small font-medium text-(--color-kraan-ink)">Hosted in the EU</dt>
            <dd class="text-small text-(--color-kraan-stone-500)">Cloudflare · Neon · Hetzner</dd>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Icon name="phone-call" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
          <div>
            <dt class="text-small font-medium text-(--color-kraan-ink)">Natural conversation</dt>
            <dd class="text-small text-(--color-kraan-stone-500)">Knows your boiler rate + surcharge</dd>
          </div>
        </div>
      </dl>
      <p class="mt-8 text-small text-(--color-kraan-stone-500)">
        Cancel monthly · Done-for-you setup · 50% off the first month
      </p>
    </div>
  </section>

  <!-- 1b. Risk-reversal -->
  <RiskReversal lang="en" />

  <!-- 2. Pain-stats trio (stone-100) -->
  <section
    class="bg-(--color-kraan-stone-100) py-10 md:py-16"
    aria-label="What seasonal peaks cost a heating engineer"
  >
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 sm:grid-cols-3">
      {painStats.map((stat) => <Stat value={stat.value} label={stat.caption} />)}
    </div>
  </section>

  <!-- 3. Modules (cream, hairline rows) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">Modules</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">
        What Klantkraan does for heating engineers.
      </h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-kraan-stone-700)">
        Three modules. One monthly price. Built for the heating engineer who no longer wants to leave the January peak to their partner.
      </p>
      <div class="mt-10 divide-y divide-(--color-kraan-stone-300) border-y border-(--color-kraan-stone-300)">
        {
          features.map((feature) => (
            <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
              <Icon name={feature.icon} class="mt-1 h-7 w-7 text-(--color-kraan-blue)" />
              <div>
                <h3 class="font-display text-h3 text-(--color-kraan-ink)">{feature.title}</h3>
                <p class="mt-2 text-body text-(--color-kraan-stone-700)">{feature.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. ROI snippet (stone-100) -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">The maths</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">
        Do the maths.
      </h2>
      <div class="mt-8 rounded-(--radius-card) border border-(--color-kraan-stone-300) bg-white p-6 md:p-10">
        <p class="text-h3 text-(--color-kraan-ink)">
          Miss 7 calls a week at €340? That's <strong class="text-(--color-kraan-rust)">around €41,000 in lost revenue a year</strong>.
        </p>
        <p class="mt-4 text-body text-(--color-kraan-stone-700)">
          Klantkraan Chat is €299 a month. One extra emergency boiler call from the January peak covers the subscription. Everything that
          comes in after that is revenue. And the customer isn't sat in a cold house for three hours.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/en/rekentool/"
            class="inline-block rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
          >
            Open the calculator
          </a>
          <a
            href="/en/prijzen/"
            class="inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
          >
            See the pricing
          </a>
        </div>
        <p class="mt-6 text-micro text-(--color-kraan-stone-500)">
          Amounts exclude 21% VAT. Example based on an industry average of €340 per call for
          boiler breakdowns and water-heater failures (source: Aira / Invoca missed-call benchmarks) and the
          assumption that roughly 1 in 3 missed calls would have produced a paying job (33% conversion rate).
        </p>
      </div>
    </div>
  </section>

  <!-- 5. FAQ (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">Questions</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">
        Frequently asked questions.
      </h2>
      <div class="mt-10 divide-y divide-(--color-kraan-stone-300) border-y border-(--color-kraan-stone-300)">
        {
          faqs.map((faq) => (
            <details class="group py-4">
              <summary class="block min-h-[2.75rem] cursor-pointer list-none py-1 font-display text-h3 text-(--color-kraan-ink) marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{faq.q}</span>
                  <Icon
                    name="chevron-down"
                    class="mt-1 h-5 w-5 shrink-0 text-(--color-kraan-blue) transition-transform group-open:rotate-180"
                  />
                </span>
              </summary>
              <p class="mt-3 text-body text-(--color-kraan-stone-700)">{faq.a}</p>
              {faq.href && faq.linkLabel && (
                <p class="mt-3 text-small">
                  <a href={faq.href} class="underline">
                    {faq.linkLabel}
                  </a>
                </p>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. Final CTA (blue) -->
  <section class="bg-(--color-kraan-blue) py-10 md:py-16 text-white">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="font-display text-h1 text-white">
        Ready for the next heating season?
      </h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-kraan-stone-100)">
        Try the live demo. After that you'll know whether it spots a boiler breakdown and how it separates one
        from a question about the annual service.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/en/demo/"
          class="inline-block rounded-(--radius-button) bg-white px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
        >
          Try the demo
        </a>
        <a
          href="/en/prijzen/"
          class="inline-block rounded-(--radius-button) border border-white px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
        >
          See pricing
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Base>
