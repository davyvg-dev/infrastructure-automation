---
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import Stat from '../../components/Stat.astro'
import StormCloud from '../../components/illustrations/StormCloud.astro'
import RiskReversal from '../../components/RiskReversal.astro'
import PhotoBand from '../../components/PhotoBand.astro'

// English roofers (dakdekkers) landing page. Inlined from the Dutch section
// components (Hero, PainStats, Features, StormScenario, RoiSnippet, Faq,
// FinalCta). CityLinks + VerderLezen dropped. Voice: British-English
// copywriter, u-form "you/your", concrete and declarative, no AI-tells.

interface Feature {
  icon: 'zap' | 'calendar-check' | 'phone'
  title: string
  body: string
}

const features: Feature[] = [
  {
    icon: 'zap',
    title: 'Storm protocol',
    body: `On your website and WhatsApp, the receptionist tells a quote request from an emergency leak. An emergency means an instant alert on your phone, evenings and weekends included. Conversations run in parallel, so there is no queue.`,
  },
  {
    icon: 'calendar-check',
    title: 'Inspection and quote appointments',
    body: `Non-urgent requests are qualified by postcode and roof type, then booked straight into your calendar. In the morning you see what's on the schedule. No phone tag, no back-and-forth email.`,
  },
  {
    icon: 'phone',
    title: 'Leads and callback requests on your phone',
    body: `Every lead and every callback request lands straight on your phone as a message, with the customer's name, number and what they reported. No leak report gets lost while you're up on a roof.`,
  },
]

interface Faq {
  q: string
  a: string
}

const faqs: Faq[] = [
  {
    q: 'Does it work during a storm with lots of reports at once?',
    a: `Yes. The receptionist handles conversations in parallel, so there is no queue. Ten customers can chat or message at the same time and all ten get an answer straight away. Emergency leaks are recognised and separated from quote requests.`,
  },
  {
    q: 'Does the AI know my set rates for inspection and emergency repair?',
    a: `Yes. During onboarding we configure your inspection rate, emergency-repair surcharge, call-out charge and, if you have one, a weekend surcharge. The AI quotes those figures exactly as you set them. No wrong amounts, no 'we'll get back to you on price'.`,
  },
  {
    q: "Does the customer know it's AI?",
    a: `Yes, from the first line. The assistant tells your customer they're chatting with a digital assistant, as article 50 of the EU AI Act requires. Read the full <a href="/legal/ai-disclosure/">AI disclosure</a>.`,
  },
  {
    q: "What if I'm up on the roof and can't respond?",
    a: `For an emergency leak you get an instant alert on your phone with the customer's name, number and address. In the conversation the customer is told their report has been passed on and when to expect a reply. You call back the moment you're off the roof.`,
  },
  {
    q: 'Does it work alongside my existing phone number or answering service?',
    a: `Yes. The receptionist runs on your website and WhatsApp, separate from your phone line. You keep your current number; nothing is ported or forwarded. It can be switched on or off within one working day.`,
  },
  {
    q: 'Can I cancel Klantkraan monthly?',
    a: `Yes. No annual contract, no hidden renewal. You cancel by email, whenever you like. The service runs to the end of the month you paid for, and nothing is charged after that. Full terms in the <a href="/legal/voorwaarden/">terms and conditions</a>.`,
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]+>/g, ''),
    },
  })),
}
---

<Base
  lang="en"
  title="Win roofing customers: AI receptionist with storm protocol | Klantkraan"
  description="AI receptionist for roofers, cancel monthly. The storm protocol escalates emergency leaks straight to your phone, books inspections and captures leads, day and night."
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div
      class="mx-auto grid max-w-page gap-10 px-gutter md:grid-cols-[1fr_auto] md:items-center md:gap-16"
    >
      <div>
        <h1 class="font-display text-hero text-chalk">
          The <span class="text-(--color-sodium)">customer engine</span> for roofers.
        </h1>
        <p class="mt-6 max-w-2xl text-[1.125rem] text-dim leading-relaxed">
          A storm protocol sends emergency leaks straight to your phone, day and night. Inspection
          and quote appointments go straight into your calendar.
        </p>
        <div class="mt-10 btn-row">
          <a href="/en/demo/" class="btn btn-primary btn-lg"> Try the demo </a>
          <a href="/en/rekentool/" class="btn btn-ghost btn-lg"> Work out your ROI </a>
        </div>
      </div>
      <div class="hidden text-(--color-dim) md:block">
        <StormCloud class="h-64 w-64 lg:h-72 lg:w-72" aria-label="Storm over a roof" />
      </div>
    </div>
    <div class="mx-auto max-w-page px-gutter">
      <ul role="list" class="fact-row mt-10">
        <li><span class="text-(--color-chalk)">GDPR + AI Act art. 50</span> <span>Disclosure always on</span></li>
        <li><span class="text-(--color-chalk)">Hosted in the EU</span> <span>Cloudflare · Neon · Hetzner</span></li>
        <li><span class="text-(--color-chalk)">Natural conversation</span> <span>Knows storm protocol + emergency rate</span></li>
      </ul>
      <p class="mt-8 text-small text-dim">
        Cancel monthly · Done-for-you setup · 50% off the first month
      </p>
    </div>
  </section>

  <section class="pb-10 md:pb-16">
    <PhotoBand
      slug="dakdekkers"
      alt="Roofer at work on a pitched roof"
      caption="Up on the roof. Your receptionist still answers."
      focus="50% 38%"
    />
  </section>

  <!-- 1b. Risk-reversal -->
  <RiskReversal lang="en" />

  <!-- 2. Pain-stats trio (stone-100) -->
  <section class="border-y border-(--color-line) py-8 md:py-10">
    <div class="mx-auto max-w-page px-gutter">
      <div class="stat-row">
      <Stat value="35%" label="of your storm calls come in after peak hours and go unanswered." />
      <Stat value="€650" label="average value of a single emergency repair after a storm." />
      <Stat
        value="4–6 weeks"
        label="of revenue that evaporates when an inspection request is left sitting."
      />
      </div>
    </div>
  </section>

  <!-- 3. What Klantkraan does for roofers (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      <p class="eyebrow">Modules</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">What Klantkraan does for roofers.</h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        Three modules for one monthly price. We wrote them after storm Pia, having spent an evening
        listening in with a roofer in Utrecht.
      </p>

      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          features.map((feature) => (
            <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
              <Icon name={feature.icon} class="mt-1 h-7 w-7 text-(--color-dim)" />
              <div>
                <h3 class="font-display text-h3 text-chalk">{feature.title}</h3>
                <p class="mt-2 text-body text-dim">{feature.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Storm scenario (stone-100) -->
  <section class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      <p class="eyebrow">Scenario</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">
        Saturday night, 21:00. A <span class="text-(--color-sodium)">storm</span> rolls in.
      </h2>
      <p class="mt-4 max-w-3xl text-body text-dim">
        Three customers call at once with a leak. You're at a birthday party or already asleep.
      </p>

      <div class="mt-10 grid gap-4 md:gap-6 md:grid-cols-2">
        <article
          class="rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5 md:p-6"
        >
          <p class="font-mono text-micro uppercase tracking-wider text-dim">Without Klantkraan</p>
          <h3 class="mt-2 font-display text-h3 text-chalk">Three calls, one voicemail.</h3>
          <ul class="mt-4 space-y-3 text-body text-dim">
            <li>Call 1 hits a busy tone while you take call 2.</li>
            <li>Call 3 goes to voicemail. That customer rings a competitor.</li>
            <li>Monday: one review fewer, two jobs lost.</li>
            <li>Damage: about €1,300 in revenue gone, plus a knock to your Google rating.</li>
          </ul>
        </article>

        <article
          class="rounded-(--radius-card) border border-sodium/40 bg-(--color-panel) p-5 md:p-6"
        >
          <p class="font-mono text-micro uppercase tracking-wider text-(--color-confirm)">
            With Klantkraan
          </p>
          <h3 class="mt-2 font-display text-h3 text-chalk">Three calls, all three handled.</h3>
          <ul class="mt-4 space-y-3 text-body text-dim">
            <li>
              The AI takes all three in parallel, each with the AI disclosure.
            </li>
            <li>
              The emergency leak is recognised. Your phone rings once, with the address and roof
              type already gathered.
            </li>
            <li>
              The other two get a callback booked for Monday morning at 08:00 in your calendar.
            </li>
            <li>Monday: three customers helped, zero missed jobs.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- 5. ROI snippet (cream; inner white card) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      <div
        class="frame bg-(--color-panel) p-6 md:p-10"
      >
        <h2 class="font-display text-h1 text-chalk">The maths for one storm season.</h2>
        <p class="mt-6 max-w-3xl text-body text-dim">
          Say you miss 5 emergency repairs per storm season.
          <span class="font-mono">€650</span> per repair =
          <span class="font-mono text-(--color-sodium)">€3,250</span> handed to the competition. Klantkraan
          Chat costs <span class="font-mono">€299</span> a month. One recovered emergency repair covers
          more than two months of subscription.
        </p>
        <p class="mt-2 text-small text-dim">All amounts exclude 21% VAT.</p>
        <div class="mt-8">
          <a href="/en/rekentool/" class="btn btn-primary btn-lg"> Work out your own ROI </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. FAQ (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      
      <h2 class="font-display text-h1 text-chalk">Questions roofers often ask.</h2>

      <div class="mt-10 space-y-3">
        {
          faqs.map((faq) => (
            <details class="group rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5 md:p-6">
              <summary class="flex min-h-[2.75rem] cursor-pointer items-center justify-between gap-4 font-display text-h3 text-chalk marker:content-none">
                <span>{faq.q}</span>
                <Icon
                  name="chevron-down"
                  class="h-5 w-5 shrink-0 text-(--color-dim) transition-transform group-open:rotate-180"
                />
              </summary>
              <p class="mt-4 text-body text-dim" set:html={faq.a} />
            </details>
          ))
        }
      </div>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  </section>

  <!-- 7. Final CTA band (blue) -->
  <section class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      <h2 class="font-display text-h1 text-chalk">Get set up before the next storm.</h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        One subscription handles the storm peak. We set everything up for you, with no annual
        contract and the first month at half price.
      </p>
      <div class="mt-8 btn-row">
        <a href="/en/demo/" class="btn btn-primary btn-lg"> Try the demo </a>
        <a href="/en/prijzen/" class="btn btn-ghost btn-lg"> See pricing </a>
      </div>
    </div>
  </section>
</Base>
