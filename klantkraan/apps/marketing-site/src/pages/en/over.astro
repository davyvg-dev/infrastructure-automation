---
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import { waLink } from '../../data/contact'
import { company } from '../../data/company'
---

<Base
  lang="en"
  title="About Klantkraan: who builds it and why"
  description="Klantkraan is a trading name of T4 Software Consulting BV, built by a single Dutch IT entrepreneur. Hosted in the Netherlands, GDPR-compliant, no outside investors."
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="font-display text-hero text-(--color-kraan-ink)">About <span class="text-(--color-kraan-rust)">Klantkraan</span></h1>
      <p class="mt-6 max-w-2xl text-h3 text-(--color-kraan-stone-700)">
        A done-for-you subscription so Dutch business owners never miss a customer enquiry again.
        Built by a single IT entrepreneur, hosted in the Netherlands, with no outside investors.
      </p>
    </div>
  </section>

  <!-- 2. Company + what we stand for (stone-100) -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16">
    <div class="mx-auto grid max-w-5xl gap-6 md:gap-8 px-6 md:grid-cols-2">
      <div>
        <h2 class="font-display text-h2 text-(--color-kraan-ink)">The company</h2>
        <dl class="mt-4 space-y-3 text-body text-(--color-kraan-stone-700)">
          <div>
            <dt class="text-small text-(--color-kraan-stone-500)">Trading name</dt>
            <dd>Klantkraan</dd>
          </div>
          <div>
            <dt class="text-small text-(--color-kraan-stone-500)">Legal entity</dt>
            <dd>T4 Software Consulting BV</dd>
          </div>
          <div>
            <dt class="text-small text-(--color-kraan-stone-500)">Chamber of Commerce (KvK) number</dt>
            <dd class="font-mono break-all">{company.kvk}</dd>
          </div>
          {
            company.btw && (
              <div>
                <dt class="text-small text-(--color-kraan-stone-500)">VAT number</dt>
                <dd class="font-mono break-all">{company.btw}</dd>
              </div>
            )
          }
          <div>
            <dt class="text-small text-(--color-kraan-stone-500)">Registered in</dt>
            <dd>The Netherlands</dd>
          </div>
          <div>
            <dt class="text-small text-(--color-kraan-stone-500)">Contact</dt>
            <dd><a href="mailto:hallo@klantkraan.nl">hallo@klantkraan.nl</a></dd>
          </div>
        </dl>
      </div>

      <div>
        <h2 class="font-display text-h2 text-(--color-kraan-ink)">What we stand for</h2>
        <ul class="mt-4 space-y-3 text-body text-(--color-kraan-stone-700)">
          <li>
            <strong>Hosted in the Netherlands.</strong> Customer data lives with Cloudflare EU + Neon EU + Hetzner
            FSN1. No US data export.
          </li>
          <li>
            <strong>GDPR-compliant by default.</strong> Standard data processing agreement (DPA), Article 30
            register, public sub-processor list.
          </li>
          <li>
            <strong>EU AI Act, article 50.</strong> The AI disclosure is in every conversation and cannot be
            switched off. Full stop.
          </li>
          <li>
            <strong>Cancel monthly.</strong> No vendor lock-in, no annual contract by default. You stay because
            it works, not because you have to.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 3. Who builds Klantkraan (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">The founder</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">Who builds Klantkraan</h2>

      <div class="mt-8 grid gap-6 md:gap-10 md:grid-cols-[auto_1fr] md:items-start">
        <div
          class="flex h-24 w-24 items-center justify-center rounded-full bg-(--color-kraan-rust) font-display text-h1 text-white"
          aria-hidden="true"
        >
          K
        </div>

        <div class="max-w-2xl space-y-4 text-body text-(--color-kraan-stone-700)">
          <p>
            Klantkraan is built by a single Dutch IT entrepreneur and registered as a trading name of
            <strong>T4 Software Consulting</strong> BV. No outside investors, no VC pressure, no growth
            figures that come before customer quality.
          </p>
          <p>
            The build is deliberately solo: one person designs the AI receptionist, builds the integrations
            and tailors every configuration to your business. When you have a question, you're not routed
            through support tiers 1, 2 and 3. You speak directly with the owner.
          </p>
          <p>
            Background: years of building software for SME clients through T4 Software Consulting.
            Klantkraan takes what works well for a single client and makes it repeatable for the trades:
            plumbers, roofers, electricians, installation engineers, contractors, painters.
          </p>
          <p class="pt-2 text-small text-(--color-kraan-stone-500)">
            <a
              href="mailto:hallo@klantkraan.nl"
              class="text-(--color-kraan-blue) underline underline-offset-4 hover:no-underline"
              >hallo@klantkraan.nl</a
            >
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Why Klantkraan exists (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">Why</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">Why Klantkraan exists</h2>
      <div class="mt-6 max-w-3xl space-y-4 text-body text-(--color-kraan-stone-700)">
        <p>
          Klantkraan grew out of a simple observation: the average Dutch plumber, roofer or installation
          engineer misses about 28% of their calls. Not out of unwillingness. They're up on the roof, on
          the ladder, or with another customer. Each missed call is, on average, a €450 job that goes to
          the competition.
        </p>
        <p>
          The solutions that existed didn't feel right. Too expensive (€899 setup + €199/month), twelve-month
          contracts, or one of those American packages that doesn't do call-out charges and doesn't know what
          an emergency rate is. We wanted to build something that sounds like it belongs to the business:
          fluent Dutch, knows what a water heater is, polite but to the point.
        </p>
        <p>
          Klantkraan is exactly that: a digital receptionist via website chat and WhatsApp that answers
          questions, books appointments and captures leads, with an AI phone agent as the next step (coming
          soon). Done-for-you setup, cancel monthly. Built by someone who runs their own IT business, hosted
          in Europe.
        </p>
      </div>
    </div>
  </section>

  <!-- 5. Downloads + speak to the founder (stone-100) -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16">
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 md:grid-cols-3">
      <div>
        <h2 class="font-display text-h2 text-(--color-kraan-ink)">Data processing agreement</h2>
        <p class="mt-4 text-body text-(--color-kraan-stone-700)">
          Our standard DPA, readable before you sign. Legally reviewed, no separate negotiation needed.
        </p>
        <a
          href="/legal/dpa/"
          class="mt-4 inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-5 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-white"
        >
          View DPA
        </a>
      </div>
      <div>
        <h2 class="font-display text-h2 text-(--color-kraan-ink)">Chamber of Commerce extract</h2>
        <p class="mt-4 text-body text-(--color-kraan-stone-700)">
          Official business register extract for Klantkraan under T4 Software Consulting BV.
          For your own supplier file. Ask for it and it's in your inbox the same working day.
        </p>
        <a
          href="mailto:hallo@klantkraan.nl?subject=Request%20Chamber%20of%20Commerce%20extract"
          class="mt-4 inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-5 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-white"
        >
          Request extract
        </a>
      </div>
      <div>
        <h2 class="font-display text-h2 text-(--color-kraan-ink)">Speak to the founder</h2>
        <p class="mt-4 text-body text-(--color-kraan-stone-700)">
          Questions that don't need a demo? Send a WhatsApp or an email. Usually a reply within one working
          day, straight from the owner.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a
            href={waLink}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-(--radius-button) bg-(--color-kraan-blue) px-5 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
          >
            <Icon name="message-circle" class="h-5 w-5" />
            <span>WhatsApp</span>
          </a>
          <a
            href="mailto:hallo@klantkraan.nl"
            class="inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-5 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-white"
          >
            Email
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
