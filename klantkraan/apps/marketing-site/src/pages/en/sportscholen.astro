---
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import Stat from '../../components/Stat.astro'
import Dumbbell from '../../components/illustrations/Dumbbell.astro'
import RiskReversal from '../../components/RiskReversal.astro'

// Gyms landing page (English twin of /sportscholen/). Follows the /en/loodgieters
// template structure; copy per klantkraan/docs/09-brand/voice-and-tone.md (you-form,
// concrete figures, no emojis), with gym vocabulary (trial class, membership, schedule)
// instead of trade nouns. Links to the general English demo at /en/demo/.

interface PainStat {
  value: string
  caption: string
}

const painStats: PainStat[] = [
  { value: 'Evenings', caption: 'are when most trial-class requests come in, right when the front desk is closed.' },
  { value: '21×', caption: 'more likely to reach a lead when you reply within 5 minutes.' },
  { value: '€480', caption: 'yearly value of one lost member, at €40 a month.' },
]

interface Feature {
  icon: 'phone' | 'message-square' | 'calendar-check'
  title: string
  body: string
}

const features: Feature[] = [
  {
    icon: 'message-square',
    title: 'Every message answered, even at 10pm',
    body: 'Answers questions about memberships, opening hours and classes, on your website and via WhatsApp, in natural English. Weekends too. Never quotes a rate you haven\'t set yourself.',
  },
  {
    icon: 'calendar-check',
    title: 'Trial classes straight into your calendar',
    body: 'The receptionist books trial classes, tours and personal training intros straight into your calendar, only in the slots you\'ve made available. The 10pm lead is on the schedule the next morning.',
  },
  {
    icon: 'phone',
    title: 'Every lead on your phone',
    body: 'Every trial-class request and every callback request lands straight on your phone as a message, with name, number and the question. No lead is left sitting in an unanswered DM.',
  },
]

interface Faq {
  q: string
  a: string
  href?: string
  linkLabel?: string
}

const faqs: Faq[] = [
  {
    q: 'How does the receptionist get onto my website?',
    a: 'With one small script that we install for you. You don\'t have to do a thing. We connect the WhatsApp channel in the same done-for-you setup. You keep your own site, your own number and your own branding.',
  },
  {
    q: 'We already have a front desk. What does this add?',
    a: 'The front desk isn\'t there during a class, at the weekend or at 10pm, and those are exactly the moments when people go looking for a gym. The receptionist catches everything that comes in outside desk hours, books the trial class and lets your team do what they\'re good at: the floor.',
  },
  {
    q: 'Does the visitor know it\'s AI?',
    a: 'Yes. Every conversation opens by stating that they\'re chatting with a digital assistant, on behalf of your gym. That isn\'t a marketing choice but a legal requirement under the EU AI Act (article 50). The disclosure always stays on.',
    href: '/legal/ai-disclosure/',
    linkLabel: 'Read the full AI disclosure',
  },
  {
    q: 'What if the AI says something wrong about membership prices?',
    a: 'That can\'t happen. The assistant only quotes rates you\'ve set yourself: memberships, trial class, personal training. Unknown prices aren\'t made up; the visitor is offered a callback or an advice call instead. We test every configuration before you go live.',
  },
  {
    q: 'Can it handle cancellations and membership freezes too?',
    a: 'It catches them neatly: the assistant notes the request, books a call if needed and passes it straight to you. Decisions about memberships stay with your team. The assistant only makes sure the request never gets left.',
  },
  {
    q: 'What happens to my members\' data?',
    a: 'We host in the EU: Hetzner Frankfurt, Neon EU, Cloudflare EU. We sign a data processing agreement (DPA) with you and keep chat conversations for 30 days, unless you want shorter. The full supplier list is public in our sub-processor register.',
    href: '/legal/dpa/',
    linkLabel: 'View the DPA and privacy statement',
  },
  {
    q: 'Cancel monthly, really?',
    a: 'Yes. No annual contract, no hidden renewal. You cancel by email; notice period is one month. For anyone who prefers to pay 6 or 12 months up front there\'s a discount (15% and 20% respectively), but that\'s a choice, not the default.',
    href: '/legal/voorwaarden/',
    linkLabel: 'Read the terms and conditions',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]+>/g, ''),
    },
  })),
}
---

<Base
  lang="en"
  title="Win gym members: digital receptionist for trial classes"
  description="Digital receptionist for gyms, cancel monthly. Answers questions on memberships and classes, books trial classes and captures leads via chat and WhatsApp."
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div
      class="mx-auto grid max-w-5xl gap-10 px-6 md:grid-cols-[1fr_auto] md:items-center md:gap-16"
    >
      <div>
        <h1 class="font-display text-hero text-chalk">
          The <span class="text-(--color-sodium)">customer engine</span> for gyms.
        </h1>
        <p class="mt-6 max-w-2xl text-h3 text-dim">
          On the floor teaching a class? Then our digital receptionist answers the question about
          memberships or the trial class, on your website and via WhatsApp, with your schedule and
          rates to hand. Evenings, weekends, public holidays. The trial class goes straight into
          your calendar.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/en/demo/"
            class="btn btn-primary btn-lg"
          >
            Try the demo
          </a>
          <a
            href="/en/prijzen/"
            class="btn btn-ghost btn-lg"
          >
            See the rates
          </a>
        </div>
      </div>
      <div class="hidden text-(--color-sodium) md:block">
        <Dumbbell class="h-64 w-64 lg:h-72 lg:w-72" />
      </div>
    </div>
    <div class="mx-auto max-w-5xl px-6">
      <ul role="list" class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-6">
        <li class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
          <div>
            <p class="text-small font-medium text-chalk">GDPR + AI Act art. 50</p>
            <p class="text-small text-dim">Disclosure on by default</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
          <div>
            <p class="text-small font-medium text-chalk">Hosted in the EU</p>
            <p class="text-small text-dim">Cloudflare · Neon · Hetzner</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="phone-call" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
          <div>
            <p class="text-small font-medium text-chalk">Natural conversation</p>
            <p class="text-small text-dim">Knows your schedule + memberships</p>
          </div>
        </li>
      </ul>
      <p class="mt-8 text-small text-dim">
        Cancel monthly · Done-for-you setup · 50% off first month
      </p>
    </div>
  </section>

  <!-- 1b. Risk-reversal -->
  <RiskReversal lang="en" />

  <!-- 2. Pain-stats trio (stone-100) -->
  <section
    class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16"
    aria-label="What a missed lead costs"
  >
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 sm:grid-cols-3">
      {painStats.map((stat) => <Stat value={stat.value} label={stat.caption} />)}
    </div>
  </section>

  <!-- 3. What Klantkraan does for gyms (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">Modules</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">
        What Klantkraan does for gyms.
      </h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        Three modules. One monthly price. Built for the owner who's on the floor more often than
        behind the desk.
      </p>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          features.map((feature) => (
            <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
              <Icon name={feature.icon} class="mt-1 h-7 w-7 text-(--color-sodium)" />
              <div>
                <h3 class="font-display text-h3 text-chalk">{feature.title}</h3>
                <p class="mt-2 text-body text-dim">{feature.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. ROI snippet (cream; inner white card) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">The maths</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">
        Do the maths.
      </h2>
      <div class="mt-8 rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-6 md:p-10">
        <p class="text-h3 text-chalk">
          Leave 4 trial-class requests a month unanswered, at €480 yearly value each? That's
          <strong class="text-(--color-sodium)">over €23,000 in lost revenue a year</strong>.
        </p>
        <p class="mt-4 text-body text-dim">
          Klantkraan Chat is €299 a month. One extra member a month and you break even. Every member
          after that is your margin.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/en/demo/"
            class="btn btn-primary btn-lg"
          >
            Try the demo
          </a>
          <a
            href="/en/prijzen/"
            class="btn btn-ghost btn-lg"
          >
            See the rates
          </a>
        </div>
        <p class="mt-6 text-micro text-dim">
          Amounts exclude 21% VAT. Example based on a €40 average monthly membership rate and an
          average membership length of 12 months; the 5-minute response figures come from the
          lead-response study by Harvard Business Review / InsideSales.
        </p>
      </div>
    </div>
  </section>

  <!-- 5. FAQ (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">Questions</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">
        Frequently asked questions.
      </h2>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          faqs.map((faq) => (
            <details class="group py-4">
              <summary class="block min-h-[2.75rem] cursor-pointer list-none py-1 font-display text-h3 text-chalk marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{faq.q}</span>
                  <Icon
                    name="chevron-down"
                    class="mt-1 h-5 w-5 shrink-0 text-(--color-sodium) transition-transform group-open:rotate-180"
                  />
                </span>
              </summary>
              <p class="mt-3 text-body text-dim">{faq.a}</p>
              {faq.href && faq.linkLabel && (
                <p class="mt-3 text-small">
                  <a href={faq.href} class="underline">
                    {faq.linkLabel}
                  </a>
                </p>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. End CTA band (blue) -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="font-display text-h1 text-chalk">
        Ready to stop missing trial classes?
      </h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        Try the live demo of a gym receptionist. In one conversation you'll see how a question about
        a membership ends as a booked trial class in the calendar.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/en/demo/"
          class="btn btn-primary btn-lg"
        >
          Try the demo
        </a>
        <a
          href="/en/prijzen/"
          class="btn btn-ghost btn-lg"
        >
          See pricing
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Base>
