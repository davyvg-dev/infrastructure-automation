---
import Base from '../../layouts/Base.astro'
import { branches } from '../../data/branches'
import TapValve from '../../components/illustrations/TapValve.astro'
import StormCloud from '../../components/illustrations/StormCloud.astro'
import PaintRoller from '../../components/illustrations/PaintRoller.astro'
import HardHat from '../../components/illustrations/HardHat.astro'
import Dumbbell from '../../components/illustrations/Dumbbell.astro'
import Icon from '../../components/Icon.astro'

// Map illustration name to component for branches that have one.
const illustrations = {
  TapValve,
  StormCloud,
  PaintRoller,
  HardHat,
  Dumbbell,
  RingingPhone: null, // Reserved for the homepage; not used on cards.
}
---

<Base
  lang="en"
  title="Who it's for | Klantkraan for every trade"
  description="Klantkraan works for plumbers, roofers, painters, installers, electricians, contractors and gyms. Pick your trade for a receptionist built around it."
  centered={false}
>
  <!-- Hero -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="font-display text-hero text-(--color-chalk)">What kind of business do you run?</h1>
      <p class="mt-6 max-w-2xl text-h3 text-(--color-dim)">
        Klantkraan speaks the language of your trade. Trial classes and memberships for the gym.
        Call-out charges and emergency rates for the plumber. Square-metre pricing and colour
        samples for the painter.
      </p>
    </div>
  </section>

  <!-- Branches grid -->
  <section
    class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16"
    aria-label="Trades"
  >
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid gap-5 md:gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          branches.map((b) => {
            const Illustration = b.illustration ? illustrations[b.illustration] : null
            return (
              <a
                href={`/en/${b.slug}/`}
                class="group flex flex-col rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5 md:p-6 no-underline transition-colors hover:border-(--color-sodium)"
              >
                <div class="flex items-start justify-between gap-3">
                  <h2 class="font-display text-h2 text-(--color-chalk)">{b.labelPluralEn}</h2>
                  {Illustration && (
                    <div class="hidden text-(--color-sodium) sm:block" aria-hidden="true">
                      <Illustration class="h-20 w-20" />
                    </div>
                  )}
                </div>
                <p class="mt-3 text-body text-(--color-dim)">{b.hubLineEn}</p>
                <p class="mt-5 inline-flex items-center gap-1 text-small font-medium text-(--color-sodium) group-hover:underline">
                  <span>See the solution for {b.labelPluralEn.toLowerCase()}</span>
                  <span aria-hidden="true">→</span>
                </p>
              </a>
            )
          })
        }
      </div>
    </div>
  </section>

  <!-- "My trade isn't listed" -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">Another trade?</p>
      <h2 class="mt-3 font-display text-h2 text-(--color-chalk)">Don't see your trade?</h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-dim)">
        Klantkraan works for any business where customer questions and appointments come in, from
        carpenters, landscapers and glaziers to hairdressers, physios and driving schools. In a
        short intake we capture your services, rates and house rules. After that the receptionist
        answers the way you would yourself.
      </p>
      <div class="mt-8 btn-row">
        <a href="/en/demo/" class="btn btn-primary btn-lg"> Try the demo </a>
        <a href="/en/rekentool/" class="btn btn-ghost btn-lg"> Work out your ROI </a>
      </div>
    </div>
  </section>

  <!-- Trust micro-line -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <ul role="list" class="grid grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-6">
        <li class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
          <div>
            <p class="text-small font-medium text-(--color-chalk)">GDPR + AI Act art. 50</p>
            <p class="text-small text-(--color-dim)">Disclosure on by default</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
          <div>
            <p class="text-small font-medium text-(--color-chalk)">Hosted in the EU</p>
            <p class="text-small text-(--color-dim)">Cloudflare · Neon · Hetzner</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="clock" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
          <div>
            <p class="text-small font-medium text-(--color-chalk)">Cancel monthly</p>
            <p class="text-small text-(--color-dim)">No lock-in, no hidden fees</p>
          </div>
        </li>
      </ul>
    </div>
  </section>
</Base>
