---
import Base from '../../layouts/Base.astro'
import { branches } from '../../data/branches'
import TapValve from '../../components/illustrations/TapValve.astro'
import StormCloud from '../../components/illustrations/StormCloud.astro'
import PaintRoller from '../../components/illustrations/PaintRoller.astro'
import HardHat from '../../components/illustrations/HardHat.astro'
import Dumbbell from '../../components/illustrations/Dumbbell.astro'
import Icon from '../../components/Icon.astro'

// Map illustration name to component for branches that have one.
const illustrations = {
  TapValve,
  StormCloud,
  PaintRoller,
  HardHat,
  Dumbbell,
  RingingPhone: null, // Reserved for the homepage; not used on cards.
}
---

<Base
  lang="en"
  title="Who it's for | Klantkraan for every trade"
  description="Klantkraan works for plumbers, roofers, painters, installers, electricians, contractors and gyms. Pick your trade for a receptionist built around it."
  centered={false}
>
  <!-- Hero -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="font-display text-hero text-(--color-kraan-ink)">
        What kind of business do you run?
      </h1>
      <p class="mt-6 max-w-2xl text-h3 text-(--color-kraan-stone-700)">
        Klantkraan speaks the language of your trade. Trial classes and memberships for the gym.
        Call-out charges and emergency rates for the plumber. Square-metre pricing and colour
        samples for the painter.
      </p>
    </div>
  </section>

  <!-- Branches grid -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16" aria-label="Trades">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid gap-5 md:gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          branches.map((b) => {
            const Illustration = b.illustration ? illustrations[b.illustration] : null
            return (
              <a
                href={`/en/${b.slug}/`}
                class="group flex flex-col rounded-(--radius-card) border border-(--color-kraan-stone-300) bg-white p-5 md:p-6 no-underline transition-colors hover:border-(--color-kraan-blue)"
              >
                <div class="flex items-start justify-between gap-3">
                  <h2 class="font-display text-h2 text-(--color-kraan-ink)">{b.labelPluralEn}</h2>
                  {Illustration && (
                    <div
                      class="hidden text-(--color-kraan-blue) sm:block"
                      aria-hidden="true"
                    >
                      <Illustration class="h-20 w-20" />
                    </div>
                  )}
                </div>
                <p class="mt-3 text-body text-(--color-kraan-stone-700)">{b.hubLineEn}</p>
                <p
                  class="mt-5 inline-flex items-center gap-1 text-small font-medium text-(--color-kraan-blue) group-hover:underline"
                >
                  <span>See the solution for {b.labelPluralEn.toLowerCase()}</span>
                  <span aria-hidden="true">→</span>
                </p>
              </a>
            )
          })
        }
      </div>
    </div>
  </section>

  <!-- "My trade isn't listed" -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p
        class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)"
      >
        Another trade?
      </p>
      <h2 class="mt-3 font-display text-h2 text-(--color-kraan-ink)">
        Don't see your trade?
      </h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-kraan-stone-700)">
        Klantkraan works for any business where customer questions and appointments come in, from
        carpenters, landscapers and glaziers to hairdressers, physios and driving schools. In a
        short intake we capture your services, rates and house rules. After that the receptionist
        answers the way you would yourself.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/en/demo/"
          class="inline-block rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
        >
          Try the demo
        </a>
        <a
          href="/en/rekentool/"
          class="inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
        >
          Work out your ROI
        </a>
      </div>
    </div>
  </section>

  <!-- Trust micro-line -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <dl class="grid grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-6">
        <div class="flex items-start gap-3">
          <Icon
            name="shield-check"
            class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)"
          />
          <div>
            <dt class="text-small font-medium text-(--color-kraan-ink)">GDPR + AI Act art. 50</dt>
            <dd class="text-small text-(--color-kraan-stone-500)">Disclosure on by default</dd>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Icon
            name="shield-check"
            class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)"
          />
          <div>
            <dt class="text-small font-medium text-(--color-kraan-ink)">Hosted in the EU</dt>
            <dd class="text-small text-(--color-kraan-stone-500)">Cloudflare · Neon · Hetzner</dd>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Icon name="clock" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
          <div>
            <dt class="text-small font-medium text-(--color-kraan-ink)">Cancel monthly</dt>
            <dd class="text-small text-(--color-kraan-stone-500)">No lock-in, no hidden fees</dd>
          </div>
        </div>
      </dl>
    </div>
  </section>
</Base>
