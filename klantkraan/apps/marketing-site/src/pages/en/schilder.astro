---
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import Stat from '../../components/Stat.astro'
import PaintRoller from '../../components/illustrations/PaintRoller.astro'
import RiskReversal from '../../components/RiskReversal.astro'

// Painter landing page. Follows the /loodgieters template structure.
// Trade-specific copy: quote requests, spring peak, per-m² rate, colour sample.

interface PainStat {
  value: string
  caption: string
}

const painStats: PainStat[] = [
  { value: '37%', caption: 'of your quote requests come in after 5pm.' },
  { value: '€2,500', caption: 'average value of an interior painting job on a home.' },
  { value: '3×', caption: 'more requests in March to May (the spring peak).' },
]

interface Feature {
  icon: 'phone' | 'message-square' | 'calendar-check'
  title: string
  body: string
}

const features: Feature[] = [
  {
    icon: 'message-square',
    title: 'Knows your per-m² rate by heart',
    body: 'Answers customer questions on your website and via WhatsApp, in clear, natural language, well after 5pm too. Quotes only your own per-m² rate, colour-sample surcharge and spray-work surcharge. Nothing invented, nothing approximate.',
  },
  {
    icon: 'calendar-check',
    title: 'Appointments straight into your calendar',
    body: 'Site-survey and quote appointments are booked straight into your calendar, only in the slots you have made available yourself. No phone tag, no back-and-forth email.',
  },
  {
    icon: 'phone',
    title: 'Leads and callback requests on your phone',
    body: 'A homeowner asks for a quote after hours? The receptionist catches the request and sends it straight to your phone as a message, with name, number and the question. No prospect slips away while you\'re up on the scaffolding.',
  },
]

interface Faq {
  q: string
  a: string
  href?: string
  linkLabel?: string
}

const faqs: Faq[] = [
  {
    q: 'How does the receptionist get onto my website?',
    a: 'With one small script that we install for you. You don\'t have to do a thing. We connect the WhatsApp channel in the same done-for-you setup. You keep your own site, your own number and your own branding.',
  },
  {
    q: 'And if I\'m up on the scaffolding and can\'t reply?',
    a: 'That\'s exactly what this is built for. The receptionist answers the question (a new quote request, a scheduling question, a supplier, a complaint), qualifies the request by postcode and project size, and books an appointment in your calendar. You get a summary by WhatsApp or email. You can call back on your break or after hours.',
  },
  {
    q: 'What if five customers send a request at the same time during the spring season?',
    a: 'The receptionist handles conversations in parallel. No queue. Ten customers can chat or WhatsApp at the same time about an exterior painting job, and all ten get an answer straight away. Emergencies (water or mould damage) are recognised and kept separate from scheduling requests.',
  },
  {
    q: 'Can the customer tell it\'s AI?',
    a: 'Yes. Every conversation opens by telling your customer they\'re chatting with a digital assistant, on behalf of your business. That isn\'t a marketing choice but a legal requirement under the EU AI Act (article 50). The disclosure always stays on.',
    href: '/legal/ai-disclosure/',
    linkLabel: 'Read the full AI disclosure',
  },
  {
    q: 'What if the AI says something wrong about my rates?',
    a: 'That can\'t happen. The assistant only quotes rates you\'ve entered into your system yourself: call-out charge, per-m² rate for interior and exterior, spray-work surcharge, colour sample. Unknown prices are never invented; the customer gets a callback request instead. We test every configuration before you go live.',
  },
  {
    q: 'What happens to the customer data?',
    a: 'We host in the EU: Hetzner Frankfurt, Neon EU, Cloudflare EU. We sign a data processing agreement (DPA) with you and keep chat conversations for 30 days, unless you want them kept for less. The full supplier list is published openly in our sub-processor register.',
    href: '/legal/dpa/',
    linkLabel: 'View the DPA and privacy statement',
  },
  {
    q: 'Cancel monthly, really?',
    a: 'Yes. No annual contract, no hidden renewal. You cancel by email; the notice period is one month. For anyone who would rather pay 6 or 12 months up front there\'s a discount (15% and 20% respectively).',
    href: '/legal/voorwaarden/',
    linkLabel: 'Read the terms and conditions',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
}
---

<Base
  lang="en"
  title="Win painting clients: AI receptionist for quotes | Klantkraan"
  description="AI receptionist for painters, cancel monthly. Knows your per-m² rate and colour-sample surcharge, catches spring-peak requests and books appointments, 24/7."
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div
      class="mx-auto grid max-w-5xl gap-10 px-6 md:grid-cols-[1fr_auto] md:items-center md:gap-16"
    >
      <div>
        <h1 class="font-display text-hero text-chalk">
          The <span class="text-(--color-sodium)">customer engine</span> for painters.
        </h1>
        <p class="mt-6 max-w-2xl text-h3 text-dim">
          A digital receptionist on your website and WhatsApp that keeps quote requests,
          scheduling questions and suppliers apart. It catches the evening requests you miss now
          while you're up on the scaffolding. And the spring peak without you hiring extra people.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/en/demo/"
            class="btn btn-primary btn-lg"
          >
            Try the demo
          </a>
          <a
            href="/en/rekentool/"
            class="btn btn-ghost btn-lg"
          >
            Work out your ROI
          </a>
        </div>
      </div>
      <div class="hidden text-(--color-sodium) md:block">
        <PaintRoller class="h-64 w-64 lg:h-72 lg:w-72" />
      </div>
    </div>
    <div class="mx-auto max-w-5xl px-6">
      <ul role="list" class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-6">
        <li class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
          <div>
            <p class="text-small font-medium text-chalk">GDPR + AI Act art. 50</p>
            <p class="text-small text-dim">Disclosure on by default</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
          <div>
            <p class="text-small font-medium text-chalk">Hosted in the EU</p>
            <p class="text-small text-dim">Cloudflare · Neon · Hetzner</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="phone-call" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
          <div>
            <p class="text-small font-medium text-chalk">Natural conversation</p>
            <p class="text-small text-dim">Knows your per-m² rate + colour sample</p>
          </div>
        </li>
      </ul>
      <p class="mt-8 text-small text-dim">
        Cancel monthly · Done-for-you setup · 50% off the first month
      </p>
    </div>
  </section>

  <!-- 1b. Risk-reversal -->
  <RiskReversal lang="en" />

  <!-- 2. Pain-stats trio (stone-100) -->
  <section
    class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16"
    aria-label="What a missed quote request costs a painter"
  >
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 sm:grid-cols-3">
      {painStats.map((stat) => <Stat value={stat.value} label={stat.caption} />)}
    </div>
  </section>

  <!-- 3. Modules (cream, hairline rows) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">Modules</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">
        What Klantkraan does for painters.
      </h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        Three modules. One monthly price. Built for the painter who doesn't want to miss another evening call during the spring peak.
      </p>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          features.map((feature) => (
            <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
              <Icon name={feature.icon} class="mt-1 h-7 w-7 text-(--color-sodium)" />
              <div>
                <h3 class="font-display text-h3 text-chalk">{feature.title}</h3>
                <p class="mt-2 text-body text-dim">{feature.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. ROI snippet (stone-100) -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">The maths</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">
        Do the maths.
      </h2>
      <div class="mt-8 rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-6 md:p-10">
        <p class="text-h3 text-chalk">
          Miss 5 quote requests a month at €2,500 each? That's <strong class="text-(--color-sodium)">around €50,000 in lost revenue a year</strong>.
        </p>
        <p class="mt-4 text-body text-dim">
          Klantkraan Chat is €299 a month. One spring job you currently lose to the evening callers pays for the whole
          subscription. The rest goes in your pocket instead of a competitor's.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/en/rekentool/"
            class="btn btn-primary btn-lg"
          >
            Open the calculator
          </a>
          <a
            href="/en/prijzen/"
            class="btn btn-ghost btn-lg"
          >
            See pricing
          </a>
        </div>
        <p class="mt-6 text-micro text-dim">
          Amounts exclude 21% VAT. Example based on an industry-average €2,500 per interior
          painting job on a home (source: OnderhoudNL industry figures) and the assumption that
          roughly 1 in 3 missed requests would have become a paying job (33% conversion rate).
        </p>
      </div>
    </div>
  </section>

  <!-- 5. FAQ (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">Questions</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">
        Frequently asked questions.
      </h2>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          faqs.map((faq) => (
            <details class="group py-4">
              <summary class="block min-h-[2.75rem] cursor-pointer list-none py-1 font-display text-h3 text-chalk marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{faq.q}</span>
                  <Icon
                    name="chevron-down"
                    class="mt-1 h-5 w-5 shrink-0 text-(--color-sodium) transition-transform group-open:rotate-180"
                  />
                </span>
              </summary>
              <p class="mt-3 text-body text-dim">{faq.a}</p>
              {faq.href && faq.linkLabel && (
                <p class="mt-3 text-small">
                  <a href={faq.href} class="underline">
                    {faq.linkLabel}
                  </a>
                </p>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. Final CTA (blue) -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="font-display text-h1 text-chalk">
        Ready for the spring season?
      </h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        Try the live demo. You'll see how it tells a per-m² question and a colour-sample question apart,
        and what it does when someone asks about spray work.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/en/demo/"
          class="btn btn-primary btn-lg"
        >
          Try the demo
        </a>
        <a
          href="/en/prijzen/"
          class="btn btn-ghost btn-lg"
        >
          See pricing
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Base>
