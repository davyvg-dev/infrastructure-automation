---
import Base from '../../layouts/Base.astro'
import FlowDiagram from '../../components/diagrams/FlowDiagram.astro'
import CostReceipt from '../../components/home/CostReceipt.astro'
import FinalCta from '../../components/home/FinalCta.astro'
import Hero from '../../components/home/Hero.astro'
import Honest from '../../components/home/Honest.astro'
import HowItWorks from '../../components/home/HowItWorks.astro'
import { waLink } from '../../data/contact'

const hero = {
  status: 'Answering now on site and WhatsApp',
  h1a: 'The light stays',
  h1on: 'on.',
  sub:
    "You're up a ladder, on a roof or asleep, and a customer has a question right now. " +
    "Klantkraan's digital receptionist answers it on your site and WhatsApp, day and night. " +
    'It books the appointment and notes every callback request.',
  ctaPrimary: 'Start today',
  ctaPrimaryHref: '/en/aanmelden/',
  ctaGhost: 'Try the demo',
  ctaGhostHref: '/en/demo/',
  proof: [
    { label: 'Done-for-you setup' },
    { label: 'Cancel monthly' },
    { label: 'GDPR-compliant, EU-hosted' },
  ],
  panelAria:
    'Conversation at 23:47: a customer with a leak asks a question, the digital receptionist books an appointment for Tuesday 09:00 and prepares a callback request for the owner.',
  threadName: 'Klantkraan',
  threadSub: 'Replies instantly',
  liveTs: 'Tonight 23:47',
  disclosure: "You're chatting with a digital assistant.",
  customerMsg: "I've got a leak under the kitchen sink, can someone come tomorrow?",
  recepMsg:
    "Sorry to hear that, we'll sort it. Tomorrow 09:00 is free. Shall I lock that in for you?",
  stampStrong: 'BOOKED',
  stampDetail: 'Tue 09:00 · callback ready for the owner',
  window: {
    title: 'klantkraan',
    meta: 'Example',
    listLabel: 'Conversations',
    rows: [
      { channel: 'WhatsApp', time: '23:47', text: 'Leak under the kitchen sink', status: 'Booked', active: true },
      { channel: 'Website chat', time: '22:14', text: 'Boiler stopped working', status: 'Call back' },
      { channel: 'WhatsApp', time: '20:31', text: 'Do you also work in Haarlem?', status: 'Answered' },
      { channel: 'Website chat', time: '18:05', text: 'What does replacing a tap cost?', status: 'Answered' },
    ],
    resultLabel: 'Appointment',
    fields: [
      { k: 'Job', v: 'Leak under the kitchen sink' },
      { k: 'When', v: 'Tue 09:00' },
      { k: 'Via', v: 'WhatsApp, 23:47' },
      { k: 'Next', v: 'Callback ready for the owner' },
    ],
  },
}

const flow = {
  label: 'The night shift',
  heading: 'What the receptionist takes over while you work.',
  steps: [
    { title: 'Answers every question', text: 'Knows your rates, services and service area, and only quotes prices you have set.' },
    { title: 'Books the appointment', text: 'Straight into your calendar, only in free slots. The customer picks one and you see it at once.' },
    { title: 'Captures the callback', text: "When you can't pick up, the receptionist notes the name, number and job. You call back the ones that matter." },
  ],
}
const flowLabels = {
  inSite: 'Website chat',
  inWa: 'WhatsApp',
  node: 'Klantkraan',
  nodeSub: 'digital receptionist',
  outAnswer: 'Answer',
  outBooking: 'Appointment booked',
  outCallback: 'Callback request',
  aria:
    'Diagram: questions via website chat and WhatsApp come in at Klantkraan, which answers them, books an appointment in your calendar or prepares a callback request for you.',
}

const cost = {
  eyebrow: 'The bill for a dark evening',
  heading: 'Every unanswered question is a job walking to your competitor.',
  sub:
    'This is an example. Run it on your own numbers to see what a month of missed calls costs you.',
  ariaLabel: 'Example calculation of lost revenue',
  cap: 'Example · 40 calls a week',
  lines: [
    { k: 'Calls per month', v: '173' },
    { k: 'Missed (industry estimate: 28%)', v: '48' },
    { k: 'Would have become jobs (1 in 3)', v: '16' },
    { k: '× value per job', v: '€450' },
  ],
  resultK: 'Lost revenue',
  resultV: '± €7,200/mo',
  ctaLabel: 'Run it on your own numbers',
  ctaHref: '/en/rekentool/',
}

const honest = {
  eyebrow: 'Honest about AI',
  heading: "The light is on. There's nothing to hide.",
  quote: "You're chatting with a digital assistant.",
  bullets: [
    'Every conversation starts with that line.',
    'Article 50 of the EU AI Act requires that notice from 2 August 2026.',
    'Some voicebots are sold on "nobody can tell the difference". Our receptionist says what it is. Your customer knows where they stand, and you risk no fine.',
  ],
  linkLabel: 'Read the full disclosure',
  linkHref: '/legal/ai-disclosure/',
}

const start = {
  eyebrow: 'Getting started',
  heading: 'Sign up today, live this week.',
  steps: [
    {
      title: 'Sign up',
      text: 'Five minutes. You pay straight away through Mollie: first month €149.50, then €299 a month, excl. VAT.',
    },
    {
      title: 'We build your receptionist',
      text: 'Within one working day we call to go through your services, rates and calendar. You build nothing.',
    },
    {
      title: 'Live on your site and WhatsApp',
      text: 'You test it yourself and give the go-ahead. From that moment it answers every enquiry, day and night.',
    },
  ],
  note: 'Cancel monthly by email, with no notice period. No annual contract, no hidden renewal.',
}

const roadmap = {
  eyebrow: 'Where this is going',
  heading: 'The front desk today. The office next.',
  sub:
    'The receptionist covers the front door: everything that arrives while you are working. ' +
    'Behind that sits the paperwork you now do at the kitchen table at night. That is where ' +
    'we are heading, together with our first clients.',
  nowLabel: 'What it does now',
  now: [
    'Answers questions on your site and WhatsApp, day and night',
    'Books appointments straight into your own calendar',
    'Takes callback requests with name, number and job',
    'Says it is a digital assistant, in every conversation',
  ],
  laterLabel: 'What we are building',
  laterNote:
    'Not available yet. It is not part of your subscription and you are not paying for it.',
  later: [
    'Quotes that follow up by themselves when the customer goes quiet',
    'Appointment reminders, so nobody drives out for nothing',
    'Review requests as soon as the job is done',
    'Reminders for unpaid invoices',
  ],
  footnote:
    'Our clients at the time decide which of these comes first, not us. Ask for something ' +
    "that isn't on the list and we'll tell you so, and when it will be.",
}

const finalCta = {
  h2a: 'Turn the light',
  h2on: 'on.',
  sub:
    'Try the demo and ask the receptionist a question as if you were a customer. If you like ' +
    'it, sign up and we do the rest. You build nothing.',
  primary: { label: 'Start today', href: '/en/aanmelden/' },
  ghosts: [
    { label: 'Try the demo', href: '/en/demo/' },
    { label: 'Book an intro chat', href: waLink, external: true },
  ],
}
---

<Base
  lang="en"
  title="AI receptionist for your business: website chat & WhatsApp | Klantkraan"
  description="An AI receptionist on your website and WhatsApp: answers questions, books appointments and captures leads, day and night. Done-for-you setup. Cancel monthly."
  centered={false}
>
  <Hero t={hero} />
  <FlowDiagram t={flow} labels={flowLabels} />
  <CostReceipt t={cost} />
  <Honest eerlijk={honest} roadmap={roadmap} />
  <HowItWorks t={start} />
  <FinalCta t={finalCta} />
</Base>
