---
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import Stat from '../../components/Stat.astro'
import HardHat from '../../components/illustrations/HardHat.astro'
import RiskReversal from '../../components/RiskReversal.astro'

// Building-contractor landing page. Follows the /en/loodgieters template structure.
// Trade-specific copy: quote requests, variations, subcontractors, project scheduling.

interface PainStat {
  value: string
  caption: string
}

const painStats: PainStat[] = [
  { value: '41%', caption: 'of your quote requests come in outside office hours.' },
  { value: '€12k', caption: 'average size of a missed renovation enquiry.' },
  { value: '5×', caption: 'more enquiries after a neighbourhood renovation project in the area.' },
]

interface Feature {
  icon: 'phone' | 'message-square' | 'calendar-check'
  title: string
  body: string
}

const features: Feature[] = [
  {
    icon: 'message-square',
    title: 'Sorts quote requests and variations separately',
    body: 'Answers customer questions on your website and via WhatsApp, in natural language, in the evenings and at weekends too. Sorts quote requests, variations, suppliers and emergencies apart. In the morning a short list is waiting in your WhatsApp, before you climb into the van.',
  },
  {
    icon: 'calendar-check',
    title: 'Appointments straight into your calendar',
    body: 'Consultation and measuring-up appointments are booked straight into your calendar, only in the slots you\'ve released yourself. No phone tag, no back-and-forth email between two renovations.',
  },
  {
    icon: 'phone',
    title: 'Leads and callback requests on your phone',
    body: 'A client gets in touch during a site visit? The receptionist catches the enquiry and puts it straight on your phone as a message, with name, number and project type. No prospect gets lost in a voicemail.',
  },
]

interface Faq {
  q: string
  a: string
  href?: string
  linkLabel?: string
}

const faqs: Faq[] = [
  {
    q: 'How does the receptionist get onto my website?',
    a: 'With one small script that we install for you. You don\'t have to do a thing. We connect the WhatsApp channel in the same done-for-you setup. You keep your own site, your own number and your own branding.',
  },
  {
    q: 'And when I\'m on site?',
    a: 'That\'s exactly what this is built for. The receptionist answers the question (quote request, variation query, supplier, complaint), qualifies new enquiries by postcode and project type, and books an appointment in your calendar. You get a summary by WhatsApp or email. You can call back on your break.',
  },
  {
    q: 'What if three customers ask for a quote at the same time?',
    a: 'The receptionist handles conversations in parallel. No queue. Ten customers can chat or message at once, and all ten get an answer straight away. Emergencies (a leak, damage, an insurance claim) are recognised and separated from scheduling enquiries.',
  },
  {
    q: 'Can the customer tell it\'s AI?',
    a: 'Yes. Every conversation opens by stating that your customer is chatting with a digital assistant, on behalf of your business. That isn\'t a marketing choice but a legal requirement under the European AI Act (article 50). The disclosure always stays on.',
    href: '/legal/ai-disclosure/',
    linkLabel: 'Read the full AI disclosure',
  },
  {
    q: 'What if the AI says something wrong about my rates or availability?',
    a: 'That can\'t happen. The assistant only states what you\'ve put into your system yourself: call-out charges, the hourly inspection rate, lead times on your schedule, holiday periods. Unknown questions are never made up; instead the customer gets a callback request. We test every configuration before you go live.',
  },
  {
    q: 'What happens to the customer data?',
    a: 'We host in the EU: Hetzner Frankfurt, Neon EU, Cloudflare EU. We sign a data processing agreement (DPA) with you and keep chat conversations for 30 days, unless you want a shorter period. The full supplier list is public in our sub-processor register.',
    href: '/legal/dpa/',
    linkLabel: 'View the DPA and privacy statement',
  },
  {
    q: 'Cancel monthly, really?',
    a: 'Yes. No annual contract, no hidden renewal. You cancel by email; notice is one month. If you\'d rather pay 6 or 12 months up front there\'s a discount (15% and 20% respectively).',
    href: '/legal/voorwaarden/',
    linkLabel: 'Read the terms and conditions',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]+>/g, ''),
    },
  })),
}
---

<Base
  title="Win contractor clients: AI receptionist for quotes | Klantkraan"
  description="AI receptionist for building contractors, cancel monthly. Sorts quote requests and variations, books appointments and captures leads while you're on site."
  lang="en"
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div
      class="mx-auto grid max-w-5xl gap-10 px-6 md:grid-cols-[1fr_auto] md:items-center md:gap-16"
    >
      <div>
        <h1 class="font-display text-hero text-(--color-kraan-ink)">
          The <span class="text-(--color-kraan-rust)">customer engine</span> for building contractors.
        </h1>
        <p class="mt-6 max-w-2xl text-h3 text-(--color-kraan-stone-700)">
          Keeps quote requests, variations and suppliers apart. Someone asks about a renovation at
          19:30 while you're still on site? The digital receptionist answers them on your website
          and via WhatsApp. No more missed enquiries.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/en/demo/"
            class="inline-block rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
          >
            Try the demo
          </a>
          <a
            href="/en/rekentool/"
            class="inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
          >
            Work out your ROI
          </a>
        </div>
      </div>
      <div class="hidden text-(--color-kraan-blue) md:block">
        <HardHat class="h-64 w-64 lg:h-72 lg:w-72" />
      </div>
    </div>
    <div class="mx-auto max-w-5xl px-6">
      <ul role="list" class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-6">
        <li class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
          <div>
            <p class="text-small font-medium text-(--color-kraan-ink)">GDPR + AI Act art. 50</p>
            <p class="text-small text-(--color-kraan-stone-500)">Disclosure on by default</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
          <div>
            <p class="text-small font-medium text-(--color-kraan-ink)">Hosted in the EU</p>
            <p class="text-small text-(--color-kraan-stone-500)">Cloudflare · Neon · Hetzner</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="phone-call" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
          <div>
            <p class="text-small font-medium text-(--color-kraan-ink)">Natural conversation</p>
            <p class="text-small text-(--color-kraan-stone-500)">Filters quote requests</p>
          </div>
        </li>
      </ul>
      <p class="mt-8 text-small text-(--color-kraan-stone-500)">
        Cancel monthly · Done-for-you setup · 50% off your first month
      </p>
    </div>
  </section>

  <!-- 1b. Risk-reversal -->
  <RiskReversal lang="en" />

  <!-- 2. Pain-stats trio (stone-100) -->
  <section
    class="bg-(--color-kraan-stone-100) py-10 md:py-16"
    aria-label="What a missed call costs a building contractor"
  >
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 sm:grid-cols-3">
      {painStats.map((stat) => <Stat value={stat.value} label={stat.caption} />)}
    </div>
  </section>

  <!-- 3. Modules (cream, hairline rows) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">Modules</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">
        What Klantkraan does for building contractors.
      </h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-kraan-stone-700)">
        Three modules. One monthly price. For the contractor who's on site when their best prospect calls.
      </p>
      <div class="mt-10 divide-y divide-(--color-kraan-stone-300) border-y border-(--color-kraan-stone-300)">
        {
          features.map((feature) => (
            <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
              <Icon name={feature.icon} class="mt-1 h-7 w-7 text-(--color-kraan-blue)" />
              <div>
                <h3 class="font-display text-h3 text-(--color-kraan-ink)">{feature.title}</h3>
                <p class="mt-2 text-body text-(--color-kraan-stone-700)">{feature.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. ROI snippet (stone-100) -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">The maths</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">
        Do the maths.
      </h2>
      <div class="mt-8 rounded-(--radius-card) border border-(--color-kraan-stone-300) bg-white p-6 md:p-10">
        <p class="text-h3 text-(--color-kraan-ink)">
          Miss 2 quote requests a month at €12,000 each? That's <strong class="text-(--color-kraan-rust)">around €95,000 in lost revenue a year</strong>.
        </p>
        <p class="mt-4 text-body text-(--color-kraan-stone-700)">
          Klantkraan Chat is €299 a month. One extra renovation a year covers well over three years of subscription. After that,
          every missed prospect you win back is pure profit.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/en/rekentool/"
            class="inline-block rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
          >
            Open the calculator
          </a>
          <a
            href="/en/prijzen/"
            class="inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
          >
            See the pricing
          </a>
        </div>
        <p class="mt-6 text-micro text-(--color-kraan-stone-500)">
          Amounts exclude 21% VAT. Example based on the industry average of €12k per
          renovation/refurbishment quote (source: BNA / Aedes 2024 benchmarks) and the assumption that
          roughly 1 in 3 missed enquiries would have turned into a paying job (33% conversion rate).
        </p>
      </div>
    </div>
  </section>

  <!-- 5. FAQ (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">Questions</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">
        Frequently asked questions.
      </h2>
      <div class="mt-10 divide-y divide-(--color-kraan-stone-300) border-y border-(--color-kraan-stone-300)">
        {
          faqs.map((faq) => (
            <details class="group py-4">
              <summary class="block min-h-[2.75rem] cursor-pointer list-none py-1 font-display text-h3 text-(--color-kraan-ink) marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{faq.q}</span>
                  <Icon
                    name="chevron-down"
                    class="mt-1 h-5 w-5 shrink-0 text-(--color-kraan-blue) transition-transform group-open:rotate-180"
                  />
                </span>
              </summary>
              <p class="mt-3 text-body text-(--color-kraan-stone-700)">{faq.a}</p>
              {faq.href && faq.linkLabel && (
                <p class="mt-3 text-small">
                  <a href={faq.href} class="underline">
                    {faq.linkLabel}
                  </a>
                </p>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. Final CTA (blue) -->
  <section class="bg-(--color-kraan-blue) py-10 md:py-16 text-white">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="font-display text-h1 text-white break-words hyphens-auto">
        Ready to stop missing renovation enquiries?
      </h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-kraan-stone-100)">
        Try the live demo. Then you'll know how it keeps quote requests, variation queries and
        suppliers apart. And how that lands in your WhatsApp.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/en/demo/"
          class="inline-block rounded-(--radius-button) bg-white px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
        >
          Try the demo
        </a>
        <a
          href="/en/prijzen/"
          class="inline-block rounded-(--radius-button) border border-white px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
        >
          See pricing
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Base>
