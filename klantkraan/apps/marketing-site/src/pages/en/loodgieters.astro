---
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import Stat from '../../components/Stat.astro'
import TapValve from '../../components/illustrations/TapValve.astro'
import RiskReversal from '../../components/RiskReversal.astro'

// Plumbers (loodgieters) landing page, English.
// Faithful translation of ../loodgieters.astro. Voice mirrors en/index.astro
// (you-form, no fluff, concrete numbers, no emojis).

interface PainStat {
  value: string
  caption: string
}

const painStats: PainStat[] = [
  { value: '28%', caption: 'of your calls go unanswered.' },
  { value: '€450', caption: 'average value per missed job.' },
  { value: '0', caption: 'reviews for every job you don\'t pick up.' },
]

interface Feature {
  icon: 'phone' | 'message-square' | 'calendar-check'
  title: string
  body: string
}

const features: Feature[] = [
  {
    icon: 'message-square',
    title: 'Knows your call-out charges by heart',
    body: 'Answers customer questions on your website and via WhatsApp, in natural English. Evenings and weekends too. Never quotes a rate you haven\'t set yourself.',
  },
  {
    icon: 'calendar-check',
    title: 'Appointments straight into your calendar',
    body: 'The receptionist books callback and job appointments straight into your calendar, only in the slots you\'ve opened up. No phone tag, no back-and-forth email.',
  },
  {
    icon: 'phone',
    title: 'Leads and callback requests on your phone',
    body: 'Every lead and callback request lands on your phone as a message, with the name, number and the customer\'s question. No customer gets lost in a voicemail.',
  },
]

interface Faq {
  q: string
  a: string
  href?: string
  linkLabel?: string
}

const faqs: Faq[] = [
  {
    q: 'How does the receptionist get onto my website?',
    a: 'With one small script that we install for you. You don\'t have to do a thing. We connect the WhatsApp channel in the same done-for-you setup. You keep your own site, your own number and your own branding.',
  },
  {
    q: 'And what if I\'m on site and can\'t respond?',
    a: 'That\'s exactly what this is built for. The receptionist answers the question (emergency, new job, existing customer, supplier), books an appointment in your calendar if wanted and sends you a summary by WhatsApp or email. You call back when it suits you.',
  },
  {
    q: 'Can the customer tell it\'s AI?',
    a: 'Yes. Every conversation opens by telling your customer they\'re chatting with a digital assistant, on behalf of your business. That isn\'t a marketing choice but a legal requirement under the European AI Act (article 50). The disclosure always stays on.',
    href: '/legal/ai-disclosure/',
    linkLabel: 'Read the full AI disclosure',
  },
  {
    q: 'What if the AI says something wrong about my prices?',
    a: 'That can\'t happen. The assistant only quotes rates you\'ve set in your own system: call-out charge, hourly rate, emergency surcharge, materials mark-up. Unknown prices are never made up; the customer gets a callback request instead. We test every configuration before you go live.',
  },
  {
    q: 'What happens to the customer data?',
    a: 'We host in the EU: Hetzner Frankfurt, Neon EU, Cloudflare EU. We sign a data processing agreement (DPA) with you and keep chat conversations for 30 days, unless you want less. The full supplier list is published openly in our sub-processor register.',
    href: '/legal/dpa/',
    linkLabel: 'View the DPA and privacy statement',
  },
  {
    q: 'Cancel monthly, really?',
    a: 'Yes. No annual contract, no hidden renewal. You cancel by email; notice period is one month. For anyone who\'d rather pay 6 or 12 months up front there\'s a discount (15% and 20% respectively), but that\'s a choice, not the default.',
    href: '/legal/voorwaarden/',
    linkLabel: 'Read the terms and conditions',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]+>/g, ''),
    },
  })),
}
---

<Base
  lang="en"
  title="Win plumbing customers: AI receptionist for emergencies"
  description="AI receptionist for plumbers, cancel monthly. Knows your call-out charge and emergency surcharge, books appointments and captures leads via chat and WhatsApp."
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div
      class="mx-auto grid max-w-5xl gap-10 px-6 md:grid-cols-[1fr_auto] md:items-center md:gap-16"
    >
      <div>
        <h1 class="font-display text-hero text-chalk">
          The <span class="text-(--color-sodium)">Customer Engine</span> for plumbers.
        </h1>
        <p class="mt-6 max-w-2xl text-h3 text-dim">
          Under a sink right now? Our digital receptionist answers the customer's question on your
          website and via WhatsApp, with your call-out charge and emergency rate ready to hand.
          Evenings, weekends, holidays. Same story. Appointments and callback requests come with the
          same subscription.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/en/demo/"
            class="btn btn-primary btn-lg"
          >
            Try the demo
          </a>
          <a
            href="/en/rekentool/"
            class="btn btn-ghost btn-lg"
          >
            Work out your ROI
          </a>
        </div>
      </div>
      <div class="hidden text-(--color-sodium) md:block">
        <TapValve class="h-64 w-64 lg:h-72 lg:w-72" />
      </div>
    </div>
    <div class="mx-auto max-w-5xl px-6">
      <ul role="list" class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-6">
        <li class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
          <div>
            <p class="text-small font-medium text-chalk">GDPR + AI Act art. 50</p>
            <p class="text-small text-dim">Disclosure on by default</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
          <div>
            <p class="text-small font-medium text-chalk">Hosted in the EU</p>
            <p class="text-small text-dim">Cloudflare · Neon · Hetzner</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="phone-call" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
          <div>
            <p class="text-small font-medium text-chalk">Natural conversation</p>
            <p class="text-small text-dim">Knows call-out + emergency rates</p>
          </div>
        </li>
      </ul>
      <p class="mt-8 text-small text-dim">
        Cancel monthly · Done-for-you setup · First month 50% off
      </p>
    </div>
  </section>

  <!-- 1b. Risk-reversal -->
  <RiskReversal lang="en" />

  <!-- 2. Pain-stats trio (stone-100) -->
  <section
    class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16"
    aria-label="What a missed call costs"
  >
    <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 sm:grid-cols-3">
      {painStats.map((stat) => <Stat value={stat.value} label={stat.caption} />)}
    </div>
  </section>

  <!-- 3. What Klantkraan does for plumbers (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">Modules</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">
        What Klantkraan does for plumbers.
      </h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        Three modules. One monthly price. Built for the plumber who spends more time under a sink than by the phone.
      </p>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          features.map((feature) => (
            <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
              <Icon name={feature.icon} class="mt-1 h-7 w-7 text-(--color-sodium)" />
              <div>
                <h3 class="font-display text-h3 text-chalk">{feature.title}</h3>
                <p class="mt-2 text-body text-dim">{feature.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 5. ROI snippet (cream; inner white card) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">The maths</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">
        Do the maths.
      </h2>
      <div class="mt-8 rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-6 md:p-10">
        <p class="text-h3 text-chalk">
          Miss 10 calls a week at €450 each? That's <strong class="text-(--color-sodium)">over €77,000 in lost revenue a year</strong>.
        </p>
        <p class="mt-4 text-body text-dim">
          Klantkraan Chat is €299 a month. One extra emergency job a month and you break even.
          Everything after that is your margin.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/en/rekentool/"
            class="btn btn-primary btn-lg"
          >
            Open the calculator
          </a>
          <a
            href="/en/prijzen/"
            class="btn btn-ghost btn-lg"
          >
            See the rates
          </a>
        </div>
        <p class="mt-6 text-micro text-dim">
          Amounts exclude 21% VAT. Example based on an industry average of €450 per call
          (source: Aira / Invoca missed-call benchmarks) and the assumption that roughly 1 in 3
          missed calls would have turned into a paying job (33% conversion chance).
        </p>
      </div>
    </div>
  </section>

  <!-- 6. FAQ (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="eyebrow">Questions</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">
        Frequently asked questions.
      </h2>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          faqs.map((faq) => (
            <details class="group py-4">
              <summary class="block min-h-[2.75rem] cursor-pointer list-none py-1 font-display text-h3 text-chalk marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{faq.q}</span>
                  <Icon
                    name="chevron-down"
                    class="mt-1 h-5 w-5 shrink-0 text-(--color-sodium) transition-transform group-open:rotate-180"
                  />
                </span>
              </summary>
              <p class="mt-3 text-body text-dim">{faq.a}</p>
              {faq.href && faq.linkLabel && (
                <p class="mt-3 text-small">
                  <a href={faq.href} class="underline">
                    {faq.linkLabel}
                  </a>
                </p>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 8. Final CTA band (blue) -->
  <section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="font-display text-h1 text-chalk">
        Ready to stop missing jobs?
      </h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        Try the live demo. In one conversation you'll see how the receptionist answers a question
        about call-out charges and puts an appointment in the calendar.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/en/demo/"
          class="btn btn-primary btn-lg"
        >
          Try the demo
        </a>
        <a
          href="/en/prijzen/"
          class="btn btn-ghost btn-lg"
        >
          See pricing
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Base>
