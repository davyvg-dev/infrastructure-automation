---
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import { waLink, mailLink } from '../../data/contact'

// English demo embeds the airco (Mallorca) config on the shared demo origin
// (already CSP-allowlisted in public/_headers). NOTE: this only replies in
// English once config/clients/airco-mallorca.yaml is deployed to the demo
// server AND a valid ANTHROPIC_API_KEY is set. Until then it falls back to the
// server default. Same origin as the Dutch demo, so no _headers change needed.
const DEMO_SRC = 'https://demo-168-119-173-25.sslip.io/?client=airco-mallorca&embed=1'
---

<Base
  lang="en"
  title="Demo: try Klantkraan's digital receptionist"
  description="Try Klantkraan's digital receptionist right in your browser — ask a question or request an appointment. Prefer a personal demo on your own services? Send a WhatsApp or email."
  centered={false}
  stickyCta={false}
>
  <!-- 1. Hero + live embed, front and center (cream) -->
  <section class="py-8 md:py-14">
    <div class="mx-auto max-w-3xl px-6">
      <div class="flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:justify-between">
        <h1 class="font-display text-h1 md:text-hero text-(--color-kraan-ink)">
          Try the <span class="text-(--color-kraan-rust)">digital receptionist</span>.
        </h1>
        <span
          class="inline-flex shrink-0 items-center gap-2 rounded-full bg-(--color-kraan-stone-100) px-3 py-1 font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)"
        >
          <span class="h-2 w-2 rounded-full bg-(--color-kraan-blue)"></span> Live demo
        </span>
      </div>
      <p class="mt-4 text-body md:text-h3 text-(--color-kraan-stone-700)">
        A real, live example receptionist — right here in your browser. Ask a question or request an
        appointment. No obligation.
      </p>

      <!-- Desktop: live embed inline. -->
      <div class="mt-6 hidden rounded-(--radius-card) border border-(--color-kraan-stone-300) bg-white p-3 shadow-sm md:block md:p-4">
        <iframe
          src={DEMO_SRC}
          title="Live chat with Klantkraan's digital receptionist"
          loading="lazy"
          class="block h-[600px] w-full rounded-(--radius-button) border border-(--color-kraan-stone-300)"
        ></iframe>
      </div>

      <!-- Mobile: launch the chat full-screen (see /js/demo-embed.js). -->
      <div class="mt-6 rounded-(--radius-card) border border-(--color-kraan-stone-300) bg-white p-5 shadow-sm md:hidden">
        <div class="flex items-center gap-3">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-(--color-kraan-stone-100) text-(--color-kraan-blue)">
            <Icon name="message-square" class="h-5 w-5" />
          </span>
          <div class="min-w-0">
            <p class="font-display text-h3 text-(--color-kraan-ink)">Illa Air Conditioning</p>
            <p class="text-small text-(--color-kraan-stone-500)">Digital assistant · replies instantly</p>
          </div>
        </div>
        <p class="mt-4 rounded-(--radius-button) bg-(--color-kraan-stone-100) p-3 text-body text-(--color-kraan-stone-700)">
          Chat like a customer — ask a question or request an appointment. Opens full-screen.
        </p>
        <button
          type="button"
          data-demo-open
          class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white hover:bg-(--color-kraan-blue-700)"
        >
          <Icon name="message-circle" class="h-5 w-5" />
          <span>Start the demo</span>
        </button>
      </div>

      <p class="mt-3 text-small text-(--color-kraan-stone-500)">
        This is an example business. Your own receptionist is set up with your services, rates and
        service area.
      </p>
    </div>
  </section>

  <!-- 2. What you see in the demo (stone-100) -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">The demo</p>
      <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">What you see in the demo.</h2>
      <div class="mt-10 divide-y divide-(--color-kraan-stone-300) border-y border-(--color-kraan-stone-300)">
        <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
          <Icon name="message-square" class="mt-1 h-7 w-7 text-(--color-kraan-blue)" />
          <div>
            <h3 class="font-display text-h3 text-(--color-kraan-ink)">Chat on your own site</h3>
            <p class="mt-2 text-body text-(--color-kraan-stone-700)">
              The receptionist answers questions about your services, rates and service area. In
              natural English, 24 hours a day — and only with information you've set up yourself.
            </p>
          </div>
        </article>
        <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
          <Icon name="message-circle" class="mt-1 h-7 w-7 text-(--color-kraan-blue)" />
          <div>
            <h3 class="font-display text-h3 text-(--color-kraan-ink)">The WhatsApp channel</h3>
            <p class="mt-2 text-body text-(--color-kraan-stone-700)">
              The same receptionist on the channel your customers already use every day. Anyone who'd
              rather message than call gets an instant answer.
            </p>
          </div>
        </article>
        <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
          <Icon name="calendar-check" class="mt-1 h-7 w-7 text-(--color-kraan-blue)" />
          <div>
            <h3 class="font-display text-h3 text-(--color-kraan-ink)">An appointment in the calendar</h3>
            <p class="mt-2 text-body text-(--color-kraan-stone-700)">
              You see live how a customer question ends up as a booked appointment in the calendar —
              no phone tag, no back-and-forth email.
            </p>
          </div>
        </article>
        <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
          <Icon name="phone" class="mt-1 h-7 w-7 text-(--color-kraan-blue)" />
          <div>
            <h3 class="font-display text-h3 text-(--color-kraan-ink)">Lead notification on your phone</h3>
            <p class="mt-2 text-body text-(--color-kraan-stone-700)">
              Every lead and every callback request lands straight on your phone as a message, with
              name, number and the customer's question.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 3. Prefer a personal demo? (cream) — secondary path -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-(--radius-card) border border-(--color-kraan-stone-300) bg-(--color-kraan-cream) p-6 md:p-8">
        <h2 class="font-display text-h2 text-(--color-kraan-ink)">
          Prefer a personal demo?
        </h2>
        <p class="mt-3 max-w-2xl text-body text-(--color-kraan-stone-700)">
          We set the receptionist up on your own services and rates and walk through it with you. No
          sales pitch, no obligation.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href={waLink}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
          >
            <Icon name="message-circle" class="h-5 w-5" />
            <span>WhatsApp us now</span>
          </a>
          <a
            href={mailLink}
            class="inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
          >
            Prefer email
          </a>
        </div>
        <p class="mt-3 text-small text-(--color-kraan-stone-500)">
          Usually a reply within one working day, straight from the owner.
        </p>
      </div>
    </div>
  </section>

  <!-- 4. AI-disclosure (stone-100, with rust-bordered card) -->
  <section class="bg-(--color-kraan-stone-100) py-10 md:py-16" aria-labelledby="ai-act">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-(--radius-card) border-2 border-(--color-kraan-rust) bg-(--color-kraan-cream) p-6 md:p-8">
        <h2 id="ai-act" class="font-display text-h2 text-(--color-kraan-rust)">
          AI disclosure (EU AI Act, art. 50)
        </h2>
        <p class="mt-3 text-body text-(--color-kraan-stone-700)">
          The receptionist is an AI. Disclosing that is a legal requirement. We do it in the very
          first sentence of every conversation, word for word:
        </p>
        <blockquote
          class="mt-4 border-l-4 border-(--color-kraan-rust) bg-(--color-kraan-stone-100) p-3 md:p-4 text-body text-(--color-kraan-ink)"
        >
          "Hi, you're chatting with {`{{agent_name}}`}, the digital assistant at {`{{business_name}}`}.
          How can I help?"
        </blockquote>
        <ul class="mt-4 space-y-2 text-small text-(--color-kraan-stone-700)">
          <li>The disclosure is never switched off, not even at a customer's request.</li>
          <li>
            If your customer asks "Am I talking to a human?", the assistant answers honestly that
            she is a digital assistant and that the message goes straight to the owner.
          </li>
        </ul>
        <p class="mt-4 text-small">
          Read the full details in our <a href="/legal/ai-disclosure/">AI disclosure</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- 5. End CTA band (blue) -->
  <section class="bg-(--color-kraan-blue) py-10 md:py-16 text-white">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="font-display text-h1 text-white">Prefer the numbers first?</h2>
      <p class="mt-4 max-w-2xl text-body text-(--color-kraan-stone-100)">
        Take a look at the two plans — the demo stays just one click away.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/en/prijzen/"
          class="inline-block rounded-(--radius-button) bg-white px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
        >
          View pricing
        </a>
        <a
          href="/en/"
          class="inline-block rounded-(--radius-button) border border-white px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
        >
          Back to overview
        </a>
      </div>
    </div>
  </section>

  <!-- Full-screen demo overlay (mobile) — see /js/demo-embed.js. data-demo-src
       feeds the iframe URL + the allowed message origin. -->
  <div
    id="demo-overlay"
    class="fixed inset-0 z-[70] hidden overflow-hidden"
    data-demo-src={DEMO_SRC}
    aria-hidden="true"
  >
  </div>

  <style>
    #demo-overlay { background: #f6f7f9; overscroll-behavior: contain; }
    @media (prefers-color-scheme: dark) {
      #demo-overlay { background: #0f1216; }
    }
  </style>

  <!-- Externalised JS (loaded as same-origin to pass strict CSP script-src 'self'). -->
  <script src="/js/demo-embed.js?v=5" type="module" is:inline></script>
</Base>
