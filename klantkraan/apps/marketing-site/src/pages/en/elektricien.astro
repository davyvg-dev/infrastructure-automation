---
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import Stat from '../../components/Stat.astro'
import Plug from '../../components/illustrations/Plug.astro'
import RiskReversal from '../../components/RiskReversal.astro'
import PhotoBand from '../../components/PhotoBand.astro'

// Elektricien landing page. Follows the /loodgieters template structure.
// Trade-specific copy: kortsluiting, groepenkast, EV-laadpunt, stroomstoring.

interface PainStat {
  value: string
  caption: string
}

const painStats: PainStat[] = [
  { value: '34%', caption: 'of your calls after 5pm go unanswered.' },
  { value: '€375', caption: 'average value of a power-outage call.' },
  { value: '0', caption: "reviews for every job you don't pick up." },
]

interface Feature {
  icon: 'phone' | 'message-square' | 'calendar-check'
  title: string
  body: string
}

const features: Feature[] = [
  {
    icon: 'message-square',
    title: "Talks short circuits in the trade's own terms",
    body: "Answers customer questions on your website and via WhatsApp, in natural conversation, after 5pm and at weekends too. It only quotes your own short-circuit emergency rate, hourly rate and weekend surcharge, never a price you haven't set in advance.",
  },
  {
    icon: 'calendar-check',
    title: 'Appointments straight into your calendar',
    body: "Fault and installation appointments are booked straight into your calendar, only in the slots you've opened up yourself. No phone tag, no back-and-forth email.",
  },
  {
    icon: 'phone',
    title: 'Leads and callback requests on your phone',
    body: "When a power cut comes in after closing time, the receptionist takes the report and sends it straight to your phone as a message, with name, number and the question. No customer walks to the competitor while you're on another job.",
  },
]

interface Faq {
  q: string
  a: string
  href?: string
  linkLabel?: string
}

const faqs: Faq[] = [
  {
    q: 'How does the receptionist get onto my website?',
    a: "With one small script that we install for you. We connect WhatsApp in the same setup. You keep your own site, number and branding.",
  },
  {
    q: "And if I'm on an installation and can't respond?",
    a: "The receptionist answers the question (short-circuit emergency, new job, existing customer, supplier), books an appointment in your calendar if wanted and sends you a summary by WhatsApp or email. You call back once the consumer unit is closed up again.",
  },
  {
    q: "Can the customer tell it's AI?",
    a: "Yes. Every conversation opens by telling your customer they're chatting with a digital assistant, on behalf of your business. Article 50 of the EU AI Act requires it, and the disclosure always stays on.",
    href: '/legal/ai-disclosure/',
    linkLabel: 'Read the full AI disclosure',
  },
  {
    q: 'What if the AI says something wrong about my rates?',
    a: "That can't happen. The assistant only quotes rates you've set in your system yourself: call-out charge, hourly rate, emergency surcharge, EV charge-point extra. Unknown prices are never made up; the customer gets a callback request instead. We test every configuration before you go live.",
  },
  {
    q: 'What happens to the customer data?',
    a: "Conversations and bookings are stored on our server in Germany (Hetzner, Nuremberg). To write replies, chat messages go to Anthropic in the US, under the EU Standard Contractual Clauses. We sign a data processing agreement (DPA) with you and keep chat conversations for 30 days, or shorter if you prefer. The full supplier list is public in our sub-processor register.",
    href: '/legal/dpa/',
    linkLabel: 'View the DPA and privacy statement',
  },
  {
    q: 'Cancel monthly, really?',
    a: "Yes. No annual contract, no hidden renewal. You cancel by email, whenever you like. The service runs to the end of the month you paid for, and nothing is charged after that. If you pay 6 or 12 months up front, you get 15% or 20% off.",
    href: '/legal/voorwaarden/',
    linkLabel: 'Read the terms and conditions',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]+>/g, ''),
    },
  })),
}
---

<Base
  lang="en"
  title="Win electrician customers: AI receptionist for emergencies and EV | Klantkraan"
  description="AI receptionist for electricians, cancel monthly. Knows your emergency rate and EV charge-point extra, books appointments and captures leads, day and night."
  centered={false}
>
  <!-- 1. Hero (cream) -->
  <section class="py-10 md:py-16">
    <div
      class="mx-auto grid max-w-page gap-10 px-gutter md:grid-cols-[1fr_auto] md:items-center md:gap-16"
    >
      <div>
        <h1 class="font-display text-hero text-chalk">
          The <span class="text-(--color-sodium)">customer engine</span> for electricians.
        </h1>
        <p class="mt-6 max-w-2xl text-[1.125rem] text-dim leading-relaxed">
          A digital receptionist on your website and WhatsApp that explains your short-circuit
          emergency rate or EV charge-point extra to a customer. It answers questions day and night.
          Appointments and callback requests come in the same subscription.
        </p>
        <div class="mt-10 btn-row">
          <a href="/en/demo/" class="btn btn-primary btn-lg"> Try the demo </a>
          <a href="/en/rekentool/" class="btn btn-ghost btn-lg"> Work out your ROI </a>
        </div>
      </div>
      <div class="hidden text-(--color-dim) md:block">
        <Plug class="h-64 w-64 lg:h-72 lg:w-72" />
      </div>
    </div>
    <div class="mx-auto max-w-page px-gutter">
      <ul role="list" class="fact-row mt-10">
        <li><span class="text-(--color-chalk)">GDPR + AI Act art. 50</span> <span>Disclosure always on</span></li>
        <li><span class="text-(--color-chalk)">Hosted in the EU</span> <span>Cloudflare · Neon · Hetzner</span></li>
        <li><span class="text-(--color-chalk)">Natural conversation</span> <span>Knows your hourly rate + emergency surcharge</span></li>
      </ul>
      <p class="mt-8 text-small text-dim">
        Cancel monthly · Done-for-you setup · 50% off the first month
      </p>
    </div>
  </section>

  <section class="pb-10 md:pb-16">
    <PhotoBand
      slug="elektriciens"
      alt="Electrician at work in a switchboard"
      caption="Inside the panel. Your receptionist still answers."
    />
  </section>

  <!-- 1b. Risk-reversal -->
  <RiskReversal lang="en" />

  <!-- 2. Pain-stats trio (stone-100) -->
  <section
    class="border-y border-(--color-line) py-8 md:py-10"
    aria-label="What a missed call costs an electrician"
  >
    <div class="mx-auto max-w-page px-gutter">
      <div class="stat-row">
      {painStats.map((stat) => <Stat value={stat.value} label={stat.caption} />)}
      </div>
    </div>
  </section>

  <!-- 3. Modules (cream, hairline rows) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      <p class="eyebrow">Modules</p>
      <h2 class="mt-3 font-display text-h1 text-chalk">What Klantkraan does for electricians.</h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        Three modules for one monthly price. Built for the electrician with two to eight engineers,
        not the big installation firms.
      </p>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          features.map((feature) => (
            <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
              <Icon name={feature.icon} class="mt-1 h-7 w-7 text-(--color-dim)" />
              <div>
                <h3 class="font-display text-h3 text-chalk">{feature.title}</h3>
                <p class="mt-2 text-body text-dim">{feature.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. ROI snippet (stone-100) -->
  <section class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      
      <h2 class="font-display text-h1 text-chalk">Run the numbers.</h2>
      <div
        class="mt-8 frame bg-(--color-panel) p-6 md:p-10"
      >
        <p class="text-h3 text-chalk">
          Miss 8 calls a week at €375 each and you lose <strong class="text-(--color-sodium)"
            >over €51,000 in revenue a year</strong
          >.
        </p>
        <p class="mt-4 text-body text-dim">
          Klantkraan Chat is €299 a month. One short-circuit emergency a month pays for the
          subscription. Everything that comes in after that no longer goes to the competitor down
          the road.
        </p>
        <div class="mt-6 btn-row">
          <a href="/en/rekentool/" class="btn btn-primary btn-lg"> Open the calculator </a>
          <a href="/en/prijzen/" class="btn btn-ghost btn-lg"> See pricing </a>
        </div>
        <p class="mt-6 text-micro text-dim">
          Amounts exclude 21% VAT. Example based on an industry average of €375 per call for
          installation and electrical work (source: Aira / Invoca missed-call benchmarks) and the
          assumption that roughly 1 in 3 missed calls would have produced a paying job (33%
          conversion rate).
        </p>
      </div>
    </div>
  </section>

  <!-- 5. FAQ (cream) -->
  <section class="py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      
      <h2 class="font-display text-h1 text-chalk">Frequently asked questions.</h2>
      <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
        {
          faqs.map((faq) => (
            <details class="group py-4">
              <summary class="block min-h-[2.75rem] cursor-pointer list-none py-1 font-display text-h3 text-chalk marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{faq.q}</span>
                  <Icon
                    name="chevron-down"
                    class="mt-1 h-5 w-5 shrink-0 text-(--color-dim) transition-transform group-open:rotate-180"
                  />
                </span>
              </summary>
              <p class="mt-3 text-body text-dim">{faq.a}</p>
              {faq.href && faq.linkLabel && (
                <p class="mt-3 text-small">
                  <a href={faq.href} class="underline">
                    {faq.linkLabel}
                  </a>
                </p>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. Final CTA (blue) -->
  <section class="border-y border-(--color-line) bg-(--color-panel) py-10 md:py-16">
    <div class="mx-auto max-w-page px-gutter">
      <h2 class="font-display text-h1 text-chalk">
        Try it as your customer would.
      </h2>
      <p class="mt-4 max-w-2xl text-body text-dim">
        Ask the live demo what your customers ask, such as an emergency rate or an EV charge point.
        It runs on an example business; your own receptionist quotes your rates.
      </p>
      <div class="mt-8 btn-row">
        <a href="/en/demo/" class="btn btn-primary btn-lg"> Try the demo </a>
        <a href="/en/prijzen/" class="btn btn-ghost btn-lg"> See pricing </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Base>
