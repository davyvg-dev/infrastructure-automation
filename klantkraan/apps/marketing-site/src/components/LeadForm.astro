---
/*
 * LeadForm — vanilla TS form that POSTs to the public Worker /api/lead.
 * Contract: see klantkraan/apps/api/src/routes/lead.ts (zod schema).
 * 409 'suppressed' is rendered as a neutral success to avoid leaking
 * list-membership (see klantkraan/docs/06-outbound/gdpr-compliance.md).
 * Field names never change across locales — only the display strings do.
 */
interface Props {
  lang?: 'nl' | 'en'
}
const { lang = 'nl' } = Astro.props
const isEn = lang === 'en'
const apiBase = import.meta.env.PUBLIC_API_BASE ?? 'https://api.klantkraan.nl'

const t = isEn
  ? {
      nameLabel: 'Your name',
      nameError: 'Enter your name (at least 2 characters).',
      emailLabel: 'Email address',
      emailError: 'Enter a valid email address.',
      phoneLabel: 'Phone number',
      phoneOptional: '(optional)',
      phoneError: 'Enter a valid phone number (digits, spaces, brackets or dashes).',
      messageLabel: 'How can we help?',
      messagePlaceholder: "e.g. 'We miss a lot of calls while we're on a job'",
      messageError: 'Let us know how we can help.',
      formError: 'Something went wrong. Please try again or email us directly.',
      submit: 'Request a demo',
      submitting: 'Submitting…',
      privacyPre: 'By submitting this form you agree to our',
      privacyLink: 'privacy policy',
      successTitle: "Thanks — we'll be in touch within 1 working day.",
    }
  : {
      nameLabel: 'Uw naam',
      nameError: 'Vul uw naam in (minimaal 2 tekens).',
      emailLabel: 'E-mailadres',
      emailError: 'Vul een geldig e-mailadres in.',
      phoneLabel: 'Telefoonnummer',
      phoneOptional: '(optioneel)',
      phoneError: 'Vul een geldig telefoonnummer in (cijfers, spaties, haakjes of streepjes).',
      messageLabel: 'Waar kunnen wij u mee helpen?',
      messagePlaceholder: "Bijv. 'Wij missen veel oproepen tijdens spoedklussen'",
      messageError: 'Laat ons weten waar wij u mee kunnen helpen.',
      formError: 'Er ging iets mis. Probeer het opnieuw of mail ons direct.',
      submit: 'Vraag een demo aan',
      submitting: 'Versturen...',
      privacyPre: 'Door dit formulier te versturen gaat u akkoord met onze',
      privacyLink: 'privacyverklaring',
      successTitle: 'Bedankt — wij nemen binnen 1 werkdag contact op.',
    }
const privacyHref = isEn ? '/legal/privacy/' : '/legal/privacy/'
---

<form
  id="lead-form"
  class="rounded-(--radius-card) border border-(--color-kraan-stone-300) bg-(--color-kraan-cream) p-6 md:p-8"
  data-api-base={apiBase}
  novalidate
>
  <div class="space-y-5">
    <div>
      <label for="lead-name" class="block text-body font-medium text-(--color-kraan-ink)">
        {t.nameLabel}
      </label>
      <input
        id="lead-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        minlength="2"
        maxlength="200"
        class="mt-2 w-full rounded-(--radius-button) border border-(--color-kraan-stone-300) bg-white p-3 text-body focus:border-(--color-kraan-blue) focus:outline-none focus:ring-2 focus:ring-(--color-kraan-blue)"
      />
      <p
        id="lead-name-error"
        class="mt-1 hidden text-small text-(--color-kraan-rust)"
        aria-live="polite"
      >
        {t.nameError}
      </p>
    </div>

    <div>
      <label for="lead-email" class="block text-body font-medium text-(--color-kraan-ink)">
        {t.emailLabel}
      </label>
      <input
        id="lead-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        class="mt-2 w-full rounded-(--radius-button) border border-(--color-kraan-stone-300) bg-white p-3 text-body focus:border-(--color-kraan-blue) focus:outline-none focus:ring-2 focus:ring-(--color-kraan-blue)"
      />
      <p
        id="lead-email-error"
        class="mt-1 hidden text-small text-(--color-kraan-rust)"
        aria-live="polite"
      >
        {t.emailError}
      </p>
    </div>

    <div>
      <label for="lead-phone" class="block text-body font-medium text-(--color-kraan-ink)">
        {t.phoneLabel} <span class="text-(--color-kraan-stone-500)">{t.phoneOptional}</span>
      </label>
      <input
        id="lead-phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        class="mt-2 w-full rounded-(--radius-button) border border-(--color-kraan-stone-300) bg-white p-3 text-body focus:border-(--color-kraan-blue) focus:outline-none focus:ring-2 focus:ring-(--color-kraan-blue)"
      />
      <p
        id="lead-phone-error"
        class="mt-1 hidden text-small text-(--color-kraan-rust)"
        aria-live="polite"
      >
        {t.phoneError}
      </p>
    </div>

    <div>
      <label for="lead-message" class="block text-body font-medium text-(--color-kraan-ink)">
        {t.messageLabel}
      </label>
      <textarea
        id="lead-message"
        name="message"
        rows="4"
        required
        maxlength="4000"
        placeholder={t.messagePlaceholder}
        class="mt-2 w-full rounded-(--radius-button) border border-(--color-kraan-stone-300) bg-white p-3 text-body focus:border-(--color-kraan-blue) focus:outline-none focus:ring-2 focus:ring-(--color-kraan-blue)"
      ></textarea>
      <p
        id="lead-message-error"
        class="mt-1 hidden text-small text-(--color-kraan-rust)"
        aria-live="polite"
      >
        {t.messageError}
      </p>
    </div>

    <p id="lead-form-error" class="hidden text-body text-(--color-kraan-rust)" role="alert">
      {t.formError}
    </p>

    <div>
      <button
        id="lead-submit"
        type="submit"
        data-submitting={t.submitting}
        class="inline-block w-full rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white hover:bg-(--color-kraan-blue-700) disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
      >
        {t.submit}
      </button>
      <p class="mt-3 text-small text-(--color-kraan-stone-500)">
        {t.privacyPre}
        <a href={privacyHref}>{t.privacyLink}</a>.
      </p>
    </div>
  </div>
</form>

<div
  id="lead-success"
  class="hidden rounded-(--radius-card) border-2 border-(--color-kraan-leaf) bg-(--color-kraan-cream) p-6 md:p-8"
  role="status"
  aria-live="polite"
>
  <p class="font-display text-h2 text-(--color-kraan-ink)">{t.successTitle}</p>
</div>

<!-- Externalised JS (loaded as same-origin to pass strict CSP script-src 'self'). -->
<script src="/js/lead-form.js" type="module" is:inline></script>
