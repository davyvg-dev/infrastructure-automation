---
/*
 * LeadForm — vanilla TS form that POSTs to the public Worker /api/lead.
 * Contract: see klantkraan/apps/api/src/routes/lead.ts (zod schema).
 * 409 'suppressed' is rendered as a neutral success to avoid leaking
 * list-membership (see klantkraan/docs/06-outbound/gdpr-compliance.md).
 */
const apiBase = import.meta.env.PUBLIC_API_BASE ?? 'https://api.klantkraan.nl'
---

<form
  id="lead-form"
  class="rounded-(--radius-card) border border-(--color-kraan-stone-300) bg-(--color-kraan-cream) p-8"
  data-api-base={apiBase}
  novalidate
>
  <div class="space-y-5">
    <div>
      <label for="lead-name" class="block text-body font-medium text-(--color-kraan-ink)">
        Uw naam
      </label>
      <input
        id="lead-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        minlength="2"
        maxlength="200"
        class="mt-2 w-full rounded-(--radius-button) border border-(--color-kraan-stone-300) bg-white p-3 text-body focus:border-(--color-kraan-blue) focus:outline-none focus:ring-2 focus:ring-(--color-kraan-blue)"
      />
      <p
        id="lead-name-error"
        class="mt-1 hidden text-small text-(--color-kraan-rust)"
        aria-live="polite"
      >
        Vul uw naam in (minimaal 2 tekens).
      </p>
    </div>

    <div>
      <label for="lead-email" class="block text-body font-medium text-(--color-kraan-ink)">
        E-mailadres
      </label>
      <input
        id="lead-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        class="mt-2 w-full rounded-(--radius-button) border border-(--color-kraan-stone-300) bg-white p-3 text-body focus:border-(--color-kraan-blue) focus:outline-none focus:ring-2 focus:ring-(--color-kraan-blue)"
      />
      <p
        id="lead-email-error"
        class="mt-1 hidden text-small text-(--color-kraan-rust)"
        aria-live="polite"
      >
        Vul een geldig e-mailadres in.
      </p>
    </div>

    <div>
      <label for="lead-phone" class="block text-body font-medium text-(--color-kraan-ink)">
        Telefoonnummer <span class="text-(--color-kraan-stone-500)">(optioneel)</span>
      </label>
      <input
        id="lead-phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        class="mt-2 w-full rounded-(--radius-button) border border-(--color-kraan-stone-300) bg-white p-3 text-body focus:border-(--color-kraan-blue) focus:outline-none focus:ring-2 focus:ring-(--color-kraan-blue)"
      />
      <p
        id="lead-phone-error"
        class="mt-1 hidden text-small text-(--color-kraan-rust)"
        aria-live="polite"
      >
        Vul een geldig telefoonnummer in (cijfers, spaties, haakjes of streepjes).
      </p>
    </div>

    <div>
      <label for="lead-message" class="block text-body font-medium text-(--color-kraan-ink)">
        Waar kunnen wij u mee helpen?
      </label>
      <textarea
        id="lead-message"
        name="message"
        rows="4"
        required
        maxlength="4000"
        placeholder="Bijv. 'Wij missen veel oproepen tijdens spoedklussen'"
        class="mt-2 w-full rounded-(--radius-button) border border-(--color-kraan-stone-300) bg-white p-3 text-body focus:border-(--color-kraan-blue) focus:outline-none focus:ring-2 focus:ring-(--color-kraan-blue)"
      ></textarea>
      <p
        id="lead-message-error"
        class="mt-1 hidden text-small text-(--color-kraan-rust)"
        aria-live="polite"
      >
        Laat ons weten waar wij u mee kunnen helpen.
      </p>
    </div>

    <p
      id="lead-form-error"
      class="hidden text-body text-(--color-kraan-rust)"
      role="alert"
    >
      Er ging iets mis. Probeer het opnieuw of mail ons direct.
    </p>

    <div>
      <button
        id="lead-submit"
        type="submit"
        class="inline-block rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white hover:bg-(--color-kraan-blue-700) disabled:cursor-not-allowed disabled:opacity-60"
      >
        Vraag een demo aan
      </button>
      <p class="mt-3 text-small text-(--color-kraan-stone-500)">
        Door dit formulier te versturen gaat u akkoord met onze
        <a href="/legal/privacy">privacyverklaring</a>.
      </p>
    </div>
  </div>
</form>

<div
  id="lead-success"
  class="hidden rounded-(--radius-card) border-2 border-(--color-kraan-leaf) bg-(--color-kraan-cream) p-8"
  role="status"
  aria-live="polite"
>
  <p class="font-display text-h2 text-(--color-kraan-ink)">Bedankt — wij nemen binnen 1 werkdag contact op.</p>
</div>

<script>
  // Vanilla TS lead-capture: validate -> POST /api/lead -> render state.
  // 409 'suppressed' is rendered as success to avoid leaking suppression-list
  // membership (Worker contract: apps/api/src/routes/lead.ts).
  const form = document.getElementById('lead-form') as HTMLFormElement | null
  const submitBtn = document.getElementById('lead-submit') as HTMLButtonElement | null
  const formError = document.getElementById('lead-form-error') as HTMLParagraphElement | null
  const successCard = document.getElementById('lead-success') as HTMLDivElement | null

  const nameEl = document.getElementById('lead-name') as HTMLInputElement | null
  const emailEl = document.getElementById('lead-email') as HTMLInputElement | null
  const phoneEl = document.getElementById('lead-phone') as HTMLInputElement | null
  const messageEl = document.getElementById('lead-message') as HTMLTextAreaElement | null

  const nameErr = document.getElementById('lead-name-error') as HTMLParagraphElement | null
  const emailErr = document.getElementById('lead-email-error') as HTMLParagraphElement | null
  const phoneErr = document.getElementById('lead-phone-error') as HTMLParagraphElement | null
  const messageErr = document.getElementById('lead-message-error') as HTMLParagraphElement | null

  // Mirror the Worker zod regex exactly.
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
  const PHONE_RE = /^\+?[0-9 ()-]+$/

  function show(el: HTMLElement | null): void {
    if (el) el.classList.remove('hidden')
  }
  function hide(el: HTMLElement | null): void {
    if (el) el.classList.add('hidden')
  }

  function validate(): boolean {
    let ok = true

    const name = nameEl?.value.trim() ?? ''
    const email = emailEl?.value.trim() ?? ''
    const phone = phoneEl?.value.trim() ?? ''
    const message = messageEl?.value.trim() ?? ''

    if (name.length < 2) {
      show(nameErr)
      ok = false
    } else {
      hide(nameErr)
    }

    if (!EMAIL_RE.test(email)) {
      show(emailErr)
      ok = false
    } else {
      hide(emailErr)
    }

    if (phone.length > 0) {
      const validLen = phone.length >= 8 && phone.length <= 20
      if (!validLen || !PHONE_RE.test(phone)) {
        show(phoneErr)
        ok = false
      } else {
        hide(phoneErr)
      }
    } else {
      hide(phoneErr)
    }

    if (message.length < 1) {
      show(messageErr)
      ok = false
    } else {
      hide(messageErr)
    }

    return ok
  }

  function setSubmitting(submitting: boolean): void {
    if (!submitBtn) return
    submitBtn.disabled = submitting
    submitBtn.textContent = submitting ? 'Versturen...' : 'Vraag een demo aan'
  }

  function renderSuccess(): void {
    hide(form)
    show(successCard)
  }

  function renderError(): void {
    show(formError)
    setSubmitting(false)
  }

  if (form && submitBtn) {
    const apiBase = form.dataset.apiBase ?? 'https://api.klantkraan.nl'

    form.addEventListener('submit', (event: SubmitEvent) => {
      event.preventDefault()
      hide(formError)

      if (!validate()) return

      const name = nameEl?.value.trim() ?? ''
      const email = emailEl?.value.trim() ?? ''
      const phone = phoneEl?.value.trim() ?? ''
      const message = messageEl?.value.trim() ?? ''

      // Assemble payload — omit `phone` when empty so we don't send "" and
      // trip the Worker's 8-char min on the optional field.
      const payload: {
        name: string
        email: string
        message: string
        phone?: string
      } = phone.length > 0
        ? { name, email, message, phone }
        : { name, email, message }

      setSubmitting(true)

      void fetch(`${apiBase}/api/lead`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
        .then((res: Response) => {
          // 201 = created, 409 = suppressed (render as success to avoid leak).
          if (res.status === 201 || res.status === 409) {
            renderSuccess()
            return
          }
          renderError()
        })
        .catch(() => {
          renderError()
        })
    })
  }
</script>
