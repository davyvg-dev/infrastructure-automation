---
// Renders one or more JSON-LD schema objects (built in src/data/jsonld.ts).
interface Props {
  schema: object | object[]
}

const { schema } = Astro.props
const schemas = Array.isArray(schema) ? schema : [schema]
---

{schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} is:inline />)}
