---
const year = new Date().getFullYear()
const legal = [
  { href: '/legal/voorwaarden', label: 'Algemene voorwaarden' },
  { href: '/legal/dpa', label: 'Verwerkersovereenkomst' },
  { href: '/legal/sla', label: 'SLA' },
  { href: '/legal/privacy', label: 'Privacy' },
  { href: '/legal/ai-disclosure', label: 'AI-disclosure' },
  { href: '/legal/subprocessors', label: 'Sub-processors' },
]
---

<footer class="border-t border-(--color-kraan-stone-300) bg-(--color-kraan-stone-100)">
  <div class="mx-auto max-w-5xl px-6 py-12 text-small text-(--color-kraan-stone-700)">
    <div class="grid gap-8 sm:grid-cols-3">
      <div>
        <p class="font-display text-h3 text-(--color-kraan-ink)">Klantkraan</p>
        <p class="mt-2">De Klantenmotor voor Nederlandse vakmensen.</p>
        <p class="mt-4 text-micro">
          Klantkraan is een handelsnaam van T4 Software Consulting BV.<br />
          KvK: <span class="font-mono">TODO</span> · BTW: <span class="font-mono">TODO</span>
        </p>
      </div>
      <div>
        <p class="font-display text-h3 text-(--color-kraan-ink)">Juridisch</p>
        <ul class="mt-2 space-y-1">
          {
            legal.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="font-display text-h3 text-(--color-kraan-ink)">Contact</p>
        <p class="mt-2">
          <a href="mailto:hallo@klantkraan.nl">hallo@klantkraan.nl</a>
        </p>
        <p class="mt-1">
          <a href="tel:+31000000000">+31 (0) TODO</a>
        </p>
      </div>
    </div>
    <p class="mt-10 text-micro">&copy; {year} Klantkraan · Gemaakt in Nederland.</p>
  </div>
</footer>
