---
import Icon from './Icon.astro'
import { branches } from '../data/branches'
import { contact, waLink, telLink, mailLink } from '../data/contact'
import { company } from '../data/company'

interface Props {
  lang?: 'nl' | 'en' | 'es'
}
const { lang = 'nl' } = Astro.props

const year = new Date().getFullYear()

interface LegalLink {
  href: string
  label: string
}

// Legal hrefs are identical across locales; only the labels differ.
const legalByLang: Record<'nl' | 'en' | 'es', LegalLink[]> = {
  nl: [
    { href: '/legal/voorwaarden/', label: 'Algemene voorwaarden' },
    { href: '/legal/dpa/', label: 'Verwerkersovereenkomst' },
    { href: '/legal/sla/', label: 'SLA' },
    { href: '/legal/privacy/', label: 'Privacy' },
    { href: '/legal/ai-disclosure/', label: 'AI-disclosure' },
    { href: '/legal/subprocessors/', label: 'Sub-processors' },
  ],
  en: [
    { href: '/legal/voorwaarden/', label: 'Terms & conditions' },
    { href: '/legal/dpa/', label: 'Data processing agreement' },
    { href: '/legal/sla/', label: 'SLA' },
    { href: '/legal/privacy/', label: 'Privacy' },
    { href: '/legal/ai-disclosure/', label: 'AI disclosure' },
    { href: '/legal/subprocessors/', label: 'Sub-processors' },
  ],
  es: [
    { href: '/legal/voorwaarden/', label: 'Términos y condiciones' },
    { href: '/legal/dpa/', label: 'Contrato de tratamiento de datos' },
    { href: '/legal/sla/', label: 'SLA' },
    { href: '/legal/privacy/', label: 'Privacidad' },
    { href: '/legal/ai-disclosure/', label: 'Declaración de IA' },
    { href: '/legal/subprocessors/', label: 'Subencargados' },
  ],
}
const legal = legalByLang[lang]

interface TrustBadge {
  icon: 'shield-check' | 'check' | 'phone-call' | 'clock'
  label: string
  sub: string
}

const trustBadgesByLang: Record<'nl' | 'en' | 'es', TrustBadge[]> = {
  nl: [
    { icon: 'shield-check', label: 'AVG / GDPR conform', sub: 'Standaard verwerkersovereenkomst' },
    { icon: 'shield-check', label: 'EU AI Act art. 50', sub: 'Disclosure niet uitschakelbaar' },
    { icon: 'check', label: 'EU-gehost', sub: 'Cloudflare · Neon · Hetzner FSN1' },
    { icon: 'clock', label: 'Per maand opzegbaar', sub: 'Geen wurgcontract, geen verborgen kosten' },
  ],
  en: [
    { icon: 'shield-check', label: 'GDPR compliant', sub: 'Standard data processing agreement' },
    { icon: 'shield-check', label: 'EU AI Act art. 50', sub: "Disclosure can't be switched off" },
    { icon: 'check', label: 'EU-hosted', sub: 'Cloudflare · Neon · Hetzner FSN1' },
    { icon: 'clock', label: 'Cancel monthly', sub: 'No lock-in, no hidden fees' },
  ],
  es: [
    { icon: 'shield-check', label: 'Conforme al RGPD', sub: 'Contrato de tratamiento estándar' },
    { icon: 'shield-check', label: 'Reglamento de IA de la UE art. 50', sub: 'La declaración no se puede desactivar' },
    { icon: 'check', label: 'Alojado en la UE', sub: 'Cloudflare · Neon · Hetzner FSN1' },
    { icon: 'clock', label: 'Cancele cada mes', sub: 'Sin permanencia ni costes ocultos' },
  ],
}
const trustBadges = trustBadgesByLang[lang]

const T = {
  nl: {
    trustKicker: 'Waarom u ons kunt vertrouwen',
    trustAria: 'Vertrouwens-signalen',
    tagline: 'De Klantenmotor voor Nederlandse ondernemers.',
    tradeNameNote: 'Klantkraan is een handelsnaam van',
    branchesHead: 'Branches',
    allBranches: 'Alle branches →',
    legalHead: 'Juridisch',
    contactHead: 'Contact',
    whatsapp: 'WhatsApp ons',
    founder: 'De oprichter',
    founderSub: 'Lees ons verhaal →',
    madeIn: 'Gemaakt in Nederland.',
  },
  en: {
    trustKicker: 'Why you can trust us',
    trustAria: 'Trust signals',
    tagline: 'The digital receptionist for tradespeople and local businesses.',
    tradeNameNote: 'Klantkraan is a trade name of',
    branchesHead: 'Trades',
    allBranches: 'All trades →',
    legalHead: 'Legal',
    contactHead: 'Contact',
    whatsapp: 'WhatsApp us',
    founder: 'The founder',
    founderSub: 'Read our story →',
    madeIn: 'Made in the Netherlands.',
  },
  es: {
    trustKicker: 'Por qué puede confiar en nosotros',
    trustAria: 'Señales de confianza',
    tagline: 'La recepcionista digital para profesionales y negocios locales.',
    tradeNameNote: 'Klantkraan es un nombre comercial de',
    branchesHead: 'Sectores',
    allBranches: 'Todos los sectores →',
    legalHead: 'Legal',
    contactHead: 'Contacto',
    whatsapp: 'Escríbanos por WhatsApp',
    founder: 'El fundador',
    founderSub: 'Lea nuestra historia →',
    madeIn: 'Hecho en los Países Bajos.',
  },
} as const
const t = T[lang]

const overHref = lang === 'nl' ? '/over/' : lang === 'es' ? '/es/over/' : '/en/over/'
const gridCols = 'sm:grid-cols-2 md:grid-cols-4'

// Trades column, resolved per language from the shared branch list. ES trade
// cornerstones don't exist yet, so ES reuses the English cornerstones.
const branchLinks = branches.map((b) => ({
  href: lang === 'nl' ? b.href : `/en/${b.slug}/`,
  label: lang === 'es' ? b.labelPluralEs : lang === 'en' ? b.labelPluralEn : b.labelPlural,
}))
const hubHref = lang === 'nl' ? '/voor-wie/' : lang === 'es' ? '/es/voor-wie/' : '/en/voor-wie/'
---

<footer class="border-t border-(--color-line)">
  <!-- Trust band — sits above the legal/branch grid. -->
  <section class="border-b border-(--color-line) bg-[rgba(0,0,0,0.14)]" aria-label={t.trustAria}>
    <div class="mx-auto max-w-5xl px-6 py-8 md:py-10">
      <p class="font-mono text-micro uppercase tracking-widest text-(--color-sodium)">
        {t.trustKicker}
      </p>
      <ul class="mt-5 grid gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          trustBadges.map((b) => (
            <li class="flex items-start gap-3">
              <Icon name={b.icon} class="mt-0.5 h-5 w-5 shrink-0 text-(--color-sodium)" />
              <div>
                <p class="text-small font-medium text-(--color-chalk)">{b.label}</p>
                <p class="text-small text-(--color-dim)">{b.sub}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-6 py-8 md:py-12 text-small text-(--color-dim)">
    <div class:list={['grid gap-6 md:gap-8', gridCols]}>
      <div>
        <p class="font-display text-h3 text-(--color-chalk)">Klantkraan</p>
        <p class="mt-2">{t.tagline}</p>
        <p class="mt-4 text-micro">
          {t.tradeNameNote} {company.legalName}.<br />
          KvK: <span class="font-mono">{company.kvk}</span>{
            company.btw && (
              <>
                {' '}· BTW: <span class="font-mono">{company.btw}</span>
              </>
            )
          }
        </p>
      </div>
      <div>
        <p class="font-display text-h3 text-(--color-chalk)">{t.branchesHead}</p>
        <ul class="mt-2">
          {branchLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="block py-2 text-(--color-dim) no-underline hover:text-(--color-chalk)"
              >
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href={hubHref} class="block py-2 text-(--color-sodium) no-underline">
              {t.allBranches}
            </a>
          </li>
        </ul>
      </div>
      <div>
        <p class="font-display text-h3 text-(--color-chalk)">{t.legalHead}</p>
        <ul class="mt-2">
          {
            legal.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block py-2 text-(--color-dim) no-underline hover:text-(--color-chalk)"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="font-display text-h3 text-(--color-chalk)">{t.contactHead}</p>
        <p>
          <a
            href={waLink}
            target="_blank"
            rel="noopener"
            class="flex items-center gap-2 py-2 text-(--color-dim) no-underline hover:text-(--color-chalk)"
          >
            <Icon name="message-circle" class="h-4 w-4 shrink-0" />
            <span>{t.whatsapp}</span>
          </a>
        </p>
        <p>
          <a
            href={mailLink}
            class="flex items-center gap-2 py-2 text-(--color-dim) no-underline hover:text-(--color-chalk)"
          >
            <Icon name="mail" class="h-4 w-4 shrink-0" />
            <span>{contact.email}</span>
          </a>
        </p>
        <p>
          <a
            href={telLink}
            class="flex items-center gap-2 py-2 text-(--color-dim) no-underline hover:text-(--color-chalk)"
          >
            <Icon name="phone" class="h-4 w-4 shrink-0" />
            <span>{contact.phoneDisplay}</span>
          </a>
        </p>
        <a
          href={overHref}
          class="mt-4 flex items-center gap-3 py-2 no-underline hover:text-(--color-chalk)"
        >
          <span
            class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-(--color-line) bg-(--color-panel) font-display text-h3 text-(--color-sodium)"
            aria-hidden="true"
          >
            K
          </span>
          <span>
            <span class="block text-(--color-chalk)">{t.founder}</span>
            <span class="block text-micro text-(--color-dim)">{t.founderSub}</span>
          </span>
        </a>
      </div>
    </div>
    <p class="mt-10 text-micro">&copy; {year} Klantkraan · {t.madeIn}</p>
  </div>
</footer>
