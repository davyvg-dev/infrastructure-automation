---
/*
 * Stat: one figure and what it means, as an item of a `.stat-row` (the parent
 * draws the hairlines). The figure sits above its caption so a wide figure
 * ("4 tot 6 weken", "'s Avonds") never squeezes the caption into a narrow column.
 * Tabular digits, no card, no accent bar.
 */
interface Props {
  value: string
  label: string
}

const { value, label } = Astro.props
---

<div data-stat>
  <p class="font-mono text-[1.75rem] leading-none tracking-[-0.02em] text-(--color-chalk) tabular-nums">
    {value}
  </p>
  <p data-stat-caption class="mt-3 max-w-[22rem] text-small text-(--color-dim)">{label}</p>
</div>
