---
/*
 * Stat: one number and what it means, as a cell of a `.grid-rule` row (the
 * parent draws the hairlines). The figure is set large in the text face with
 * tabular digits; no accent bar, no card.
 */
interface Props {
  value: string
  label: string
}

const { value, label } = Astro.props
---

<div class="p-6 md:p-8">
  <p class="text-h1 leading-none text-(--color-chalk) tabular-nums">
    {value}
  </p>
  <p class="mt-4 text-small text-(--color-dim)">{label}</p>
</div>
