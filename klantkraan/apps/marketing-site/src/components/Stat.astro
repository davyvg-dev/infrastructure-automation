---
/*
 * Stat: one figure and what it means, set on one line (figure left, caption
 * right) inside a `.stat-row`. Tabular digits, no card, no accent bar.
 */
interface Props {
  value: string
  label: string
}

const { value, label } = Astro.props
---

<div class="flex items-baseline gap-4">
  <p class="shrink-0 font-mono text-[1.75rem] leading-none tracking-[-0.02em] text-(--color-chalk) tabular-nums">
    {value}
  </p>
  <p class="text-small text-(--color-dim)">{label}</p>
</div>
