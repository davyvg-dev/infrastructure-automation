---
/**
 * One mini offer: the narrow problem, what is delivered, fixed price, delivery
 * time and the pay button (a Mollie payment link once set in magnets.ts, a mail
 * link until then). Used on /klein-beginnen/ and once after each magnet.
 * Works on the dark site and on the light /scan pages: colours fall back from the
 * light page's --d-* tokens to the site tokens.
 */
import { miniOffers, payHref, payLabel, type Area } from '../data/magnets'
import { contact } from '../data/contact'

interface Props {
  area: Area
  /** Small line above the name, e.g. "Liever meteen geregeld?" */
  kicker?: string
  /** Heading level: h2 on /klein-beginnen/, h3 inside a magnet page. */
  level?: 'h2' | 'h3'
  /** Element id; defaults to the offer's slug so /klein-beginnen/#slug works. */
  id?: string
  hidden?: boolean
}
const { area, kicker, level = 'h3', id, hidden = false } = Astro.props
const o = miniOffers[area]
const Heading = level
const isMail = !o.payUrl
---

<article
  data-mini-offer
  data-area={area}
  id={id ?? o.slug}
  class="mini-offer"
  hidden={hidden}
>
  {kicker && <p class="mini-kicker">{kicker}</p>}
  <Heading class="mini-name">{o.name}</Heading>
  <p data-problem class="mini-problem">{o.problem}</p>
  <p data-delivers class="mini-delivers"><b>Geregeld:</b> {o.delivers}</p>
  <p class="mini-price">
    <span class="mini-amount">{o.price}</span>
    <span class="mini-note">{o.priceNote}</span>
  </p>
  <p class="mini-days">{o.days}</p>
  <a
    data-pay
    href={payHref(o)}
    class="btn btn-primary mini-pay"
    {...isMail ? {} : { rel: 'noopener' }}
  >
    {payLabel(o)}
  </a>
  {
    isMail ? (
      <p class="mini-after">Binnen 1 werkdag volgt een betaallink, daarna gaan we aan de slag.</p>
    ) : (
      <p class="mini-after">
        Na de betaling: stuur {o.send} naar{' '}
        <a href={`mailto:${contact.email}?subject=${encodeURIComponent(`Betaald: ${o.name}`)}`}>{contact.email}</a>.
        Binnen 1 werkdag gaan we aan de slag.
        {o.priceNote.startsWith('+') && ' Het maandbedrag komt daarna apart, per maand opzegbaar.'}
      </p>
    )
  }
</article>

<style>
  .mini-offer {
    --mo-ink: var(--d-ink, var(--color-chalk));
    --mo-dim: var(--d-dim, var(--color-dim));
    --mo-line: var(--d-line, var(--color-line));
    --mo-card: var(--d-card, var(--color-panel));
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 20px;
    border: 1px solid var(--mo-line);
    border-radius: var(--radius-card, 12px);
    background: var(--mo-card);
    color: var(--mo-ink);
  }
  .mini-offer[hidden] {
    display: none;
  }
  .mini-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--d-amber-ink, var(--color-dim));
  }
  :global(.scan-page) .mini-kicker {
    color: var(--d-dim);
  }
  .mini-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.15;
    letter-spacing: -0.022em;
    color: var(--mo-ink);
  }
  .mini-problem,
  .mini-delivers,
  .mini-days,
  .mini-after {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .mini-problem {
    color: var(--mo-dim);
  }
  .mini-delivers b {
    font-weight: 600;
  }
  .mini-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: 4px 0 0;
  }
  .mini-amount {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.875rem;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .mini-note,
  .mini-days,
  .mini-after {
    font-size: 0.9rem;
    color: var(--mo-dim);
  }
  .mini-after a {
    color: inherit;
    font-weight: 600;
  }
  .mini-pay {
    align-self: stretch;
    margin-top: 6px;
  }
  @media (min-width: 480px) {
    .mini-pay {
      align-self: flex-start;
    }
  }
</style>
