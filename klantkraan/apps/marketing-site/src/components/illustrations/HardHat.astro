---
/*
 * Single-line illustration — construction hard hat over rolled-up
 * blueprint. Used on /aannemer hero.
 */
interface Props {
  class?: string
  'aria-label'?: string
}
const { class: className = 'h-56 w-56', 'aria-label': ariaLabel = 'Bouwhelm en bouwtekening' } =
  Astro.props
---

<svg
  viewBox="0 0 240 240"
  fill="none"
  stroke="currentColor"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label={ariaLabel}
  class={className}
>
  <!-- Hard hat dome -->
  <path d="M55 110 Q55 50 120 50 Q185 50 185 110"></path>
  <!-- Hat brim (wider than dome) -->
  <path d="M40 110 Q40 122 55 122 L185 122 Q200 122 200 110"></path>
  <line x1="40" y1="110" x2="200" y2="110"></line>
  <!-- Center crest (the raised front ridge) -->
  <line x1="120" y1="50" x2="120" y2="110"></line>
  <!-- Side ridges -->
  <path d="M85 55 Q83 80 88 110"></path>
  <path d="M155 55 Q157 80 152 110"></path>
  <!-- Rolled blueprint (cylinder under hat) -->
  <rect x="50" y="155" width="140" height="32" rx="4"></rect>
  <ellipse cx="50" cy="171" rx="4" ry="16"></ellipse>
  <ellipse cx="190" cy="171" rx="4" ry="16"></ellipse>
  <!-- Inside spiral hint on the right cap -->
  <ellipse cx="190" cy="171" rx="2" ry="8"></ellipse>
  <!-- Tie ribbon -->
  <path d="M120 187 L116 200 L124 200 Z"></path>
</svg>
