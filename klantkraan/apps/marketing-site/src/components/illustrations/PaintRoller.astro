---
/*
 * Single-line illustration — paint roller with fresh stroke on wall.
 * Used on /schilder hero.
 */
interface Props {
  class?: string
  'aria-label'?: string
}
const { class: className = 'h-56 w-56', 'aria-label': ariaLabel = 'Verfroller' } = Astro.props
---

<svg
  viewBox="0 0 240 240"
  fill="none"
  stroke="currentColor"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label={ariaLabel}
  class={className}
>
  <!-- Roller drum (rounded rectangle) -->
  <rect x="40" y="55" width="140" height="32" rx="6" />
  <!-- End caps (small ticks) -->
  <line x1="40" y1="65" x2="36" y2="65" />
  <line x1="40" y1="77" x2="36" y2="77" />
  <line x1="180" y1="65" x2="184" y2="65" />
  <line x1="180" y1="77" x2="184" y2="77" />
  <!-- Frame: bent metal rod -->
  <path d="M110 87 L110 110 L150 110 L150 135" />
  <!-- Handle grip -->
  <rect x="138" y="135" width="24" height="60" rx="8" />
  <!-- Grip ridges -->
  <line x1="142" y1="150" x2="158" y2="150" />
  <line x1="142" y1="165" x2="158" y2="165" />
  <line x1="142" y1="180" x2="158" y2="180" />
  <!-- Paint stroke trailing left from roller -->
  <path d="M40 71 Q22 71 18 85 L18 110 Q18 130 32 130" />
  <!-- Drip -->
  <path d="M28 130 Q24 142 28 150 Q32 142 28 130 Z" />
</svg>
