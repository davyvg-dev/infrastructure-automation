---
/**
 * The one call to action block: headline (the magnet's result), button, what
 * happens next, and the true reason to do it now. Base.astro renders it above the
 * footer on every Dutch page (per-page `offerArea`). All copy lives in
 * src/data/magnets.ts. On the magnet's own page the button jumps to the tool.
 */
import { magnets, type Area } from '../data/magnets'

interface Props {
  area: Area
  variant?: 'band' | 'inline'
}
const { area, variant = 'band' } = Astro.props
const m = magnets[area]
const ownPage = Astro.url.pathname === m.href
const href = ownPage ? `#${m.anchor}` : m.href
---

<section
  data-offer-cta
  data-area={area}
  class:list={[
    'offer-cta',
    variant === 'band' ? 'border-t border-(--color-line) bg-(--color-panel)' : '',
  ]}
  aria-labelledby={`offer-cta-${area}`}
>
  <div
    class:list={[
      'mx-auto max-w-page px-gutter',
      variant === 'band' ? 'py-14 md:py-20' : 'py-6',
      'md:grid md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:items-end md:gap-16',
    ]}
  >
    <div>
      <p class="eyebrow">Gratis</p>
      <h2
        id={`offer-cta-${area}`}
        class="mt-3 max-w-[22em] text-h2 text-balance text-(--color-chalk) [overflow-wrap:anywhere]"
      >
        {m.name}
      </h2>
    </div>
    <div class="mt-6 flex flex-col gap-5 md:mt-0">
      <div class="max-w-xl text-body">
        <p data-next class="text-(--color-chalk-2)">{m.next}</p>
        <p data-reason class="mt-1 text-small text-(--color-dim)">{m.reason}</p>
      </div>
      <a href={href} class="btn btn-primary btn-lg self-stretch sm:self-start">{m.button}</a>
    </div>
  </div>
</section>
