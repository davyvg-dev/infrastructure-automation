---
/**
 * The light "Daglicht" shell shared by /scan and /scan/bevestigd/: chalk page,
 * lamp wordmark, one white card column, small footer. Styles are global but
 * every rule is prefixed .scan-, so they only touch these pages.
 */
import Base from '../../layouts/Base.astro'

interface Props {
  title: string
  description: string
  noindex?: boolean
}
const { title, description, noindex = false } = Astro.props
---

<Base title={title} description={description} noindex={noindex} bare themeColor="#f4efe6">
  <div class="scan-page">
    <header class="scan-top">
      <a class="scan-lamp" href="/" aria-label="Klantkraan, naar de homepage">
        <i aria-hidden="true"></i>klantkraan
      </a>
    </header>

    <main id="main" class="scan-main">
      <slot />
    </main>

    <footer class="scan-foot">
      <a href="/">klantkraan.nl</a>
      <span aria-hidden="true">·</span>
      <a href="/legal/privacy/">Privacy</a>
    </footer>
  </div>
</Base>

<style is:global>
  /* Daglicht: these pages are light inside a dark site. The rules key on
   * .scan-page so they only apply while such a page is on screen. */
  html:has(.scan-page) {
    background-color: #f4efe6;
    color-scheme: light;
  }
  html:has(.scan-page) body::before {
    display: none;
  }

  .scan-page {
    --d-bg: #f4efe6;
    --d-card: #ffffff;
    --d-ink: #14292b;
    --d-dim: #5d706d;
    --d-line: #ddd5c6;
    --d-amber: #ffb84d;
    --d-amber-ink: #241603;
    --d-ok: #1d8a66;
    --d-err: #a3341f;

    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--d-bg);
    color: var(--d-ink);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.55;
    padding: 0 max(16px, env(safe-area-inset-right)) env(safe-area-inset-bottom)
      max(16px, env(safe-area-inset-left));
  }

  .scan-top,
  .scan-main,
  .scan-foot {
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
  }

  .scan-top {
    padding: 28px 4px 20px;
  }
  .scan-lamp {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    color: var(--d-ink);
    text-decoration: none;
  }
  .scan-lamp:hover {
    color: var(--d-ink);
  }
  .scan-lamp i {
    width: 11px;
    height: 11px;
    margin-left: 5px;
    border-radius: 50%;
    background: var(--d-amber);
    box-shadow: 0 0 0 5px rgba(255, 184, 77, 0.24);
  }

  .scan-main {
    flex: 1;
  }

  .scan-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: var(--d-card);
    border: 1px solid var(--d-line);
    border-radius: 12px;
    padding: 28px 22px;
    box-shadow: 0 24px 48px -36px rgba(20, 41, 43, 0.35);
  }
  .scan-card[hidden] {
    display: none;
  }

  .scan-card h1,
  .scan-card h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--d-ink);
  }
  .scan-card h1 {
    font-size: clamp(1.75rem, 6.2vw, 2.35rem);
  }
  .scan-card h2 {
    font-size: 1.75rem;
  }

  .scan-lead {
    margin: 0;
    color: var(--d-dim);
  }

  .scan-promises {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 0;
    padding: 0 0 4px;
    list-style: none;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .scan-promises li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .scan-promises li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--d-amber);
  }

  .scan-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .scan-field label {
    font-size: 0.95rem;
    font-weight: 600;
  }
  .scan-field label small {
    margin-left: 4px;
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--d-dim);
  }
  .scan-field input,
  .scan-field textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem; /* 16px keeps iOS from zooming in on focus */
    color: var(--d-ink);
    background: var(--d-card);
    border: 1px solid var(--d-line);
    border-radius: 10px;
    padding: 12px 13px;
    resize: vertical;
    transition:
      border-color 120ms ease,
      box-shadow 120ms ease;
  }
  .scan-field textarea {
    min-height: 5.6rem;
  }
  .scan-field input::placeholder,
  .scan-field textarea::placeholder {
    color: var(--d-dim);
    opacity: 0.72;
    font-size: 0.92rem; /* the examples are long; smaller keeps them whole on a phone */
    text-overflow: ellipsis;
  }
  .scan-field input:hover,
  .scan-field textarea:hover {
    border-color: #c4baa7;
  }
  .scan-field input:focus-visible,
  .scan-field textarea:focus-visible {
    outline: none;
    border-color: var(--d-amber);
    border-radius: 10px;
    box-shadow: 0 0 0 3px rgba(255, 184, 77, 0.45);
  }

  .scan-consent {
    margin: -6px 0 0;
    font-size: 0.82rem;
    color: var(--d-dim);
  }

  /* Brevo's bot trap: parked off-screen so people never see or reach it. */
  .scan-trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .scan-error {
    margin: 0;
    padding: 12px 14px;
    border-radius: 10px;
    background: #fbeeea;
    color: var(--d-err);
    font-size: 0.92rem;
  }
  .scan-error a {
    color: inherit;
    font-weight: 600;
  }

  .scan-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 52px;
    padding: 14px 20px;
    font: inherit;
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--d-amber-ink);
    background: var(--d-amber);
    border: 0;
    border-radius: 10px;
    cursor: pointer;
    box-shadow: 0 10px 22px -12px rgba(255, 184, 77, 0.95);
    transition:
      background-color 120ms ease,
      transform 120ms ease;
  }
  .scan-btn:hover {
    background: #ffc266;
  }
  .scan-btn:active {
    transform: translateY(1px);
  }
  .scan-btn:focus-visible {
    outline: 2px solid var(--d-ink);
    outline-offset: 3px;
    border-radius: 10px;
  }
  .scan-btn[disabled] {
    opacity: 0.7;
    cursor: progress;
  }

  .scan-sign {
    margin: 0;
    font-size: 0.86rem;
    color: var(--d-dim);
  }

  .scan-done {
    gap: 12px;
    padding-block: 34px;
  }
  .scan-done:focus {
    outline: none;
  }
  .scan-done p {
    margin: 0;
  }
  .scan-done .scan-done-hint {
    font-size: 0.88rem;
    color: var(--d-dim);
  }
  .scan-tick {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 4px;
    border: 2px solid var(--d-ok);
    border-radius: 50%;
    color: var(--d-ok);
  }

  .scan-foot {
    display: flex;
    gap: 10px;
    padding: 22px 4px 30px;
    font-size: 0.82rem;
    color: var(--d-dim);
  }
  .scan-foot a {
    color: var(--d-dim);
  }
  .scan-foot a:hover {
    color: var(--d-ink);
  }

  @media (min-width: 640px) {
    .scan-top {
      padding-top: 44px;
    }
    .scan-card {
      padding: 36px 34px;
    }
  }
</style>
