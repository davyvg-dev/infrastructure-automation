---
/**
 * E-mailcursus opt-in: the free 4-lesson "gemiste omzet" course.
 *
 * Self-contained band: pitch left, form right. Native POST works without JS
 * (the API 303s back to the referring page with ?cursus=ok|fout);
 * /js/cursus-form.js upgrades it to fetch() + inline result. IDs are fixed
 * (cursus-form / cursus-success / cursus-error / cursus-submit), so place at
 * most ONE instance per page.
 */
interface Props {
  /** Copy locale. EN/ES include the "lessons are in Dutch" note. */
  lang?: 'nl' | 'en' | 'es'
  /** Recessed band background, for alternating with cream sections. */
  recessed?: boolean
  /**
   * Embedded: no full-bleed section wrapper, single column. For pages whose
   * layout centers content itself (e.g. blog articles).
   */
  embedded?: boolean
}

const { lang = 'nl', recessed = false, embedded = false } = Astro.props

const strings = {
  nl: {
    eyebrow: 'Gratis e-mailcursus',
    heading: 'Pak uw gemiste omzet aan in 4 lessen',
    pitch:
      'Vier korte e-mails in negen dagen, geschreven voor vakmensen met een volle agenda. ' +
      'Concreet, zonder verkooppraatjes, en alles is zelf toe te passen.',
    lessons: [
      'Les 1: de klus die naar een ander ging.',
      'Les 2: wat een lead kost als u hem terugkoopt.',
      'Les 3: drie dingen die u deze week zelf kunt regelen.',
      'Les 4: als u het wilt automatiseren.',
    ],
    unsubscribe: 'Afmelden kan onder elke les met één klik.',
    nameLabel: 'Voornaam',
    nameOptional: '(optioneel)',
    emailLabel: 'E-mail',
    error: 'Dat ging mis. Controleer uw e-mailadres en probeer het opnieuw.',
    submit: 'Stuur mij les 1',
    footnote: 'U krijgt les 1 direct in uw inbox. Geen nieuwsbrief, geen spam.',
    successTitle: 'Les 1 is onderweg',
    successBody:
      'Kijk in uw inbox, en voor de zekerheid even bij de ongewenste e-mail. De volgende ' +
      'lessen komen vanzelf.',
  },
  en: {
    eyebrow: 'Free e-mail course',
    heading: 'Tackle your missed revenue in 4 lessons',
    pitch:
      'Four short e-mails over nine days, written for tradespeople with a full schedule. ' +
      'Practical, no sales pitch, and everything can be applied yourself. The lessons are ' +
      'in Dutch.',
    lessons: [
      'Lesson 1: the job that went to someone else.',
      'Lesson 2: what a lead costs when you buy it back.',
      'Lesson 3: three things you can fix yourself this week.',
      'Lesson 4: if you want to automate it.',
    ],
    unsubscribe: 'Unsubscribe with one click under any lesson.',
    nameLabel: 'First name',
    nameOptional: '(optional)',
    emailLabel: 'E-mail',
    error: 'Something went wrong. Check your e-mail address and try again.',
    submit: 'Send me lesson 1',
    footnote: 'Lesson 1 lands in your inbox right away. No newsletter, no spam.',
    successTitle: 'Lesson 1 is on its way',
    successBody:
      'Check your inbox, and your spam folder just in case. The next lessons follow ' +
      'automatically.',
  },
  es: {
    eyebrow: 'Curso gratuito por e-mail',
    heading: 'Recupere sus ingresos perdidos en 4 lecciones',
    pitch:
      'Cuatro e-mails breves en nueve días, escritos para profesionales con la agenda llena. ' +
      'Prácticos, sin discursos de venta, y todo se puede aplicar por su cuenta. Las lecciones ' +
      'están en neerlandés.',
    lessons: [
      'Lección 1: el trabajo que se llevó otro.',
      'Lección 2: lo que cuesta un lead cuando lo recompra.',
      'Lección 3: tres cosas que puede arreglar usted mismo esta semana.',
      'Lección 4: si quiere automatizarlo.',
    ],
    unsubscribe: 'Puede darse de baja con un clic debajo de cualquier lección.',
    nameLabel: 'Nombre',
    nameOptional: '(opcional)',
    emailLabel: 'E-mail',
    error: 'Algo ha fallado. Revise su dirección de e-mail e inténtelo de nuevo.',
    submit: 'Envíenme la lección 1',
    footnote: 'La lección 1 llega directamente a su bandeja de entrada. Sin newsletter, sin spam.',
    successTitle: 'La lección 1 está en camino',
    successBody:
      'Revise su bandeja de entrada y, por si acaso, la carpeta de spam. Las siguientes ' +
      'lecciones llegan solas.',
  },
}
const t = strings[lang]
---

<section
  class:list={[
    embedded
      ? 'mt-12 border-t border-(--color-line) pt-10'
      : recessed
        ? 'border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16'
        : 'py-10 md:py-16',
  ]}
>
  <div
    class:list={[
      'grid gap-6 md:gap-8 md:items-start',
      embedded ? 'max-w-2xl' : 'mx-auto max-w-5xl px-6 md:grid-cols-[1fr_.9fr]',
    ]}
  >
    <div>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="mt-3 font-display text-h2 text-(--color-chalk)">{t.heading}</h2>
      <p class="mt-4 text-body text-(--color-dim)">{t.pitch}</p>
      <ul class="mt-4 space-y-2 text-body text-(--color-dim)">
        {t.lessons.map((les) => <li>{les}</li>)}
      </ul>
      <p class="mt-4 text-small text-(--color-dim)">{t.unsubscribe}</p>
    </div>

    <div>
      <!-- method+action are the zero-JS fallback: the browser posts the form itself and
           the API answers with a 303 back to this page with ?cursus=ok|fout. -->
      <form
        id="cursus-form"
        method="POST"
        action="https://demo.klantkraan.nl/api/cursus"
        data-astro-reload
        class="rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5 md:p-6"
      >
        <div class="space-y-6">
          <div>
            <label for="cursus-naam" class="block text-body font-medium text-(--color-chalk)">
              {t.nameLabel}
              <span class="font-normal text-(--color-dim)">{t.nameOptional}</span>
            </label>
            <input
              id="cursus-naam"
              name="naam"
              type="text"
              autocomplete="given-name"
              class="mt-2 w-full rounded-(--radius-button) border border-(--color-line) bg-[rgba(0,0,0,0.25)] px-3 py-3 text-body text-(--color-chalk)"
            />
          </div>
          <div>
            <label for="cursus-email" class="block text-body font-medium text-(--color-chalk)">
              {t.emailLabel}
            </label>
            <input
              id="cursus-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="mt-2 w-full rounded-(--radius-button) border border-(--color-line) bg-[rgba(0,0,0,0.25)] px-3 py-3 text-body text-(--color-chalk)"
            />
          </div>
          <div class="hp" aria-hidden="true">
            <label for="cursus-website">Website</label>
            <input
              id="cursus-website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>
          <p id="cursus-error" class="hidden text-small text-(--color-sodium)" role="alert">
            {t.error}
          </p>
          <button
            type="submit"
            id="cursus-submit"
            class="btn btn-primary btn-lg w-full justify-center"
          >
            {t.submit}
          </button>
          <p class="text-small text-(--color-dim)">{t.footnote}</p>
        </div>
      </form>
      <div
        id="cursus-success"
        class="hidden rounded-(--radius-card) border border-(--color-sodium) bg-(--color-panel) p-5 md:p-6"
      >
        <h3 class="font-display text-h3 text-(--color-chalk)">{t.successTitle}</h3>
        <p class="mt-2 text-body text-(--color-dim)">{t.successBody}</p>
      </div>
    </div>
  </div>
</section>

<!-- Externalised JS (loaded as same-origin to pass strict CSP script-src 'self'). -->
<script src="/js/cursus-form.js" type="module" is:inline></script>

<style>
  /* Honeypot: parked off-screen so humans never see it; bots that fill it are dropped. */
  .hp {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
