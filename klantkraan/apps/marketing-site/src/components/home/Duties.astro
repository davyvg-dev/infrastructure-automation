---
/*
 * "What the receptionist takes over": brand-treated photo left, icon rows right —
 * the same hairline-divided rows /demo uses, instead of three lookalike cards.
 */
import Icon from '../Icon.astro'

interface Duty {
  icon: 'message-square' | 'calendar-check' | 'phone-call'
  title: string
  text: string
}

interface Props {
  t: {
    eyebrow: string
    heading: string
    photoAlt: string
    items: Duty[]
  }
}

const { t } = Astro.props
---

<section id="nachtdienst" class="scroll-mt-24 py-10 md:py-16">
  <div class="mx-auto max-w-5xl px-6">
    <span class="eyebrow">{t.eyebrow}</span>
    <h2 class="mt-3.5 max-w-[18em] font-display text-h2 text-balance">{t.heading}</h2>

    <div class="mt-10 grid gap-8 md:grid-cols-[.95fr_1.05fr] md:items-center md:gap-12">
      <img
        src="/photos/home-hero.jpg"
        srcset="/photos/home-hero-sm.jpg 700w, /photos/home-hero.jpg 1400w"
        sizes="(min-width: 768px) 45vw, calc(100vw - 3rem)"
        width="1400"
        height="900"
        loading="lazy"
        decoding="async"
        alt={t.photoAlt}
        class="w-full rounded-(--radius-card) border border-(--color-line) object-cover"
      />

      <ul class="divide-y divide-(--color-line)" role="list">
        {
          t.items.map((duty) => (
            <li class="grid grid-cols-[auto_1fr] gap-4 py-5 first:pt-0 last:pb-0">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-(--color-panel-2) text-(--color-sodium)">
                <Icon name={duty.icon} class="h-5 w-5" />
              </span>
              <div>
                <h3 class="font-display text-h3 text-(--color-chalk)">{duty.title}</h3>
                <p class="mt-1.5 text-body text-(--color-dim)">{duty.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
