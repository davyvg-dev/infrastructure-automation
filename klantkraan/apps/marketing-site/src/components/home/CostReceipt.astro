---
/*
 * What missed questions cost per month: the section head, the measured ledger
 * (diagrams/CostLedger.astro) and a link to the calculator for the visitor's own
 * numbers. Numbers must match /rekentool's model.
 */
import Section from '../ui/Section.astro'
import CostLedger from '../diagrams/CostLedger.astro'

interface Line {
  k: string
  v: string
}
interface Props {
  t: {
    eyebrow?: string
    heading: string
    sub: string
    ariaLabel: string
    cap: string
    lines: Line[]
    resultK: string
    resultV: string
    ctaLabel: string
    ctaHref: string
  }
}

const { t } = Astro.props
---

<Section id="kosten" name="ledger" label={t.eyebrow} heading={t.heading} sub={t.sub}>
  <div class="mt-10 md:mt-12">
    <CostLedger ariaLabel={t.ariaLabel} cap={t.cap} lines={t.lines} resultK={t.resultK} resultV={t.resultV} />
  </div>
  <a class="btn btn-ghost mt-8" href={t.ctaHref}>
    {t.ctaLabel}
    <span aria-hidden="true">&rarr;</span>
  </a>
</Section>
