---
/*
 * The missed-revenue receipt: one worked example, one CTA to the calculator.
 * Numbers must match /rekentool's model. Set in the display face rather than
 * mono — a receipt is money, not console output, and the mono made this read
 * as a debug dump.
 */

interface Line {
  k: string
  v: string
}

interface Props {
  t: {
    eyebrow: string
    heading: string
    sub: string
    ariaLabel: string
    cap: string
    lines: Line[]
    resultK: string
    resultV: string
    ctaLabel: string
    ctaHref: string
  }
}

const { t } = Astro.props
---

<section id="kosten" class="scroll-mt-24 py-10 md:py-16">
  <div
    class="mx-auto grid max-w-5xl gap-8 px-6 md:grid-cols-[1.1fr_.9fr] md:items-center md:gap-11"
  >
    <div>
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 class="mt-3.5 max-w-[16em] font-display text-h2 text-balance">{t.heading}</h2>
      <p class="mt-4 max-w-[38em] text-[1.05rem] text-[#cdd8d5]">{t.sub}</p>
      <a class="btn btn-ghost mt-7" href={t.ctaHref}>
        {t.ctaLabel}
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
    <div class="kk-receipt" aria-label={t.ariaLabel}>
      <p class="kk-receipt-cap">{t.cap}</p>
      {
        t.lines.map((line) => (
          <div class="line">
            <span class="k">{line.k}</span>
            <span class="v">{line.v}</span>
          </div>
        ))
      }
      <div class="line result">
        <span class="k">{t.resultK}</span>
        <span class="v bad">{t.resultV}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .kk-receipt {
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    padding: 0.5rem 1.5rem;
  }
  .kk-receipt .line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9375rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .kk-receipt .line:last-child {
    border-bottom: 0;
  }
  .kk-receipt .k {
    font-size: 0.9375rem;
    color: var(--color-dim);
  }
  .kk-receipt .v {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-chalk);
    font-variant-numeric: tabular-nums;
  }
  .kk-receipt .v.bad {
    color: var(--color-sodium);
  }
  .kk-receipt-cap {
    font-size: 0.8125rem;
    color: var(--color-dim);
    padding-top: 1rem;
    margin: 0;
  }
  .kk-receipt .line.result {
    border-bottom: 0;
    border-top: 1px solid var(--color-line);
    margin-top: 0.25rem;
    padding: 1.125rem 0 1.25rem;
  }
  .kk-receipt .line.result .k {
    color: var(--color-chalk);
    font-weight: 600;
  }
  .kk-receipt .line.result .v {
    font-size: clamp(1.6rem, 6.5vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    /* "± €7.200/mnd" must never break across lines — it did on a 390px screen,
     * stranding the ± on a line of its own. */
    white-space: nowrap;
  }
  /* Narrow screens: the total gets its own line rather than fighting the label. */
  @media (max-width: 26rem) {
    .kk-receipt .line.result {
      display: grid;
      gap: 0.25rem;
    }
  }
</style>
