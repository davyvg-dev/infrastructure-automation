---
/*
 * "Vandaag de voordeur, straks het kantoor." Repositions the subscription as an entry
 * point rather than a ceiling, without claiming anything we have not built.
 *
 * The honesty is structural, not a disclaimer: two visually distinct groups, a check
 * only on what actually runs today, a clock on what does not, and the word "nog niet"
 * in plain sight. If a future item ships, move it up a list — never restyle the lists
 * to blur the line.
 */
import Icon from '../Icon.astro'

interface Props {
  t: {
    eyebrow: string
    heading: string
    sub: string
    nowLabel: string
    now: string[]
    laterLabel: string
    laterNote: string
    later: string[]
    footnote: string
  }
}

const { t } = Astro.props
---

<section id="roadmap" class="scroll-mt-24 py-12 md:py-18">
  <div class="mx-auto max-w-5xl px-6">
    <span class="eyebrow">{t.eyebrow}</span>
    <h2 class="mt-3.5 max-w-[16em] font-display text-h2 text-balance">{t.heading}</h2>
    <p class="mt-4 max-w-[46em] text-body text-[#cdd8d5]">{t.sub}</p>

    <div class="mt-8 grid gap-5 md:grid-cols-2">
      <div class="kk-now rounded-(--radius-card) p-6 md:p-7">
        <p class="font-display text-h3 text-(--color-chalk)">{t.nowLabel}</p>
        <ul class="mt-4 space-y-3" role="list">
          {
            t.now.map((item) => (
              <li class="grid grid-cols-[auto_1fr] items-start gap-3 text-body text-[#cdd8d5]">
                <Icon name="check" class="mt-1 h-4 w-4 text-(--color-sodium)" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="kk-later rounded-(--radius-card) p-6 md:p-7">
        <p class="font-display text-h3 text-(--color-chalk)">{t.laterLabel}</p>
        <p class="mt-2 text-small text-(--color-dim)">{t.laterNote}</p>
        <ul class="mt-4 space-y-3" role="list">
          {
            t.later.map((item) => (
              <li class="grid grid-cols-[auto_1fr] items-start gap-3 text-body text-(--color-dim)">
                <Icon name="clock" class="mt-1 h-4 w-4 text-(--color-dim)" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="mt-6 max-w-[46em] text-small text-(--color-dim)">{t.footnote}</p>
  </div>
</section>

<style>
  /* What runs today gets the sodium edge the rest of the site uses for live things. */
  .kk-now {
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-sodium);
  }
  /* What does not gets no accent and a dashed edge, so the difference survives a
   * screenshot, a squint, and a customer skim-reading on a phone. */
  .kk-later {
    background: transparent;
    border: 1px dashed var(--color-line);
  }
</style>
