---
/*
 * Homepage hero: copy left, the live dispatch panel right. Shared by nl/en/es —
 * all strings come in via `t`, so the panel markup, styles and animation live once.
 */

interface PanelRow {
  ts: string
  what: string
  st: string
}

interface Props {
  t: {
    status: string
    statusChannels: string
    h1a: string
    h1on: string
    sub: string
    ctaPrimary: string
    ctaPrimaryHref: string
    ctaGhost: string
    ctaGhostHref: string
    trustHtml: string
    panelAria: string
    panelTop: string
    panelOn: string
    rows: PanelRow[]
    liveTs: string
    disclosure: string
    customerWho: string
    customerMsg: string
    recepWho: string
    recepMsg: string
    stampStrong: string
    stampDetail: string
  }
}

const { t } = Astro.props
---

<section class="pt-11 pb-0 md:pt-[4.5rem]">
  <div class="mx-auto max-w-5xl px-6 pb-10 md:pb-16">
    <div class="grid gap-10 md:grid-cols-[1.05fr_.95fr] md:items-center md:gap-14">
      <!-- copy -->
      <div>
        <span class="kk-status">
          <span class="kk-dot" aria-hidden="true"></span>
          <span>{t.status}</span>
          <span class="sep" aria-hidden="true">&middot;</span>
          <span>{t.statusChannels}</span>
        </span>

        <h1 class="kk-h1">{t.h1a} <span class="on">{t.h1on}</span></h1>

        <p class="kk-sub">{t.sub}</p>

        <div class="mt-8 flex flex-wrap gap-3.5">
          <a href={t.ctaPrimaryHref} class="btn btn-primary btn-lg">{t.ctaPrimary}</a>
          <a href={t.ctaGhostHref} class="btn btn-ghost btn-lg">{t.ctaGhost}</a>
        </div>
        <p class="mt-[18px] text-small text-(--color-dim)" set:html={t.trustHtml} />
      </div>

      <!-- live dispatch panel (decorative: role=img + summary label) -->
      <div class="kk-shell">
        <div id="kk-dispatch" class="kk-panel" role="img" aria-label={t.panelAria}>
          <div class="kk-panel-top">
            <span>{t.panelTop}</span>
            <span class="on"><span class="kk-dot" aria-hidden="true"></span>{t.panelOn}</span>
          </div>
          <div class="kk-log" aria-hidden="true">
            {
              t.rows.map((row) => (
                <div class="kk-row dim">
                  <span class="kk-ts">{row.ts}</span>
                  <span class="kk-what">{row.what}</span>
                  <span class="kk-st">{row.st}</span>
                </div>
              ))
            }

            <div class="kk-live">
              <div class="kk-lts kk-reveal" style="animation-delay:.2s">{t.liveTs}</div>
              <div class="kk-disclosure kk-reveal" style="animation-delay:.5s">{t.disclosure}</div>

              <div class="kk-msg kk-klant kk-reveal" style="animation-delay:.9s">
                <span class="who">{t.customerWho}</span>
                <span>{t.customerMsg}</span>
              </div>

              <div
                id="kk-typing"
                class="kk-msg kk-recep kk-reveal"
                style="animation-delay:1.5s;padding:0"
              >
                <span class="kk-typing" aria-hidden="true"><i></i><i></i><i></i></span>
              </div>

              <div id="kk-reply" class="kk-msg kk-recep" hidden>
                <span class="who">{t.recepWho}</span>
                <span>{t.recepMsg}</span>
              </div>

              <div id="kk-stamp" class="kk-stamp" hidden>
                <span class="tick" aria-hidden="true">✓</span>
                <span>
                  <strong>{t.stampStrong}</strong>
                  <span class="detail"> {t.stampDetail}</span>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .kk-status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--color-sodium-soft);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 6px 13px 6px 12px;
    background: var(--color-panel);
  }
  .kk-status .sep {
    color: var(--color-line);
  }
  .kk-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-sodium);
    flex: none;
    animation: kk-pulse 2.6s ease-out infinite;
  }
  .kk-h1 {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.025em;
    font-size: clamp(2.5rem, 6.4vw, 4.7rem);
    line-height: 0.98;
    margin: 22px 0 0;
    text-wrap: balance;
  }
  .kk-h1 .on {
    color: var(--color-sodium);
  }
  .kk-sub {
    margin-top: 24px;
    max-width: 33em;
    font-size: clamp(1.02rem, 1.4vw, 1.18rem);
    color: #cdd8d5;
    line-height: 1.6;
  }

  /* ---- dispatch panel (the signature) ---- */
  .kk-shell {
    position: relative;
  }
  .kk-shell::before {
    content: '';
    position: absolute;
    inset: -14% -8% -18% -8%;
    z-index: 0;
    background: radial-gradient(closest-side, rgba(255, 184, 77, 0.22), transparent 72%);
    filter: blur(6px);
  }
  .kk-panel {
    position: relative;
    z-index: 1;
    background: linear-gradient(180deg, var(--color-panel-2), var(--color-panel));
    border: 1px solid var(--color-line);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.7);
  }
  .kk-panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 16px;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    color: var(--color-dim);
    background: rgba(0, 0, 0, 0.14);
  }
  .kk-panel-top .on {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--color-sodium);
  }
  .kk-log {
    padding: 8px 16px 18px;
  }
  .kk-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 12px;
    align-items: baseline;
    padding: 11px 0;
    border-bottom: 1px dashed var(--color-line);
    font-size: 14.5px;
  }
  .kk-row:last-child {
    border-bottom: 0;
  }
  .kk-row.dim {
    opacity: 0.5;
  }
  .kk-ts {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-sodium-soft);
  }
  .kk-what {
    color: #cdd8d5;
  }
  .kk-st {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.03em;
    color: var(--color-confirm);
    white-space: nowrap;
  }
  .kk-live {
    margin-top: 4px;
    padding-top: 12px;
  }
  .kk-lts {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-sodium-soft);
    letter-spacing: 0.04em;
  }
  .kk-disclosure {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-dim);
    border: 1px dashed var(--color-line);
    border-radius: 7px;
    padding: 6px 9px;
    margin: 10px 0 12px;
  }
  .kk-msg {
    margin: 9px 0;
    max-width: 82%;
    padding: 9px 13px;
    border-radius: 12px;
    font-size: 14.5px;
    line-height: 1.45;
  }
  .kk-msg .who {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-dim);
    margin-bottom: 3px;
  }
  .kk-klant {
    background: var(--color-panel-2);
    border: 1px solid var(--color-line);
    border-bottom-left-radius: 4px;
  }
  .kk-recep {
    background: rgba(255, 184, 77, 0.12);
    border: 1px solid rgba(255, 184, 77, 0.32);
    color: #ffe9c7;
    margin-left: auto;
    border-bottom-right-radius: 4px;
  }
  .kk-recep .who {
    color: var(--color-sodium);
  }
  .kk-typing {
    display: inline-flex;
    gap: 4px;
    padding: 12px 14px;
  }
  .kk-typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-dim);
    animation: kk-blink 1.1s infinite;
  }
  .kk-typing i:nth-child(2) {
    animation-delay: 0.18s;
  }
  .kk-typing i:nth-child(3) {
    animation-delay: 0.36s;
  }
  @keyframes kk-blink {
    0%,
    60%,
    100% {
      opacity: 0.25;
    }
    30% {
      opacity: 1;
    }
  }
  .kk-stamp {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    padding: 11px 13px;
    background: rgba(99, 211, 171, 0.1);
    border: 1px solid rgba(99, 211, 171, 0.34);
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-confirm);
  }
  .kk-stamp .tick {
    width: 19px;
    height: 19px;
    flex: none;
    border-radius: 50%;
    background: var(--color-confirm);
    color: var(--color-night);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 12px;
  }
  .kk-stamp .detail {
    color: #bfe7d7;
  }

  /* entrance for live rows (JS re-triggers .kk-rise on reveal) */
  .kk-reveal,
  .kk-rise {
    opacity: 0;
    transform: translateY(6px);
    animation: kk-rise 0.5s ease forwards;
  }
  @keyframes kk-rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  /* Hidden states must beat the base display of .kk-msg/.kk-stamp (higher specificity). */
  .kk-msg[hidden],
  .kk-stamp[hidden] {
    display: none;
  }
</style>

<script>
  // Live dispatch panel: klant → typing → reply → INGEPLAND stamp.
  // Bound to astro:page-load so it survives client-side (ClientRouter) nav and
  // re-runs when the visitor returns to the home page. Reduced-motion jumps
  // straight to the resting state. The panel is decorative (role=img with a
  // summary label), so the no-JS state (typing shown, reply/stamp hidden)
  // matches the approved concept.
  function initDispatch() {
    const panel = document.getElementById('kk-dispatch')
    if (!panel) return
    const typing = document.getElementById('kk-typing')
    const reply = document.getElementById('kk-reply')
    const stamp = document.getElementById('kk-stamp')
    if (!typing || !reply || !stamp) return

    const reduce =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const reveal = (el: HTMLElement) => {
      el.hidden = false
      el.classList.remove('kk-rise')
      void el.offsetWidth // force reflow so the entrance animation restarts
      el.classList.add('kk-rise')
    }

    if (reduce) {
      typing.hidden = true
      reply.hidden = false
      stamp.hidden = false
      return
    }

    // rewind to the start of the shift, then play it out
    typing.hidden = false
    reply.hidden = true
    stamp.hidden = true
    window.setTimeout(() => {
      typing.hidden = true
      reveal(reply)
    }, 2400)
    window.setTimeout(() => reveal(stamp), 3100)
  }

  document.addEventListener('astro:page-load', initDispatch)
</script>
