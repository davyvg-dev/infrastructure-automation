---
/*
 * Homepage hero: the headline, then the product itself in one window.
 * Shared by nl/en/es — every string arrives via `t`, so markup, styles and the
 * animation live once.
 *
 * The window has the three things an owner sees (modelled on the client dashboard
 * in r/[slug].astro): the list of conversations, the conversation that is
 * happening now, and the appointment it produced. The thread plays out once
 * (customer, typing, reply, booking slip) and the appointment pane fills in when
 * the slip lands. "aan." switches on as the customer's message arrives.
 * Reduced motion, or no JS: everything is shown finished.
 */
interface Row {
  channel: string
  time: string
  text: string
  status: string
  active?: boolean
}
interface Field {
  k: string
  v: string
}
interface Props {
  t: {
    status: string
    h1a: string
    h1on: string
    sub: string
    ctaPrimary: string
    ctaPrimaryHref: string
    ctaGhost: string
    ctaGhostHref: string
    proof: { label: string }[]
    panelAria: string
    threadName: string
    threadSub: string
    liveTs: string
    disclosure: string
    customerMsg: string
    recepMsg: string
    stampStrong: string
    stampDetail: string
    window: {
      title: string
      meta: string
      listLabel: string
      rows: Row[]
      resultLabel: string
      fields: Field[]
    }
  }
}

const { t } = Astro.props
const w = t.window
---

<section class="kk-hero" data-section="hero">
  <div class="mx-auto max-w-page px-gutter">
    <div class="kk-hero-head">
      <div>
        <p class="kk-status">
          <span class="lamp" aria-hidden="true"></span>
          <span>{t.status}</span>
        </p>
        <h1 class="kk-h1">{t.h1a} <span class="on">{t.h1on}</span></h1>
      </div>
      <div class="kk-hero-side">
        <p class="kk-sub">{t.sub}</p>
        <div class="mt-7 btn-row">
          <a href={t.ctaPrimaryHref} class="btn btn-primary btn-lg">{t.ctaPrimary}</a>
          <a href={t.ctaGhostHref} class="btn btn-ghost btn-lg">{t.ctaGhost}</a>
        </div>
      </div>
    </div>

    <ul class="kk-proof" role="list">
      {t.proof.map((item) => <li>{item.label}</li>)}
    </ul>

    <div class="window kk-window" data-hero-window>
      <div class="window-bar">
        <span class="lamp" aria-hidden="true"></span>
        <span class="min-w-0 truncate">{w.title}</span>
        <span class="ml-auto shrink-0">{w.meta}</span>
      </div>

      <div class="kk-panes">
        <!-- Pane 1: the conversation list (decorative, summarised by the thread's label) -->
        <div class="kk-list" aria-hidden="true">
          <p class="kk-pane-label">{w.listLabel}</p>
          <ul role="list">
            {
              w.rows.map((r) => (
                <li class:list={['kk-row', r.active && 'is-active']}>
                  <span class="kk-row-meta">
                    <span>{r.channel}</span>
                    <span>{r.time}</span>
                  </span>
                  <span class="kk-row-text">{r.text}</span>
                  <span class="kk-row-status">{r.status}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Pane 2: the conversation (role=img + a summary label) -->
        <div id="kk-dispatch" class="kk-thread" role="img" aria-label={t.panelAria}>
          <div class="kk-thread-top" aria-hidden="true">
            <span class="kk-avatar">K</span>
            <span class="kk-thread-id">
              <strong>{t.threadName}</strong>
              <span>{t.threadSub}</span>
            </span>
          </div>

          <div class="kk-thread-body" aria-hidden="true">
            <div class="kk-daychip" data-reveal style="--d:.2s">{t.liveTs}</div>
            <div class="kk-note" data-reveal style="--d:.5s">{t.disclosure}</div>
            <div class="kk-bubble kk-in" data-reveal style="--d:.9s">{t.customerMsg}</div>
            <div id="kk-typing" class="kk-bubble kk-out kk-typing" hidden>
              <i></i><i></i><i></i>
            </div>
            <div id="kk-reply" class="kk-bubble kk-out">{t.recepMsg}</div>
            <div id="kk-stamp" class="kk-slip">
              <strong>{t.stampStrong}</strong>
              <span>{t.stampDetail}</span>
            </div>
          </div>
        </div>

        <!-- Pane 3: what the owner gets out of it -->
        <div id="kk-result" class="kk-result">
          <div class="kk-result-head" aria-hidden="true">
            <p class="kk-pane-label">{w.resultLabel}</p>
            <span class="kk-booked">{t.stampStrong}</span>
          </div>
          <dl class="kk-fields" aria-hidden="true">
            {
              w.fields.map((f) => (
                <div>
                  <dt>{f.k}</dt>
                  <dd>{f.v}</dd>
                </div>
              ))
            }
          </dl>
          <a href={t.ctaGhostHref} class="kk-try">
            {t.ctaGhost}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .kk-hero {
    padding: 3.5rem 0 4.5rem;
  }
  @media (min-width: 768px) {
    .kk-hero {
      padding: 6rem 0 6.5rem;
    }
  }

  /* ---- headline row: H1 left, the sub and buttons bottom-right ---- */
  .kk-hero-head {
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 1024px) {
    .kk-hero-head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: 4rem;
    }
  }
  .kk-status {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-dim);
  }
  .kk-h1 {
    margin: 1.25rem 0 0;
    font-size: var(--text-hero);
    line-height: var(--text-hero--line-height);
    font-weight: var(--text-hero--font-weight);
    letter-spacing: var(--text-hero--letter-spacing);
    color: var(--color-chalk);
    text-wrap: balance;
  }
  .kk-h1 .on {
    color: var(--color-sodium);
  }
  .kk-sub {
    margin: 0;
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-chalk-2);
  }

  /* ---- three plain facts, divided by hairlines ---- */
  .kk-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-dim);
  }
  .kk-proof li {
    padding: 0 1rem;
    border-left: 1px solid var(--color-line-strong);
  }
  .kk-proof li:first-child {
    padding-left: 0;
    border-left: 0;
  }
  @media (max-width: 479px) {
    .kk-proof {
      flex-direction: column;
    }
    .kk-proof li {
      padding: 0;
      border-left: 0;
    }
  }

  /* ---- the window ---- */
  .kk-window {
    margin-top: 3rem;
  }
  @media (min-width: 768px) {
    .kk-window {
      margin-top: 4rem;
    }
  }
  .kk-panes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 768px) {
    .kk-panes {
      grid-template-columns: minmax(0, 1fr) minmax(0, 17rem);
    }
  }
  @media (min-width: 1100px) {
    .kk-panes {
      grid-template-columns: 16.5rem minmax(0, 1fr) 18.5rem;
    }
  }
  .kk-pane-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-dim);
  }

  /* pane 1: list */
  .kk-list {
    display: none;
    border-right: 1px solid var(--color-line);
    padding: 1rem 0;
  }
  @media (min-width: 1100px) {
    .kk-list {
      display: block;
    }
  }
  .kk-list .kk-pane-label {
    padding: 0 1rem 0.75rem;
  }
  .kk-list ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .kk-row {
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--color-line);
  }
  .kk-row.is-active {
    background: var(--color-panel-2);
    box-shadow: inset 2px 0 0 var(--color-sodium);
  }
  .kk-row-meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-dim);
  }
  .kk-row-text {
    font-size: 0.875rem;
    color: var(--color-chalk);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .kk-row-status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-dim);
  }
  .kk-row.is-active .kk-row-status {
    color: var(--color-confirm);
  }

  /* pane 2: thread */
  .kk-thread {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--color-night);
  }
  .kk-thread-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--color-line);
  }
  .kk-avatar {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    border-radius: 50%;
    background: var(--color-panel-2);
    border: 1px solid var(--color-line);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-sodium);
  }
  .kk-thread-id {
    display: grid;
    line-height: 1.25;
  }
  .kk-thread-id strong {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-chalk);
  }
  .kk-thread-id span {
    font-size: 0.75rem;
    color: var(--color-dim);
  }
  .kk-thread-body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.25rem;
    min-height: 22rem;
  }
  @media (min-width: 768px) {
    .kk-thread-body {
      padding: 1.5rem 1.75rem;
      min-height: 25rem;
    }
  }
  .kk-daychip {
    align-self: center;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-dim);
  }
  .kk-note {
    align-self: center;
    max-width: 22rem;
    padding: 0.375rem 0.625rem;
    border: 1px dashed var(--color-line-strong);
    border-radius: 6px;
    font-size: 0.75rem;
    color: var(--color-dim);
    text-align: center;
  }
  .kk-bubble {
    max-width: min(26rem, 86%);
    padding: 0.625rem 0.875rem;
    border-radius: 14px;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .kk-in {
    align-self: flex-start;
    background: var(--color-panel-2);
    border: 1px solid var(--color-line);
    border-bottom-left-radius: 4px;
    color: var(--color-chalk);
  }
  .kk-out {
    align-self: flex-end;
    background: color-mix(in oklab, var(--color-sodium) 13%, var(--color-night));
    border: 1px solid color-mix(in oklab, var(--color-sodium) 26%, var(--color-night));
    border-bottom-right-radius: 4px;
    color: var(--color-chalk);
  }
  .kk-typing {
    display: inline-flex;
    gap: 4px;
    padding: 0.75rem 0.875rem;
  }
  .kk-typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-dim);
  }
  .kk-slip {
    align-self: flex-end;
    display: grid;
    gap: 0.125rem;
    max-width: min(26rem, 86%);
    padding: 0.5rem 0.75rem;
    border: 1px solid color-mix(in oklab, var(--color-confirm) 45%, var(--color-night));
    border-radius: 6px;
    font-size: 0.8125rem;
    color: var(--color-chalk-2);
  }
  .kk-slip strong {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-confirm);
  }

  /* pane 3: the appointment */
  .kk-result {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  @media (min-width: 768px) {
    .kk-result {
      border-top: 0;
      border-left: 1px solid var(--color-line);
    }
  }
  .kk-result-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .kk-booked {
    padding: 0.1875rem 0.4375rem;
    border: 1px solid color-mix(in oklab, var(--color-confirm) 45%, var(--color-night));
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--color-confirm);
    transition:
      color 0.4s ease,
      border-color 0.4s ease;
  }
  .kk-fields {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--color-line);
  }
  .kk-fields > div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .kk-fields dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-dim);
    padding-top: 0.125rem;
  }
  .kk-fields dd {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-chalk);
    transition: color 0.4s ease;
  }
  .kk-try {
    margin-top: auto;
    align-self: flex-start;
    font-size: 0.9375rem;
    font-weight: 550;
    text-decoration: none;
  }
  .kk-try:hover {
    text-decoration: underline;
  }

  /* Waiting state, set by the script only while the thread plays: the fields
   * read as blanks until the booking slip lands. */
  .kk-result.is-waiting .kk-fields dd {
    color: transparent;
    background: linear-gradient(var(--color-panel-2), var(--color-panel-2)) left center / 70% 0.625rem no-repeat;
  }
  .kk-result.is-waiting .kk-booked {
    color: var(--color-dim);
    border-color: var(--color-line);
  }

  /* ---- motion: only with no-preference, so reduced motion is simply finished ---- */
  @media (prefers-reduced-motion: no-preference) {
    [data-reveal] {
      animation: kk-rise 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) both;
    }
    .kk-rise {
      animation: kk-rise 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .kk-typing i {
      animation: kk-dot 1s ease-in-out infinite;
    }
    .kk-typing i:nth-child(2) {
      animation-delay: 0.15s;
    }
    .kk-typing i:nth-child(3) {
      animation-delay: 0.3s;
    }
    /* "aan." starts unlit and switches on as the customer's message lands:
     * two short flickers, then steady, the way a street lamp catches. */
    .kk-h1 .on {
      animation: kk-ignite 1.3s linear 1s both;
    }
  }
  @keyframes kk-rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes kk-dot {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }
  @keyframes kk-ignite {
    0%,
    9%,
    22% {
      color: var(--color-line-strong);
    }
    5%,
    15% {
      color: color-mix(in oklab, var(--color-sodium) 70%, var(--color-night));
    }
    100% {
      color: var(--color-sodium);
    }
  }
  .kk-bubble[hidden],
  .kk-slip[hidden] {
    display: none;
  }
</style>

<script>
  // The thread plays out once: customer, typing, reply, booking slip, then the
  // appointment pane fills in. Bound to astro:page-load so it replays after
  // ClientRouter navigation. Reduced motion (or no JS) shows the finished state.
  let timers: number[] = []

  function initDispatch() {
    timers.forEach((id) => window.clearTimeout(id))
    timers = []
    const typing = document.getElementById('kk-typing')
    const reply = document.getElementById('kk-reply')
    const stamp = document.getElementById('kk-stamp')
    const result = document.getElementById('kk-result')
    if (!typing || !reply || !stamp || !result) return

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (reduce) {
      typing.hidden = true
      reply.hidden = false
      stamp.hidden = false
      result.classList.remove('is-waiting')
      return
    }

    const reveal = (el: HTMLElement) => {
      el.hidden = false
      el.classList.remove('kk-rise')
      void el.offsetWidth // restart the entrance animation
      el.classList.add('kk-rise')
    }

    reply.hidden = true
    stamp.hidden = true
    typing.hidden = true
    result.classList.add('is-waiting')
    timers.push(window.setTimeout(() => reveal(typing), 1500))
    timers.push(
      window.setTimeout(() => {
        typing.hidden = true
        reveal(reply)
      }, 2700),
    )
    timers.push(window.setTimeout(() => reveal(stamp), 3400))
    timers.push(window.setTimeout(() => result.classList.remove('is-waiting'), 3700))
  }

  document.addEventListener('astro:page-load', initDispatch)
</script>
