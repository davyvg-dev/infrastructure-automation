---
/*
 * Homepage hero: copy left, a live conversation right, a tradesperson behind it all.
 * Shared by nl/en/es — every string arrives via `t`, so markup, styles and the
 * animation live once.
 *
 * 2026-07-28: the panel used to be a shift log — "DIENSTLOG", timestamped rows,
 * a ✓ status column, monospaced throughout. It read like a server dashboard, which
 * is the opposite of who buys this. Same story now (23:47, a leak, booked for
 * Tuesday), told as the thing the customer actually sees: a phone thread.
 */
import Icon from '../Icon.astro'

interface Proof {
  icon: 'message-circle' | 'calendar-check' | 'shield-check'
  label: string
}

interface Props {
  t: {
    status: string
    h1a: string
    h1on: string
    sub: string
    ctaPrimary: string
    ctaPrimaryHref: string
    ctaGhost: string
    ctaGhostHref: string
    proof: Proof[]
    panelAria: string
    threadName: string
    threadSub: string
    liveTs: string
    disclosure: string
    customerMsg: string
    recepMsg: string
    stampStrong: string
    stampDetail: string
  }
}

const { t } = Astro.props
---

<section class="kk-hero">
  <div class="kk-hero-inner">
    <div class="kk-hero-copy">
      <span class="kk-status">
        <span class="kk-dot" aria-hidden="true"></span>
        <span>{t.status}</span>
      </span>

      <h1 class="kk-h1">{t.h1a} <span class="on">{t.h1on}</span></h1>

      <p class="kk-sub">{t.sub}</p>

      <div class="mt-8 btn-row">
        <a href={t.ctaPrimaryHref} class="btn btn-primary btn-lg">{t.ctaPrimary}</a>
        <a href={t.ctaGhostHref} class="btn btn-ghost btn-lg">{t.ctaGhost}</a>
      </div>

      <ul class="kk-proof" role="list">
        {
          t.proof.map((item) => (
            <li>
              <Icon name={item.icon} class="h-[1.15rem] w-[1.15rem]" />
              <span>{item.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- The conversation (decorative: role=img + a summary label) -->
    <div class="kk-thread-wrap">
      <div id="kk-dispatch" class="kk-thread" role="img" aria-label={t.panelAria}>
        <div class="kk-thread-top">
          <span class="kk-avatar" aria-hidden="true">
            <Icon name="message-circle" class="h-[1.15rem] w-[1.15rem]" />
          </span>
          <span class="kk-thread-id">
            <strong>{t.threadName}</strong>
            <span><i class="kk-live-dot" aria-hidden="true"></i>{t.threadSub}</span>
          </span>
        </div>

        <div class="kk-thread-body" aria-hidden="true">
          <div class="kk-daychip kk-reveal" style="animation-delay:.2s">{t.liveTs}</div>
          <div class="kk-note kk-reveal" style="animation-delay:.5s">{t.disclosure}</div>

          <div class="kk-bubble kk-in kk-reveal" style="animation-delay:.9s">{t.customerMsg}</div>

          <div id="kk-typing" class="kk-bubble kk-out kk-typing kk-reveal" style="animation-delay:1.5s">
            <i></i><i></i><i></i>
          </div>

          <div id="kk-reply" class="kk-bubble kk-out" hidden>{t.recepMsg}</div>

          <div id="kk-stamp" class="kk-slip" hidden>
            <span class="tick" aria-hidden="true">
              <Icon name="check" class="h-3 w-3" />
            </span>
            <span>
              <strong>{t.stampStrong}</strong>
              <span class="detail">{t.stampDetail}</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---- the stage ---- */
  .kk-hero {
    position: relative;
    isolation: isolate;
    padding: 2.75rem 0 3.5rem;
    overflow: clip;
  }
  @media (min-width: 768px) {
    .kk-hero {
      padding: 4rem 0 5rem;
    }
  }

  .kk-hero-inner {
    margin: 0 auto;
    max-width: 64rem;
    padding: 0 1.5rem;
    display: grid;
    gap: 2.75rem;
  }
  @media (min-width: 768px) {
    .kk-hero-inner {
      grid-template-columns: 1.04fr 0.96fr;
      align-items: center;
      gap: 3.5rem;
    }
  }

  /* ---- copy ---- */
  .kk-status {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-sodium-soft);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.4375rem 0.9375rem 0.4375rem 0.8125rem;
    background: rgba(22, 41, 43, 0.82);
    backdrop-filter: blur(6px);
  }
  .kk-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-sodium);
    flex: none;
    animation: kk-pulse 2.6s ease-out infinite;
  }
  .kk-h1 {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.025em;
    font-size: clamp(2.5rem, 6.4vw, 4.7rem);
    line-height: 0.98;
    margin: 1.375rem 0 0;
    text-wrap: balance;
  }
  .kk-h1 .on {
    color: var(--color-sodium);
  }
  .kk-sub {
    margin-top: 1.5rem;
    max-width: 31em;
    font-size: clamp(1.02rem, 1.4vw, 1.18rem);
    color: #cdd8d5;
    line-height: 1.6;
  }

  /* Trust, shown as three checkable facts rather than run together in one grey
   * sentence. Same icon-and-label pattern as the trade pages. */
  .kk-proof {
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem 1.375rem;
  }
  .kk-proof li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: #cdd8d5;
  }
  .kk-proof :global(svg) {
    flex: none;
    color: var(--color-sodium);
  }

  /* ---- the conversation ---- */
  .kk-thread-wrap {
    position: relative;
  }
  .kk-thread-wrap::before {
    content: '';
    position: absolute;
    inset: -12% -6% -16% -6%;
    z-index: 0;
    background: radial-gradient(closest-side, rgba(255, 184, 77, 0.2), transparent 72%);
    filter: blur(8px);
  }
  .kk-thread {
    position: relative;
    z-index: 1;
    background: linear-gradient(180deg, var(--color-panel-2), var(--color-panel));
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 34px 80px -34px rgba(0, 0, 0, 0.85);
  }
  .kk-thread-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--color-line);
    background: rgba(0, 0, 0, 0.16);
  }
  .kk-avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgba(255, 184, 77, 0.14);
    border: 1px solid rgba(255, 184, 77, 0.3);
    color: var(--color-sodium);
  }
  .kk-thread-id {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }
  .kk-thread-id strong {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-chalk);
  }
  .kk-thread-id > span {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    font-size: 0.8125rem;
    color: var(--color-dim);
  }
  .kk-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-confirm);
    flex: none;
  }

  .kk-thread-body {
    padding: 1.125rem 1rem 1.25rem;
  }
  /* The date pill a phone puts between days — the only timestamp left. */
  .kk-daychip {
    display: block;
    width: fit-content;
    margin: 0 auto 0.875rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.22);
    font-size: 0.75rem;
    color: var(--color-dim);
  }
  /* EU AI Act art. 50 — the conversation opens by saying what it is. Never remove. */
  .kk-note {
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-dim);
    margin-bottom: 1rem;
    padding: 0 0.5rem;
  }
  .kk-bubble {
    max-width: 85%;
    padding: 0.6875rem 0.9375rem;
    border-radius: 1.125rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    margin-bottom: 0.625rem;
  }
  .kk-in {
    background: var(--color-panel-2);
    border: 1px solid var(--color-line);
    color: var(--color-chalk);
    border-bottom-left-radius: 0.375rem;
  }
  .kk-out {
    background: rgba(255, 184, 77, 0.13);
    border: 1px solid rgba(255, 184, 77, 0.3);
    color: #ffe9c7;
    margin-left: auto;
    border-bottom-right-radius: 0.375rem;
  }
  .kk-typing {
    display: flex;
    gap: 0.25rem;
    width: fit-content;
    padding: 0.875rem 0.9375rem;
  }
  .kk-typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-sodium-soft);
    opacity: 0.4;
    animation: kk-blink 1.1s infinite;
  }
  .kk-typing i:nth-child(2) {
    animation-delay: 0.18s;
  }
  .kk-typing i:nth-child(3) {
    animation-delay: 0.36s;
  }
  @keyframes kk-blink {
    0%,
    60%,
    100% {
      opacity: 0.3;
    }
    30% {
      opacity: 1;
    }
  }

  /* The one monospaced thing left on the page: the docket the job lands on.
   * Mono as punctuation, at the moment the product delivers, not as wallpaper. */
  .kk-slip {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 0.875rem;
    padding: 0.75rem 0.875rem;
    background: rgba(99, 211, 171, 0.1);
    border: 1px solid rgba(99, 211, 171, 0.32);
    border-radius: 0.75rem;
  }
  .kk-slip strong {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-confirm);
  }
  .kk-slip .detail {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.8125rem;
    color: #bfe7d7;
  }
  .kk-slip .tick {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--color-confirm);
    color: var(--color-night);
  }

  /* entrance for the live rows (JS re-triggers .kk-rise on reveal) */
  .kk-reveal,
  .kk-rise {
    opacity: 0;
    transform: translateY(6px);
    animation: kk-rise 0.5s ease forwards;
  }
  @keyframes kk-rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  /* Hidden states must beat the base display of .kk-bubble/.kk-slip. */
  .kk-bubble[hidden],
  .kk-slip[hidden] {
    display: none;
  }
</style>

<script>
  // The thread plays out once: customer → typing → reply → booking slip.
  // Bound to astro:page-load so it survives client-side (ClientRouter) nav and
  // replays when the visitor returns home. Reduced motion jumps straight to the
  // resting state. The thread is decorative (role=img with a summary label), so
  // the no-JS state (typing shown, reply/slip hidden) is an acceptable still.
  function initDispatch() {
    const panel = document.getElementById('kk-dispatch')
    if (!panel) return
    const typing = document.getElementById('kk-typing')
    const reply = document.getElementById('kk-reply')
    const stamp = document.getElementById('kk-stamp')
    if (!typing || !reply || !stamp) return

    const reduce =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const reveal = (el: HTMLElement) => {
      el.hidden = false
      el.classList.remove('kk-rise')
      void el.offsetWidth // force reflow so the entrance animation restarts
      el.classList.add('kk-rise')
    }

    if (reduce) {
      typing.hidden = true
      reply.hidden = false
      stamp.hidden = false
      return
    }

    typing.hidden = false
    reply.hidden = true
    stamp.hidden = true
    window.setTimeout(() => {
      typing.hidden = true
      reveal(reply)
    }, 2400)
    window.setTimeout(() => reveal(stamp), 3100)
  }

  document.addEventListener('astro:page-load', initDispatch)
</script>
