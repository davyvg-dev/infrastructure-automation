---
/*
 * The live demo. Copy and example questions on the left, the chat on the right at
 * widget width — full-bleed it and the empty thread reads as a broken box rather
 * than a waiting receptionist. Desktop gets the inline iframe, mobile a one-tap
 * full-screen launcher (reuses /js/demo-embed.js, same as /demo). Includes the
 * overlay div + script, so a page composes this once and gets the whole thing.
 * The embedded receptionist speaks Dutch, so only the NL homepage embeds it —
 * en/es link to their /demo/ pages instead.
 */
import Icon from '../Icon.astro'

interface Props {
  t: {
    eyebrow: string
    heading: string
    sub: string
    asksLabel: string
    asks: string[]
    iframeTitle: string
    mobileName: string
    mobileTag: string
    mobileHint: string
    mobileCta: string
    trust: string
  }
}

const { t } = Astro.props
---

<section
  id="demo"
  class="scroll-mt-24 border-y border-(--color-line) bg-[rgba(0,0,0,0.26)] py-12 md:py-18"
>
  <div class="mx-auto max-w-5xl px-6">
    <div class="grid gap-9 md:grid-cols-[0.82fr_1.18fr] md:items-center md:gap-12">
      <div>
        <span class="eyebrow">{t.eyebrow}</span>
        <h2 class="mt-3.5 font-display text-h2 text-balance">{t.heading}</h2>
        <p class="mt-4 text-[1.05rem] text-[#cdd8d5]">{t.sub}</p>

        <p class="mt-7 text-small font-semibold text-(--color-chalk)">{t.asksLabel}</p>
        <ul class="kk-asks" role="list">
          {t.asks.map((ask) => <li>{ask}</li>)}
        </ul>
      </div>

      <div>
        <div
          class="hidden rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-3 shadow-sm md:block"
        >
          <iframe
            src="https://demo-168-119-173-25.sslip.io/?embed=1"
            title={t.iframeTitle}
            loading="lazy"
            width="560"
            height="460"
            class="block h-[460px] w-full rounded-(--radius-button) border border-(--color-line)"
          ></iframe>
        </div>

        <div
          class="rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5 shadow-sm md:hidden"
        >
          <div class="flex items-center gap-3">
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-(--color-panel-2) text-(--color-sodium)"
            >
              <Icon name="message-square" class="h-5 w-5" />
            </span>
            <div class="min-w-0">
              <p class="font-display text-h3 text-(--color-chalk)">{t.mobileName}</p>
              <p class="text-small text-(--color-dim)">{t.mobileTag}</p>
            </div>
          </div>
          <p
            class="mt-4 rounded-(--radius-button) bg-[rgba(0,0,0,0.22)] p-3 text-body text-(--color-dim)"
          >
            {t.mobileHint}
          </p>
          <button
            type="button"
            data-demo-open
            class="mt-4 btn btn-primary btn-lg w-full justify-center"
          >
            <Icon name="message-circle" class="h-5 w-5" />
            <span>{t.mobileCta}</span>
          </button>
        </div>

        <p class="mt-3 text-small text-(--color-dim)">{t.trust}</p>
      </div>
    </div>
  </div>

  <!-- Full-screen demo overlay (mobile). Injected iframe is sized to the visual
       viewport by /js/demo-embed.js so the iOS keyboard never hides the chat. -->
  <div
    id="demo-overlay"
    class="fixed inset-0 z-[70] hidden overflow-hidden bg-(--color-night) overscroll-contain"
    aria-hidden="true"
  >
  </div>
  <script src="/js/demo-embed.js?v=5" type="module" is:inline></script>
</section>

<style>
  /* Openers a visitor can copy straight into the chat — an empty input is the
   * reason most people bounce off a demo. */
  .kk-asks {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .kk-asks li {
    padding: 0.5625rem 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-panel);
    font-size: 0.9375rem;
    color: #cdd8d5;
    width: fit-content;
    max-width: 100%;
  }
  .kk-asks li::before {
    content: '“';
    color: var(--color-sodium);
  }
  .kk-asks li::after {
    content: '”';
    color: var(--color-sodium);
  }
</style>
