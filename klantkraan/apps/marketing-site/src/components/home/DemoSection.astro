---
/*
 * The live demo: desktop gets the inline iframe, mobile a one-tap full-screen
 * launcher (reuses /js/demo-embed.js, same as /demo). Includes the overlay div +
 * script, so a page composes this once and gets the whole thing. The embedded
 * receptionist speaks Dutch, so only the NL homepage embeds it — en/es link to
 * their /demo/ pages instead.
 */
import Icon from '../Icon.astro'

interface Props {
  t: {
    eyebrow: string
    heading: string
    sub: string
    iframeTitle: string
    mobileName: string
    mobileTag: string
    mobileHint: string
    mobileCta: string
    trust: string
  }
}

const { t } = Astro.props
---

<section
  id="demo"
  class="scroll-mt-24 border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16"
>
  <div class="mx-auto max-w-5xl px-6">
    <span class="eyebrow">{t.eyebrow}</span>
    <h2 class="mt-3.5 max-w-[18em] font-display text-h2 text-balance">{t.heading}</h2>
    <p class="mt-4 max-w-[40em] text-[1.05rem] text-[#cdd8d5]">{t.sub}</p>

    <div
      class="mt-8 hidden rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-3 shadow-sm md:block md:p-4"
    >
      <iframe
        src="https://demo-168-119-173-25.sslip.io/?embed=1"
        title={t.iframeTitle}
        loading="lazy"
        width="800"
        height="560"
        class="block h-[560px] w-full rounded-(--radius-button) border border-(--color-line)"
      ></iframe>
    </div>

    <div
      class="mt-8 rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-5 shadow-sm md:hidden"
    >
      <div class="flex items-center gap-3">
        <span
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-(--color-panel-2) text-(--color-sodium)"
        >
          <Icon name="message-square" class="h-5 w-5" />
        </span>
        <div class="min-w-0">
          <p class="font-display text-h3 text-(--color-chalk)">{t.mobileName}</p>
          <p class="text-small text-(--color-dim)">{t.mobileTag}</p>
        </div>
      </div>
      <p class="mt-4 rounded-(--radius-button) bg-[rgba(0,0,0,0.22)] p-3 text-body text-(--color-dim)">
        {t.mobileHint}
      </p>
      <button type="button" data-demo-open class="mt-4 btn btn-primary btn-lg w-full justify-center">
        <Icon name="message-circle" class="h-5 w-5" />
        <span>{t.mobileCta}</span>
      </button>
    </div>

    <p class="mt-3 text-small text-(--color-dim)">{t.trust}</p>
  </div>

  <!-- Full-screen demo overlay (mobile). Injected iframe is sized to the visual
       viewport by /js/demo-embed.js so the iOS keyboard never hides the chat. -->
  <div
    id="demo-overlay"
    class="fixed inset-0 z-[70] hidden overflow-hidden bg-(--color-night) overscroll-contain"
    aria-hidden="true"
  >
  </div>
  <script src="/js/demo-embed.js?v=5" type="module" is:inline></script>
</section>
