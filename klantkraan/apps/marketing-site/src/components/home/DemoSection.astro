---
/*
 * The live demo. Copy and example questions on the left, the chat on the right at
 * widget width — full-bleed it and the empty thread reads as a broken box rather
 * than a waiting receptionist. Desktop gets the inline iframe, mobile a one-tap
 * full-screen launcher (reuses /js/demo-embed.js, same as /demo). Includes the
 * overlay div + script, so a page composes this once and gets the whole thing.
 * The embedded receptionist speaks Dutch, so only the NL homepage embeds it —
 * en/es link to their /demo/ pages instead.
 */
import Icon from '../Icon.astro'

interface Props {
  t: {
    eyebrow: string
    heading: string
    sub: string
    asksLabel: string
    asks: string[]
    iframeTitle: string
    mobileName: string
    mobileTag: string
    mobileHint: string
    mobileCta: string
    trust: string
  }
}

const { t } = Astro.props
---

<section id="demo" data-section="demo" aria-labelledby="demo-h" class="scroll-mt-24 border-y border-(--color-line) bg-(--color-panel)">
  <div class="mx-auto max-w-page px-gutter py-section">
    <div class="grid gap-10 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] md:items-center md:gap-14">
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 id="demo-h" class="mt-3 text-h2 text-balance text-(--color-chalk)">{t.heading}</h2>
        <p class="mt-4 text-body text-(--color-chalk-2)">{t.sub}</p>

        <p class="mt-8 font-mono text-[0.75rem] text-(--color-dim)">{t.asksLabel}</p>
        <ul class="kk-asks" role="list">
          {t.asks.map((ask) => <li>{ask}</li>)}
        </ul>
      </div>

      <div>
        <div class="window hidden md:block">
          <div class="window-bar">
            <span class="lamp" aria-hidden="true"></span>
            <span class="min-w-0 truncate">{t.mobileName}</span>
            <span class="ml-auto shrink-0">{t.mobileTag}</span>
          </div>
          <iframe
            src="https://demo-168-119-173-25.sslip.io/?embed=1"
            title={t.iframeTitle}
            loading="lazy"
            width="560"
            height="480"
            class="block h-[480px] w-full border-0 bg-(--color-night)"
          ></iframe>
        </div>

        <div class="window md:hidden">
          <div class="window-bar">
            <span class="lamp" aria-hidden="true"></span>
            <span class="min-w-0 truncate">{t.mobileName}</span>
          </div>
          <div class="p-5">
            <p class="text-small text-(--color-dim)">{t.mobileTag}</p>
            <p class="mt-3 text-body text-(--color-chalk-2)">{t.mobileHint}</p>
            <button type="button" data-demo-open class="mt-5 btn btn-primary btn-lg w-full justify-center">
              <Icon name="message-circle" class="h-5 w-5" />
              <span>{t.mobileCta}</span>
            </button>
          </div>
        </div>

        <p class="mt-3 font-mono text-[0.75rem] text-(--color-dim)">{t.trust}</p>
      </div>
    </div>
  </div>

  <!-- Full-screen demo overlay (mobile). Injected iframe is sized to the visual
       viewport by /js/demo-embed.js so the iOS keyboard never hides the chat. -->
  <div
    id="demo-overlay"
    class="fixed inset-0 z-[70] hidden overflow-hidden bg-(--color-night) overscroll-contain"
    aria-hidden="true"
  >
  </div>
  <script src="/js/demo-embed.js?v=5" type="module" is:inline></script>
</section>

<style>
  /* Openers a visitor can copy straight into the chat: an empty input is the
   * reason most people bounce off a demo. One hairline-divided list. */
  .kk-asks {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }
  .kk-asks li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.9375rem;
    color: var(--color-chalk);
  }
  .kk-asks li::before {
    content: '“';
    color: var(--color-sodium);
  }
  .kk-asks li::after {
    content: '”';
    color: var(--color-sodium);
  }
</style>
