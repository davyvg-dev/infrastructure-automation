---
/*
 * Honest-about-AI: the disclosure quote plus short scannable points instead of a
 * paragraph slab. Same bullet pattern /demo uses for its art. 50 section.
 */
import Icon from '../Icon.astro'

interface Props {
  t: {
    eyebrow: string
    heading: string
    quote: string
    bullets: string[]
    linkLabel: string
    linkHref: string
  }
}

const { t } = Astro.props
---

<section
  id="eerlijk"
  class="scroll-mt-24 border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16"
>
  <div class="mx-auto max-w-5xl px-6">
    <span class="eyebrow">{t.eyebrow}</span>
    <h2 class="mt-3.5 max-w-[18em] font-display text-h2 text-balance">{t.heading}</h2>

    <div class="kk-trans mt-6">
      <span class="quote">&ldquo;{t.quote}&rdquo;</span>
      <ul class="mt-2 space-y-3" role="list">
        {
          t.bullets.map((bullet) => (
            <li class="grid grid-cols-[auto_1fr] items-start gap-3 text-body text-[#cdd8d5]">
              <Icon name="check" class="mt-1 h-4 w-4 text-(--color-sodium)" />
              <span>{bullet}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-5 text-small">
        <a href={t.linkHref} class="text-(--color-sodium) underline underline-offset-2">
          {t.linkLabel}
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .kk-trans {
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-sodium);
    border-radius: var(--radius-card);
    padding: 30px 32px;
    max-width: 760px;
  }
  .kk-trans .quote {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-sodium-soft);
    border: 1px dashed var(--color-line);
    border-radius: 8px;
    padding: 10px 13px;
    display: inline-block;
    margin-bottom: 18px;
  }
</style>
