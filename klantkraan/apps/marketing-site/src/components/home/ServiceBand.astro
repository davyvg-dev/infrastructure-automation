---
/*
 * One service on the homepage, below the receptionist: copy on the left (h2,
 * sub, three points, price, two buttons and the small start), its drawing on
 * the right, passed in as the default slot. Name, points, price and links come
 * from src/data/services.ts; only the band's heading and sub are page copy.
 * data-section is the service's area, id its anchor (the hero links here).
 */
import { serviceByArea } from '../../data/services'
import { offerHref, type Area } from '../../data/magnets'

interface Props {
  area: Exclude<Area, 'receptionist'>
  t: {
    heading: string
    sub: string
    /** Ghost button to the service page. */
    more: string
    /** Lead-in for the small paid start, e.g. "Klein beginnen:". */
    smallLabel: string
  }
  /** Raised panel background, to alternate with the band above. */
  sunk?: boolean
}
const { area, t, sunk = false } = Astro.props
const s = serviceByArea[area]
const headingId = `${s.anchor}-h`
// The ads magnet lives on the service page itself: point at its form.
const freeHref = s.free.href === s.href ? `${s.free.href}#${s.free.anchor}` : s.free.href
// The ad pack is the service price itself; no separate small start to name.
const showSmall = !s.price.includes(s.small.price)
---

<section
  id={s.anchor}
  data-section={area}
  aria-labelledby={headingId}
  class:list={['scroll-mt-24', sunk && 'border-y border-(--color-line) bg-(--color-panel)']}
>
  <div class="mx-auto max-w-page px-gutter py-section">
    <div class="kk-band">
      <div class="kk-band-copy">
        <p class="eyebrow">{s.label}</p>
        <h2 id={headingId} class="mt-3 text-h2 text-balance text-(--color-chalk)">{t.heading}</h2>
        <p class="mt-4 max-w-[36rem] text-body text-(--color-chalk-2)">{t.sub}</p>

        <ul role="list" class="kk-band-points">
          {
            s.points.map((p) => (
              <li>
                <span class="kk-band-mark" aria-hidden="true" />
                <span>{p}</span>
              </li>
            ))
          }
        </ul>

        <p class="kk-band-price" data-price>
          <span class="kk-band-amount">{s.price}</span>
          <span class="kk-band-note">{s.priceNote}</span>
        </p>

        <div class="mt-7 btn-row">
          <a href={freeHref} class="btn btn-primary btn-lg">{s.free.button}</a>
          <a href={s.href} class="btn btn-ghost btn-lg">{t.more}</a>
        </div>
        {
          showSmall && (
            <p class="kk-band-small" data-price>
              {t.smallLabel}{' '}
              <a href={offerHref(s.small)}>{s.small.name}</a>, {s.small.price} {s.small.priceNote}
            </p>
          )
        }
      </div>

      <div class="kk-band-drawing">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .kk-band {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: minmax(0, 1fr);
  }
  /* Side by side only where the copy column is wide enough for both buttons on
   * one row in every band (the widest pair, the automations one, needs ~505px).
   * Below 1280 the drawing goes under the copy. */
  @media (min-width: 1280px) {
    .kk-band {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 3.5rem;
    }
  }
  .kk-band-points {
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }
  .kk-band-points li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.9375rem;
    color: var(--color-chalk);
  }
  .kk-band-mark {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-sodium);
    transform: translateY(-0.05rem);
  }
  .kk-band-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.625rem;
    margin: 1.75rem 0 0;
  }
  .kk-band-amount {
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: -0.025em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--color-chalk);
  }
  .kk-band-note {
    font-size: var(--text-small);
    color: var(--color-dim);
  }
  .kk-band-small {
    margin: 1rem 0 0;
    font-size: var(--text-small);
    color: var(--color-dim);
  }
  .kk-band-small a {
    color: var(--color-chalk-2);
    font-weight: 550;
  }
  /* The drawings are about 22rem wide; a frame much wider than that leaves
   * them floating in an empty box. */
  .kk-band-drawing {
    min-width: 0;
    width: 100%;
    max-width: 32rem;
  }
  @media (min-width: 1280px) {
    .kk-band-drawing {
      justify-self: end;
    }
  }
</style>
