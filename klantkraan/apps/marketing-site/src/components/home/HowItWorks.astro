---
/*
 * From signup to live in three numbered steps — the homepage's answer to "how do
 * I actually start?", pointing at /aanmelden now that the site can sell.
 */

interface Step {
  title: string
  text: string
}

interface Props {
  t: {
    eyebrow: string
    heading: string
    steps: Step[]
    note: string
  }
}

const { t } = Astro.props
---

<section id="starten" class="scroll-mt-24 py-10 md:py-16">
  <div class="mx-auto max-w-5xl px-6">
    <span class="eyebrow">{t.eyebrow}</span>
    <h2 class="mt-3.5 max-w-[18em] font-display text-h2 text-balance">{t.heading}</h2>

    <ol class="kk-steps mt-10 grid gap-4 md:grid-cols-3 md:gap-5" role="list">
      {
        t.steps.map((step, i) => (
          <li>
            <span class="kk-step-n" aria-hidden="true">
              {i + 1}
            </span>
            <h3 class="mt-4 font-display text-h3 text-(--color-chalk)">{step.title}</h3>
            <p class="mt-2 text-body text-(--color-dim)">{step.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-6 text-small text-(--color-dim)">{t.note}</p>
  </div>
</section>

<style>
  /* Numbering earns its place here: signing up, the build call and going live
   * genuinely happen in that order. Set in the display face at size so the step
   * reads as a stage in a process, not as an array index. */
  .kk-steps li {
    padding: 1.75rem;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: linear-gradient(180deg, var(--color-panel-2), var(--color-panel));
  }
  .kk-step-n {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgba(255, 184, 77, 0.12);
    border: 1px solid rgba(255, 184, 77, 0.3);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-sodium);
  }
</style>
