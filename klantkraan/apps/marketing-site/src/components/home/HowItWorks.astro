---
/*
 * From signup to live in three numbered steps — the homepage's answer to "how do
 * I actually start?", pointing at /aanmelden now that the site can sell.
 */

interface Step {
  title: string
  text: string
}

interface Props {
  t: {
    eyebrow: string
    heading: string
    steps: Step[]
    note: string
  }
}

const { t } = Astro.props
---

<section id="starten" class="scroll-mt-24 py-10 md:py-16">
  <div class="mx-auto max-w-5xl px-6">
    <span class="eyebrow">{t.eyebrow}</span>
    <h2 class="mt-3.5 max-w-[18em] font-display text-h2 text-balance">{t.heading}</h2>

    <ol class="mt-10 grid gap-[18px] md:grid-cols-3" role="list">
      {
        t.steps.map((step, i) => (
          <li class="rounded-(--radius-card) border border-(--color-line) bg-(--color-panel) p-6">
            <span class="font-mono text-small text-(--color-sodium)">{i + 1}.</span>
            <h3 class="mt-3 font-display text-h3 text-(--color-chalk)">{step.title}</h3>
            <p class="mt-2 text-body text-(--color-dim)">{step.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-6 text-small text-(--color-dim)">{t.note}</p>
  </div>
</section>
