---
/*
 * From signup to live in three numbered steps — the homepage's answer to "how do
 * I actually start?", pointing at /aanmelden now that the site can sell.
 */

interface Step {
  title: string
  text: string
}

interface Props {
  t: {
    eyebrow?: string
    heading: string
    steps: Step[]
    note: string
  }
}

const { t } = Astro.props
---

<section id="starten" class="scroll-mt-24 py-10 md:py-16">
  <div class="mx-auto max-w-5xl px-6">
    {t.eyebrow && <span class="eyebrow">{t.eyebrow}</span>}
    <h2 class:list={['max-w-[18em] font-display text-h2 text-balance', t.eyebrow && 'mt-3.5']}>{t.heading}</h2>

    <ol class="kk-steps mt-10 grid gap-8 md:grid-cols-3 md:gap-10" role="list">
      {
        t.steps.map((step, i) => (
          <li>
            <span class="kk-step-n" aria-hidden="true">
              {i + 1}
            </span>
            <h3 class="mt-3 font-display text-h3 text-(--color-chalk)">{step.title}</h3>
            <p class="mt-2 text-body text-(--color-dim)">{step.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-6 text-small text-(--color-dim)">{t.note}</p>
  </div>
</section>

<style>
  /* Numbering earns its place here: signing up, the build call and going live
   * genuinely happen in that order. No cards and no badge circles (the stock
   * three-card pattern); a hairline and a big quiet numeral carry the sequence. */
  .kk-steps li {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .kk-step-n {
    display: block;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-sodium);
    opacity: 0.55;
  }
</style>
