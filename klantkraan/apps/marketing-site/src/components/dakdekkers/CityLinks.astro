---
// "Wij werken ook in" linkback to Wave-1 programmatic city pages.
// Mirrors the pattern on the loodgieters and schilder cornerstones.
---

<section class="bg-(--color-kraan-stone-100) py-10 md:py-16" aria-label="Dakdekkers per stad">
  <div class="mx-auto max-w-5xl px-6">
    <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">
      Per stad
    </p>
    <h2 class="mt-3 font-display text-h2 text-(--color-kraan-ink)">
      Wij ondersteunen dakdekkers in:
    </h2>
    <ul class="mt-6 grid max-w-3xl grid-cols-2 gap-2 text-body sm:grid-cols-3 md:grid-cols-4">
      <li>
        <a href="/amsterdam/dakdekker/" class="text-(--color-kraan-blue) underline">Amsterdam</a>
      </li>
      <li>
        <a href="/rotterdam/dakdekker/" class="text-(--color-kraan-blue) underline">Rotterdam</a>
      </li>
      <li>
        <a href="/utrecht/dakdekker/" class="text-(--color-kraan-blue) underline">Utrecht</a>
      </li>
    </ul>
  </div>
</section>
