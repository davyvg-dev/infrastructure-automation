---
// "Wij werken ook in" linkback to Wave-1 programmatic city pages.
// Mirrors the pattern on the loodgieters and schilder cornerstones.
---

<section
  class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16"
  aria-label="Dakdekkers per stad"
>
  <div class="mx-auto max-w-5xl px-6">
    <p class="eyebrow">Per stad</p>
    <h2 class="mt-3 font-display text-h2 text-chalk">Wij ondersteunen dakdekkers in:</h2>
    <ul class="mt-6 grid max-w-3xl grid-cols-2 gap-2 text-body sm:grid-cols-3 md:grid-cols-4">
      <li>
        <a href="/amsterdam/dakdekker/" class="block py-2 text-(--color-sodium) underline"
          >Amsterdam</a
        >
      </li>
      <li>
        <a href="/rotterdam/dakdekker/" class="block py-2 text-(--color-sodium) underline"
          >Rotterdam</a
        >
      </li>
      <li>
        <a href="/utrecht/dakdekker/" class="block py-2 text-(--color-sodium) underline">Utrecht</a>
      </li>
    </ul>
  </div>
</section>
