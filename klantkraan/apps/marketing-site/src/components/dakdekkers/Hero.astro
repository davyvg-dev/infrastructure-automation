---
import StormCloud from '../illustrations/StormCloud.astro'

// Hero — H1 + storm-protocol subhead + dual CTA + trust line.
// Voice: voice-and-tone.md (u-form, declarative, one promise per sentence).
// v2 2026-05-21: 2-column grid on desktop with storm-cloud illustration on
// the right; vertical stack on mobile (illustration hidden under md).
---

<section class="py-10 md:py-16">
  <div class="mx-auto grid max-w-page gap-10 px-gutter md:grid-cols-[1fr_auto] md:items-center md:gap-16">
    <div>
      <h1 class="font-display text-hero text-chalk">
        De <span class="text-(--color-sodium)">Klantenmotor</span> voor dakdekkers.
      </h1>
      <p class="mt-6 max-w-2xl text-[1.125rem] text-dim leading-relaxed">
        Storm-protocol dat spoed-lekkages direct naar uw mobiel escaleert. 24/7 storingsdienst in
        vlot Nederlands. Inspectie- en offerte-afspraken rechtstreeks in uw agenda.
      </p>
      <div class="mt-10 btn-row">
        <a href="/demo/" class="btn btn-primary btn-lg">Probeer de demo</a>
        <a href="/rekentool/" class="btn btn-ghost btn-lg">Bereken uw ROI</a>
      </div>
    </div>
    <div class="hidden text-(--color-dim) md:block">
      <StormCloud class="h-64 w-64 lg:h-72 lg:w-72" />
    </div>
  </div>
  <div class="mx-auto max-w-page px-gutter">
    <ul role="list" class="fact-row mt-10">
      <li><span class="text-(--color-chalk)">AVG + AI Act art. 50</span> <span>Disclosure standaard aan</span></li>
      <li><span class="text-(--color-chalk)">Gehost in de EU</span> <span>Cloudflare · Neon · Hetzner</span></li>
      <li><span class="text-(--color-chalk)">Vlot Nederlands</span> <span>Kent storm-protocol + spoedtarief</span></li>
    </ul>
    <p class="mt-8 text-small text-dim">
      Done-for-you setup · Per maand opzegbaar · Eerste maand 50% korting
    </p>
  </div>
</section>
