---
import Icon from '../Icon.astro'
import StormCloud from '../illustrations/StormCloud.astro'

// Hero — H1 + storm-protocol subhead + dual CTA + trust line.
// Voice: voice-and-tone.md (u-form, declarative, one promise per sentence).
// v2 2026-05-21: 2-column grid on desktop with storm-cloud illustration on
// the right; vertical stack on mobile (illustration hidden under md).
---

<section class="py-10 md:py-16">
  <div
    class="mx-auto grid max-w-5xl gap-10 px-6 md:grid-cols-[1fr_auto] md:items-center md:gap-16"
  >
    <div>
      <h1 class="font-display text-hero text-(--color-kraan-ink)">
        De <span class="text-(--color-kraan-rust)">Klantenmotor</span> voor dakdekkers.
      </h1>
      <p class="mt-6 max-w-2xl text-h3 text-(--color-kraan-stone-700)">
        Storm-protocol dat spoed-lekkages direct naar uw mobiel escaleert. 24/7 storingsdienst in
        vlot Nederlands. Inspectie- en offerte-afspraken rechtstreeks in uw agenda.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/demo/"
          class="inline-block rounded-(--radius-button) bg-(--color-kraan-blue) px-6 py-3 text-body font-medium text-white no-underline hover:bg-(--color-kraan-blue-700)"
        >
          Probeer de demo
        </a>
        <a
          href="/rekentool/"
          class="inline-block rounded-(--radius-button) border border-(--color-kraan-blue) px-6 py-3 text-body font-medium text-(--color-kraan-blue) no-underline hover:bg-(--color-kraan-stone-100)"
        >
          Bereken uw ROI
        </a>
      </div>
    </div>
    <div class="hidden text-(--color-kraan-blue) md:block">
      <StormCloud class="h-64 w-64 lg:h-72 lg:w-72" />
    </div>
  </div>
  <div class="mx-auto max-w-5xl px-6">
    <ul role="list" class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-6">
      <li class="flex items-start gap-3">
        <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
        <div>
          <p class="text-small font-medium text-(--color-kraan-ink)">AVG + AI Act art. 50</p>
          <p class="text-small text-(--color-kraan-stone-500)">Disclosure standaard aan</p>
        </div>
      </li>
      <li class="flex items-start gap-3">
        <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
        <div>
          <p class="text-small font-medium text-(--color-kraan-ink)">Gehost in de EU</p>
          <p class="text-small text-(--color-kraan-stone-500)">Cloudflare · Neon · Hetzner</p>
        </div>
      </li>
      <li class="flex items-start gap-3">
        <Icon name="phone-call" class="mt-0.5 h-5 w-5 shrink-0 text-(--color-kraan-blue)" />
        <div>
          <p class="text-small font-medium text-(--color-kraan-ink)">Vlot Nederlands</p>
          <p class="text-small text-(--color-kraan-stone-500)">Kent storm-protocol + spoedtarief</p>
        </div>
      </li>
    </ul>
    <p class="mt-8 text-small text-(--color-kraan-stone-500)">
      Done-for-you setup · Per maand opzegbaar · Eerste maand 50% korting
    </p>
  </div>
</section>
