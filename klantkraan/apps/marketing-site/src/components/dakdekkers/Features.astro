---
import Icon from '../Icon.astro'

// Wat Klantkraan doet voor dakdekkers — drie hairline-divided rows.
// Linear/Plain pattern: no card boxing, icon left, content right.

const features = [
  {
    icon: 'zap' as const,
    title: 'Storm-protocol',
    body: 'De receptionist herkent op uw website en WhatsApp het verschil tussen een offerte-aanvraag en een spoed-lekkage. Bij spoed: directe melding op uw mobiel, ook \'s avonds en in het weekend. Gelijktijdige gesprekken worden parallel afgehandeld. Geen wachtrij.',
  },
  {
    icon: 'calendar-check' as const,
    title: 'Inspectie- en offerte-afspraken',
    body: 'Niet-spoed-aanvragen worden gekwalificeerd op postcode en daktype, en direct ingepland in uw agenda. \'s Ochtends ziet u wat er op de planning staat. Geen telefoontag, geen heen-en-weer-mailen.',
  },
  {
    icon: 'phone' as const,
    title: 'Leads en terugbelverzoeken op uw telefoon',
    body: 'Elke lead en elk terugbelverzoek landt direct als bericht op uw telefoon, met naam, nummer en de melding van de klant. Geen lekkage-melding raakt verloren terwijl u op een dak staat.',
  },
]
---

<section class="py-10 md:py-16">
  <div class="mx-auto max-w-5xl px-6">
    <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">Modules</p>
    <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">
      Wat Klantkraan doet voor dakdekkers.
    </h2>
    <p class="mt-4 max-w-2xl text-body text-(--color-kraan-stone-700)">
      Drie modules. Eén maandprijs. Geschreven na een avond meeluisteren met een dakdekker in Utrecht na storm Pia.
    </p>

    <div class="mt-10 divide-y divide-(--color-kraan-stone-300) border-y border-(--color-kraan-stone-300)">
      {
        features.map((feature) => (
          <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
            <Icon name={feature.icon} class="mt-1 h-7 w-7 text-(--color-kraan-blue)" />
            <div>
              <h3 class="font-display text-h3 text-(--color-kraan-ink)">{feature.title}</h3>
              <p class="mt-2 text-body text-(--color-kraan-stone-700)">{feature.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
