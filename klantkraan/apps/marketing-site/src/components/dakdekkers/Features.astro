---
import Icon from '../Icon.astro'

// Wat Klantkraan doet voor dakdekkers — drie hairline-divided rows.
// Linear/Plain pattern: no card boxing, icon left, content right.

const features = [
  {
    icon: 'zap' as const,
    title: 'Storm-protocol',
    body: 'De AI herkent het verschil tussen een offerte-aanvraag en een spoed-lekkage. Bij spoed: directe escalatie naar uw mobiel, ook \'s avonds en in het weekend. Gelijktijdige oproepen worden parallel afgehandeld — geen wachtrij.',
  },
  {
    icon: 'calendar-check' as const,
    title: 'Inspectie- en offerte-afspraken',
    body: 'Niet-spoed-aanvragen worden gekwalificeerd op postcode en daktype, en direct ingepland in uw Cal.com-agenda. U ziet \'s ochtends wat er op de planning staat — geen telefoontag, geen heen-en-weer-mailen.',
  },
  {
    icon: 'star' as const,
    title: 'Review-automation',
    body: 'Klus klaar? De klant krijgt de volgende ochtend om 10:00 een SMS met een korte review-vraag, specifiek over de kwaliteit van het werk. Google-reviews stapelen zich op — uw lokale ranking voor ‚dakdekker + plaats\' stijgt vanzelf.',
  },
]
---

<section class="py-10 md:py-16">
  <div class="mx-auto max-w-5xl px-6">
    <p class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)">Modules</p>
    <h2 class="mt-3 font-display text-h1 text-(--color-kraan-ink)">
      Wat Klantkraan doet voor dakdekkers.
    </h2>

    <div class="mt-10 divide-y divide-(--color-kraan-stone-300) border-y border-(--color-kraan-stone-300)">
      {
        features.map((feature) => (
          <article class="grid grid-cols-[auto_1fr] items-start gap-5 md:gap-6 py-6 md:py-8">
            <Icon name={feature.icon} class="mt-1 h-7 w-7 text-(--color-kraan-blue)" />
            <div>
              <h3 class="font-display text-h3 text-(--color-kraan-ink)">{feature.title}</h3>
              <p class="mt-2 text-body text-(--color-kraan-stone-700)">{feature.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
