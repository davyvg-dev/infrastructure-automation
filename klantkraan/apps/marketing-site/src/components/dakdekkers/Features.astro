---
import FlowDiagram from '../diagrams/FlowDiagram.astro'

// Wat Klantkraan doet voor dakdekkers, as the schematic: the three modules are
// its three outputs (answer, appointment, callback).

const features = [
  {
    icon: 'zap' as const,
    title: 'Stormprotocol',
    body: "De receptionist herkent op uw website en in WhatsApp het verschil tussen een offerteaanvraag en een spoedlekkage. Bij spoed krijgt u direct een melding op uw mobiel, ook 's avonds en in het weekend. Hij voert gesprekken tegelijk, zonder wachtrij.",
  },
  {
    icon: 'calendar-check' as const,
    title: 'Inspectie- en offerteafspraken',
    body: "Aanvragen zonder spoed beoordeelt hij op postcode en daktype en plant hij direct in uw agenda. 's Ochtends ziet u wat er op de planning staat. U belt en mailt niet meer heen en weer.",
  },
  {
    icon: 'phone' as const,
    title: 'Aanvragen en terugbelverzoeken op uw telefoon',
    body: 'Elke aanvraag en elk terugbelverzoek komt direct als bericht op uw telefoon binnen, met naam, nummer en de melding van de klant. Geen lekkagemelding raakt zoek terwijl u op een dak staat.',
  },
]
---

<FlowDiagram
  id="modules"
  nodeSub="voor dakdekkers"
  t={{
    label: 'Modules',
    heading: 'Wat Klantkraan doet voor dakdekkers',
    sub: 'Drie modules voor één maandprijs, geschreven na een avond meeluisteren met een dakdekker in Utrecht na storm Pia.',
    steps: features.map((f) => ({ title: f.title, text: f.body })),
  }}
/>
