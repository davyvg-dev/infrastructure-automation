---
import Stat from '../Stat.astro'

// Pijn-stats trio voor dakdekkers — storm-context.
---

<section class="border-y border-(--color-line) py-8 md:py-10">
  <div class="mx-auto max-w-page px-gutter">
    <div class="stat-row">
    <Stat value="35%" label="van uw oproepen bij storm komt na de piekuren binnen en wordt gemist." />
    <Stat value="€ 650" label="gemiddelde waarde van één noodreparatie na een storm." />
    <Stat
      value="4 tot 6 weken"
      label="wachttijdomzet die verdampt als een inspectieaanvraag blijft liggen."
    />
    </div>
  </div>
</section>
