---
import Stat from '../Stat.astro'

// Pijn-stats trio voor dakdekkers — storm-context.
---

<section class="border-y border-(--color-line) bg-[rgba(0,0,0,0.14)] py-10 md:py-16">
  <div class="mx-auto grid max-w-5xl gap-4 md:gap-6 px-6 sm:grid-cols-3">
    <Stat
      value="35%"
      label="van uw storm-oproepen komt na piek-uren binnen en wordt gemist."
    />
    <Stat
      value="€650"
      label="gemiddelde waarde van één noodreparatie na een storm."
    />
    <Stat
      value="4–6 weken"
      label="wachttijd-omzet die verdampt wanneer een inspectie-aanvraag blijft liggen."
    />
  </div>
</section>
