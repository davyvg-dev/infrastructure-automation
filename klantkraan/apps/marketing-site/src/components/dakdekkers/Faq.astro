---
import Icon from '../Icon.astro'

// FAQ — 6 vragen specifiek voor dakdekkers.
// HTML <details>/<summary> — geen JS, accessibility ok by default.

const faqs = [
  {
    q: 'Werkt het tijdens een storm met veel gelijktijdige meldingen?',
    a: 'Ja. De receptionist voert gesprekken tegelijk, zonder wachtrij. Chatten of appen tien klanten tegelijk, dan krijgen ze alle tien direct antwoord. Spoedlekkages herkent hij en houdt hij apart van offerteaanvragen.',
  },
  {
    q: 'Kent de AI mijn vaste tarieven voor inspectie en noodreparatie?',
    a: "Ja. Bij de start stellen wij uw inspectietarief, toeslag voor noodreparaties, voorrijkosten en eventuele weekendtoeslag in. De receptionist noemt die bedragen precies zoals u ze opgeeft.",
  },
  {
    q: 'Weet de klant dat het AI is?',
    a: 'Ja, vanaf de eerste zin. De assistent meldt dat uw klant met een digitale assistent chat, zoals artikel 50 van de Europese AI-verordening vereist. <a href="/legal/ai-disclosure/">Lees de volledige AI-disclosure</a>.',
  },
  {
    q: 'Wat als ik op het dak sta en niet kan reageren?',
    a: 'Bij een spoedlekkage krijgt u direct een melding op uw telefoon met naam, nummer en adres van de klant. De klant krijgt in het gesprek bevestiging dat de melding is doorgezet en wanneer hij reactie kan verwachten. U belt terug zodra u van het dak bent.',
  },
  {
    q: 'Werkt het naast mijn bestaande telefoonnummer of antwoordservice?',
    a: 'Ja. De receptionist draait op uw website en WhatsApp en staat los van uw telefoonlijn. U houdt uw huidige nummer; er wordt niets overgezet of doorgeschakeld. Aan- en uitzetten kan binnen één werkdag.',
  },
  {
    q: 'Is Klantkraan per maand opzegbaar?',
    a: 'Ja. U zegt op met één mail, wanneer u wilt. Er is geen jaarcontract en geen verborgen verlenging. De receptionist werkt tot het einde van de betaalde maand; daarna incasseren wij niets meer. <a href="/legal/voorwaarden/">Lees de algemene voorwaarden</a>.',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]+>/g, ''),
    },
  })),
}
---

<section class="py-10 md:py-16">
  <div class="mx-auto max-w-page px-gutter">
    
    <h2 class="font-display text-h1 text-chalk">Vragen die dakdekkers vaak stellen</h2>

    <div class="mt-10 divide-y divide-(--color-line) border-y border-(--color-line)">
      {
        faqs.map((faq) => (
          <details class="group py-4">
            <summary class="flex min-h-[2.75rem] cursor-pointer items-center justify-between gap-4 font-display text-h3 text-chalk marker:content-none">
              <span>{faq.q}</span>
              <Icon
                name="chevron-down"
                class="h-5 w-5 shrink-0 text-(--color-dim) transition-transform group-open:rotate-180"
              />
            </summary>
            <p class="mt-4 text-body text-dim" set:html={faq.a} />
          </details>
        ))
      }
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</section>
