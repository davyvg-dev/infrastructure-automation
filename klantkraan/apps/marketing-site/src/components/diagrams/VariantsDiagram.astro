---
/*
 * One ad video into sixteen versions, drawn as a fan-out: the source clip feeds
 * one rail that splits into four columns of four clips, beads on a wire. Every clip
 * keeps the same body (the existing footage, the same frame marks as the source)
 * and gets its own opening: a lit segment with a mark in a place no other version
 * has (16 distinct). Only what magnets.ts promises: sixteen versions of one
 * video, each with a different opening. Nothing about results.
 *
 * HTML boxes, so it reads the same in any slot from 280px to 620px. Snapped to
 * the paper's 40px ruling: the source sits between two lines, the rail lies on
 * one, and each row of clips runs down the middle of a lane. The source feeds the
 * rail at its left end, over the first column, so the current reads like text: it
 * runs right along the rail and down each column in turn, and each opening lights
 * as it passes (fed in the middle, half the rail ran right to left). Then every 7s
 * one pulse runs the same way and each opening brightens softly as it passes.
 * Motion is CSS only (transform, opacity), held until seen and paused off screen
 * by scripts/play-in-view.ts. Reduced motion or no JS: finished, nothing moving.
 */
interface Props {
  id?: string
}
const { id } = Astro.props

const aria =
  'Schema: één advertentievideo wordt zestien versies. Elke versie heeft hetzelfde beeld en een andere opening.'
// Where each version's mark sits in its opening (column, height): all 16 pairs
// differ, and no two neighbours share a column or a height.
const marks = [
  [0, 2], [2, 0], [1, 3], [3, 1],
  [2, 3], [0, 1], [3, 2], [1, 0],
  [1, 1], [3, 3], [0, 0], [2, 2],
  [3, 0], [1, 2], [2, 1], [0, 3],
]
const cols = [0, 1, 2, 3]
const rows = [0, 1, 2, 3]
---

<figure id={id} class="frame sheet" data-diagram="variants" data-kk-play role="img" aria-label={aria}>
  <div class="plan">
    <div class="src">
      <span class="clip clip-src"><span class="op"></span><span class="bd"></span></span>
      <span>Uw video</span>
    </div>

    <div class="fan">
      <span class="w w-feed"></span>
      <span class="w w-bus"></span>
      {
        cols.map((c) => (
          <div class="col" style={`--c:${c}`}>
            <span class="w w-drop" />
            {c < cols.length - 1 && <span class="j" />}
            {rows.map((r) => {
              const [mx, mh] = marks[r * 4 + c]
              return (
                <span class="clip" style={`--r:${r}`}>
                  <span class="op">
                    <i style={`--mx:${mx};--mh:${mh}`} />
                  </span>
                  <span class="bd" />
                </span>
              )
            })}
          </div>
        ))
      }
    </div>

    <p class="cap">16 versies, elk met een andere opening</p>
  </div>
</figure>

<style>
  .sheet {
    margin: 0;
    padding: 40px 1.25rem 2.5rem;
    background:
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent calc(2.5rem - 1px),
        color-mix(in oklab, var(--color-line) 45%, transparent) calc(2.5rem - 1px),
        color-mix(in oklab, var(--color-line) 45%, transparent) 2.5rem
      ),
      var(--color-night);
  }
  .plan {
    max-width: 23rem;
    margin-inline: auto;
  }

  /* ---- the source: over the first column, its left edge on the clips' (6px) ---- */
  .src {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: max-content;
    margin: 0 0 40px 6px;
    padding: 0 0.875rem;
    height: 40px;
    border: 1.5px solid var(--color-chalk-2);
    border-radius: 6px;
    background: var(--color-panel);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-chalk);
  }
  /* from the source's bottom edge (40px above the rail) down to the rail's bottom
   * edge, straight over the first column's drop; placed on the fan, not inside the
   * source, so it does not hang off the box's border */
  .w-feed {
    left: var(--x0);
    top: -40px;
    width: 1.5px;
    height: 40.5px;
    margin-left: -0.75px;
  }

  /* ---- a clip: an opening, then the footage ---- */
  .clip {
    position: relative;
    z-index: 1;
    display: flex;
    height: 14px;
    border: 1px solid var(--color-line-strong);
    border-radius: 2px;
    background: var(--color-night);
    overflow: hidden;
  }
  .op {
    position: relative;
    width: 34%;
    flex: none;
    border-right: 1px solid var(--color-line-strong);
    background: var(--color-panel-2);
  }
  .op::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-sodium);
  }
  .op i {
    position: absolute;
    z-index: 1;
    left: calc(16% + var(--mx) * 20%);
    bottom: 2px;
    width: 2px;
    height: calc(3px + var(--mh) * 2px);
    background: var(--color-sodium-ink);
  }
  /* the footage: frame marks, the same in every version */
  .bd {
    flex: 1;
    background: repeating-linear-gradient(
      to right,
      transparent 0 4px,
      var(--color-line-strong) 4px 5px
    );
  }
  .clip-src {
    width: 3rem;
    height: 12px;
  }
  /* the source's own opening: the one every version replaces */
  .clip-src .op {
    background: repeating-linear-gradient(
      -45deg,
      var(--color-line-strong) 0 1px,
      transparent 1px 3.5px
    );
  }
  .clip-src .op::before {
    content: none;
  }

  /* ---- wires ---- */
  .w {
    position: absolute;
    background: var(--color-line-strong);
  }
  .w::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-sodium);
    opacity: 0.6;
    transform-origin: 50% 0;
  }
  /* Wire centres, rounded so every 1.5px wire box starts on a whole px (a column
   * centre at 12.5% of the width rarely is one): --xc is a column's centre, --x0
   * and --x3 the first and last. The drops and junctions sit in .col but are placed
   * on the fan (the columns are not positioned). */
  .fan {
    --x0: 12.5%;
    --x3: 87.5%;
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .col {
    --xc: calc((var(--c) * 2 + 1) * 12.5%);
  }
  @supports (left: round(down, 1px, 1px)) {
    .fan {
      --x0: calc(round(down, 12.5% - 0.75px, 1px) + 0.75px);
      --x3: calc(round(down, 87.5% - 0.75px, 1px) + 0.75px);
    }
    .col {
      --xc: calc(round(down, (var(--c) * 2 + 1) * 12.5% - 0.75px, 1px) + 0.75px);
    }
  }
  /* The rail's top edge sits 1px above the ruled line, on a whole pixel (at 0.75px
   * above it sat on .25 and drew thinner than the drops); its centre is 0.25px
   * above the line and the junctions hang on it. It runs from the feed's left
   * edge to the last drop's outer edge, so that corner is solid. */
  .w-bus {
    top: -1px;
    left: calc(var(--x0) - 0.75px);
    width: calc(var(--x3) - var(--x0) + 1.5px);
    height: 1.5px;
  }
  .w-bus::after {
    transform-origin: 0 50%;
  }
  /* a dot where the line branches: under the feed, and where columns 2 and 3 tap off */
  .j {
    position: absolute;
    left: var(--xc);
    top: -0.25px;
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
    border-radius: 50%;
    background: var(--color-chalk-2);
  }
  /* clip centres at 20, 60, 100 and 140px under the rail: mid-lane */
  .col {
    display: grid;
    gap: 26px;
    padding: 13px 6px 0;
  }
  .w-drop {
    left: calc(var(--xc) - 0.75px);
    top: 0;
    width: 1.5px;
    height: 140px;
  }

  .cap {
    margin: 1.5rem 0 0;
    text-align: center;
    text-wrap: balance;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-dim);
  }

  /* ---- motion ----
   * Build-up: the feed from 0.4s (40px at 280px/s), then the rail left to right in
   * 0.6s, so it reaches column c at --at = 0.543s + c * 0.2s; each column runs down
   * from then at the feed's speed, and an opening lights as the current passes it.
   *
   * Idle, from --idle on, every 7s: one pulse down the feed (40px at 200px/s), along
   * the rail in 1.4s, and down each column from the moment it passes (0.4125s per
   * column: the rail's head reaches a column centre at 29.5 to 30% of its run, at
   * any width from 280 to 620px, within 3px). Each opening brightens softly as the
   * pulse reaches it, by less than a tenth in luminance, so it is no flash. A pulse
   * is a short bright dash inside its wire, which clips it; the feed's and drops'
   * dashes move 1400px (7s at 200px/s) per cycle, the rail's dash crosses the rail
   * in the first fifth of its cycle and waits past its end, so a dash only shows in
   * its own wire, going down or right, and the jump back to the start of a cycle
   * happens out of sight. Keyframe names carry this drawing's prefix: keyframes are
   * global. */
  @media (prefers-reduced-motion: no-preference) and (scripting: enabled) {
    .sheet {
      --idle: 6s;
    }
    .w-feed::after {
      animation:
        vd-wy 0.143s linear 0.4s backwards,
        vd-settle 0.9s ease 1.4s backwards;
    }
    .w-bus::after {
      animation:
        vd-wx 0.6s linear 0.543s backwards,
        vd-settle 0.9s ease 1.6s backwards;
    }
    .col {
      --at: calc(0.543s + var(--c) * 0.2s);
      --pt: calc(var(--idle) + 0.2s + var(--c) * 0.4125s);
    }
    .w-drop::after {
      animation:
        vd-wy 0.5s linear var(--at) backwards,
        vd-settle 0.9s ease calc(var(--at) + 1s) backwards;
    }
    .op::before {
      animation: vd-print 0.26s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--at) + 0.07s + var(--r) * 0.143s) backwards;
    }
    .op i {
      animation: vd-on 0.26s linear calc(var(--at) + 0.07s + var(--r) * 0.143s) backwards;
    }

    /* ---- the idle pulse ---- */
    .w {
      z-index: 0;
      overflow: hidden;
    }
    .w::before {
      content: '';
      position: absolute;
      z-index: 1;
    }
    .w-feed::before,
    .w-drop::before {
      left: 0;
      right: 0;
      top: -32px;
      height: 32px;
      background: linear-gradient(
        to bottom,
        transparent,
        color-mix(in oklab, var(--color-sodium) 30%, transparent) 55%,
        var(--color-sodium) 88%
      );
      animation: vd-run-y 7s linear var(--pt, var(--idle)) infinite;
    }
    /* the rail's dash rides at the left end of a box as long as the rail plus the
     * dash, which moves by its own width */
    .w-bus::before {
      top: 0;
      bottom: 0;
      left: -32px;
      right: 0;
      background: linear-gradient(
          to right,
          transparent,
          color-mix(in oklab, var(--color-sodium) 30%, transparent) 55%,
          var(--color-sodium) 88%
        )
        0 0 / 32px 100% no-repeat;
      animation: vd-run-rail 7s linear calc(var(--idle) + 0.2s) infinite;
    }
    .fan .op::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--color-sodium-soft);
      opacity: 0;
      animation: vd-brighten 7s linear calc(var(--pt) + 0.065s + var(--r) * 0.2s) infinite;
    }
  }
  @keyframes vd-wy {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes vd-wx {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes vd-settle {
    from {
      opacity: 1;
    }
  }
  @keyframes vd-on {
    from {
      opacity: 0;
    }
  }
  /* an opening written in from the left */
  @keyframes vd-print {
    from {
      opacity: 0;
      transform: scaleX(0.2);
    }
  }
  .op::before {
    transform-origin: 0 50%;
  }
  @keyframes vd-run-y {
    to {
      transform: translateY(1400px);
    }
  }
  @keyframes vd-run-rail {
    20%,
    100% {
      transform: translateX(100%);
    }
  }
  /* sodium to sodium-soft at 60%: a soft brighten, not a flash */
  @keyframes vd-brighten {
    0% {
      opacity: 0;
      animation-timing-function: cubic-bezier(0.3, 0.6, 0.4, 1);
    }
    1.5% {
      opacity: 0.6;
      animation-timing-function: ease-in-out;
    }
    9%,
    100% {
      opacity: 0;
    }
  }
</style>

<script>
  import '../../scripts/play-in-view'
</script>
