---
/*
 * Product-screenshot stand-in. Pure HTML + Tailwind so it renders crisp
 * at any resolution and uses the brand font stack. Shows the two screens
 * that matter most for selling the product: the gesprekslog (call log)
 * and the missed-call SMS flow.
 *
 * Per blueprint research/website-aesthetics.md §4 A2: a product artefact
 * above the fold is what every B2B SaaS gold standard does and what
 * Klantkraan is missing. This component fills the slot until the real
 * dashboard ships.
 */

interface CallLogEntry {
  time: string
  status: 'spoed' | 'routine' | 'afgewerkt'
  subject: string
  duration: string
}

const callLog: CallLogEntry[] = [
  { time: '14:32', status: 'spoed', subject: 'Lekkage badkamer', duration: '3 min' },
  { time: '13:18', status: 'routine', subject: 'CV-storing inplannen', duration: '5 min' },
  { time: '11:02', status: 'afgewerkt', subject: 'Standleiding inspectie', duration: '12 min' },
]
---

<div
  class="relative overflow-hidden rounded-(--radius-card) border border-(--color-kraan-stone-300) bg-white"
  role="img"
  aria-label="Voorbeeldweergave van het Klantkraan-dashboard"
>
  <!-- Window chrome -->
  <div
    class="flex items-center gap-2 border-b border-(--color-kraan-stone-300) bg-(--color-kraan-stone-100) px-4 py-3"
  >
    <span class="inline-block h-2.5 w-2.5 rounded-full bg-(--color-kraan-stone-300)"></span>
    <span class="inline-block h-2.5 w-2.5 rounded-full bg-(--color-kraan-stone-300)"></span>
    <span class="inline-block h-2.5 w-2.5 rounded-full bg-(--color-kraan-stone-300)"></span>
    <span class="ml-4 font-mono text-micro text-(--color-kraan-stone-500)">
      app.klantkraan.nl/dashboard
    </span>
  </div>

  <div class="grid gap-0 md:grid-cols-2">
    <!-- Left pane: call log -->
    <div
      class="border-b border-(--color-kraan-stone-300) p-5 md:border-b-0 md:border-r md:p-6"
    >
      <p
        class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)"
      >
        Gesprekslog · vandaag
      </p>
      <ul class="mt-5 space-y-4">
        {
          callLog.map((entry) => (
            <li class="flex items-start gap-3">
              <span
                class:list={[
                  'mt-1.5 inline-block h-2.5 w-2.5 shrink-0 rounded-full',
                  entry.status === 'spoed' && 'bg-(--color-kraan-rust)',
                  entry.status === 'routine' && 'bg-(--color-kraan-blue)',
                  entry.status === 'afgewerkt' && 'bg-(--color-kraan-leaf)',
                ]}
                aria-hidden="true"
              />
              <div class="min-w-0 flex-1">
                <div class="flex items-baseline justify-between gap-3">
                  <p class="font-mono text-small text-(--color-kraan-ink)">{entry.time}</p>
                  <p
                    class:list={[
                      'text-micro font-medium uppercase tracking-wider',
                      entry.status === 'spoed' && 'text-(--color-kraan-rust)',
                      entry.status === 'routine' && 'text-(--color-kraan-blue)',
                      entry.status === 'afgewerkt' && 'text-(--color-kraan-leaf)',
                    ]}
                  >
                    {entry.status}
                  </p>
                </div>
                <p class="mt-1 text-small text-(--color-kraan-ink)">{entry.subject}</p>
                <p class="text-micro text-(--color-kraan-stone-500)">
                  +31 6 1• •• ••• · {entry.duration}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Right pane: missed-call SMS flow -->
    <div class="bg-(--color-kraan-cream) p-5 md:p-6">
      <p
        class="font-mono text-micro uppercase tracking-widest text-(--color-kraan-stone-500)"
      >
        Gemiste oproep · net binnen
      </p>
      <p class="mt-2 font-mono text-small text-(--color-kraan-ink)">+31 6 12 345 678</p>

      <!-- SMS bubble -->
      <p class="mt-5 text-micro text-(--color-kraan-stone-500)">
        Bericht verzonden 14:33
      </p>
      <div
        class="mt-2 rounded-(--radius-card) border border-(--color-kraan-stone-300) bg-white p-4"
      >
        <p class="text-small text-(--color-kraan-ink)">
          Hoi! U belde Klantkraan Loodgieter zojuist. Wij bellen u binnen 10 minuten terug. Past u
          dat? Antwoord <strong>JA</strong>.
        </p>
        <p class="mt-3 text-micro text-(--color-kraan-stone-500)">Klantkraan</p>
      </div>

      <!-- Status checks -->
      <ul class="mt-5 space-y-2 text-small">
        <li class="flex items-start gap-2 text-(--color-kraan-ink)">
          <span class="font-mono text-(--color-kraan-leaf)" aria-hidden="true">✓</span>
          <span>
            Klant heeft <strong>JA</strong> geantwoord <span class="text-(--color-kraan-stone-500)"
              >14:35</span
            >
          </span>
        </li>
        <li class="flex items-start gap-2 text-(--color-kraan-ink)">
          <span class="font-mono text-(--color-kraan-leaf)" aria-hidden="true">✓</span>
          <span>
            Terugbel-afspraak ingepland <span class="text-(--color-kraan-stone-500)"
              >· vandaag 14:45 met Jan B.</span
            >
          </span>
        </li>
      </ul>
    </div>
  </div>
</div>
