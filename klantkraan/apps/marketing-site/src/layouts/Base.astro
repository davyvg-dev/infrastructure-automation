---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import StickyMobileCta from '../components/StickyMobileCta.astro'

interface Props {
  title: string
  description: string
  canonical?: string
  /**
   * When true (default): wrap <slot /> in a centered max-w-5xl main.
   * When false: emit a bare <main id="main"> so individual sections can
   * own their own bg + width (used by pages with full-bleed alt-bg sections).
   */
  centered?: boolean
}

const { title, description, canonical, centered = true } = Astro.props
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString()
const ogImage = new URL('/og-default.png', Astro.site).toString()
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Klantkraan" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0F4C81" />
  </head>
  <body class="pb-[5.5rem] md:pb-0">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-(--radius-button) focus:bg-(--color-kraan-blue) focus:px-4 focus:py-2 focus:text-white focus:no-underline"
    >
      Ga naar hoofdinhoud
    </a>
    <Header />
    {
      centered ? (
        <main id="main" class="mx-auto max-w-5xl px-6 py-10 md:py-16">
          <slot />
        </main>
      ) : (
        <main id="main">
          <slot />
        </main>
      )
    }
    <Footer />
    <StickyMobileCta />
  </body>
</html>
