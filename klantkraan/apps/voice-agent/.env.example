# @kk/voice-agent — environment. Copy to .env (gitignored). Real values in Bitwarden.

# --- LiveKit (media transport / SFU) ---
# Phase 2 decision: LiveKit Cloud (free tier) to start, self-host on Hetzner later.
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Model providers (the call cost lives here, not in the SFU) ---
DEEPGRAM_API_KEY=          # STT — nova-2/3, Dutch (nl)
ELEVENLABS_API_KEY=        # TTS — Dutch voice, eleven_multilingual_v2 (Daan/Sanne)
ANTHROPIC_API_KEY=         # LLM — claude-sonnet-4-6

# --- Klantkraan backend ---
KK_API_BASE_URL=https://api.klantkraan.nl   # tool callbacks + call-end webhook

# --- Telephony / SIP (phase 3) ---
# Inbound number -> SIP trunk -> LiveKit SIP -> this agent.
SIP_PROVIDER=              # twilio | telnyx | cm  (decision pending)
SIP_TRUNK_ID=
ELEVENLABS_COOLGLOBAL_AGENT_ID=
ELEVENLABS_DHZ_AGENT_ID=
