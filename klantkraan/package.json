{
  "name": "klantkraan",
  "version": "0.0.0",
  "private": true,
  "description": "Klantkraan productized marketing automation for Dutch trades.",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,astro,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,astro,md,json,yaml,yml}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
