        "jsonBody": "={\n  \"from\": \"Klantkraan <welkom@klantkraan.nl>\",\n  \"to\": [\"{{ $('Parse SignWell Payload').item.json.owner_email }}\"],\n  \"subject\": \"Welkom bij Klantkraan — eerste stap\",\n  \"text\": \"Hoi {{ $('Parse SignWell Payload').item.json.owner_voornaam }},\\n\\nWelkom! De komende 8 dagen ben ik vooral op de achtergrond bezig. Wat we van jou nodig hebben:\\n\\n1. Vul de intake in (12 minuten): {{ $('Parse SignWell Payload').item.json.tally_short_url }}\\n2. Bekijk dit korte filmpje (90 sec) over wat er deze week gebeurt: {{ $('Parse SignWell Payload').item.json.loom_link }}\\n3. Donderdag dag 4 stuur ik je de doorschakel-instructies voor {{ $('Parse SignWell Payload').item.json.provider }}.\\n\\nVragen tussendoor? App me direct op {{ $('Parse SignWell Payload').item.json.founder_whatsapp }}.\\n\\nTot zo,\\n{{ $('Parse SignWell Payload').item.json.founder_voornaam }}\"\n}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER",
          "name": "Resend - API Key"
        }
      }
    },
