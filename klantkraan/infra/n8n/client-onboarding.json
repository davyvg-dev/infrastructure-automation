    {
      "id": "44444444-4444-4444-8444-444444444442",
      "name": "Parse SignWell Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 400],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Expected: { document_id, client_id, tier (Lite|Pro|Max), owner_voornaam, owner_e164, owner_email, bedrijfsnaam, slug, provider, tally_short_url, loom_link, founder_voornaam, founder_whatsapp }\nconst body = items[0].json.body || items[0].json;\nif (!['Lite','Pro','Max'].includes(body.tier)) {\n  throw new Error('Invalid tier: ' + body.tier);\n}\nfor (const k of ['client_id','owner_voornaam','owner_e164','owner_email','bedrijfsnaam','slug']) {\n  if (!body[k]) throw new Error('Missing required field: ' + k);\n}\nreturn [{ json: body }];"
      }
    },
    {
      "id": "44444444-4444-4444-8444-444444444443",
      "name": "Suppression Check (Owner SMS)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [640, 400],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT EXISTS(SELECT 1 FROM suppression_list WHERE e164_hash = encode(digest($1, 'sha256'), 'hex')) AS sms_suppressed, EXISTS(SELECT 1 FROM suppression_list WHERE email_hash = encode(digest(lower($2), 'sha256'), 'hex')) AS email_suppressed;",
        "options": {
          "queryReplacement": "={{ $('Parse SignWell Payload').item.json.owner_e164 }},={{ $('Parse SignWell Payload').item.json.owner_email }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Neon - klantkraan_app"
        }
      }
    },
    {
      "id": "44444444-4444-4444-8444-444444444444",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [640, 600],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"onboarding_started\" }"
      }
    },
