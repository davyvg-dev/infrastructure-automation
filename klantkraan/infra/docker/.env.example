# Copy to .env on the host at /mnt/data/docker/.env and chmod 600.
# Real values live in Bitwarden vault "klantkraan-infra"; never commit a populated .env.

# n8n editor basic-auth — separate from any Cloudflare Access in front of /ops.
N8N_USER=admin
N8N_PASSWORD=change-me-32-chars-min

# Symmetric key used by n8n to encrypt credentials at rest. MUST be stable across deploys;
# losing this key bricks every stored credential. Generate once: `openssl rand -hex 32`.
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# Neon Postgres connection — branch `main`, role `klantkraan_n8n` (separate DB from app role).
PG_HOST=ep-xxx-pooler.eu-central-1.aws.neon.tech
PG_DB=klantkraan_n8n
PG_USER=klantkraan_n8n
PG_PASS=change-me

# Borg / Borgmatic — used by scripts/borg-backup.sh
BORG_REPO=ssh://borguser@xxx.repo.borgbase.com/./repo
BORG_PASSPHRASE=change-me-borg-passphrase
BORG_RSH=ssh -i /home/klantkraan/.ssh/id_ed25519_borg -o StrictHostKeyChecking=yes

# Healthchecks.io ping URLs (one per cron). Pinged on success at end of script.
HC_BORG_BACKUP_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000
HC_DEPLOY_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000001

# Deploy target — consumed by scripts/deploy.sh.
KK_HOST=klantkraan@kk-prod-1.klantkraan.nl
KK_SSH_KEY=~/.ssh/id_ed25519_klantkraan
