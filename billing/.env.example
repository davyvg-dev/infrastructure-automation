# Mollie API key — START WITH A TEST KEY (test_...). Get it from the Mollie
# dashboard: Developers -> API keys. Switch to a live key (live_...) only after
# Mollie has verified your account. NEVER commit the real key.
MOLLIE_API_KEY=test_replace_me

# Where Mollie returns the client after checkout.
BILLING_REDIRECT_URL=https://klantkraan.nl/

# Resend API key — used by the webhook to email the factuur to the client.
# The 'from' address (BILLING_SELLER_EMAIL) must be on a Resend-verified domain.
RESEND_API_KEY=

# Optional: base URL of the billing webhook server (scaffold step). Leave unset
# until it's deployed — webhooks are simply omitted while this is empty.
# BILLING_WEBHOOK_BASE=https://billing.klantkraan.nl

# Seller identity for invoices (scaffold step). Fill from the KvK/BTW registration.
BILLING_SELLER_NAME=Klantkraan
BILLING_SELLER_KVK=
BILLING_SELLER_BTW=
BILLING_SELLER_ADDRESS=
BILLING_SELLER_EMAIL=facturen@klantkraan.nl
BILLING_SELLER_IBAN=
