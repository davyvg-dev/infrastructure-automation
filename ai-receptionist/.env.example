# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...

# --- Intake scraping (optional) ---
# Enriches `python -m app.extract` with Google Maps details (name, phone, hours, primaryType).
# Without it, extract falls back to site-only scraping. Enable "Places API (New)" in Google Cloud.
# GOOGLE_PLACES_API_KEY=

# Optional: override the business config file (default: config/business.yaml). This is the
# single-tenant / fallback config; multi-tenant clients are routed from config/clients/<slug>.yaml.
# BUSINESS_CONFIG=config/my-prospect.yaml
# Optional: where routed client configs live (default: config/clients)
# CLIENTS_DIR=config/clients

# --- Telegram channel (optional) ---
# The receptionist's OWN bot — create a SECOND bot with @BotFather, separate from the
# growth-engine approval bot. Needed only if you run the Telegram channel.
TELEGRAM_BOT_TOKEN=

# --- Owner notifications (optional) ---
# Get pinged when the receptionist books someone, takes a message, or gets stuck.
# Message your bot once, then run `python -m app.notify chatid` and paste what it prints.
OWNER_TELEGRAM_CHAT_ID=
# Which bot sends the alerts — defaults to TELEGRAM_BOT_TOKEN if left blank.
# NOTIFY_TELEGRAM_TOKEN=
# Fallback inbox for the long-form reports (the daily digest) when Telegram is not
# configured, or when the report is too long for Telegram. Needs RESEND_API_KEY below.
# Without either, the digest timer exits 1 instead of quietly delivering into the journal.
# OWNER_EMAIL=davy@klantkraan.nl

# --- Per-client capture / oversight (optional; app/analytics.py) ---
# Every conversation turn is persisted to data/analytics.db, namespaced by client slug.
# Channel user ids (phone numbers) are stored only as a hash salted with this value.
# ANALYTICS_SALT=change-me
# AVG retention: raw transcript text older than this many days is purged by
# `python -m app.analytics purge` (run it from a daily cron/systemd timer). The
# aggregated per-client rollup is kept as ROI history regardless. Default 90.
# ANALYTICS_RETENTION_DAYS=90
# Daily oversight digest (`python -m app.oversight digest`, systemd timer) reuses
# OWNER_TELEGRAM_CHAT_ID below. Cost estimate: USD->EUR factor + per-client cost-spike
# alert threshold (€/day). Defaults 0.92 and 2.0.
# OVERSIGHT_USD_TO_EUR=0.92
# OVERSIGHT_COST_ALERT_EUR=2.0
# Nightly analyst (`python -m app.oversight analyze`, systemd timer) uses ANTHROPIC_API_KEY
# to turn finished transcripts into per-client insights. Cheap Haiku classification; override
# the model if needed (Haiku takes no effort/thinking params). Default claude-haiku-4-5.
# OVERSIGHT_ANALYST_MODEL=claude-haiku-4-5-20251001

# --- Uptime watchdog (optional; ops/hetzner/ai-receptionist-watchdog.timer) ---
# Probes the live demo every 2 min and self-heals; deep /chat probe every ~15 min
# catches a dead API key / no credits (which leave /health green). Alerts reuse
# OWNER_TELEGRAM_CHAT_ID above, so set that for the pings to reach you.
# WATCHDOG_HEALTH_URL=https://demo-168-119-173-25.sslip.io/health
# WATCHDOG_CHAT_URL=          # default: health URL with /health -> /chat
# WATCHDOG_SERVICE=ai-receptionist
# WATCHDOG_DEEP_INTERVAL=900  # seconds between deep /chat probes
# WATCHDOG_CHAT_API_KEY=      # only if you set CHAT_API_KEY below

# --- Server (optional) ---
# HOST=0.0.0.0 when serving behind Caddy on a VPS; default 127.0.0.1.
# HOST=127.0.0.1
# PORT=8000
# LOG_LEVEL=INFO

# --- Web chat endpoint protection (optional) ---
# Per-IP requests per minute on POST /chat (default 20). Every request is a paid Claude call.
# CHAT_RATE_LIMIT_PER_MINUTE=20
# Require an X-API-Key header on /chat — for embedding the API behind your own frontend.
# Note: the bundled widget sends no key, so only set this when you proxy the widget yourself.
# CHAT_API_KEY=
# Origins allowed to POST signup leads to /api/lead (comma-separated). Defaults to the
# klantkraan.nl marketing site; Pages deploy previews are always allowed via regex.
# CORS_ALLOW_ORIGINS=https://klantkraan.nl,https://www.klantkraan.nl

# --- WhatsApp channel via Twilio (optional) ---
# Required to accept /whatsapp webhooks: incoming requests are rejected unless the
# Twilio signature validates against this token (fail-closed).
TWILIO_AUTH_TOKEN=
# Local dev only: accept unsigned /whatsapp requests without a token. Never in production.
# WHATSAPP_ALLOW_UNSIGNED=1
# Only needed if you later send proactive/outbound WhatsApp messages:
# TWILIO_ACCOUNT_SID=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Mollie billing (optional; app/billing.py) ---
# Live API key from the Mollie dashboard; unset = billing disabled, everything else works.
MOLLIE_API_KEY=
# Where the customer lands after checkout (default: https://klantkraan.nl/ until a
# /bedankt/ thank-you page exists) and where Mollie posts payment webhooks.
# MOLLIE_REDIRECT_URL=https://klantkraan.nl/bedankt/
# MOLLIE_WEBHOOK_URL=https://demo.klantkraan.nl/api/mollie/webhook

# --- Transactional e-mail via Resend (optional; app/mailer.py) ---
# Sends the customer their welcome mail the moment a first payment lands. Unset = the mail
# is printed instead of sent, and the founder's Telegram ping says so loudly so he can send
# it by hand (python -m app.billing welcome cst_... --send). Resend is already the declared
# transactional-email sub-processor, so this adds no vendor to the register.
# The MAIL_FROM domain must be verified in Resend or every send is refused.
RESEND_API_KEY=
# MAIL_FROM=Klantkraan <hallo@klantkraan.nl>
# MAIL_REPLY_TO=hallo@klantkraan.nl

# --- Google Calendar provider (optional; only for clients on calendar.provider: google) ---
# Path to the shared service-account key JSON (the account the client shared their calendar
# with). Keep this file outside the repo. Full setup: docs/GOOGLE-CALENDAR.md.
# GOOGLE_CALENDAR_SA_JSON=/path/to/klantkraan-agenda-sa.json
